{
  "schemaVersion": "hartevo-web-adapters/github-pages/v1",
  "pluginId": "site-publication.github-pages",
  "service": "SitePublicationService",
  "provider": "GitHub Pages adapter",
  "consumer": "Mission capability/result",
  "adapterId": "web.github-pages",
  "adapterVersion": 1,
  "registryVersion": "web-publication.github-pages/v1",
  "operations": [
    "probe",
    "read",
    "prepare_effect",
    "execute",
    "reconcile",
    "verify",
    "rollback"
  ],
  "proposalOnly": false,
  "externalMutation": true,
  "mutationModel": "non_force_git_data_commit_and_ref_update",
  "rollbackModel": "new_effect_new_receipt_new_readback",
  "reconcileModel": "read_only_external_state_confirmation_no_auto_replay",
  "readModel": "repository_tree_at_pages_source_ref",
  "secretMaterial": "opaque_reference_only",
  "requiredScopes": ["contents:read", "contents:write", "pages:read"],
  "stagingProductionFence": true,
  "approvalBinding": [
    "exact_proposal_digest",
    "source_work_product_id_revision_digest",
    "connection_id",
    "account_id",
    "domain_id",
    "environment",
    "target_revision",
    "base_head_sha",
    "target_tree_digest",
    "payload_digest",
    "effect_digest",
    "effect_approval_digest",
    "effect_broker_authorization_digest"
  ],
  "independentReadback": [
    "pages_config",
    "authenticated_ref_tree_blob",
    "public_url",
    "dns",
    "public_content"
  ],
  "failClosedProviderStates": [
    "unauthorized",
    "forbidden",
    "conflict",
    "rate_limited",
    "branch_protection",
    "provider_drift",
    "partial_commit",
    "late_webhook",
    "revoked_connection"
  ],
  "registrationBinding": {
    "tenant": true,
    "project": true,
    "mission": true,
    "connection": true,
    "digest": true,
    "revocable": true
  },
  "durableModelVisibleLog": true,
  "claimAuthority": {
    "connected": false,
    "providerExecution": false,
    "providerReceipt": false,
    "businessVerification": false,
    "e4": false
  }
}
