{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hartevo.example/contracts/distribution/restore-drill/1.0.0",
  "title": "Hartevo backup, restore and disaster-recovery drill",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "drillId", "releaseCommit", "manifestSha256", "evidenceClass", "releaseDecision", "scenarios", "contentFree", "nativeEvidenceRequired"],
  "properties": {
    "schemaVersion": {"const": "hartevo-restore-drill/v1"},
    "drillId": {"type": "string", "pattern": "^restore-[0-9a-f]{40}$"},
    "releaseCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "manifestSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidenceClass": {"enum": ["DETERMINISTIC_SIMULATOR", "NATIVE", "BLOCKED_ENV", "CI_NOT_EXECUTED"]},
    "releaseDecision": {"const": "NOT_EVALUATED"},
    "contentFree": {"const": true},
    "nativeEvidenceRequired": {"const": true},
    "scenarios": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "status", "evidenceClass", "rpoMinutes", "rtoMinutes", "checks", "failureClasses"],
        "properties": {
          "id": {"enum": ["local_sqlcipher_backup_restore", "cell_postgres_failover", "object_store_unavailable", "desktop_migration_rollback", "signed_update_rollback"]},
          "kind": {"enum": ["local", "cell", "object_store", "migration", "update"]},
          "status": {"enum": ["PASS", "FAIL", "BLOCKED_ENV", "CI_NOT_EXECUTED"]},
          "evidenceClass": {"enum": ["DETERMINISTIC_SIMULATOR", "NATIVE", "BLOCKED_ENV", "CI_NOT_EXECUTED"]},
          "rpoMinutes": {"type": "integer", "minimum": 0},
          "rtoMinutes": {"type": "integer", "minimum": 0},
          "checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "failureClasses": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Z0-9_]{1,64}$"}}
        }
      }
    }
  }
}
