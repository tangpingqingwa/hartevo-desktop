{
  "schemaVersion": "hartevo-linkedin-insight-read-contract/v1",
  "contractVersion": "linkedin-insight-read-e1/v1",
  "evidenceLevel": "E1",
  "providerId": "linkedin",
  "adapterId": "linkedin.marketing.organization-insights",
  "adapterVersion": 1,
  "service": "PaidSocialInsightReadService",
  "consumer": "MissionPaidSocialInsightConsumer",
  "centralCatalogRegistration": "deferred_until_mission_reverse_mapping",
  "registrations": [],
  "connectionAuthority": "authenticated_probe_only",
  "connectionStates": [
    "unmounted",
    "mounted",
    "stale",
    "revoked"
  ],
  "connectedClaim": false,
  "claimAuthority": {
    "connected": false,
    "providerExecution": false,
    "providerReceipt": false,
    "businessVerification": false,
    "e4": false,
    "effect": false
  },
  "scope": {
    "connector": [
      "tenant",
      "project",
      "provider=linkedin",
      "account=authenticated_member"
    ],
    "provider": [
      "member",
      "organization",
      "organization_page",
      "ad_account"
    ],
    "binding": "member_identity_and_each_requested_provider_id_must_match_authenticated_probe"
  },
  "authentication": {
    "flow": "member_authorization_3_legged_oauth",
    "secretMaterial": "opaque_reference_only",
    "memberProbe": "GET /v2/userinfo",
    "organizationProbe": "GET /rest/organizations/{organizationId}",
    "pageProbe": "GET /rest/organizations/{pageId}",
    "adAccountProbe": "GET /rest/adAccounts/{adAccountId}",
    "requiredScopes": {
      "member": [
        "openid",
        "profile"
      ],
      "organizationPageRead": [
        "rw_organization_admin",
        "r_organization_social"
      ],
      "adAccountRead": [
        "r_ads",
        "r_ads_reporting"
      ]
    },
    "providerWritePermissionNote": "LinkedIn documents rw_organization_admin for organizationalEntityShareStatistics reporting; this adapter exposes no write operation, no Effect authority, and no write registration."
  },
  "readSurfaces": {
    "organizationPagePerformance": {
      "method": "GET",
      "path": "/rest/organizationalEntityShareStatistics",
      "model": "linkedin_organization_share_statistics",
      "activity": "organic_only",
      "scopeParameter": "organizationalEntity=urn:li:organization:{pageId}"
    },
    "organizationPostPerformance": {
      "method": "GET",
      "path": "/rest/organizationalEntityShareStatistics",
      "model": "linkedin_organization_share_statistics",
      "activity": "organic_only",
      "scopeParameter": "organizationalEntity=urn:li:organization:{pageId}",
      "postFilter": "shares=List(urn:li:share:{postId})",
      "timeWindow": "provider_lifetime_only; time-bound statistics are not supported for specific shares"
    },
    "adAccountPerformance": {
      "method": "GET",
      "path": "/rest/adAnalytics",
      "model": "linkedin_ad_analytics",
      "activity": "sponsored_reporting",
      "scopeParameter": "accounts=List(urn:li:sponsoredAccount:{adAccountId})",
      "pivot": "ACCOUNT",
      "timeGranularity": "DAILY"
    },
    "organizationNotificationPull": {
      "method": "GET",
      "path": "/rest/organizationalEntityNotifications",
      "model": "linkedin_organization_social_action_notification",
      "activity": "reconcile_only; not an insight metric",
      "scopeParameter": "organizationalEntity=urn:li:organization:{pageId}",
      "retention": "provider_retains_notifications_for_60_days"
    }
  },
  "requestHeaders": {
    "Linkedin-Version": "configurable YYYYMM marketing version",
    "X-Restli-Protocol-Version": "2.0.0",
    "Content-Type": "application/json"
  },
  "pagination": {
    "providerBehavior": "organizationalEntityShareStatistics_and_adAnalytics_do_not_support_pagination",
    "connectorCursor": "durable_plan_cursor_over_provider_non_paginated_target_and_time_window_units",
    "planOrder": "caller_target_order_then_ascending_bounded_time_windows; organization-posts_are_provider_lifetime_single_units",
    "crossScope": "one_Mission_plan_can_bind_probed_member_organization_page_and_ad_account_scope; every_target_must_match_the_mounted_scope",
    "cursorBinding": [
      "tenant_project_provider_member_scope_digest",
      "credential_reference_digest",
      "credential_revision",
      "lease_revision",
      "token_generation_digest",
      "adapter_id_and_version",
      "plan_digest",
      "target_index",
      "window_index_and_window_digest",
      "page_index",
      "request_query_digest",
      "source_response_digest",
      "page_digest",
      "previous_cursor_digest"
    ],
    "providerNextPage": "typed_fail_closed",
    "pageSize": "bounded_request_contract_only_for_insight_reads; not sent_as_provider_pagination_to_non_paginated_provider_endpoints",
    "restart": "durable_observation_checkpoint_restores_the_last_plan_cursor_before_next_provider_request",
    "duplicateProtection": "cursor_sequence_and_page_digest_are_durable; cursor_rollback_or_replay_is_typed_fail_closed"
  },
  "reconcile": {
    "webhook": {
      "eventType": "ORGANIZATION_SOCIAL_ACTION_NOTIFICATIONS",
      "payload": "notificationId_organizationalEntity_action_lastModifiedAt_and_urn_references_only",
      "providerDelivery": "HTTPS_webhook_inbound; no_provider_write_or_Effect_authority",
      "dedupeKey": "notificationId_plus_lastModifiedAt",
      "deliveryReliability": "provider_redelivers_for_up_to_8_hours; late_or_duplicate_delivery_is_not_adopted"
    },
    "poll": {
      "method": "GET",
      "path": "/rest/organizationalEntityNotifications",
      "purpose": "bootstrap_or_missed_webhook_recovery_only",
      "providerPagination": "Restli_start_count_next_link",
      "cursor": "scope_request_token_generation_and_source_digest_bound_durable_poll_cursor"
    },
    "adoption": "notification_is_durable_event_evidence; authenticated_insight_GET_must_succeed_before_Mission_adoptable_result",
    "receipt": [
      "source_webhook_or_poll",
      "delivery_and_payload_digest",
      "notification_ids_and_modified_watermark",
      "source_request_and_response_digest",
      "reconcile_rate_limit_and_cost",
      "insight_page_digest_and_cursor_digest",
      "native_attribution_model",
      "causal_status_not_claimed"
    ],
    "failClosed": [
      "duplicate_delivery",
      "out_of_order_delivery",
      "cursor_rollback",
      "late_response_after_mount_generation_drift",
      "permission_downgrade",
      "revocation",
      "organic_sponsored_model_drift"
    ]
  },
  "rateLimitAndBudget": {
    "providerEvidenceHeaders": [
      "x-ratelimit-limit",
      "x-ratelimit-remaining",
      "x-ratelimit-reset",
      "retry-after"
    ],
    "status429": "typed_rate_limit_with_bounded_retry_after",
    "localBudget": "DispatchBudget_receipt_with_quota_and_cost_minor"
  },
  "freshness": {
    "probeMaxTtlSeconds": 120,
    "observationPolicyMaxTtlSeconds": 900,
    "boundedTimeRangeMaxDays": 31,
    "staleProbe": "fail_closed"
  },
  "observation": {
    "schema": "hartevo-linkedin-insight-read/v1",
    "durableLog": true,
    "requiredReceipts": [
      "source_method_path_query_digest_status_response_digest",
      "requested_and_observed_time",
      "freshness",
      "quota",
      "cost",
      "durable_cursor",
      "scope_credential_generation_and_plugin_binding",
      "window_and_page_digest",
      "classification",
      "attribution_model",
      "causal_status_not_claimed",
      "reconcile_receipt_when_event_driven"
    ],
    "unknownProviderFields": "digest_only",
    "secretAndPayloadLogging": "forbidden"
  },
  "attribution": {
    "organicModel": "linkedin_organization_share_statistics",
    "sponsoredModel": "linkedin_ad_analytics",
    "causalClaim": false,
    "reviewState": [
      "required",
      "unknown"
    ]
  },
  "revocationAndDrift": {
    "secretReference": "typed_fail_closed",
    "credentialLease": "typed_fail_closed",
    "providerUnauthorized": "typed_fail_closed",
    "unmount": "clears_mount_and_cursor",
    "reconcileSession": "unmount_or_revoke_clears_plan_cursor_poll_cursor_delivery_deduplication_and_watermarks",
    "refreshScopeOrRevisionDrift": "typed_fail_closed",
    "permissionDowngrade": "stale_and_typed_fail_closed",
    "lateProviderResponse": "mount_generation_and_credential_binding_checked_before_durable_append",
    "writeAuthority": "never_granted"
  },
  "credentialedProbe": {
    "liveHttpsPath": true,
    "transport": "HTTPS_only_curl_config_stdin_with_authorization_redacted_from_argv",
    "environmentGate": "HARTEVO_RUN_LINKEDIN_CREDENTIAL_PROBE=1 plus HARTEVO_LINKEDIN_ACCESS_TOKEN",
    "missingCredentials": "BLOCKED_ENV",
    "fixtures": "contract_tests_only; not_native_completion"
  },
  "writePolicy": {
    "enabled": false,
    "prepareEffect": "writes_disabled",
    "execute": "not_implemented",
    "approvalReceiptReadback": "required_before_any_future_write_slice"
  }
}
