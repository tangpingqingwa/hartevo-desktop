{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hartevo.example/contracts/capabilities/signed-manifest/v1",
  "title": "Hartevo Signed Capability Manifest v1",
  "description": "Ed25519 envelope for the versioned capability manifest. Private signing material is never part of this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest", "signature"],
  "properties": {
    "manifest": {"$ref": "manifest.v1.json"},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "publicKey", "signature"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "keyId": {"type": "string", "minLength": 1, "maxLength": 256},
        "publicKey": {"type": "array", "minItems": 32, "maxItems": 32, "items": {"type": "integer", "minimum": 0, "maximum": 255}},
        "signature": {"type": "array", "minItems": 64, "maxItems": 64, "items": {"type": "integer", "minimum": 0, "maximum": 255}}
      }
    }
  }
}
