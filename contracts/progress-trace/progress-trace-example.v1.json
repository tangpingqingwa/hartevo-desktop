{
  "schemaVersion": "hartevo-progress-trace/v1",
  "contract": {
    "schemaVersion": "hartevo-progress-trace/v1",
    "contractId": "durable-progress-trace",
    "authority": "eval_only_no_production_authority",
    "releaseEligible": false,
    "requiredIdentity": {
      "scope": true,
      "epoch": true,
      "cursor": true,
      "everyEvent": true
    },
    "awaiting": {
      "persistence": "durable",
      "presentation": "painted",
      "beforeResume": true
    },
    "firstUsefulProgress": {
      "progressClass": "useful",
      "distinctFromGeneric": true,
      "requiresBusinessStep": true
    },
    "runningCaughtUp": {
      "caughtUpIsNonTerminal": true,
      "lateDeltaLegal": true
    },
    "terminal": {
      "operations": ["append", "reset"],
      "finalCaughtUpRequired": true,
      "finalCaughtUpSameCursor": true
    },
    "rejectionRules": {
      "duplicateEventId": true,
      "duplicateCursor": true,
      "skippedCursor": true,
      "crossScope": true,
      "cursorRegression": true,
      "postTerminal": true,
      "rawClockDeterminism": true
    },
    "requiredRestartMarkers": [
      "before_resume",
      "after_first_useful_progress",
      "before_terminal"
    ],
    "clock": {
      "authority": "virtual_monotonic/v1",
      "wallClockOrderingAllowed": false
    },
    "provenance": {
      "allowedKinds": ["fixture", "simulator", "native"],
      "mixedSourcesAllowed": false,
      "nativeReceiptRequired": true,
      "checkedInSampleSatisfiesNative": false
    }
  },
  "trace": {
    "traceId": "durable-progress-example",
    "scope": {
      "tenantId": "fixture-tenant",
      "projectId": "fixture-project",
      "missionId": "fixture-mission",
      "conversationId": "fixture-conversation",
      "runId": "fixture-run"
    },
    "epoch": 7,
    "initialCursor": 40,
