{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hartevo.example/contracts/release-evidence/2.3.0",
  "title": "Hartevo Release Evidence",
  "type": "object",
  "required": [
    "schemaVersion",
    "schemaDigest",
    "passed",
    "releaseCommit",
    "environment",
    "requestedStage",
    "missionCatalogVersion",
    "applicationHandlerRegistryVersion",
    "applicationRouteCount",
    "implementedApplicationHandlerCount",
    "notImplementedApplicationRouteCount",
    "capabilityCatalogVersion",
    "providerCatalogVersion",
    "datasetPartitionRevision",
    "catalogDigest",
    "contaminationAuditDigest",
    "traceabilityComplete",
    "missionResults",
    "quality",
    "safetyInvariants",
    "evaluationRunResultReferences",
    "notImplemented",
    "blockedEnv",
    "missingRequiredEvidence",
    "failures",
    "startedAt",
    "completedAt"
  ],
  "properties": {
    "schemaVersion": {"const": "2.3.0"},
    "schemaDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "passed": {"type": "boolean"},
    "releaseCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "environment": {"type": "string", "minLength": 1},
    "requestedStage": {"$ref": "#/$defs/releaseStage"},
    "missionCatalogVersion": {"type": "string", "minLength": 1},
    "applicationHandlerRegistryVersion": {"type": "string", "minLength": 1},
    "applicationRouteCount": {"const": 52},
    "implementedApplicationHandlerCount": {"type": "integer", "minimum": 0, "maximum": 52},
    "notImplementedApplicationRouteCount": {"type": "integer", "minimum": 0, "maximum": 52},
    "capabilityCatalogVersion": {"type": "string", "minLength": 1},
    "providerCatalogVersion": {"type": "string", "minLength": 1},
    "datasetPartitionRevision": {"type": "string", "minLength": 1},
    "catalogDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "contaminationAuditDigest": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      ]
    },
    "traceabilityComplete": {"type": "boolean"},
    "missionResults": {
      "type": "object",
      "minProperties": 12,
      "maxProperties": 12,
      "patternProperties": {
        "^VM-(0[0-9]|1[01])$": {"$ref": "#/$defs/missionEvidence"}
      },
      "additionalProperties": false
    },
    "quality": {"$ref": "#/$defs/qualityEvidence"},
    "safetyInvariants": {"$ref": "#/$defs/safetyEvidence"},
    "evaluationRunResultReferences": {"$ref": "#/$defs/evaluationRunResultReferences"},
    "notImplemented": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "blockedEnv": {
      "type": "array",
      "items": {"$ref": "#/$defs/blockedEnvironment"},
      "uniqueItems": true
    },
    "missingRequiredEvidence": {
      "type": "array",
      "minItems": 0,
      "items": {
        "enum": [
          "evaluation_run_result_references",
          "stage_application_route_scope",
          "provider_account_capability_e4_matrix",
          "e5_mission_mode_longitudinal_mapping"
        ]
      },
      "uniqueItems": true
    },
    "failures": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "startedAt": {"type": "string", "format": "date-time"},
    "completedAt": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {
        "required": ["passed"],
        "properties": {"passed": {"const": true}}
      },
      "then": {
        "properties": {
          "traceabilityComplete": {"const": true},
          "safetyInvariants": {"$ref": "#/$defs/passedSafetyEvidence"},
          "evaluationRunResultReferences": {
            "$ref": "#/$defs/eligibleEvaluationRunResultReferences"
          },
          "missingRequiredEvidence": {"maxItems": 0},
          "failures": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {
          "evaluationRunResultReferences": {
            "required": ["run"],
            "properties": {
              "run": {
                "anyOf": [
                  {"type": "null"},
                  {
                    "required": ["partitionComplete"],
                    "properties": {"partitionComplete": {"const": false}}
                  },
                  {
                    "required": ["thresholdStatus"],
                    "properties": {
                      "thresholdStatus": {"not": {"const": "evaluated_passed"}}
                    }
                  },
                  {
                    "required": ["evidenceKind"],
                    "properties": {
                      "evidenceKind": {"not": {"const": "evaluation_run_result"}}
                    }
                  },
                  {
                    "required": ["evaluatorAuthority"],
                    "properties": {
                      "evaluatorAuthority": {
                        "not": {"const": "hartevo_evaluation_run_validator_v1"}
                      }
                    }
                  },
                  {
                    "required": ["executionStatus"],
                    "properties": {
                      "executionStatus": {"not": {"const": "EXECUTED"}}
                    }
                  },
                  {
                    "required": ["authorityScope"],
                    "properties": {
                      "authorityScope": {
                        "not": {"const": "evaluation_results_only"}
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "required": ["evaluationRunResultReferences"]
      },
      "then": {
        "properties": {
          "passed": {"const": false},
          "missingRequiredEvidence": {
            "contains": {"const": "evaluation_run_result_references"}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evaluationRunResultReferences": {
            "required": ["browserResults"],
            "properties": {
              "browserResults": {
                "contains": {"$ref": "#/$defs/ineligibleBrowserEvaluationResultReference"}
              }
            }
          }
        },
        "required": ["evaluationRunResultReferences"]
      },
      "then": {
        "properties": {
          "passed": {"const": false},
          "missingRequiredEvidence": {
            "contains": {"const": "evaluation_run_result_references"}
          }
        }
      }
    },
    {
      "if": {"$ref": "#/$defs/foundationRequest"},
      "then": {
        "properties": {
          "missionResults": {"$ref": "#/$defs/foundationMissionResults"},
          "blockedEnv": {
            "not": {
              "contains": {
                "properties": {"requiredFrom": {"const": "engineering_foundation"}},
                "required": ["requiredFrom"]
              }
            }
          }
        }
      }
    },
    {
      "if": {"$ref": "#/$defs/alphaRequest"},
      "then": {
        "properties": {
          "missionResults": {"$ref": "#/$defs/foundationMissionResults"},
          "quality": {
            "properties": {
              "mgcr": {"type": "number", "minimum": 0.8, "maximum": 1},
              "p0Mgcr": {"type": "number", "minimum": 0.8, "maximum": 1}
            }
          },
          "blockedEnv": {
            "not": {
              "contains": {
                "properties": {
                  "requiredFrom": {
                    "enum": ["engineering_foundation", "internal_alpha"]
                  }
                },
                "required": ["requiredFrom"]
              }
            }
          }
        }
      }
    },
    {
      "if": {"$ref": "#/$defs/betaRequest"},
      "then": {
        "properties": {
          "contaminationAuditDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "missionResults": {"$ref": "#/$defs/betaMissionResults"},
          "quality": {
            "properties": {
              "mgcr": {"type": "number", "minimum": 0.85, "maximum": 1},
              "p0Mgcr": {"type": "number", "minimum": 0.9, "maximum": 1},
              "vbor": {"type": "number", "minimum": 0.95, "maximum": 1},
              "lcr": {"type": "number", "minimum": 0.8, "maximum": 1}
            }
          },
          "blockedEnv": {
            "not": {
              "contains": {
                "properties": {
                  "requiredFrom": {
                    "enum": ["engineering_foundation", "internal_alpha", "controlled_beta"]
                  }
                },
                "required": ["requiredFrom"]
              }
            }
          }
        }
      }
    },
    {
      "if": {"$ref": "#/$defs/gaRequest"},
      "then": {
        "properties": {
          "contaminationAuditDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "missionResults": {"$ref": "#/$defs/gaMissionResults"},
          "implementedApplicationHandlerCount": {"const": 52},
          "notImplementedApplicationRouteCount": {"const": 0},
          "notImplemented": {"maxItems": 0},
          "quality": {
            "properties": {
              "mgcr": {"type": "number", "minimum": 0.9, "maximum": 1},
              "p0Mgcr": {"type": "number", "minimum": 0.9, "maximum": 1},
              "vbor": {"type": "number", "minimum": 0.99, "maximum": 1},
              "lcr": {"type": "number", "minimum": 0.9, "maximum": 1},
              "judgeCalibratedSamples": {"minimum": 200},
              "longitudinalDays": {"minimum": 30}
            }
          },
          "blockedEnv": {
            "not": {
              "contains": {
                "properties": {
                  "requiredFrom": {
                    "enum": [
                      "engineering_foundation",
                      "internal_alpha",
                      "controlled_beta",
                      "general_availability"
                    ]
                  }
                },
                "required": ["requiredFrom"]
              }
            }
          }
        }
      }
    },
    {
      "if": {"$ref": "#/$defs/e5Request"},
      "then": {
        "properties": {
          "contaminationAuditDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "missionResults": {"$ref": "#/$defs/e5MissionResults"},
          "implementedApplicationHandlerCount": {"const": 52},
          "notImplementedApplicationRouteCount": {"const": 0},
          "notImplemented": {"maxItems": 0},
          "quality": {
            "properties": {
              "mgcr": {"type": "number", "minimum": 0.9, "maximum": 1},
              "p0Mgcr": {"type": "number", "minimum": 0.9, "maximum": 1},
              "vbor": {"type": "number", "minimum": 0.99, "maximum": 1},
              "lcr": {"type": "number", "minimum": 0.9, "maximum": 1},
              "workProductAdoption": {"type": "number", "minimum": 0.85, "maximum": 1},
              "judgeCalibratedSamples": {"minimum": 200},
              "longitudinalTenants": {"minimum": 12},
              "longitudinalVerticals": {"minimum": 3},
              "longitudinalMarkets": {"minimum": 3},
              "longitudinalDays": {"minimum": 90}
            }
          },
          "blockedEnv": {"maxItems": 0}
        }
      }
    }
  ],
  "$defs": {
    "evaluationPartition": {
      "enum": ["V0", "V1", "V2", "cross_cutting"]
    },
    "evaluatorEvidenceKind": {
      "enum": [
        "evaluation_run_result",
        "browser_evaluation_result",
        "integration_build_provenance",
        "local_fallback_receipt",
        "fixture",
        "simulator",
        "source_audit",
        "ignored_result"
      ]
    },
    "evaluatorEvidenceAuthority": {
      "enum": [
        "hartevo_evaluation_run_validator_v1",
        "hartevo_browser_contract_validator_v1",
        "INTEGRATION_BUILD_PROVENANCE_ONLY",
        "LOCAL_FALLBACK_RECEIPT_ONLY",
        "FIXTURE_EVIDENCE_ONLY",
        "SIMULATOR_EVIDENCE_ONLY",
        "SOURCE_AUDIT_ONLY",
        "IGNORED_RESULT_ONLY"
      ]
    },
    "evaluatorExecutionStatus": {
      "enum": [
        "EXECUTED",
        "NOT_EXECUTED",
        "CI_NOT_EXECUTED",
        "BLOCKED_EXTERNAL_BILLING",
        "IGNORED"
      ]
    },
    "evaluatorAuthorityScope": {
      "enum": ["evaluation_results_only", "audit_only"]
    },
    "evaluationReferenceRunProfile": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "missionId"],
          "properties": {
            "kind": {"const": "mission_v0"},
            "missionId": {"type": "string", "pattern": "^VM-(0[0-9]|1[01])$"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind"],
          "properties": {"kind": {"const": "local_rc"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "writingMissionId"],
          "properties": {
            "kind": {"const": "engineering_foundation"},
            "writingMissionId": {"enum": ["VM-01", "VM-03", "VM-04", "VM-05"]}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "writingMissionId"],
          "properties": {
            "kind": {"const": "internal_alpha"},
            "writingMissionId": {"enum": ["VM-01", "VM-03", "VM-04", "VM-05"]}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind"],
          "properties": {"kind": {"const": "controlled_beta"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind"],
          "properties": {"kind": {"const": "general_availability"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind"],
          "properties": {"kind": {"const": "mature_e5"}},
          "additionalProperties": false
        }
      ]
    },
    "evaluationRunResultReference": {
      "type": "object",
      "required": [
        "validationAuthority",
        "evidenceAuthority",
        "evidenceKind",
        "evaluatorAuthority",
        "executionStatus",
        "authorityScope",
        "releaseCommit",
        "catalogDigest",
        "releaseSchemaDigest",
        "environmentDigest",
        "runId",
        "planDigest",
        "resultSetDigest",
        "receiptDigest",
        "runProfile",
        "missionIds",
        "partitions",
        "requiredPartitionCount",
        "completedPartitionCount",
        "configuredCaseCount",
        "recordedCaseCount",
        "executedCaseCount",
        "successfulCaseCount",
        "structurallyComplete",
        "partitionComplete",
        "thresholdStatus",
        "safetyMappingStatus",
        "privateAttestationStatus"
      ],
      "properties": {
        "validationAuthority": {"const": "hartevo_evaluation_run_validator_v1"},
        "evidenceAuthority": {"const": "run_evidence_only"},
        "evidenceKind": {"$ref": "#/$defs/evaluatorEvidenceKind"},
        "evaluatorAuthority": {"$ref": "#/$defs/evaluatorEvidenceAuthority"},
        "executionStatus": {"$ref": "#/$defs/evaluatorExecutionStatus"},
        "authorityScope": {"$ref": "#/$defs/evaluatorAuthorityScope"},
        "releaseCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "catalogDigest": {"$ref": "#/$defs/digest"},
        "releaseSchemaDigest": {"$ref": "#/$defs/digest"},
        "environmentDigest": {"$ref": "#/$defs/digest"},
        "runId": {"$ref": "#/$defs/digest"},
        "planDigest": {"$ref": "#/$defs/digest"},
        "resultSetDigest": {"$ref": "#/$defs/digest"},
        "receiptDigest": {"$ref": "#/$defs/digest"},
        "runProfile": {"$ref": "#/$defs/evaluationReferenceRunProfile"},
        "missionIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {"type": "string", "pattern": "^VM-(0[0-9]|1[01])$"},
          "uniqueItems": true
        },
        "partitions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/evaluationPartition"},
          "uniqueItems": true
        },
        "requiredPartitionCount": {"type": "integer", "minimum": 1, "maximum": 48},
        "completedPartitionCount": {"type": "integer", "minimum": 0, "maximum": 48},
        "configuredCaseCount": {"type": "integer", "minimum": 1},
        "recordedCaseCount": {"type": "integer", "minimum": 1},
        "executedCaseCount": {"type": "integer", "minimum": 0},
        "successfulCaseCount": {"type": "integer", "minimum": 0},
        "structurallyComplete": {"type": "boolean"},
        "partitionComplete": {"type": "boolean"},
        "thresholdStatus": {
          "enum": [
            "not_evaluated_incomplete_partition",
            "evaluated_passed",
            "evaluated_failed"
          ]
        },
        "safetyMappingStatus": {"const": "MISSING_AUTHORITATIVE_MAPPING"},
        "privateAttestationStatus": {
          "const": "MISSING_TRUSTED_PRIVATE_EVALUATOR_ATTESTATION"
        }
      },
      "additionalProperties": false
    },
    "eligibleEvaluationRunResultReference": {
      "allOf": [
        {"$ref": "#/$defs/evaluationRunResultReference"},
        {
          "properties": {
            "evidenceKind": {"const": "evaluation_run_result"},
            "evaluatorAuthority": {"const": "hartevo_evaluation_run_validator_v1"},
            "executionStatus": {"const": "EXECUTED"},
            "authorityScope": {"const": "evaluation_results_only"},
            "structurallyComplete": {"const": true},
            "partitionComplete": {"const": true},
            "thresholdStatus": {"const": "evaluated_passed"},
            "completedPartitionCount": {"minimum": 1},
            "executedCaseCount": {"minimum": 1}
          }
        }
      ]
    },
    "browserEvidenceClass": {
      "enum": [
        "source_audit",
        "native_preflight",
        "deterministic_simulator",
        "native_browser",
        "native_browser_account_readback"
      ]
    },
    "browserEvaluationResultReference": {
      "type": "object",
      "required": [
        "validationAuthority",
        "evidenceKind",
        "evaluatorAuthority",
        "executionStatus",
        "authorityScope",
        "receiptSchemaVersion",
        "receiptAuthority",
        "releaseDecision",
        "releaseCommit",
        "catalogDigest",
        "releaseSchemaDigest",
        "environmentDigest",
        "runId",
        "resultSetDigest",
        "caseId",
        "providerMode",
        "evidenceClasses",
        "verdict",
        "configuredAttemptCount",
        "recordedAttemptCount",
        "executedAttemptCount",
        "successfulAttemptCount",
        "executionStartedAttemptCount",
        "testModeAttemptCount",
        "mockAttemptCount",
        "ignoredTestAttemptCount",
        "receiptDigest",
        "validationResultDigest",
        "releaseEvidenceAuthority",
        "eLevelCeiling"
      ],
      "properties": {
        "validationAuthority": {"const": "hartevo_browser_contract_validator_v1"},
        "evidenceKind": {"$ref": "#/$defs/evaluatorEvidenceKind"},
        "evaluatorAuthority": {"$ref": "#/$defs/evaluatorEvidenceAuthority"},
        "executionStatus": {"$ref": "#/$defs/evaluatorExecutionStatus"},
        "authorityScope": {"$ref": "#/$defs/evaluatorAuthorityScope"},
        "receiptSchemaVersion": {"const": "hartevo-browser-run-receipt/v1"},
        "receiptAuthority": {"const": "browser_harness_evidence_only"},
        "releaseDecision": {"const": "NOT_EVALUATED"},
        "releaseCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "catalogDigest": {"$ref": "#/$defs/digest"},
        "releaseSchemaDigest": {"$ref": "#/$defs/digest"},
        "environmentDigest": {"$ref": "#/$defs/digest"},
        "runId": {"$ref": "#/$defs/digest"},
        "resultSetDigest": {"$ref": "#/$defs/digest"},
        "caseId": {"type": "string", "minLength": 1},
        "providerMode": {"enum": ["controlled_simulator", "native_browser_account"]},
        "evidenceClasses": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/browserEvidenceClass"},
          "uniqueItems": true
        },
        "verdict": {"enum": ["PASS", "FAIL", "INCOMPLETE"]},
        "configuredAttemptCount": {"type": "integer", "minimum": 1},
        "recordedAttemptCount": {"type": "integer", "minimum": 0},
        "executedAttemptCount": {"type": "integer", "minimum": 0},
        "successfulAttemptCount": {"type": "integer", "minimum": 0},
        "executionStartedAttemptCount": {"type": "integer", "minimum": 0},
        "testModeAttemptCount": {"type": "integer", "minimum": 0},
        "mockAttemptCount": {"type": "integer", "minimum": 0},
        "ignoredTestAttemptCount": {"type": "integer", "minimum": 0},
        "receiptDigest": {"$ref": "#/$defs/digest"},
        "validationResultDigest": {"$ref": "#/$defs/digest"},
        "releaseEvidenceAuthority": {"const": false},
        "eLevelCeiling": {"const": "E1_MAX"}
      },
      "additionalProperties": false
    },
    "eligibleBrowserEvaluationResultReference": {
      "allOf": [
        {"$ref": "#/$defs/browserEvaluationResultReference"},
        {
          "properties": {
            "evidenceKind": {"const": "browser_evaluation_result"},
            "evaluatorAuthority": {"const": "hartevo_browser_contract_validator_v1"},
            "executionStatus": {"const": "EXECUTED"},
            "authorityScope": {"const": "evaluation_results_only"},
            "providerMode": {"const": "native_browser_account"},
            "evidenceClasses": {
              "items": {
                "enum": ["native_browser", "native_browser_account_readback"]
              }
            },
            "verdict": {"const": "PASS"},
            "recordedAttemptCount": {"minimum": 1},
            "executedAttemptCount": {"minimum": 1},
            "successfulAttemptCount": {"minimum": 1},
            "executionStartedAttemptCount": {"minimum": 1},
            "testModeAttemptCount": {"const": 0},
            "mockAttemptCount": {"const": 0},
            "ignoredTestAttemptCount": {"const": 0}
          }
        }
      ]
    },
    "ineligibleBrowserEvaluationResultReference": {
      "anyOf": [
        {
          "required": ["evidenceKind"],
          "properties": {"evidenceKind": {"not": {"const": "browser_evaluation_result"}}}
        },
        {
          "required": ["evaluatorAuthority"],
          "properties": {
            "evaluatorAuthority": {
              "not": {"const": "hartevo_browser_contract_validator_v1"}
            }
          }
        },
        {
          "required": ["executionStatus"],
          "properties": {"executionStatus": {"not": {"const": "EXECUTED"}}}
        },
        {
          "required": ["authorityScope"],
          "properties": {
            "authorityScope": {"not": {"const": "evaluation_results_only"}}
          }
        },
        {
          "required": ["providerMode"],
          "properties": {"providerMode": {"const": "controlled_simulator"}}
        },
        {
          "required": ["evidenceClasses"],
          "properties": {
            "evidenceClasses": {
              "contains": {
                "enum": ["source_audit", "native_preflight", "deterministic_simulator"]
              }
            }
          }
        },
        {
          "required": ["verdict"],
          "properties": {"verdict": {"not": {"const": "PASS"}}}
        }
      ]
    },
    "evaluationRunResultReferences": {
      "type": "object",
      "required": ["schemaVersion", "referenceSetDigest", "run", "browserResults"],
      "properties": {
        "schemaVersion": {"const": "hartevo-release-evaluation-result-references/v2"},
        "referenceSetDigest": {"$ref": "#/$defs/digest"},
        "run": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/evaluationRunResultReference"}
          ]
        },
        "browserResults": {
          "type": "array",
          "items": {"$ref": "#/$defs/browserEvaluationResultReference"},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "eligibleEvaluationRunResultReferences": {
      "allOf": [
        {"$ref": "#/$defs/evaluationRunResultReferences"},
        {
          "properties": {
            "run": {"$ref": "#/$defs/eligibleEvaluationRunResultReference"},
            "browserResults": {
              "items": {"$ref": "#/$defs/eligibleBrowserEvaluationResultReference"}
            }
          }
        }
      ]
    },
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "releaseStage": {
      "enum": [
        "engineering_foundation",
        "internal_alpha",
        "controlled_beta",
        "general_availability",
        "mature_e5"
      ]
    },
    "missionEvidence": {
      "type": "object",
      "required": [
        "missionId",
        "evidenceLevel",
        "status",
        "configuredV0Cases",
        "executedV0Cases",
        "passedV0Cases",
        "configuredV1Cases",
        "executedV1Cases",
        "passedV1Cases",
        "configuredV2Cases",
        "executedV2Cases",
        "passedV2Cases",
        "configuredCrossCuttingCases",
        "executedCrossCuttingCases",
        "passedCrossCuttingCases",
        "providerCanaryScenarios",
        "tenantProjectEvidence",
        "observationDays",
        "failures"
      ],
      "properties": {
        "missionId": {"type": "string", "pattern": "^VM-(0[0-9]|1[01])$"},
        "evidenceLevel": {"enum": ["E0", "E1", "E2", "E3", "E4", "E5"]},
        "status": {"enum": ["not_implemented", "blocked_env", "fail", "partial", "expected_refusal", "pass"]},
        "configuredV0Cases": {"const": 20},
