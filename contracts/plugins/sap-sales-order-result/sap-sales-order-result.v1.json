{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tangpingqingwa/hartevo-desktop/contracts/plugins/sap-sales-order-result/sap-sales-order-result.v1.json",
  "title": "Hartevo SAP S/4HANA sales-order result Layer-1 contract",
  "description": "A scoped, read/proposal/recording-only SAP Sales Order A2X OData V2 evidence seam. It is not a native ERP connector, mutation authority, durable native receipt, or kernel adoption authority.",
  "schemaVersion": "hartevo.sap-sales-order-result.contract/v1",
  "contractVersion": "sap-sales-order-result/v1",
  "pluginVersion": "0.1.0",
  "layer": "Layer-1",
  "layerNumber": 1,
  "serviceId": "sap.s4hana.sales-order.result",
  "providerId": "sap.s4hana.sales-order-a2x-odata-v2",
  "consumerId": "mission.sap.sales-order.result",
  "officialApi": {
    "name": "SAP Sales Order A2X OData V2",
    "version": "OData V2",
    "basis": "https://help.sap.com/docs/SAP_S4HANA_CLOUD/03c04db2a7434731b7fe21dca77440da/641bd0dc16bf406684ca2c614322c15e.html",
    "readRequests": "https://help.sap.com/docs/SAP_S4HANA_CLOUD/03c04db2a7434731b7fe21dca77440da/275f93c02de54f3e8ee7fa2eeddd7282.html"
  },
  "scope": [
    "tenant",
    "system",
    "opaque_sales_order_id",
    "odata_version",
    "allowlisted_entity_sets",
    "allowlisted_select_fields",
    "allowlisted_filter",
    "permission_lease_and_revision",
    "opaque_secret_reference",
    "plugin_version_digest",
    "contract_digest",
    "provider_digest",
    "implementation_digest",
    "permission_digest",
    "project_id_and_revision",
    "mission_id_and_revision",
    "work_product_id_and_revision",
    "redaction_policy_revision",
    "query_bounds"
  ],
  "digests": [
    "plugin_version_digest",
    "contract_digest",
    "provider_digest",
    "implementation_digest",
    "permission_digest",
    "scope_digest",
    "registration_digest",
    "request_digest",
    "etag_digest",
    "source_revision_digest",
    "result_digest",
    "recording_digest",
    "proposal_digest"
  ],
  "registration": {
    "versionAndScopeBound": true,
    "reversible": true,
    "revocable": true,
    "failClosedOn": [
      "secret_revocation",
      "registration_revocation",
      "tenant_or_system_drift",
      "odata_version_drift",
      "entity_set_or_projection_drift",
      "permission_drift",
      "project_revision_drift",
      "mission_revision_drift",
      "work_product_revision_drift",
      "order_revision_drift",
      "etag_drift",
      "tampered_digest",
      "duplicate_page_or_proposal"
    ]
  },
  "readAllowlist": {
    "odataVersion": "V2",
    "entitySets": [
      "A_SalesOrder",
      "A_SalesOrderItem",
      "A_SalesOrderDocFlow"
    ],
    "select": {
      "A_SalesOrder": [
        "SalesOrder",
        "SalesOrderType",
        "SalesOrganization",
        "DistributionChannel",
        "OrganizationDivision",
        "CreationDate",
        "LastChangeDate",
        "TransactionCurrency",
        "TotalNetAmount",
        "OverallSDProcessStatus",
        "OverallDeliveryStatus",
        "OverallBillingStatus",
        "DeliveryBlockReason",
        "BillingBlockReason",
        "TotalBlockStatus",
        "ETag"
      ],
      "A_SalesOrderItem": [
        "SalesOrder",
        "SalesOrderItem",
        "Material",
        "RequestedQuantity",
        "RequestedQuantityUnit",
        "NetAmount",
        "TransactionCurrency",
        "DeliveryStatus",
        "BillingStatus",
        "DeliveryBlockReason",
        "BillingBlockReason",
        "HigherLevelItem",
        "CreationDate",
        "LastChangeDate",
        "ETag"
      ],
      "A_SalesOrderDocFlow": [
        "SalesOrder",
        "PrecedingDocument",
        "SubsequentDocument",
        "PrecedingDocumentItem",
        "SubsequentDocumentItem",
        "DeliveryDocument",
        "BillingDocument",
        "DocumentCategory",
        "DocumentFlowStatus",
        "DocumentFlowDepth",
        "CreationDate",
        "LastChangeDate",
        "ETag"
      ]
    },
    "filter": "scope-bound SalesOrder equality only; no caller-supplied raw expression",
    "expand": [],
    "pageSizeMax": 100,
    "pageCountMax": 16,
    "itemCountMax": 1000,
    "documentFlowCountMax": 256,
    "documentFlowDepthMax": 3
  },
  "projection": {
    "order": [
      "opaque_document_id",
      "lifecycle_status",
      "created_date",
      "last_changed_date",
      "currency",
      "net_amount_summary",
      "delivery_status",
      "billing_status",
      "delivery_block_state",
      "billing_block_state",
      "etag_digest",
      "source_revision"
    ],
    "items": [
      "opaque_item_document_id",
      "material_digest",
      "quantity_summary",
      "amount_summary",
      "delivery_status",
      "billing_status",
      "block_state",
      "source_revision"
    ],
    "documentFlow": [
      "opaque_preceding_document_id",
      "opaque_subsequent_document_id",
      "opaque_delivery_document_id",
      "opaque_billing_document_id",
      "document_category",
      "document_flow_status",
      "document_flow_depth",
      "created_date",
      "last_changed_date",
      "source_revision"
    ]
  },
  "redaction": {
    "partner_and_customer_fields": "drop_and_digest_field_name_only",
    "free_text_and_address_fields": "drop_and_digest_field_name_only",
    "document_identifiers": "opaque_sha256_digest",
    "raw_payload_retention": false,
    "raw_secret_retention": false
  },
  "statusHandling": {
    "401": "access_lost",
    "403": "access_lost",
    "404": "deleted_or_not_found",
    "409": "revision_conflict",
    "429": "provider_unknown_retryable",
    "5xx": "provider_unknown_retryable",
    "timeout": "provider_unknown_retryable",
    "etag_drift": "revision_conflict",
    "partial_page_chain": "partial"
  },
  "evidenceModes": [
    "fixture",
    "recording",
    "loopback",
    "BLOCKED_ENV"
  ],
  "authority": {
    "connected": false,
    "native": false,
    "firstParty": false,
    "externalWrites": false,
    "durableNativeReceipt": false,
    "independentReadBack": false,
    "kernelOutcomeAdoption": false,
    "truthAuthority": false
  },
  "nativeClaims": {
    "connected": false,
    "nativeProvider": false,
    "firstParty": false,
    "durableNativeReceipt": false,
    "independentReadBack": false,
    "adoptedOutcome": false,
    "blockedEnvironmentIsNative": false
  },
  "forbidden": [
    "raw_secret_serialization",
    "raw_partner_or_customer_pii_retention",
    "create_update_delete_sales_order",
    "release_order_or_delivery",
    "change_delivery_or_billing_block",
    "pricing_or_workflow_effect",
    "native_connected_claim",
    "first_party_claim",
    "durable_native_receipt",
    "independent_write_read_back",
    "silent_scope_or_provider_failover",
    "kernel_outcome_adoption"
  ],
  "layer2Gaps": [
    "native_secret_resolution",
    "bounded_https_odata_execution",
    "consent_and_effect_authority",
    "durable_provider_receipt",
    "independent_result_read_back",
    "verified_work_product_adoption",
    "ambiguity_and_retry_recovery"
  ]
}
