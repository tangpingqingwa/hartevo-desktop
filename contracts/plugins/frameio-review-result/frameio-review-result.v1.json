{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hartevo.local/contracts/plugins/frameio-review-result/frameio-review-result.v1.json",
  "title": "Hartevo Frame.io governed creative-review result contract",
  "schemaVersion": "hartevo.frameio-review-result-contract/v1",
  "contractVersion": "frameio-review-result/v1",
  "layer": 1,
  "service": {
    "id": "frameio.review-result",
    "version": "1.0.0",
    "implementation": "FrameIoReviewResultService",
    "operations": [
      "describe_capabilities",
      "register",
      "revoke_registration",
      "read_asset_metadata",
      "read_asset_version",
      "read_review_link",
      "read_approval_status",
      "read_comment_summary",
      "compile_review_proposal",
      "record_review_proposal",
      "consume_review_proposal"
    ],
    "readOnly": true,
    "liveExecution": false,
    "writes": false
  },
  "provider": {
    "id": "frameio.api",
    "version": "1.0.0",
    "implementation": "FrameIoProvider",
    "transport": ["fixture", "recording", "loopback", "blocked_env"],
    "operations": [
      "GET /v2/assets/:asset_id",
      "GET /v2/assets/:asset_id/versions/:version_id",
      "GET /v2/review-links/:review_link_id",
      "GET /v2/review-links/:review_link_id/approval",
      "GET /v2/assets/:asset_id/comments"
    ],
    "native": false,
    "connected": false,
    "liveHttps": false
  },
  "consumer": {
    "id": "mission.frameio-review-result",
    "version": "1.0.0",
    "implementation": "MissionFrameIoReviewConsumer",
    "missionBound": true,
    "projectBound": true,
    "workProductBound": true,
    "adoptsWorkProduct": false,
    "outcomeAuthority": false
  },
  "scope": {
    "required": [
      "pluginVersion",
      "contractVersion",
      "providerId",
      "providerVersion",
      "accountId",
      "frameIoProjectId",
      "assetId",
      "assetVersionId",
      "reviewLinkId",
      "projectId",
      "projectRevision",
      "missionId",
      "missionRevision",
      "workProductId",
      "workProductRevision",
      "permissionDigest",
      "consentScope",
      "consentDigest",
      "assetRevision",
      "versionRevision",
      "reviewLinkRevision",
      "commentRevision"
    ],
    "secretReference": "opaque_secret_reference_only",
    "digest": "sha256_lower_hex",
    "registration": "version_provider_scope_secret_revision_bound"
  },
  "reads": {
    "allow": [
      "bounded_asset_metadata_get",
      "bounded_asset_version_get",
      "bounded_review_link_get",
      "bounded_approval_status_get",
      "bounded_comment_summary_get"
    ],
    "method": "GET",
    "arbitraryPath": false,
    "arbitraryQuery": false,
    "cursor": "opaque_digest_only",
    "timeWindow": "bounded",
    "maxPages": 4,
    "pageSize": 50,
    "maxResponseBytes": 1048576
  },
  "evidence": {
    "retain": [
      "bounded_comment_counts",
      "bounded_timestamps",
      "normalized_status",
      "asset_digest",
      "version_digest",
      "review_link_digest",
      "comment_digest",
      "redacted_request_receipt",
      "redacted_result_receipt"
    ],
    "redact": [
      "media_urls",
      "signed_urls",
      "thumbnails",
      "raw_comments",
      "reviewer_names",
      "reviewer_contact_data",
      "reviewer_ids",
      "drawings",
      "annotation_geometry",
      "binary_metadata",
      "provider_payload"
    ],
    "rawProviderPayload": false,
    "rawComments": false,
    "reviewerPii": false,
    "mediaDownload": false
  },
  "states": [
    "uploaded",
    "processing",
    "ready",
    "in_review",
    "approved",
    "changes_requested",
    "rejected",
    "partial",
    "retention_gap",
    "access_lost",
    "provider_unknown"
  ],
  "registration": {
    "versionBound": true,
    "providerBound": true,
    "contractDigestBound": true,
    "scopeDigestBound": true,
    "secretReferenceBound": true,
    "credentialRevisionBound": true,
    "reversible": true,
    "revocable": true,
    "failClosedOnDrift": true,
    "duplicateProposalRejected": true
  },
  "authority": {
    "readOnly": true,
    "externalWrites": false,
    "assetUpload": false,
    "assetReplacement": false,
    "commentMutation": false,
    "approvalMutation": false,
    "reviewLinkCreation": false,
    "mediaDownload": false,
    "signedUrlExposure": false,
    "webhookRegistration": false,
    "publication": false,
    "connected": false,
    "nativeProvider": false,
    "receipt": false,
    "verification": false,
    "outcome": false,
    "workProductAdoption": false
  },
  "honesty": {
    "fixtureNative": false,
    "recordingNative": false,
    "loopbackNative": false,
    "blockedEnvNative": false,
    "fixtureConnected": false,
    "recordingConnected": false,
    "loopbackConnected": false,
    "blockedEnvConnected": false,
    "absenceOfCommentsIsApproval": false,
    "absenceOfApprovalIsQuality": false,
    "blockedEnvironmentStatus": "BLOCKED_ENV"
  },
  "layer2Gaps": [
    "native_frameio_authorization_and_account_probe",
    "consented_live_https_gets_with_independent_readback",
    "durable_provider_receipts",
    "upload_or_replace_asset_effects",
    "comment_or_approval_mutation_effects",
    "review_link_creation",
    "media_or_signed_url_access",
    "webhook_ingestion",
    "verified_work_product_adoption"
  ]
}
