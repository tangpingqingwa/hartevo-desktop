    "allowlistedFieldsOnly": true,
    "rawOData": false,
    "writes": [],
    "remediation": false,
    "assignmentMutation": false,
    "exemptionMutation": false,
    "stateViews": ["latest", "default"]
  },
  "bounds": {
    "maxPages": 8,
    "maxRecords": 512,
    "maxRecordsPerPage": 128,
    "maxResponseBytes": 1048576,
    "maxFilterNodes": 8,
    "nextLink": "opaque_digest_only",
    "retries": "bounded"
  },
  "retention": {
    "retained": [
      "policyDefinitionId",
      "policyAssignmentId",
      "policySetDefinitionId",
      "resourceId",
      "complianceState",
      "timestamp",
      "resourceLocation",
      "resourceType",
      "policyMetadataDigest",
      "responseDigest"
    ],
    "digestOnly": ["policyMetadata", "nextLink", "query", "tenant"],
    "redacted": ["rawPolicyJson", "resourceTags", "tenantPii", "remediationPayload"]
  },
  "registration": {
    "boundFields": [
      "providerDigest",
      "providerApiVersion",
      "contractDigest",
      "pluginVersion",
      "permissionDigest",
      "queryDigest",
      "scopeDigest",
      "evidenceDigest"
    ],
    "versionBound": true,
    "providerBound": true,
    "apiBound": true,
    "contractDigestBound": true,
    "permissionBound": true,
    "queryBound": true,
    "scopeBound": true,
    "evidenceBound": true,
    "reversible": true,
    "revocable": true,
    "failClosedOnDrift": true
  },
  "failClosed": [
    "tenantOrSubscriptionDrift",
    "resourceGroupOrResourceDrift",
    "policyFingerprintDrift",
    "queryWindowDrift",
    "policyStateViewDrift",
    "nextLinkScopeMismatch",
    "nextLinkReplay",
    "partialPage",
    "400",
    "401",
    "403",
    "404",
    "409",
    "429",
    "5xx",
    "timeout",
    "tamper",
    "revocation"
