  "layer2Gaps": [
    "nativeMicrosoftEntraResolution",
    "nativeHttpsPolicyInsightsRead",
    "durableProviderReceipt",
    "independentReadback",
    "consentedAssignmentOrRemediation",
    "verifiedWorkProductAdoption",
    "kernelOutcomeAuthority",
    "complianceCertification"
