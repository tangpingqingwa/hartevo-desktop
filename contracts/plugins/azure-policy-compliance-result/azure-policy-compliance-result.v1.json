  "queryPolicy": {
    "operation": "bounded_read_only_queryResults",
    "filterAst": [
      "complianceState",
      "policyDefinitionId",
      "policyAssignmentId",
      "policySetDefinitionId",
      "timestampAfter",
      "timestampBefore",
      "and"
