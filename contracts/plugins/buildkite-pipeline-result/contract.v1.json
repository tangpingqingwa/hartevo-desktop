  "pluginId": "buildkite.pipeline-result",
  "layer": 1,
  "evidenceLevel": "L1_PROVIDER_CONTRACT",
  "digestInput": "hartevo.buildkite-pipeline-result-contract/v1|layer=1|service=buildkite.pipeline-result.read|provider=buildkite.cloud.pipeline-result.recording|consumer=mission.buildkite-pipeline-result.consumer",
  "contractDigest": "c9942af361e8c7636dff8d344ce1189f592f6276e560e42f0b7d495bb902de4f",
  "service": {
    "type": "BuildkitePipelineResultService",
    "id": "buildkite.pipeline-result.read",
