{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tangpingqingwa/hartevo-desktop/contracts/plugins/azure-cosmosdb-container-result/azure-cosmosdb-container-result.v1.json",
  "title": "Hartevo Azure Cosmos DB container-posture result Layer-1 contract",
  "description": "A bounded, read/proposal/local-record/verify-only Azure Cosmos DB management-plane container posture seam. It is not a data-plane reader, availability or compliance authority, or Hartevo kernel authority.",
  "schemaVersion": "hartevo.azure-cosmosdb-container-result.contract/v1",
  "contractVersion": "azure-cosmosdb-container-result/v1",
  "pluginVersion": "1.0.0",
  "layer": "Layer-1",
  "officialReferences": [
    "https://learn.microsoft.com/en-us/rest/api/cosmos-db-resource-provider/database-accounts/get",
    "https://learn.microsoft.com/en-us/rest/api/cosmos-db-resource-provider/sql-resources/get-sql-database",
    "https://learn.microsoft.com/en-us/rest/api/cosmos-db-resource-provider/sql-resources/get-sql-container",
    "https://learn.microsoft.com/en-us/rest/api/cosmos-db-resource-provider/sql-resources"
  ],
  "service": {
    "id": "hartevo.azure.cosmosdb.container-result",
    "implementation": "AzureCosmosContainerResultService",
    "version": "1.0.0",
    "operations": [
      "describe_capabilities",
      "register",
      "revoke_registration",
      "reverse_registration",
      "read_bounded",
      "propose",
      "record",
      "verify"
    ],
    "readOnly": true,
    "proposalOnly": true,
    "liveExecution": false,
    "externalWrites": false
  },
  "provider": {
    "id": "azure.cosmosdb.resource",
    "implementation": "AzureCosmosResourceProvider",
    "version": "1.0.0",
    "apiVersion": "2024-11-01",
    "apiRevision": "azure-cosmosdb-arm-read-r1",
    "allowlistedOperations": [
      "DatabaseAccounts_Get",
      "SqlDatabases_Get",
      "SqlContainers_Get",
      "ThroughputSettings_Get"
    ],
    "allowlistedMethods": ["GET"],
    "acceptedTransports": ["fixture", "recording", "fake", "loopback", "BLOCKED_ENV"],
    "native": false,
    "connected": false,
    "first_party": false,
    "externalWrites": false,
    "dataPlane": false,
    "secretReference": "opaque_non_serializing_entra_arm_read_only"
  },
  "consumer": {
    "id": "mission.azure.cosmosdb.container-result",
    "implementation": "MissionAzureCosmosContainerConsumer",
    "version": "1.0.0",
    "projectBound": true,
    "missionBound": true,
    "workProductBound": true,
    "revisionBound": true,
    "adoptsOutcome": false,
    "adoptsWorkProduct": false,
    "truthAuthority": false,
    "consentAuthority": false,
    "effectAuthority": false
  },
  "scope": {
    "required": [
      "tenant_id",
      "subscription_id",
      "resource_group",
      "exact_account_id_and_revision",
      "exact_sql_database_id_and_revision",
      "exact_sql_container_id_and_revision",
      "api_version",
      "provider_id_and_revision",
      "project_id_and_revision",
      "mission_id_and_revision",
      "work_product_id_and_revision",
      "permission_digest",
      "scope_digest",
      "secret_reference_digest"
    ],
    "target": "exactly_one_account_database_container",
    "resourceEtags": "digest_only",
    "dataPlane": false,
    "keys": false,
    "connectionStrings": false
  },
  "registration": {
    "pluginVersionBound": true,
    "contractVersionBound": true,
    "contractDigestBound": true,
    "providerIdBound": true,
    "providerVersionBound": true,
    "providerRevisionBound": true,
    "providerDigestBound": true,
    "apiVersionBound": true,
    "permissionDigestBound": true,
    "scopeDigestBound": true,
    "secretReferenceDigestBound": true,
    "evidenceDigestBound": true,
    "reversible": true,
    "revocable": true,
    "failClosedOn": [
      "plugin_version_drift",
      "contract_or_provider_digest_drift",
      "api_version_drift",
      "permission_or_scope_drift",
      "secret_reference_revocation",
      "resource_etag_or_revision_drift",
      "evidence_tamper",
      "proposal_replay",
      "registration_revocation"
    ]
  },
  "bounds": {
    "maxResponseBytes": 1048576,
    "maxRequestsPerRead": 12,
    "maxRetries": 2,
    "maxRegions": 32,
    "maxRuPerSecond": 10000000,
    "maxProviderErrors": 12,
    "maxIdentifierBytes": 256
  },
  "evidence": {
    "states": [
      "PRESENT",
      "DEGRADED_CONFIGURATION",
      "PARTIAL",
      "NOT_FOUND",
      "ACCESS_LOST",
      "REVISION_DRIFT",
      "PROVIDER_UNKNOWN",
      "TAMPERED",
      "REVOKED"
    ],
    "retained": [
      "resource_identity_digest",
      "resource_revision_digest",
      "location_summary",
      "replication_topology_summary",
      "consistency_policy_enum",
      "backup_policy_enum",
      "public_network_access_boolean",
      "network_filter_boolean",
      "throughput_mode_and_bounded_ru_values",
      "indexing_mode_enum",
      "partition_key_digest",
      "observation_timestamp",
      "provider_error_codes",
      "evidence_digest"
    ],
    "notRetained": [
      "access_keys",
      "connection_strings",
      "account_endpoints",
      "ip_rules",
      "virtual_network_ids",
      "managed_identities",
      "tags",
      "partition_key_paths",
      "indexing_paths",
      "arbitrary_property_bags",
      "raw_provider_payload",
      "credential_material"
    ],
    "externalConfigurationIsEvidenceNotTruth": true,
    "missingOrInsufficientDataFailsClosed": true
  },
  "redaction": {
    "secretMaterial": false,
    "rawProviderPayload": false,
    "accountEndpoint": false,
    "accessKeys": false,
    "connectionStrings": false,
    "ipRules": false,
    "virtualNetworkIds": false,
    "identities": false,
    "tags": false,
    "partitionKeyPaths": false,
    "indexingPaths": false,
    "arbitraryProperties": false,
    "errorMessages": false
  },
  "authority": {
    "readOnly": true,
    "proposalOnly": true,
    "localRecordOnly": true,
    "externalWrites": false,
    "dataPlaneRead": false,
    "keyRetrieval": false,
    "connectionStringRetrieval": false,
    "resourceMutation": false,
    "throughputMutation": false,
    "indexingMutation": false,
    "partitionMutation": false,
    "networkMutation": false,
    "native": false,
    "connected": false,
    "firstParty": false,
    "truthAuthority": false,
    "consentAuthority": false,
    "effectAuthority": false,
    "receiptAuthority": false,
    "verificationAuthority": false,
    "outcomeAuthority": false,
    "workProductAdoption": false
  },
  "honesty": {
    "nativeStatus": "BLOCKED_ENV",
    "blockedEnvironmentIsNative": false,
    "fixtureIsNative": false,
    "recordingIsNative": false,
    "fakeIsNative": false,
    "loopbackIsNative": false,
    "presentIsAvailabilityTruth": false,
    "presentIsComplianceTruth": false,
    "presentIsDurabilityTruth": false,
    "layer1Boundary": "Layer 1 emits bounded redacted management-plane evidence and a Mission review proposal only. Native Entra resolution, live ARM HTTPS, durable provider receipts, independent repeat-read/reconciliation, verified Work Product adoption, and consented Cosmos effects remain Layer-2 host authority."
  },
  "layer2Gaps": [
    "native_entra_credential_resolution",
    "live_azure_resource_manager_https",
    "durable_provider_receipt",
    "independent_repeat_read_and_reconciliation",
    "verified_work_product_adoption",
    "availability_security_compliance_or_durability_truth",
    "consented_database_effects"
  ],
  "forbidden": [
    "read_documents",
    "query_data_plane",
    "retrieve_access_keys",
    "retrieve_connection_strings",
    "create_or_update_or_delete_resource",
    "change_throughput",
    "change_indexing",
    "change_partition_key",
    "change_firewall_or_private_link",
    "change_rbac",
    "failover",
    "restore",
    "claim_connected",
    "claim_native",
    "claim_first_party",
    "claim_availability_security_compliance_or_durability",
    "adopt_kernel_truth_or_outcome"
  ]
}
