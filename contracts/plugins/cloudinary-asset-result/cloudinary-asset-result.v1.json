    "doesNotOwn": [
      "Hartevo Truth",
      "Hartevo Consent authority",
      "Hartevo Effect",
      "Hartevo Receipt",
      "Hartevo Verification authority",
      "Hartevo Outcome",
      "native Cloudinary credential resolution",
      "live Cloudinary Admin or Delivery HTTPS",
      "durable provider receipt",
      "independent byte readback",
      "signed URL execution or verification",
      "upload, update, delete, or transformation creation",
      "raw media or PII retention",
      "production delivery certification",
      "verified Work Product adoption"
