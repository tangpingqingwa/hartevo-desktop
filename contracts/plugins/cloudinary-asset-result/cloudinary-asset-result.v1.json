  "layer2Gaps": [
    "native API-key/signature resolution and live Cloudinary HTTPS",
    "durable Cloudinary provider receipt",
    "independent media byte readback",
    "signed URL execution and verification",
    "consented upload/update/delete/transformation effects",
    "raw media and PII handling",
    "production delivery guarantee",
    "verified Mission Work Product/Outcome adoption"
  ],
  "honestNativeGap": "Layer-1 uses only recording, fixture, loopback, and BLOCKED_ENV transports. None claims Connected, native, first-party, durable provider receipt, signed-URL verification, delivery guarantee, raw media access, or verified adoption. Native credential resolution, live Cloudinary Admin/Delivery HTTPS, independent byte readback, consented effects, and Work Product/Outcome adoption remain Layer-2 work."
