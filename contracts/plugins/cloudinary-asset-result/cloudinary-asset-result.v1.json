    "fixture": "non_native_non_connected_non_first_party",
    "loopback": "non_native_non_connected_non_first_party",
    "blockedEnv": "non_native_non_connected_non_first_party",
    "connected": false,
    "native": false,
    "firstParty": false,
    "providerReceipt": false
  },
  "authorityBoundary": {
    "owns": [
      "bounded resource, usage, transformation, and delivery metadata reads",
      "digest-only Cloudinary asset evidence projection",
      "scope, revision, retry, and idempotency fences",
      "reversible and revocable registration",
      "redacted request and cost receipts",
      "Mission-scoped review-only proposal and recording"
