{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hartevo.local/contracts/plugins/tines-automation-result/tines-automation-result.v1.json",
  "title": "Hartevo Tines automation result Layer-1 contract",
  "description": "Bounded read-only Tines story execution evidence for Mission review; not a playbook executor, credential boundary, external-effect receipt, or Outcome authority.",
  "schemaVersion": "hartevo.tines-automation-result/v1",
  "contractVersion": "EXT-TINES-01-L1/v1",
  "pluginId": "tines.automation-result",
  "pluginVersion": "0.1.0",
  "layer": 1,
  "authority": {
    "readOnly": true,
    "proposalOnly": true,
    "connected": false,
    "nativeProvider": false,
    "firstParty": false,
    "durableReceipt": false,
    "kernelAuthority": false,
    "truthAuthority": false,
    "consentAuthority": false,
    "effectAuthority": false,
    "receiptAuthority": false,
    "verificationAuthority": false,
    "outcomeAuthority": false,
    "externalWrites": false,
    "playbookExecutionAuthority": false
  },
  "typedSurface": {
    "service": "TinesAutomationResultService",
    "provider": "TinesProvider",
    "consumer": "MissionTinesAutomationConsumer",
    "models": [
      "TinesAutomationScope",
      "TenantId",
      "StoryId",
      "ActionId",
      "StoryRunGuid",
      "EventId",
      "CaseId",
      "TimeWindow",
      "ProjectBinding",
      "MissionBinding",
      "WorkProductBinding",
      "ConsentScope",
      "SecretReference",
      "TinesPermissionSet",
      "TinesRegistration",
      "TinesAutomationEvidence",
      "TinesAutomationProposal"
    ]
  },
  "service": {
    "id": "tines.automation-result.read",
    "name": "TinesAutomationResultService",
    "version": "1.0.0",
    "access": "read_only",
    "operations": [
      "validate_read_consent",
      "read_story_metadata",
      "read_story_run_summary",
      "read_action_summary",
      "read_event_summary",
      "read_case_metadata",
      "read_audit_log_metadata",
      "compile_automation_result_proposal",
      "record_observation_receipt",
      "verify_proposal",
      "read_back_against_proposal",
      "revoke_registration",
      "restore_registration"
    ],
    "externalWrites": false,
    "liveExternalIo": false,
    "kernelAuthority": false,
    "outcomeAuthority": false
  },
  "provider": {
    "id": "tines.api.automation-result",
    "name": "TinesProvider",
    "version": "1.0.0",
    "apiRevision": "tines-api-v1-bounded-read-2026-08",
    "basePath": "/api/v1",
    "allowlistedGetPaths": [
      "/api/v1/stories/{story_id}",
      "/api/v1/stories/{story_id}/runs/{story_run_guid}/summary",
      "/api/v1/actions/{action_id}",
      "/api/v1/events/{event_id}",
      "/api/v1/cases/{case_id}",
      "/api/v1/audit_logs"
    ],
    "permissions": [
      "stories.read",
      "story_runs.read",
      "actions.read",
      "events.read",
      "cases.read",
      "audit_logs.read"
    ],
    "authentication": ["opaque_secret_reference"],
    "transportProvenance": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
    "maxPageSize": 100,
    "maxPages": 4,
    "maxResponseBytes": 1048576,
    "maxTimeWindowDays": 31,
    "maxRetryAfterSeconds": 3600,
    "rawCredentialSerialized": false,
    "rawCredentialDebug": false,
    "rawCredentialRequest": false,
    "rawCredentialReceipt": false,
    "rawPayload": false,
    "rawInputs": false,
    "rawOutputs": false,
    "rawCaseContent": false,
    "rawLogs": false,
    "reversible": true,
    "revocable": true,
    "native": false,
    "connected": false,
    "firstParty": false
  },
  "consumer": {
    "id": "mission.tines-automation-result",
    "name": "MissionTinesAutomationConsumer",
    "kind": "mission_automation_result_projection",
    "scope": [
      "tenant",
      "story",
      "action",
      "story_run",
      "event",
      "case",
      "time_window",
      "project",
      "mission",
      "work_product",
      "consent",
      "permission_set",
      "provider_digest",
      "evidence_digest",
      "mission_revision",
      "work_product_revision"
    ],
    "adoptsOutcome": false,
    "adoptsWorkProduct": false,
    "kernelAuthority": false,
    "truthAuthority": false
  },
  "exactScope": [
    "tenant",
    "story",
    "optional_action",
    "optional_story_run",
    "optional_event",
    "optional_case",
    "time_window",
    "project",
    "mission",
    "work_product",
    "consent",
    "permissions",
    "secret_reference_digest"
  ],
  "allowlist": {
    "reads": [
      {"operation": "get_story", "method": "GET", "path": "/api/v1/stories/{story_id}", "metadataOnly": true},
      {"operation": "get_story_run_summary", "method": "GET", "path": "/api/v1/stories/{story_id}/runs/{story_run_guid}/summary", "metadataOnly": true},
      {"operation": "get_action", "method": "GET", "path": "/api/v1/actions/{action_id}", "summaryOnly": true},
      {"operation": "get_event", "method": "GET", "path": "/api/v1/events/{event_id}", "payload": "digest_only"},
      {"operation": "get_case", "method": "GET", "path": "/api/v1/cases/{case_id}", "content": "digest_only"},
      {"operation": "list_audit_logs", "method": "GET", "path": "/api/v1/audit_logs", "inputsOutputs": "digest_only", "paginated": true}
    ],
    "writes": [],
    "forbidden": [
      "story_create_update_delete",
      "action_create_update_delete",
      "case_create_update_delete",
      "story_trigger",
      "story_retry",
      "event_re_emit",
      "credential_management",
      "webhook_registration",
      "raw_event_export",
      "raw_action_input_output_export",
      "raw_case_content_export",
      "raw_audit_log_export",
      "generic_workflow_registry",
      "kernel_truth_authority",
      "kernel_consent_authority",
      "kernel_effect_authority",
      "kernel_receipt_authority",
      "kernel_verification_authority",
      "kernel_outcome_authority",
      "verified_external_side_effect_claim",
      "verified_remediation_success_claim",
      "verified_work_product_adoption"
    ]
  },
  "normalization": {
    "states": ["queued", "running", "succeeded", "failed", "cancelled", "partial", "expired", "access_lost", "rate_limited", "provider_unknown"],
    "ids": "bounded_provider_ids",
    "timestamps": "RFC3339_in_registered_window",
    "payloads": "sha256_digest_only",
    "inputs": "sha256_digest_only",
    "outputs": "sha256_digest_only",
    "caseContent": "sha256_digest_only_or_dropped",
    "logs": "metadata_and_digests_only",
    "responseOrderIndependent": true,
    "externalSideEffects": "never_inferred",
    "remediationSuccess": "never_inferred"
  },
  "digests": {
    "contract": true,
    "provider": true,
    "permission": true,
    "scope": true,
    "consent": true,
    "request": true,
    "response": true,
    "evidence": true,
    "proposal": true,
    "registration": true,
    "reversible": true,
    "revocable": true
  },
  "layer2Gaps": [
    "native_Tines_credential_resolution",
    "live_https_transport",
    "story_trigger_or_retry",
    "story_action_case_mutation",
    "raw_payload_or_log_export",
    "webhooks",
    "durable_provider_receipt",
    "independent_native_readback",
    "kernel_truth_consent_effect_receipt_verification_outcome_authority"
  ]
}
