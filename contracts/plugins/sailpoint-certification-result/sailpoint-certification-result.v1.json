{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tangpingqingwa/hartevo-desktop/contracts/plugins/sailpoint-certification-result/sailpoint-certification-result.v1.json",
  "title": "Hartevo SailPoint Identity Security Cloud certification-result Layer-1 contract",
  "description": "A bounded, read-only certification and access-review evidence proposal seam. It is not a certification decision authority, access-request engine, identity provider, or kernel Consent authority.",
  "schemaVersion": "hartevo.sailpoint-certification-result.contract/v1",
  "contractVersion": "sailpoint-certification-result/v1",
  "pluginVersion": "1.0.0",
  "layer": "Layer-1",
  "service": {
    "id": "hartevo.sailpoint.certification",
    "implementation": "SailPointCertificationService",
    "version": "1.0.0",
    "operations": [
      "describe_capabilities",
      "register",
      "revoke_registration",
      "read_certification",
      "read_campaign",
      "read_access_summary",
      "compile_evidence_proposal",
      "record_proposal",
      "verify_proposal"
    ],
    "readOnly": true,
    "proposalOnly": true,
    "liveExecution": false
  },
  "provider": {
    "id": "sailpoint.identity-security-cloud",
    "implementation": "SailPointProvider",
    "version": "1.0.0",
    "apiVersion": "v3",
    "apiBasePattern": "https://{tenant}.api.identitynow.com/v3",
    "allowlistedMethods": ["GET"],
    "allowlistedReads": [
      "get_identity_certification",
      "get_identity_certifications",
      "get_identity_access_summaries"
    ],
    "accessTypes": ["ROLE", "ACCESS_PROFILE", "ENTITLEMENT"],
    "acceptedTransports": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
    "native": false,
    "connected": false,
    "externalWrites": false,
    "decisionWrites": false,
    "accessRequestWrites": false,
    "identityMutation": false,
    "entitlementMutation": false
  },
  "consumer": {
    "id": "mission.sailpoint-certification-result",
    "implementation": "MissionSailPointCertificationConsumer",
    "version": "1.0.0",
    "missionBound": true,
    "projectBound": true,
    "consentBound": true,
    "campaignBound": true,
    "reviewerBound": true,
    "identityBound": true,
    "entitlementBound": true,
    "adoptsOutcome": false,
    "accessSafetyAuthority": false,
    "truthAuthority": false,
    "consentAuthority": false,
    "effectAuthority": false
  },
  "scope": {
    "required": [
      "tenant",
      "apiBase",
      "certificationId",
      "campaignId",
      "accessType",
      "reviewerId",
      "identityId",
      "entitlementId",
      "campaignRevision",
      "entitlementRevision",
      "missionIdAndRevision",
      "projectIdAndRevision",
      "consentIdAndRevision",
      "permissionDigest",
      "scopeDigest"
    ],
    "apiBase": "exact_https_tenant_api_identitynow_com_v3",
    "accessType": ["ROLE", "ACCESS_PROFILE", "ENTITLEMENT"],
    "secret": "opaque_pat_or_oauth_secret_reference_only",
    "reviewer": "immutable_id_only",
    "identity": "immutable_id_only",
    "entitlement": "immutable_id_only",
    "tenantBound": true,
    "campaignBound": true,
    "campaignRevisionBound": true,
    "missionBound": true,
    "projectBound": true,
    "consentBound": true
  },
  "registration": {
    "versionBound": true,
    "contractVersionBound": true,
    "contractDigestBound": true,
    "providerIdBound": true,
    "providerImplementationBound": true,
    "providerVersionBound": true,
    "providerRevisionBound": true,
    "providerDigestBound": true,
    "permissionDigestBound": true,
    "scopeDigestBound": true,
    "evidenceDigestBound": true,
    "missionRevisionBound": true,
    "projectRevisionBound": true,
    "consentRevisionBound": true,
    "reversible": true,
    "revocable": true,
    "failClosedOn": [
      "plugin_version_drift",
      "contract_version_or_digest_drift",
      "provider_identity_or_revision_drift",
      "tenant_or_api_base_drift",
      "campaign_or_access_type_drift",
      "reviewer_identity_entitlement_scope_drift",
      "campaign_or_entitlement_revision_drift",
      "mission_project_consent_revision_drift",
      "permission_or_scope_digest_drift",
      "evidence_digest_drift",
      "registration_tamper",
      "registration_revocation",
      "secret_reference_revocation"
    ]
  },
  "bounds": {
    "maxResponseBytes": 1048576,
    "maxLimit": 250,
    "maxOffset": 10000,
    "maxPages": 4,
    "maxRequestsPerMinute": 5,
    "maxRecords": 256,
    "maxIdentifierBytes": 128
  },
  "evidence": {
    "allowlistedFields": [
      "tenant",
      "apiBase",
      "certificationId",
      "campaignId",
      "campaignRevision",
      "campaignState",
      "reviewerId",
      "identityId",
      "entitlementId",
      "accessType",
      "decisionState",
      "decisionCounts",
      "privileged",
      "createdAt",
      "modifiedAt",
      "dueAt",
      "decisionAt",
      "providerRevision",
      "requestReceiptDigest",
      "responseReceiptDigest",
      "sourceDigest",
      "evidenceDigest",
      "registrationDigest",
      "missionProjectConsentScopeDigest"
    ],
    "rawIdentityPayload": false,
    "rawAccessPayload": false,
    "rawAccessDescription": false,
    "reviewerName": false,
    "reviewerEmail": false,
    "identityName": false,
    "entitlementName": false,
    "reviewerComments": false,
    "rawPat": false,
    "rawOAuthToken": false,
    "rawProviderError": false
  },
  "projections": {
    "campaignStates": ["active", "completed", "remediation", "expired", "unknown"],
    "decisionStates": ["approved", "revoked", "pending", "partial"],
    "failClosed": true,
    "partialExplicit": true,
    "accessLostExplicit": true,
    "providerUnknownExplicit": true,
    "accessSafetyClaim": false,
    "adopted": false,
    "kernelAuthority": false
  },
  "authority": {
    "readOnly": true,
    "proposalOnly": true,
    "certificationApproval": false,
    "certificationRevocation": false,
    "certificationFinalization": false,
    "accessRequestSubmission": false,
    "identityMutation": false,
    "entitlementMutation": false,
    "externalWrites": false,
    "effect": false,
    "receipt": false,
    "verification": false,
    "truth": false,
    "accessSafety": false,
    "outcome": false,
    "workProductAdoption": false,
    "consentAuthority": false,
    "connected": false,
    "native": false
  },
  "redaction": {
    "rawIdentityPayload": false,
    "rawAccessPayload": false,
    "rawAccessDescription": false,
    "reviewerName": false,
    "reviewerEmail": false,
    "identityName": false,
    "entitlementName": false,
    "reviewerComments": false,
    "rawPat": false,
    "rawOAuthToken": false,
    "rawProviderError": false
  },
  "honesty": {
    "nativeStatus": "BLOCKED_ENV",
    "blockedEnvironmentIsNative": false,
    "fixtureIsNative": false,
    "recordingIsNative": false,
    "loopbackIsNative": false,
    "connectedClaim": false,
    "firstPartyEvidenceClaim": false,
    "accessSafetyClaim": false,
    "layer1Boundary": "Layer 1 retains only immutable identifiers, typed states, counts, privileged flags, timestamps and cryptographic receipts. It never resolves live PAT/OAuth material, approves/revokes/finalizes certification items, submits access requests, mutates identities or entitlements, exposes reviewer PII or raw access descriptions, claims access safety, or adopts kernel Consent/Outcome authority."
  },
  "layer2Gaps": [
    "native_sailpoint_pat_or_oauth_resolution",
    "authenticated_connected_sailpoint_reads",
    "durable_provider_receipt_and_independent_readback",
    "certification_decision_or_finalization_effects",
    "access_request_submission",
    "identity_or_entitlement_mutation",
    "host_owned_consent_and_effect_authority",
    "verified_access_safety_and_kernel_outcome_adoption"
  ],
  "forbidden": [
    "certification_approval",
    "certification_revocation",
    "certification_finalization",
    "access_request_submission",
    "identity_mutation",
    "entitlement_mutation",
    "raw_identity_payload_serialization",
    "raw_access_payload_serialization",
    "raw_access_description_serialization",
    "reviewer_pii_serialization",
    "reviewer_comments_serialization",
    "raw_pat_serialization",
    "raw_oauth_token_serialization",
    "connected_or_first_party_claim",
    "access_safety_claim",
    "kernel_consent_authority",
    "kernel_effect_authority",
    "kernel_outcome_authority"
  ]
}
