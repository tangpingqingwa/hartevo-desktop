{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tangpingqingwa/hartevo-desktop/contracts/plugins/aws-firewall-manager-result/aws-firewall-manager-result.v1.json",
  "title": "Hartevo AWS Firewall Manager policy-compliance result Layer-1 contract",
  "description": "A bounded, read/proposal/record/verify-only AWS Firewall Manager control-plane policy and compliance posture seam. It is not an AWS Firewall Manager mutation engine, data-plane rule reader, remediation authority, certification authority, or Hartevo Truth authority.",
  "schemaVersion": "hartevo.aws-firewall-manager-result.contract/v1",
  "contractVersion": "EXT-AWS-FIREWALL-MANAGER-01-L1/v1",
  "pluginId": "aws.firewall-manager.result",
  "pluginVersion": "1.0.0",
  "layer": "Layer-1",
  "evidenceLevel": "L1_PROVIDER_CONTRACT",
  "officialReferences": [
    "https://docs.aws.amazon.com/fms/2018-01-01/APIReference/API_ListPolicies.html",
    "https://docs.aws.amazon.com/fms/2018-01-01/APIReference/API_GetPolicy.html",
    "https://docs.aws.amazon.com/fms/2018-01-01/APIReference/API_ListComplianceStatus.html",
    "https://docs.aws.amazon.com/fms/2018-01-01/APIReference/API_GetComplianceDetail.html",
    "https://docs.aws.amazon.com/fms/2018-01-01/APIReference/Welcome.html"
  ],
  "service": {
    "type": "AwsFirewallManagerService",
    "id": "aws.firewall-manager.result.read",
    "access": "read_proposal_record_verify",
    "version": "1.0.0",
    "operations": [
      "describe_capabilities",
      "register",
      "revoke_registration",
      "reverse_registration",
      "read_bounded",
      "propose",
      "record",
      "verify"
    ],
    "readOnly": true,
    "proposalOnly": true,
    "recordingOnly": true,
    "liveExecution": false,
    "externalWrites": false,
    "kernelAuthority": false,
    "outcomeAdoption": false
  },
  "provider": {
    "type": "AwsFirewallManagerProvider",
    "id": "aws.firewall-manager.result.recording",
    "version": "1.0.0",
    "apiVersion": "2018-01-01",
    "apiRevision": "aws-fms-policy-compliance-read-r1",
    "operations": [
      "ListPolicies",
      "GetPolicy",
      "ListComplianceStatus",
      "GetComplianceDetail"
    ],
    "allowlistedMethods": ["POST"],
    "acceptedTransports": ["fixture", "fake", "recording", "loopback", "BLOCKED_ENV"],
    "native": false,
    "connected": false,
    "firstParty": false,
    "readOnly": true,
    "externalWrites": false,
    "sigV4Secret": "opaque_non_serializing_secret_reference_only",
    "providerReceipt": false
  },
  "consumer": {
    "type": "MissionAwsFirewallManagerConsumer",
    "id": "mission.aws.firewall-manager.result",
    "deploymentBound": false,
    "missionBound": true,
    "projectBound": true,
    "workProductBound": true,
    "revisionBound": true,
    "permissionBound": true,
    "producesDecisionProposal": true,
    "adoptsOutcome": false,
    "adoptsWorkProduct": false,
    "truthAuthority": false,
    "effectiveAuthorization": false,
    "certificationAuthority": false
  },
  "scope": {
    "required": [
      "organization_id_and_revision",
      "admin_account_id_and_revision",
      "aws_region",
      "explicit_policy_allowlist_and_revisions",
      "explicit_member_account_allowlist_and_revisions",
      "explicit_resource_type_allowlist",
      "mission_id_and_revision",
      "project_id_and_revision",
      "work_product_id_and_revision",
      "permission_snapshot_and_revision",
      "consent_expiry",
      "scope_digest"
    ],
    "controlPlaneOnly": true,
    "dataPlaneRuleBodies": false,
    "rawResourceIds": false,
    "rawPolicyJson": false,
    "managedRuleGroups": false,
    "accountPii": false,
    "identifiersInEvidence": "digest_only",
    "secret": "opaque_non_serializing_sigv4_reference_only"
  },
  "registration": {
    "pluginVersionBound": true,
    "providerIdBound": true,
    "providerVersionBound": true,
    "apiVersionBound": true,
    "apiRevisionBound": true,
    "providerDigestBound": true,
    "contractVersionBound": true,
    "contractDigestBound": true,
    "permissionDigestBound": true,
    "scopeDigestBound": true,
    "policyAllowlistDigestBound": true,
    "evidenceDigestBound": true,
    "secretReferenceDigestBound": true,
    "reversible": true,
    "revocable": true,
    "failClosedOn": [
      "plugin_version_drift",
      "provider_or_api_revision_drift",
      "provider_or_contract_digest_drift",
      "permission_or_scope_digest_drift",
      "policy_or_member_account_allowlist_drift",
      "evidence_digest_drift",
      "secret_reference_revocation",
      "registration_tamper",
      "registration_replay",
      "registration_revocation",
      "cursor_replay_or_loop",
      "stale_policy_or_compliance_revision",
      "expired_consent_or_evidence"
    ]
  },
  "bounds": {
    "maxResponseBytes": 1048576,
    "maxPages": 4,
    "pageSize": 50,
    "maxPolicies": 64,
    "maxMemberAccounts": 128,
    "maxComplianceDetails": 256,
    "maxViolationCategories": 32,
    "maxRequestsPerRead": 12,
    "maxRetries": 2,
    "maxIdentifierBytes": 128,
    "maxOpaqueCursorBytes": 512
  },
  "reads": {
    "ListPolicies": {
      "filter": "explicit_policy_allowlist_and_region",
      "items": "policy_summary_without_policy_document",
      "pagination": "opaque_bounded"
    },
    "GetPolicy": {
      "target": "explicit_policy_allowlist_only",
      "projection": ["policy_type", "resource_type_scope_digest", "remediation_enabled"],
      "policyDocument": false
    },
    "ListComplianceStatus": {
      "target": "explicit_policy_and_member_account_allowlists",
      "items": "status_counts_and_redacted_violation_category_digests",
      "pagination": "opaque_bounded"
    },
    "GetComplianceDetail": {
      "target": "explicit_policy_member_account_resource_type_scope",
      "items": "redacted_compliance_detail_and_violation_category_digests",
      "resourceIds": "digest_only"
    },
    "record": "normalized_redacted_evidence_only",
    "verify": [
      "request_digest",
      "opaque_cursor_digest",
      "permission_digest",
      "policy_allowlist_digest",
      "scope_digest",
      "provider_digest",
      "complete_pagination",
      "expiry",
      "evidence_digest"
    ]
  },
  "evidence": {
    "states": [
      "compliant",
      "non_compliant",
      "not_applicable",
      "insufficient_data",
      "partial",
      "expired",
      "unknown",
      "access_loss",
      "stale",
      "registration_revoked"
    ],
    "digests": [
      "plugin_version",
      "provider",
      "api",
      "contract",
      "permission",
      "policy_allowlist",
      "scope",
      "request",
      "cursor",
      "policy",
      "compliance",
      "violation_category",
      "evidence",
      "record"
    ],
    "retained": [
      "policy_type",
      "policy_revision",
      "resource_type_scope_digest",
      "remediation_enabled_posture",
      "member_account_digest",
      "resource_type",
      "compliance_state",
      "compliant_count",
      "non_compliant_count",
      "violation_category_digests",
      "pagination_token_digest",
      "observed_at",
      "expires_at"
    ],
    "notRetained": [
      "raw_resource_id",
      "raw_policy_id",
      "raw_policy_arn",
      "policy_json",
      "managed_rule_group_body",
      "account_email",
      "account_name",
      "raw_violation_metadata",
      "provider_payload",
      "credential_material"
    ],
    "missingOrInsufficientDataFailsClosed": true,
    "accessLossFailsClosed": true,
    "expiredEvidenceFailsClosed": true
  },
  "redaction": {
    "secretMaterial": false,
    "rawNextToken": false,
    "rawResourceIds": false,
    "rawPolicyIdentifiers": false,
    "rawPolicyJson": false,
    "managedRuleGroups": false,
    "accountPii": false,
    "rawViolationMetadata": false,
    "providerPayload": false,
    "violationCategories": "digest_only"
  },
  "provenance": {
    "fixture": "non_native_non_connected_non_first_party",
    "fake": "non_native_non_connected_non_first_party",
    "recording": "non_native_non_connected_non_first_party",
    "loopback": "non_native_non_connected_non_first_party",
    "blockedEnv": "non_native_non_connected_non_first_party",
    "connectedClaim": false,
    "nativeClaim": false,
    "firstPartyClaim": false,
    "providerReceipt": false
  },
  "authority": {
    "readOnly": true,
    "proposalOnly": true,
    "externalWrites": false,
    "policyMutation": false,
    "adminAssociation": false,
    "remediation": false,
    "effectAuthority": false,
    "rawPolicyRead": false,
    "credentialResolution": false,
    "durableNativeReceipt": false,
    "independentNativeReread": false,
    "certification": false,
    "connected": false,
    "native": false,
    "kernelOutcomeAdoption": false,
    "workProductAdoption": false
  },
  "forbidden": [
    "PutPolicy",
    "DeletePolicy",
    "AssociateAdminAccount",
    "DisassociateAdminAccount",
    "remediation",
    "effect",
    "raw_resource_ids",
    "policy_json",
    "managed_rule_group_bodies",
    "account_pii",
    "durable_native_receipt",
    "independent_native_reread",
    "outcome_adoption",
    "work_product_adoption"
  ],
  "authorityBoundary": {
    "owns": [
      "typed organization/admin-account/region/policy/member-account/resource-type scope",
      "bounded ListPolicies/GetPolicy/ListComplianceStatus/GetComplianceDetail seams",
      "policy type/resource scope/remediation posture projection",
      "member-account compliance counts/status and violation-category digests",
      "opaque pagination and drift fences",
      "version/provider/API/permission/scope/evidence digest binding",
      "reversible registration",
      "redacted proposal and recording"
    ],
    "doesNotOwn": [
      "AWS Firewall Manager policy mutation",
      "AWS WAF data-plane rules",
      "AWS Network Firewall data-plane rules",
      "Hartevo Truth, Consent, Effect, Receipt, Verification, or Outcome authority",
      "native SigV4 credential resolution",
      "live native HTTPS",
      "durable provider receipt",
      "independent native reread",
      "remediation or effect execution",
      "verified Work Product adoption"
    ]
  },
  "honesty": {
    "nativeStatus": "BLOCKED_ENV",
    "blockedEnvironmentIsNative": false,
    "fixtureIsNative": false,
    "fakeIsNative": false,
    "recordingIsNative": false,
    "loopbackIsNative": false,
    "complianceIsCertification": false,
    "layer1Boundary": "Layer 1 emits bounded external Firewall Manager policy/compliance evidence and a Mission decision proposal only. Native SigV4 resolution, live HTTPS, durable provider receipts, independent compliance reread/reconciliation, remediation/effect consent, certification, and verified Mission Work Product adoption remain Layer-2 host authority."
  },
  "layer2Gaps": [
    "native_sigv4_transport_and_credential_resolution",
    "live_aws_firewall_manager_https",
    "durable_provider_receipt",
    "independent_compliance_readback_and_reconciliation",
    "consented_policy_or_remediation_effects",
    "connected_native_first_party_evidence",
    "compliance_certification_authority",
    "verified_work_product_adoption"
  ]
}
