{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tangpingqingwa/hartevo-desktop/contracts/plugins/openai-moderation-result/openai-moderation-result.v1.json",
  "title": "Hartevo OpenAI Moderation classification result Layer-1 contract",
  "description": "Bounded redacted OpenAI Moderation proposal/read/record evidence. It is not general inference, safety certification, automatic enforcement, a connector, or kernel authority.",
  "schemaVersion": "hartevo.openai-moderation-result.contract/v1",
  "contractVersion": "openai-moderation-result/v1",
  "pluginVersion": "0.1.0",
  "layer": "Layer-1",
  "serviceId": "hartevo.openai.moderation.result",
  "providerId": "openai.moderation",
  "consumerId": "mission.openai.moderation.result",
  "api": "moderations.create",
  "endpoint": "POST /v1/moderations",
  "scope": [
    "provider_and_api",
    "project_id_and_revision",
    "mission_id_and_revision",
    "work_product_id_and_revision",
    "opaque_secret_reference_digest",
    "moderation_permission",
    "model_id_and_immutable_snapshot",
    "policy_revision_and_bounds",
    "category_allowlist_digest",
    "input_digest_and_type"
  ],
  "digests": [
    "plugin_version_digest",
    "contract_digest",
    "provider_digest",
    "evidence_mode_digest",
    "model_digest",
    "policy_digest",
    "category_allowlist_digest",
    "permission_digest",
    "scope_digest",
    "input_digest",
    "request_fingerprint",
    "proposal_digest",
    "evidence_digest",
    "response_id_digest"
  ],
  "registration": {
    "versionBound": true,
    "contractDigestBound": true,
    "providerAndApiBound": true,
    "modelBound": true,
    "policyAndCategoryAllowlistBound": true,
    "projectMissionWorkProductBound": true,
    "secretReferenceDigestBound": true,
    "evidenceModeBound": true,
    "reversible": true,
    "revocable": true,
    "failClosedOn": [
      "version_drift",
      "contract_drift",
      "provider_or_api_drift",
      "model_drift",
      "policy_drift",
      "category_allowlist_drift",
      "project_revision_drift",
      "mission_revision_drift",
      "work_product_revision_drift",
      "input_mismatch",
      "malformed_or_partial_result",
      "rate_limit",
      "unauthorized",
      "forbidden",
      "payload_too_large",
      "server_error",
      "timeout",
      "provider_unknown",
      "registration_tamper",
      "registration_revocation",
      "proposal_replay",
      "evidence_tamper"
    ]
  },
  "inputAllowlist": {
    "text": true,
    "image": true,
    "imageMediaTypes": ["image/jpeg", "image/png", "image/webp"],
    "rawTextRetention": false,
    "rawImageRetention": false,
    "urlRetention": false,
    "opaqueImageReferencesOnly": true,
    "boundedBytes": true,
    "unboundedBatch": false
  },
  "categoryProjection": {
    "allowlistBound": true,
    "flags": true,
    "scores": "optional_bounded_basis_points",
    "rawProviderJson": false,
    "unknownCategories": "reject",
    "rawPrompt": false,
    "rawImage": false,
    "hiddenReasoning": false,
    "userPii": false
  },
  "evidenceModes": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
  "authority": {
    "readOnly": true,
    "proposalOnly": true,
    "connected": false,
    "native": false,
    "firstParty": false,
    "nativeCredentialResolution": false,
    "liveModerationCall": false,
    "externalWrites": false,
    "durableProviderReceipt": false,
    "independentReadBack": false,
    "kernelConsent": false,
    "kernelEffect": false,
    "kernelVerification": false,
    "kernelOutcomeAdoption": false
  },
  "enforcement": {
    "automaticBlocking": false,
    "automaticDeletion": false,
    "notification": false,
    "safetyCertification": false,
    "reviewSignalOnly": true
  },
  "forbidden": [
    "raw_api_key_serialization",
    "raw_oauth_serialization",
    "native_secret_resolution",
    "live_https_inference",
    "raw_prompt_retention",
    "raw_image_retention",
    "raw_url_retention",
    "hidden_reasoning_retention",
    "user_pii_retention",
    "raw_provider_json_retention",
    "automatic_blocking",
    "automatic_deletion",
    "user_notification",
    "safety_certification",
    "kernel_consent_authority",
    "kernel_effect_authority",
    "kernel_verification_authority",
    "kernel_outcome_adoption"
  ],
  "layer2Gaps": [
    "native_api_key_or_oauth_resolution",
    "bounded_live_moderations_https_transport",
    "durable_provider_receipt",
    "independent_provider_reread",
    "verified_work_product_adoption",
    "host_owned_safety_review_and_enforcement"
  ],
  "nonOverlap": {
    "responsesIssue": 480,
    "purpose": "Content-safety classification evidence only; direct Responses inference remains separately owned."
  }
}
