{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hartevo.local/contracts/plugins/gcp-cloud-scheduler-result/gcp-cloud-scheduler-result.v1.json",
  "title": "Hartevo governed Google Cloud Scheduler job-result Layer-1 contract",
  "schemaVersion": "hartevo.gcp-cloud-scheduler-result/v1",
  "contractVersion": "gcp-cloud-scheduler-result/v1",
  "pluginVersion": "0.1.0",
  "layer": 1,
  "service": {
    "id": "gcp.cloud-scheduler.result",
    "name": "GcpCloudSchedulerResultService",
    "version": "1.0.0",
    "operation": "bounded_job_list_get_result_proposal",
    "operations": [
      "describe_capabilities",
      "register",
      "revoke_registration",
      "restore_registration",
      "propose_list_jobs",
      "propose_get_job",
      "read_list_jobs",
      "read_get_job",
      "record_observation",
      "verify_proposal",
      "consume_observation"
    ],
    "readOnly": true,
    "liveExecution": false,
    "connected": false,
    "native": false,
    "createsJobs": false,
    "deletesJobs": false,
    "patchesJobs": false,
    "pausesJobs": false,
    "resumesJobs": false,
    "runsJobs": false,
    "invokesTargets": false
  },
  "provider": {
    "id": "gcp.cloud-scheduler",
    "implementation": "GcpCloudSchedulerProvider",
    "apiVersion": "v1",
    "baseUrl": "https://cloudscheduler.googleapis.com",
    "operations": ["jobs.list", "jobs.get"],
    "permissions": [
      "cloudscheduler.jobs.list",
      "cloudscheduler.jobs.get"
    ],
    "acceptedTransports": [
      "fixture",
      "recording",
      "loopback",
      "BLOCKED_ENV"
    ],
    "native": false,
    "connected": false,
    "firstParty": false,
    "liveCredentialResolution": false,
    "rawArguments": false,
    "rawResults": false,
    "rawHeaders": false,
    "rawBodies": false,
    "rawProviderDiagnostics": false
  },
  "consumer": {
    "id": "mission.gcp.cloud-scheduler.result",
    "implementation": "MissionGcpCloudSchedulerConsumer",
    "missionBound": true,
    "projectBound": true,
    "workProductBound": true,
    "observesEvidence": true,
    "adoptsOutcome": false,
    "truthAuthority": false,
    "kernelAuthority": false,
    "connected": false,
    "native": false
  },
  "scope": {
    "required": [
      "gcpProject",
      "location",
      "job",
      "schedule",
      "target",
      "missionAndRevision",
      "projectAndRevision",
      "workProductAndRevision",
      "permissionDigest",
      "consentDigest"
    ],
    "secret": "opaque_non_serializing_oauth_or_service_account_reference",
    "jobIdentity": "retained_typed_id",
    "scheduleIdentity": "typed_expression_digest",
    "targetIdentity": "typed_kind_and_digest",
    "cursor": "opaque_digest_only",
    "rawArgumentRetention": false,
    "rawResultRetention": false,
    "rawTargetRetention": false
  },
  "permissions": {
    "allow": [
      "cloudscheduler.jobs.list",
      "cloudscheduler.jobs.get"
    ],
    "deny": [
      "cloudscheduler.jobs.create",
      "cloudscheduler.jobs.delete",
      "cloudscheduler.jobs.patch",
      "cloudscheduler.jobs.pause",
      "cloudscheduler.jobs.resume",
      "cloudscheduler.jobs.run",
      "target_invoke",
      "raw_target_read",
      "raw_header_read",
      "raw_body_read"
    ],
    "leastPrivilege": true,
    "externalWrites": false
  },
  "bounds": {
    "maxPageSize": 100,
    "maxPages": 16,
    "maxJobs": 500,
    "maxIdentifierBytes": 256,
    "maxScheduleBytes": 512,
    "maxOpaqueCursorBytes": 4096,
    "maxResponseBytes": 1048576,
    "maxDigestInputBytes": 32768
  },
  "evidence": {
    "bounded": true,
    "project": true,
    "location": true,
    "jobIdentity": true,
    "schedule": true,
    "targetKind": true,
    "targetDigest": true,
    "state": true,
    "resourceRevision": true,
    "pagination": true,
    "redactedStatus": true,
    "rawTarget": false,
    "rawHeaders": false,
    "rawBodies": false,
    "rawProviderDiagnostics": false,
    "states": [
      "complete",
      "partial",
      "stale",
      "access_lost",
      "not_found",
      "conflict",
      "rate_limited",
      "timeout",
      "provider_unknown"
    ]
  },
  "registration": {
    "boundDigests": [
      "schemaVersion",
      "contractVersion",
      "pluginVersion",
      "versionDigest",
      "contractDigest",
      "providerId",
      "providerVersion",
      "providerRevision",
      "providerDigest",
      "permissionDigest",
      "scopeDigest",
      "scheduleDigest",
      "targetDigest",
      "evidencePolicyDigest",
      "secretReferenceDigest",
      "credentialRevision"
    ],
    "reversible": true,
    "revocable": true,
    "rotationOnStateChange": true,
    "failClosedOnDrift": true
  },
  "transport": {
    "fixture": true,
    "recording": true,
    "loopback": true,
    "blockedEnv": true,
    "connected": false,
    "native": false,
    "firstParty": false,
    "safeBackoff": true,
    "timeoutIsUnknown": true
  },
  "authority": {
    "externalWrites": false,
    "jobCreation": false,
    "jobDeletion": false,
    "jobPatching": false,
    "jobPausing": false,
    "jobResuming": false,
    "jobRunning": false,
    "targetInvocation": false,
    "rawTarget": false,
    "rawHeaders": false,
    "rawBodies": false,
    "connected": false,
    "nativeProvider": false,
    "credentialResolution": false,
    "durableNativeReceipt": false,
    "independentNativeReadback": false,
    "verificationAuthority": false,
    "kernelOutcomeAdoption": false,
    "workProductAdoption": false
  },
  "nativeGap": {
    "status": "BLOCKED_ENV",
    "deferredTo": "layer_2_native_google_oauth_https_receipt_and_independent_readback",
    "failClosedCases": [
      "missing_google_auth_authority",
      "revoked_secret_reference",
      "api_version_drift",
      "project_location_job_scope_drift",
      "schedule_or_target_scope_drift",
      "mission_project_work_product_revision_drift",
      "permission_drift",
      "opaque_cursor_drift_or_loop",
      "partial_or_truncated_response",
      "raw_target_request",
      "create_delete_patch_pause_resume_run_or_invoke_request",
      "provider_timeout",
      "tampered_record",
      "registration_revocation"
    ]
  },
  "layer2Gaps": [
    "native_oauth_or_service_account_resolution",
    "native_https_transport",
    "durable_provider_receipt",
    "independent_terminal_readback",
    "consented_scheduler_effects",
    "kernel_outcome_adoption"
  ],
  "honestNativeGap": "Layer 1 only prepares and verifies bounded, typed, redacted jobs.list/jobs.get evidence from fixture, recording, loopback, or BLOCKED_ENV provenance. It never resolves live credentials, calls Google Cloud, reports Connected/native/first-party, retains raw targets, headers, bodies, or provider diagnostics, creates/deletes/patches/pauses/resumes/runs jobs, invokes targets, or adopts a kernel Outcome."
}
