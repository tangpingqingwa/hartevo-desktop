{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hartevo.local/contracts/plugins/canny-feedback-result/canny-feedback-result.v1.json",
  "schemaVersion": "hartevo-canny-feedback-result-contract/v1",
  "contractVersion": "canny-feedback-result-e1/v1",
  "evidenceLevel": "E1",
  "layer": 1,
  "service": {
    "id": "canny.feedback.result",
    "version": "1.0.0",
    "operation": "bounded_feedback_evidence_read_proposal",
    "readOnly": true,
    "proposalOnly": true,
    "liveExecution": false,
    "externalWrites": false
  },
  "provider": {
    "id": "canny.feedback.read",
    "version": "1.0.0",
    "origin": "https://canny.io",
    "method": "POST",
    "paths": [
      "/api/v1/boards/list",
      "/api/v1/boards/retrieve",
      "/api/v1/categories/list",
      "/api/v1/categories/retrieve",
      "/api/v1/posts/list",
      "/api/v1/posts/retrieve",
      "/api/v2/comments/list",
      "/api/v2/votes/list",
      "/api/v2/status_changes/list"
    ],
    "allowlistedOperations": [
      "board.read",
      "post.read",
      "comment.read",
      "vote.aggregate.read",
      "status.read",
      "category.read",
      "roadmap.read_from_post"
    ],
    "acceptedProvenance": ["fixture", "recording", "fake", "loopback", "blocked_env"],
    "native": false,
    "connected": false,
    "httpsTransport": false,
    "firstParty": false,
    "readback": false,
    "writes": false
  },
  "consumer": {
    "id": "mission.canny.feedback.result.consumer",
    "adoptsWorkProduct": false,
    "truthAuthority": false,
    "connected": false,
    "nativeProvider": false
  },
  "scope": {
    "required": [
      "project",
      "workspace",
      "board",
      "post",
      "comment",
      "voteWindow",
      "statusAllowlist",
      "categoryAllowlist",
      "roadmap",
      "mission",
      "workProduct",
      "privacyPolicy"
    ],
    "revisionsRequired": true,
    "secret": "opaque_api_key_reference_only"
  },
  "limits": {
    "maxWindowDays": 31,
    "maxBoards": 1,
    "maxPosts": 128,
    "maxComments": 256,
    "maxVoteAggregates": 128,
    "maxStatuses": 64,
    "maxCategories": 64,
    "maxRoadmaps": 32,
    "maxResponseBytes": 262144,
    "maxRequestsPerScopePerUtcHour": 60,
    "singlePage": true,
    "aggregateVotesOnly": true
  },
  "privacyPolicy": {
    "version": "canny-feedback-privacy/v1",
    "requiredRedactions": [
      "raw_api_body",
      "api_key",
      "comment_body",
      "author_identity",
      "voter_identity",
      "user_pii",
      "urls",
      "tokens",
      "jira_or_project_links"
    ],
    "retained": [
      "bounded_object_digests",
      "allowlisted_statuses",
      "aggregate_vote_counts",
      "bounded_counts",
      "response_and_evidence_digests",
      "redaction_summary"
    ]
  },
  "states": [
    "open",
    "planned",
    "complete",
    "duplicate",
    "unknown",
    "partial",
    "access_lost",
    "denied",
    "rate_limited",
    "provider_unknown",
    "tampered"
  ],
  "registration": {
    "versionBound": true,
    "contractDigestBound": true,
    "providerDigestBound": true,
    "scopeDigestBound": true,
    "projectBound": true,
    "workspaceBound": true,
    "boardBound": true,
    "postBound": true,
    "commentBound": true,
    "voteWindowBound": true,
    "statusBound": true,
    "categoryBound": true,
    "roadmapBound": true,
    "missionRevisionBound": true,
    "workProductRevisionBound": true,
    "evidenceDigestBound": true,
    "idempotencyBound": true,
    "reversible": true,
    "revocable": true,
    "failClosed": true
  },
  "forbidden": [
    "post_write",
    "comment_write",
    "vote_write",
    "status_write",
    "category_write",
    "raw_feedback_retention",
    "comment_body_retention",
    "user_pii_retention",
    "author_or_voter_identity",
    "user_lookup",
    "jira_synchronization",
    "project_mutation",
    "causal_demand_claim",
    "validated_demand_claim",
    "work_product_adoption",
    "outcome_authority",
    "truth_authority"
  ],
  "nativeClaims": {
    "connected": false,
    "nativeProvider": false,
    "httpsTransport": false,
    "firstParty": false,
    "durableReceipt": false,
    "readback": false,
    "adoptedWorkProduct": false,
    "adoptedOutcome": false,
    "blockedEnvironmentIsNative": false
  },
  "layer2Gaps": [
    "native_opaque_secret_resolution",
    "native_canny_api_key_resolution",
    "native_https_read_execution",
    "durable_provider_receipt",
    "independent_reread_and_reconciliation",
    "consented_feedback_effects",
    "verified_work_product_adoption",
    "kernel_outcome_or_truth_authority"
  ]
}
