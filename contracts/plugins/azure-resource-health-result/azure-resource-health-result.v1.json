{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hartevo.local/contracts/plugins/azure-resource-health-result/azure-resource-health-result.v1.json",
  "title": "Hartevo governed Azure Resource Health result Layer-1 contract",
  "description": "Bounded Azure Resource Health availability and event evidence for a Mission decision; never a recovery, causality, support, mutation, or Outcome authority.",
  "schemaVersion": "hartevo.azure-resource-health-result/v1",
  "contractVersion": "azure-resource-health-result-e1/v1",
  "pluginVersion": "1.0.0",
  "layer": 1,
  "authority": {
    "readOnly": true,
    "proposalOnly": true,
    "connected": false,
    "nativeProvider": false,
    "durableProviderReceipt": false,
    "independentReadback": false,
    "verificationAuthority": false,
    "causalAuthority": false,
    "recoveryAuthority": false,
    "externalWrites": false,
    "supportCaseAuthority": false,
    "outcomeAuthority": false,
    "kernelAuthority": false,
    "healthMutation": false
  },
  "typedSurface": {
    "service": "AzureResourceHealthService",
    "provider": "AzureResourceHealthProvider",
    "consumer": "MissionAzureResourceHealthConsumer",
    "models": [
      "AzureResourceHealthScope",
      "EventWindow",
      "PermissionFence",
      "SecretReference",
      "AzureResourceHealthRegistration",
      "AvailabilityObservation",
      "ResourceHealthEventSummary",
      "AzureResourceHealthEvidence",
      "AzureResourceHealthProposal",
      "AzureResourceHealthRecord",
      "AzureResourceHealthVerification"
    ]
  },
  "service": {
    "id": "azure.resource-health.result",
    "name": "AzureResourceHealthService",
    "version": "1.0.0",
    "access": "read_only",
    "operations": [
      "register",
      "read_availability_status",
      "read_event_list",
      "propose",
      "record",
      "verify",
      "revoke_registration",
      "restore_registration"
    ],
    "externalWrites": false,
    "liveExternalIo": false
  },
  "provider": {
    "id": "azure.resource-health.management",
    "name": "AzureResourceHealthProvider",
    "version": "1.0.0",
    "apiVersion": "2025-05-01",
    "apiRevision": "azure-resource-health-rest-2025-05-01",
    "origin": "https://management.azure.com",
    "allowlistedGetPaths": [
      "/{resourceUri}/providers/Microsoft.ResourceHealth/availabilityStatuses/current",
      "/{resourceUri}/providers/Microsoft.ResourceHealth/events"
    ],
    "permissions": [
      "Microsoft.ResourceHealth/availabilityStatuses/read",
      "Microsoft.ResourceHealth/events/read"
    ],
    "authentication": ["opaque_non_serializing_entra_secret_reference"],
    "transportProvenance": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
    "nativeHttps": false,
    "nativeEntraResolution": false,
    "connected": false,
    "rawRequestBody": false,
    "rawResponseBody": false,
    "rawDescriptions": false,
    "rawRecommendations": false,
    "rawTags": false,
    "rawTenantPii": false,
    "credentials": false,
    "externalWrites": false
  },
  "exactScope": [
    "tenant_digest",
    "subscription_id",
    "resource_id",
    "resource_revision",
    "region",
    "event_window",
    "project_id",
    "project_revision",
    "mission_id",
    "mission_revision",
    "work_product_id",
    "work_product_revision",
    "permission_digest"
  ],
  "consumer": {
    "id": "mission.azure.resource-health",
    "name": "MissionAzureResourceHealthConsumer",
    "kind": "mission_resource_health_projection",
    "adoptsOutcome": false,
    "kernelAuthority": false,
    "truthAuthority": false,
    "scopeBound": true,
    "replayProtected": true
  },
  "normalization": {
    "availabilityStatus": true,
    "statusTransitions": true,
    "eventIdentity": "sha256_digest",
    "affectedResources": "sha256_digest_only",
    "eventOrdering": "event_timestamp_then_event_identity",
    "eventWindowEnforced": true,
    "pagination": "opaque_cursor_digest_bound",
    "rawJson": false,
    "rawDescriptions": false,
    "rawRecommendations": false,
    "rawTags": false,
    "rawTenantPii": false,
    "outageCausality": false,
    "states": [
      "complete",
      "empty",
      "partial",
      "unknown",
      "access_lost",
      "not_found",
      "conflict",
      "throttled",
      "timed_out",
      "provider_unknown",
      "expired",
      "revoked"
    ]
  },
  "bounds": {
    "maxEventWindowDays": 31,
    "maxResponseBytes": 1048576,
    "maxEvents": 128,
    "maxAffectedResourceDigestsPerEvent": 32,
    "maxCursorBytes": 512,
    "maxIdentifierBytes": 256,
    "maxRegionBytes": 128
  },
  "digests": {
    "version": true,
    "contract": true,
    "provider": true,
    "api": true,
    "permission": true,
    "scope": true,
    "resource": true,
    "resourceRevision": true,
    "eventWindow": true,
    "secretReference": true,
    "registration": true,
    "availability": true,
    "events": true,
    "evidence": true,
    "proposal": true,
    "record": true,
    "verification": true
  },
  "registration": {
    "versionBound": true,
    "contractDigestBound": true,
    "providerDigestBound": true,
    "apiDigestBound": true,
    "permissionDigestBound": true,
    "resourceDigestBound": true,
    "resourceRevisionBound": true,
    "eventWindowDigestBound": true,
    "scopeDigestBound": true,
    "secretReferenceDigestBound": true,
    "evidenceDigestBound": true,
    "reversible": true,
    "revocable": true,
    "rotationOnStateChange": true,
    "failClosedOn": [
      "version_drift",
      "contract_drift",
      "provider_drift",
      "api_drift",
      "permission_drift",
      "tenant_drift",
      "subscription_drift",
      "resource_drift",
      "resource_revision_drift",
      "region_drift",
      "event_window_drift",
      "mission_stale",
      "work_product_drift",
      "cursor_drift",
      "evidence_tamper",
      "expiry",
      "registration_revocation",
      "replay"
    ]
  },
  "receipts": {
    "requestDigest": true,
    "requestPathAndQuery": true,
    "apiVersion": true,
    "responseStatus": true,
    "responseBytes": true,
    "responseDigest": true,
    "providerRevision": true,
    "cursorDigest": true,
    "rawHeaders": false,
    "rawResponseBody": false,
    "credentialMaterial": false,
    "durableNative": false
  },
  "forbidden": [
    "restart_resource",
    "redeploy_resource",
    "open_support_case",
    "mutate_health_state",
    "execute_provider_recommendation",
    "credential_resolution",
    "native_connected_claim",
    "outage_causality_claim",
    "recovery_guarantee_claim",
    "raw_description_retention",
    "raw_recommendation_retention",
    "raw_tag_retention",
    "raw_tenant_pii_retention",
    "unbounded_event_properties",
    "kernel_outcome_adoption"
  ],
  "nativeGap": {
    "status": "BLOCKED_ENV",
    "deferredTo": "layer_2_native_entra_https_receipt_readback_effect",
    "fixtureNative": false,
    "recordingNative": false,
    "loopbackNative": false,
    "blockedEnvNative": false,
    "fixtureConnected": false,
    "recordingConnected": false,
    "loopbackConnected": false,
    "blockedEnvConnected": false,
    "layer2Exits": [
      "native_entra_resolution",
      "native_https_transport",
      "durable_provider_receipt",
      "independent_status_readback",
      "consented_operational_effects"
    ]
  },
  "honesty": "Layer 1 is a bounded fixture/recording/loopback/BLOCKED_ENV evidence and proposal surface. It never claims Connected or native status, never retains provider narrative payloads or credentials, never mutates Azure health, never restarts or redeploys resources, never opens support cases, never executes recommendations, never asserts outage causality or recoverability, and never adopts kernel Outcome authority."
}
