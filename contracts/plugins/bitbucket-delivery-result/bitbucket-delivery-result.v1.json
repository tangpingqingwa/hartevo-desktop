{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hartevo.local/contracts/plugins/bitbucket-delivery-result/bitbucket-delivery-result.v1.json",
  "title": "Hartevo Bitbucket delivery-result Layer-1 contract",
  "description": "Bounded Bitbucket Cloud delivery evidence for a Mission decision; never a repository mutation, generic CI, source/diff/comment, artifact, or Outcome authority.",
  "schemaVersion": "hartevo.bitbucket-delivery-result-contract/v1",
  "contractVersion": "bitbucket-delivery-result/v1",
  "pluginVersion": "0.1.0",
  "layer": 1,
  "officialApi": "https://developer.atlassian.com/cloud/bitbucket/rest/",
  "authority": {
    "readOnly": true,
    "proposalOnly": true,
    "connected": false,
    "native": false,
    "firstParty": false,
    "durableReceipt": false,
    "independentReadback": false,
    "kernelAuthority": false,
    "outcomeAuthority": false,
    "genericCiAuthority": false,
    "externalWrites": false,
    "mergeAuthority": false,
    "approvalAuthority": false,
    "pipelineTriggerAuthority": false,
    "rawDiff": false,
    "rawComments": false,
    "rawArtifactBytes": false
  },
  "typedSurface": {
    "service": "BitbucketDeliveryResultService",
    "provider": "BitbucketProvider",
    "consumer": "MissionBitbucketDeliveryConsumer",
    "models": [
      "BitbucketDeliveryScope",
      "ProjectBinding",
      "MissionBinding",
      "WorkProductBinding",
      "SecretReference",
      "BitbucketRegistration",
      "BitbucketDeliveryEvidence",
      "DeliveryResultState",
      "BitbucketResponseReceipt"
    ]
  },
  "service": {
    "id": "bitbucket.delivery.result",
    "name": "BitbucketDeliveryResultService",
    "version": "1.0.0",
    "access": "read_only",
    "operations": [
      "describe_capabilities",
      "register",
      "revoke_registration",
      "read_repository",
      "read_pull_request",
      "read_commit_statuses",
      "read_pipeline",
      "read_deployment",
      "consume_observation"
    ],
    "externalWrites": false,
    "liveExternalIo": false,
    "genericCiAuthority": false
  },
  "provider": {
    "id": "bitbucket.cloud.delivery",
    "name": "BitbucketProvider",
    "version": "1.0.0",
    "apiRevision": "bitbucket-cloud-rest-2.0-r1",
    "officialApi": "https://developer.atlassian.com/cloud/bitbucket/rest/",
    "allowlistedGetPaths": [
      "/2.0/repositories/{workspace}/{repository}",
      "/2.0/repositories/{workspace}/{repository}/pullrequests/{pullRequestId}",
      "/2.0/repositories/{workspace}/{repository}/commit/{commit}/statuses",
      "/2.0/repositories/{workspace}/{repository}/pipelines/{pipelineUuid}",
      "/2.0/repositories/{workspace}/{repository}/deployments/{deploymentUuid}"
    ],
    "authentication": ["opaque_secret_reference"],
    "secretReferenceKinds": ["oauth", "api_token"],
    "transportProvenance": ["fixture", "recording", "fake", "loopback", "BLOCKED_ENV"],
    "maxRequestsPerMinute": 30,
    "maxResponseBytes": 1048576,
    "maxPages": 4,
    "pageSize": 50,
    "rawCredential": false,
    "rawRequestBody": false,
    "rawResponseBody": false,
    "rawDiff": false,
    "rawComments": false,
    "rawArtifactBytes": false,
    "native": false,
    "connected": false,
    "firstParty": false,
    "reversible": true,
    "revocable": true
  },
  "consumer": {
    "id": "mission.bitbucket-delivery-result",
    "name": "MissionBitbucketDeliveryConsumer",
    "kind": "mission_delivery_projection",
    "scope": [
      "workspace",
      "repository",
      "pull_request",
      "commit",
      "build",
      "pipeline",
      "deployment",
      "project",
      "mission",
      "work_product",
      "project_revision",
      "mission_revision",
      "work_product_revision",
      "repository_revision",
      "pull_request_revision",
      "pipeline_revision",
      "deployment_revision",
      "source_evidence_digest"
    ],
    "adoptsWorkProduct": false,
    "adoptsOutcome": false,
    "kernelAuthority": false,
    "truthAuthority": false
  },
  "exactScope": [
    "workspace",
    "repository",
    "pull_request",
    "commit",
    "build",
    "pipeline",
    "deployment",
    "project",
    "mission",
    "work_product"
  ],
  "allowlist": {
    "reads": [
      {"operation": "repository", "method": "GET", "path": "/2.0/repositories/{workspace}/{repository}"},
      {"operation": "pull_request", "method": "GET", "path": "/2.0/repositories/{workspace}/{repository}/pullrequests/{pullRequestId}"},
      {"operation": "commit_statuses", "method": "GET", "path": "/2.0/repositories/{workspace}/{repository}/commit/{commit}/statuses", "paginated": true},
      {"operation": "pipeline", "method": "GET", "path": "/2.0/repositories/{workspace}/{repository}/pipelines/{pipelineUuid}"},
      {"operation": "deployment", "method": "GET", "path": "/2.0/repositories/{workspace}/{repository}/deployments/{deploymentUuid}"}
    ],
    "writes": [],
    "forbidden": [
      "approve_pull_request",
      "merge_pull_request",
      "decline_pull_request",
      "create_or_delete_repository",
      "branch_mutation",
      "pipeline_trigger",
      "pipeline_stop_or_retry",
      "deployment_trigger",
      "rollback",
      "raw_source",
      "raw_diff",
      "raw_comments",
      "raw_artifact_bytes",
      "generic_ci_authority",
      "kernel_receipt",
      "outcome_authority",
      "verified_work_product_adoption"
    ]
  },
  "authentication": {
    "boundary": "opaque non-serializing SecretReference",
    "kinds": ["oauth", "api_token"],
    "rawCredentialSerialized": false,
    "rawCredentialDebug": false,
    "rawCredentialRequest": false,
    "rawCredentialReceipt": false,
    "resolvedByLayer": 2
  },
  "bounds": {
    "maxIdentifierBytes": 256,
    "maxTitleBytes": 4096,
    "maxStatusRecords": 128,
    "maxDeployments": 8,
    "maxResponseBytes": 1048576,
    "maxPages": 4,
    "pageSize": 50,
    "maxRequestsPerMinute": 30,
    "maxRetryAfterSeconds": 3600,
    "maxDiagnosticBytes": 512
  },
  "normalization": {
    "repositoryMetadataOnly": true,
    "pullRequestMetadataOnly": true,
    "commitStatusesOnly": true,
    "pipelineMetadataOnly": true,
    "deploymentMetadataOnly": true,
    "responseOrderIndependent": true,
    "paginationToken": "opaque_digest_only",
    "revision": "bound_and_digest_only",
    "url": "digest_only",
    "rawProviderPayload": "dropped_after_normalization",
    "rawDiff": "dropped",
    "rawComments": "dropped",
    "rawArtifactBytes": "dropped"
  },
  "states": [
    "open",
    "merged",
    "declined",
    "failed",
    "partial",
    "denied",
    "rate_limit",
    "provider_unknown",
    "tamper"
  ],
  "registration": {
    "pluginVersionBound": true,
    "contractVersionBound": true,
    "contractDigestBound": true,
    "providerRevisionBound": true,
    "secretReferenceDigestBound": true,
    "workspaceBound": true,
    "repositoryBound": true,
    "pullRequestBound": true,
    "commitBound": true,
    "buildBound": true,
    "pipelineBound": true,
    "deploymentBound": true,
    "projectRevisionBound": true,
    "missionRevisionBound": true,
    "workProductRevisionBound": true,
    "scopeDigestBound": true,
    "idempotencyBound": true,
    "reversible": true,
    "revocable": true,
    "failClosedOnDrift": true
  },
  "receipts": {
    "requestPathAndQuery": true,
    "requestDigest": true,
    "apiRevision": true,
    "responseStatus": true,
    "responseSize": true,
    "responseDigest": true,
    "providerRevision": true,
    "pageTokenDigest": true,
    "retryAfterSeconds": true,
    "rawProviderPayload": false,
    "rawCredentialMaterial": false,
    "rawPaginationToken": false
  },
  "nativeGap": {
    "status": "BLOCKED_ENV",
    "connected": false,
    "native": false,
    "firstParty": false,
    "failClosedCases": [
      "missing_native_oauth_or_api_token_authority",
      "missing_native_access_token",
      "api_revision_drift",
      "scope_or_revision_drift",
      "raw_diff_comment_or_artifact_request",
      "external_write_request",
      "generic_ci_authority_request"
    ]
  },
  "honestLayer2Gaps": [
    "native_oauth_or_api_token_resolution",
    "native_https_get",
    "durable_provider_receipt",
    "independent_repeat_readback",
    "consented_merge_approval_trigger_or_rollback_effects",
    "verified_work_product_adoption",
    "verified_outcome_adoption"
  ]
}
