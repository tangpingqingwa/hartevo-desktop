{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tangpingqingwa/hartevo-desktop/contracts/plugins/github-dependabot-result/github-dependabot-result.v1.json",
  "title": "Hartevo GitHub Dependabot security-result Layer-1 contract",
  "description": "A bounded, read/proposal/record/verify-only seam from GitHub Dependabot alerts to a Mission supply-chain decision. It is not a remediation engine, dependency graph exporter, advisory-content store, certification authority, or Hartevo Truth authority.",
  "schemaVersion": "hartevo.github-dependabot-result.contract/v1",
  "contractVersion": "github-dependabot-result/v1",
  "pluginVersion": "1.0.0",
  "layer": "Layer-1",
  "evidenceLevel": "E1",
  "officialReferences": [
    "https://docs.github.com/en/rest/dependabot/alerts?apiVersion=2026-03-10",
    "https://docs.github.com/en/rest/dependabot/alerts#list-dependabot-alerts-for-a-repository",
    "https://docs.github.com/en/rest/dependabot/alerts#get-a-single-dependabot-alert"
  ],
  "service": {
    "id": "hartevo.github.dependabot.result",
    "implementation": "GithubDependabotResultService",
    "version": "1.0.0",
    "operations": [
      "describe_capabilities",
      "register",
      "revoke_registration",
      "read_bounded",
      "propose",
      "record",
      "verify"
    ],
    "readOnly": true,
    "proposalOnly": true,
    "liveExecution": false
  },
  "provider": {
    "id": "github.dependabot",
    "implementation": "GithubDependabotProvider",
    "version": "1.0.0",
    "apiRevision": "github-dependabot-read-r1",
    "allowlistedOperations": [
      "GET /repos/{owner}/{repo}/dependabot/alerts",
      "GET /repos/{owner}/{repo}/dependabot/alerts/{alert_number}"
    ],
    "allowlistedMethods": ["GET"],
    "acceptedTransports": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
    "native": false,
    "connected": false,
    "firstParty": false,
    "externalWrites": false,
    "appOrOAuthSecret": "opaque_non_serializing_secret_reference_only",
    "etag304": true
  },
  "consumer": {
    "id": "mission.github.dependabot.result",
    "implementation": "MissionGithubDependabotConsumer",
    "version": "1.0.0",
    "deploymentBound": true,
    "missionBound": true,
    "projectBound": true,
    "workProductBound": true,
    "repositoryBound": true,
    "refBound": true,
    "commitBound": true,
    "alertRevisionBound": true,
    "permissionBound": true,
    "producesDecisionProposal": true,
    "adoptsOutcome": false,
    "truthAuthority": false,
    "certificationAuthority": false
  },
  "scope": {
    "required": [
      "deployment_id_and_revision",
      "project_id_and_revision",
      "mission_id_and_revision",
      "work_product_id_and_revision",
      "exact_repository_owner_and_name",
      "exact_ref",
      "exact_commit_sha",
      "alert_number_and_revision_allowlist",
      "package_ecosystem_allowlist",
      "package_digest_allowlist",
      "dependency_digest_allowlist",
      "manifest_path_digest_allowlist",
      "permission_digest",
      "secret_reference_digest",
      "scope_digest"
    ],
    "providerScope": "exact_repository_ref_commit_alert_number_ecosystem_manifest_package_mission_project_work_product",
    "secret": "opaque_non_serializing_github_app_or_oauth_reference_only",
    "rawDescriptions": false,
    "rawManifestPaths": false,
    "rawPackageNames": false,
    "rawProviderPayload": false
  },
  "registration": {
    "pluginVersionBound": true,
    "providerIdBound": true,
    "providerVersionBound": true,
    "providerRevisionBound": true,
    "providerDigestBound": true,
    "apiDigestBound": true,
    "contractVersionBound": true,
    "contractDigestBound": true,
    "permissionDigestBound": true,
    "scopeDigestBound": true,
    "evidenceDigestBound": true,
    "secretReferenceDigestBound": true,
    "reversible": true,
    "revocable": true,
    "failClosedOn": [
      "plugin_version_drift",
      "provider_or_api_revision_drift",
      "provider_or_contract_digest_drift",
      "permission_or_scope_digest_drift",
      "evidence_digest_drift",
      "secret_reference_drift",
      "registration_tamper",
      "registration_revocation",
      "repository_ref_commit_drift",
      "alert_revision_drift",
      "cursor_or_filter_replay"
    ]
  },
  "bounds": {
    "maxResponseBytes": 1048576,
    "maxPages": 4,
    "pageSize": 50,
    "maxAlerts": 256,
    "maxRequestsPerRead": 6,
    "maxRetries": 2,
    "maxIdentifierBytes": 128,
    "maxProviderErrors": 8
  },
  "filters": {
    "states": ["open", "fixed", "dismissed", "auto_dismissed"],
    "severities": ["low", "moderate", "high", "critical"],
    "packageEcosystems": "explicit_allowlist",
    "packageDigests": "optional_bounded_allowlist"
  },
  "evidence": {
    "states": [
      "open",
      "fixed",
      "dismissed",
      "auto_dismissed",
      "insufficient_data",
      "partial",
      "access_loss",
      "provider_unknown",
      "not_modified"
    ],
    "digests": [
      "plugin_version",
      "provider",
      "api",
      "contract",
      "permission",
      "scope",
      "repository",
      "ref",
      "commit",
      "alert",
      "dependency",
      "package",
      "manifest",
      "evidence",
      "proposal",
      "record"
    ],
    "retained": [
      "alert_number",
      "alert_revision",
      "alert_state",
      "package_ecosystem",
      "package_digest",
      "manifest_digest",
      "advisory_identifiers",
      "severity",
      "cvss_summary",
      "epss_summary",
      "first_detected_at",
      "updated_at"
    ],
    "notRetained": [
      "raw_description",
      "raw_package_name",
      "raw_manifest_path",
      "raw_provider_payload",
      "raw_link_header",
      "credential_material",
      "remediation_instructions"
    ],
    "missingOrInsufficientDataFailsClosed": true
  },
  "redaction": {
    "secretMaterial": false,
    "rawCursor": false,
    "rawEtag": false,
    "rawProviderPayload": false,
    "descriptions": false,
    "packageNames": false,
    "manifestPaths": false,
    "errorMessages": false
  },
  "authority": {
    "readOnly": true,
    "proposalOnly": true,
    "externalWrites": false,
    "alertUpdate": false,
    "alertDismiss": false,
    "dependencyGraphExport": false,
    "remediation": false,
    "credentialResolution": false,
    "certification": false,
    "connected": false,
    "native": false,
    "firstParty": false,
    "durableReceipt": false,
    "verification": false,
    "kernelOutcomeAdoption": false,
    "mcp": false
  },
  "honesty": {
    "nativeStatus": "BLOCKED_ENV",
    "blockedEnvironmentIsNative": false,
    "fixtureIsNative": false,
    "recordingIsNative": false,
    "loopbackIsNative": false,
    "connectedClaim": false,
    "firstPartyClaim": false,
    "openAlertIsCertification": false,
    "layer1Boundary": "Layer 1 emits bounded Dependabot evidence and a Mission supply-chain decision proposal only. Native GitHub App/OAuth resolution, live HTTPS, durable provider receipts, independent reread/reconciliation, remediation effects and verified Work Product adoption remain Layer-2 host authority."
  },
  "layer2Gaps": [
    "native_github_app_or_oauth_resolution",
    "live_https_github_transport",
    "durable_provider_receipt",
    "independent_reread_and_reconciliation",
    "consented_alert_remediation_effects",
    "dependency_graph_export",
    "verified_work_product_adoption",
    "supply_chain_certification_authority"
  ],
  "forbidden": [
    "update_dependabot_alert",
    "dismiss_dependabot_alert",
    "reopen_dependabot_alert",
    "export_dependency_graph",
    "retain_raw_advisory_description",
    "retain_raw_manifest_or_package_name",
    "resolve_live_credentials",
    "claim_connected",
    "claim_native",
    "claim_first_party",
    "claim_supply_chain_certification",
    "adopt_kernel_outcome",
    "emit_remediation_instructions"
  ]
}
