{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tangpingqingwa/hartevo-desktop/contracts/plugins/aws-route53-health-result/aws-route53-health-result.v1.json",
  "title": "Hartevo AWS Route 53 health-check result Layer-1 contract",
  "description": "A bounded Route 53 health-check configuration and recent checker-observation read/proposal/record/verify seam. It is not DNS, failover, calculated-check mutation, uptime certification, or Hartevo kernel authority.",
  "schemaVersion": "hartevo.aws-route53-health-result.contract/v1",
  "contractVersion": "aws-route53-health-result/v1",
  "pluginVersion": "1.0.0",
  "layer": "Layer-1",
  "evidenceLevel": "L1_PROVIDER_CONTRACT",
  "officialReferences": [
    "https://docs.aws.amazon.com/Route53/latest/APIReference/API_ListHealthChecks.html",
    "https://docs.aws.amazon.com/Route53/latest/APIReference/API_GetHealthCheck.html",
    "https://docs.aws.amazon.com/Route53/latest/APIReference/API_GetHealthCheckStatus.html"
  ],
  "service": {
    "id": "hartevo.aws.route53.health-result",
    "implementation": "AwsRoute53HealthService",
    "version": "1.0.0",
    "operations": [
      "describe_capabilities",
      "register",
      "revoke_registration",
      "read_bounded",
      "propose",
      "record",
      "verify"
    ],
    "readOperations": ["ListHealthChecks", "GetHealthCheck", "GetHealthCheckStatus"],
    "readOnly": true,
    "proposalOnly": true,
    "liveExecution": false,
    "externalWrites": false
  },
  "provider": {
    "id": "aws.route53.health",
    "implementation": "AwsRoute53Provider",
    "version": "1.0.0",
    "apiRevision": "aws-route53-health-read-r1",
    "allowlistedOperations": ["ListHealthChecks", "GetHealthCheck", "GetHealthCheckStatus"],
    "allowlistedMethods": ["POST"],
    "acceptedTransports": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
    "native": false,
    "connected": false,
    "firstParty": false,
    "externalWrites": false,
    "sigV4Secret": "opaque_non_serializing_secret_reference_only",
    "rawResponseRetention": false
  },
  "consumer": {
    "id": "mission.aws.route53.health-result",
    "implementation": "MissionAwsRoute53Consumer",
    "version": "1.0.0",
    "deploymentBound": true,
    "missionBound": true,
    "projectBound": true,
    "workProductBound": true,
    "revisionBound": true,
    "permissionBound": true,
    "producesDecisionProposal": true,
    "adoptsOutcome": false,
    "truthAuthority": false,
    "certificationAuthority": false
  },
  "scope": {
    "required": [
      "deployment_id_and_revision",
      "mission_id_and_revision",
      "project_id_and_revision",
      "work_product_id_and_revision",
      "exact_aws_account_id",
      "exact_route53_health_check_id_and_revision",
      "endpoint_or_cloudwatch_alarm_fingerprint",
      "aws_region",
      "permission_digest",
      "sigv4_secret_reference_digest",
      "scope_digest"
    ],
    "target": "exactly_one_endpoint_or_cloudwatch_alarm_or_calculated_check",
    "calculatedChecks": "unsupported_and_non_adoptable",
    "rawEndpoint": false,
    "rawCloudWatchAlarm": false,
    "rawIpAddress": false,
    "rawDnsRecord": false,
    "rawCustomerData": false
  },
  "registration": {
    "pluginVersionBound": true,
    "providerIdBound": true,
    "providerVersionBound": true,
    "providerRevisionBound": true,
    "providerDigestBound": true,
    "apiDigestBound": true,
    "contractVersionBound": true,
    "contractDigestBound": true,
    "permissionDigestBound": true,
    "scopeDigestBound": true,
    "healthCheckRevisionBound": true,
    "secretReferenceDigestBound": true,
    "reversible": true,
    "revocable": true,
    "failClosedOn": [
      "plugin_version_drift",
      "provider_or_api_revision_drift",
      "provider_or_contract_digest_drift",
      "permission_or_scope_digest_drift",
      "health_check_revision_drift",
      "registration_tamper",
      "registration_revocation",
      "marker_or_request_replay",
      "pagination_loop",
      "partial_or_unknown_status",
      "access_loss",
      "throttle",
      "timeout",
      "calculated_check_unsupported"
    ]
  },
  "bounds": {
    "maxResponseBytes": 1048576,
    "maxPages": 4,
    "pageSize": 50,
    "maxHealthChecks": 256,
    "maxObservations": 256,
    "maxRequestsPerRead": 12,
    "maxRetries": 2,
    "maxMarkerBytes": 512,
    "maxIdentifierBytes": 128,
    "maxObservationWindowSeconds": 86400
  },
  "evidence": {
    "states": [
      "HEALTHY",
      "UNHEALTHY",
      "INSUFFICIENT_DATA",
      "UNSUPPORTED",
      "NOT_FOUND",
      "partial",
      "access_loss",
      "throttled",
      "timeout",
      "provider_unknown"
    ],
    "digests": [
      "plugin_version",
      "provider",
      "api",
      "contract",
      "permission",
      "scope",
      "health_check_config",
      "checker",
      "failure",
      "response",
      "evidence",
      "proposal",
      "record"
    ],
    "retained": [
      "health_check_id",
      "health_check_revision",
      "health_check_type",
      "configuration_fingerprint",
      "interval_seconds",
      "failure_threshold",
      "region_set",
      "observation_status",
      "checked_time",
      "bounded_checker_digest",
      "bounded_failure_digest"
    ],
    "notRetained": [
      "ip_address",
      "domain_name",
      "resource_path",
      "cloudwatch_alarm_name",
      "raw_next_marker",
      "raw_provider_response",
      "dns_records",
      "secret_material",
      "customer_payload"
    ],
    "recentObservationWindowRequired": true,
    "missingOrInsufficientDataFailsClosed": true
  },
  "redaction": {
    "secretMaterial": false,
    "rawNextMarker": false,
    "rawProviderResponse": false,
    "ipAddress": false,
    "domainName": false,
    "resourcePath": false,
    "cloudWatchAlarmName": false,
    "dnsRecords": false,
    "failureText": false
  },
  "authority": {
    "readOnly": true,
    "proposalOnly": true,
    "externalWrites": false,
    "healthCheckMutation": false,
    "calculatedCheckMutation": false,
    "dnsRecordMutation": false,
    "failoverMutation": false,
    "credentialResolution": false,
    "rawResponseRead": false,
    "certification": false,
    "connected": false,
    "native": false,
    "firstParty": false,
    "durableReceipt": false,
    "verification": false,
    "kernelTruth": false,
    "kernelConsent": false,
    "kernelEffect": false,
    "kernelOutcome": false,
    "workProductAdoption": false
  },
  "honesty": {
    "nativeStatus": "BLOCKED_ENV",
    "blockedEnvironmentIsNative": false,
    "fixtureIsNative": false,
    "recordingIsNative": false,
    "loopbackIsNative": false,
    "connectedIsFalseForEveryTransport": true,
    "firstPartyIsFalseForEveryTransport": true,
    "healthObservationIsNotUptimeCertification": true,
    "layer1Boundary": "Layer 1 emits bounded, redacted Route 53 evidence and a Mission review proposal only. Native SigV4/HTTPS, durable provider receipt, independent endpoint read-back, consented DNS effects, failover mutation and verified Work Product adoption remain Layer-2 host authority."
  },
  "layer2Gaps": [
    "native_sigv4_https_transport_and_credential_resolution",
    "durable_provider_receipt",
    "independent_endpoint_readback",
    "consented_dns_record_or_failover_effects",
    "calculated_check_support_and_mutation",
    "production_uptime_certification",
    "verified_work_product_adoption"
  ],
  "forbidden": [
    "create_health_check",
    "update_health_check",
    "delete_health_check",
    "update_health_check_region_failure_override",
    "mutate_calculated_health_check",
    "change_dns_record",
    "change_failover_policy",
    "read_or_export_raw_ip_address",
    "read_or_export_raw_endpoint",
    "read_or_export_raw_cloudwatch_alarm",
    "read_or_export_raw_dns_record",
    "serialize_raw_provider_response",
    "serialize_secret_material",
    "resolve_live_credentials",
    "claim_connected",
    "claim_native",
    "claim_first_party",
    "claim_uptime_certification",
    "adopt_kernel_truth_consent_effect_receipt_verification_or_outcome",
    "adopt_work_product"
  ]
}
