{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tangpingqingwa/hartevo-desktop/contracts/plugins/aws-ssm-automation-result/contract.v1.json",
  "title": "Hartevo AWS Systems Manager Automation result Layer-1 contract",
  "description": "A bounded AWS SSM Automation read/proposal/record/verify seam. It never starts or stops automation, sends commands, mutates parameters or targets, retains raw output/logs/secrets, or adopts a Hartevo Outcome.",
  "schemaVersion": "hartevo.aws-ssm-automation-result.contract/v1",
  "contractVersion": "EXT-AWS-SSM-AUTOMATION-01-L1/v1",
  "pluginVersion": "1.0.0",
  "layer": 1,
  "evidenceLevel": "L1_PROVIDER_CONTRACT",
  "digestInput": "hartevo.aws-ssm-automation-result.contract/v1|layer=1|service=aws.ssm.automation-result.read|provider=aws.ssm.automation-result.recording|consumer=mission.aws-ssm-automation.consumer",
  "contractDigest": "c8d16f142ef9acd8be16d59cdcc0aa15e521877fc63baafdcbc6fea5dd008f31",
  "service": {
    "type": "AwsSsmAutomationService",
    "id": "aws.ssm.automation-result.read",
    "access": "read_proposal_record_verify_recording",
    "operations": [
      "describe_capabilities",
      "register",
      "revoke_registration",
      "reverse_registration",
      "restore_registration",
      "read",
      "propose",
      "record",
      "verify"
    ],
    "boundAwsReads": [
      "DescribeAutomationExecutions",
      "GetAutomationExecution",
      "DescribeAutomationStepExecutions"
    ],
    "readOnly": true,
    "proposalOnly": true,
    "recordingOnly": true,
    "externalWrites": false,
    "kernelAuthority": false,
    "outcomeAdoption": false
  },
  "provider": {
    "type": "AwsSsmAutomationProvider",
    "id": "aws.ssm.automation-result.recording",
    "apiRevision": "ssm-describe-automation-executions-get-automation-execution-describe-step-executions-1",
    "allowlistedOperations": [
      "DescribeAutomationExecutions",
      "GetAutomationExecution",
      "DescribeAutomationStepExecutions"
    ],
    "allowlistedMethods": ["POST"],
    "acceptedTransports": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
    "authentication": {
      "scheme": "aws_sigv4",
      "secretReference": "opaque_non_serializing_only",
      "nativeResolution": false,
      "rawCredentialMaterial": false
    },
    "connected": false,
    "native": false,
    "firstParty": false,
    "durableProviderReceipt": false,
    "redactedOutputDigest": true,
    "redactedErrorDigest": true
  },
  "consumer": {
    "type": "MissionAwsSsmAutomationConsumer",
    "id": "mission.aws-ssm-automation.consumer",
    "authority": "mission_scoped_proposal_and_record_below_kernel",
    "scope": [
      "missionId",
      "missionRevision",
      "projectId",
      "projectRevision",
      "workProductId",
      "workProductRevision"
    ],
    "revisionBound": true,
    "permissionBound": true,
    "adoptsOutcome": false,
    "adoptsWorkProduct": false,
    "truthAuthority": false
  },
  "scope": {
    "required": [
      "awsAccountId",
      "awsRegion",
      "automationDocumentName",
      "automationDocumentVersion",
      "automationExecutionId",
      "automationStepNameOrAll",
      "targetSelectorOrAll",
      "missionId",
      "missionRevision",
      "projectId",
      "projectRevision",
      "workProductId",
      "workProductRevision",
      "permissionDigest",
      "scopeDigest",
      "secretReferenceDigest"
    ],
    "identifiersInEvidence": "typed_scope_or_digest_only",
    "rawOutput": false,
    "rawLogs": false,
    "rawErrorMessages": false,
    "rawParameters": false,
    "rawTargets": false,
    "maxPages": 4,
    "maxPageSize": 50,
    "maxResponseBytes": 1048576
  },
  "registration": {
    "version": "1.0.0",
    "reversible": true,
    "revocable": true,
    "activeStatuses": ["active"],
    "terminalStatuses": ["revoked"],
    "reversibleStatuses": ["reversed"],
    "binding": [
      "pluginVersion",
      "contractVersion",
      "contractDigest",
      "providerId",
      "providerVersion",
      "providerRevision",
      "providerDigest",
      "apiDigest",
      "permissionDigest",
      "scopeDigest",
      "secretReferenceDigest",
      "evidenceDigest",
      "registrationRevision"
    ],
    "failClosedOn": [
      "provider_or_api_revision_drift",
      "provider_or_contract_digest_drift",
      "permission_drift",
      "scope_drift",
      "secret_reference_drift",
      "registration_tamper",
      "cursor_or_filter_replay",
      "execution_replacement",
      "status_regression",
      "revocation"
    ],
    "permissions": [
      "ssm:DescribeAutomationExecutions",
      "ssm:GetAutomationExecution",
      "ssm:DescribeAutomationStepExecutions",
      "mission.scope"
    ]
  },
  "pagination": {
    "cursorOpaque": true,
    "cursorDigestOnly": true,
    "cursorBoundTo": [
      "account",
      "region",
      "document",
      "documentVersion",
      "execution",
      "step",
      "target",
      "filterDigest",
      "permissionDigest",
      "pageBudget"
    ],
    "filterDriftRejected": true,
    "invalidFilterTyped": true,
    "invalidNextTokenTyped": true,
    "partialPageIsNonAdoptable": true,
    "truncationIsNonAdoptable": true
  },
  "evidence": {
    "states": [
      "pending",
      "in_progress",
      "waiting",
      "success",
      "failed",
      "timed_out",
      "cancelling",
      "cancelled",
      "partial",
      "provider_unknown",
      "access_loss",
      "invalid_filter",
      "invalid_next_token",
      "throttled",
      "truncated",
      "execution_replaced",
      "registration_revoked"
    ],
    "requiredDigests": [
      "pluginVersionDigest",
      "contractDigest",
      "providerDigest",
      "apiDigest",
      "permissionDigest",
      "scopeDigest",
      "filterDigest",
      "cursorDigest",
      "executionDigest",
      "stepDigest",
      "outputDigest",
      "errorDigest",
      "evidenceDigest",
      "proposalDigest",
      "recordDigest"
    ],
    "executionReplacementRejected": true,
    "statusRegressionRejected": true,
    "accessLossIsNonAdoptable": true,
    "unknownIsNonAdoptable": true,
    "partialIsNonAdoptable": true,
    "tamperRejected": true,
    "revocationRejected": true
  },
  "redaction": {
    "secretMaterial": false,
    "rawNextToken": false,
    "rawOutput": false,
    "rawLogs": false,
    "rawErrorMessages": false,
    "rawParameters": false,
    "rawTargetValues": false,
    "providerPayload": false
  },
  "provenance": {
    "fixture": "non_connected_non_native_non_first_party",
    "recording": "non_connected_non_native_non_first_party",
    "loopback": "non_connected_non_native_non_first_party",
    "blockedEnv": "non_connected_non_native_non_first_party",
    "connectedClaim": false,
    "nativeClaim": false,
    "firstPartyClaim": false,
    "providerReceipt": false
  },
  "authorityBoundary": {
    "owns": [
      "typed account/region/document/version/execution/step/target/Mission/Project/Work Product scope",
      "bounded DescribeAutomationExecutions/GetAutomationExecution/DescribeAutomationStepExecutions seams",
      "status and step metadata projection",
      "opaque filter and cursor binding",
      "redacted output and error digests",
      "version/revision/permission/scope/evidence digest fences",
      "reversible registration",
      "proposal/record/verify below kernel authority"
    ],
    "doesNotOwn": [
      "Hartevo Truth",
      "Hartevo Effect",
      "Hartevo Receipt",
      "Hartevo Verification authority",
      "Hartevo Outcome",
      "live SigV4 credential resolution",
      "live AWS SSM HTTPS",
      "StartAutomationExecution",
      "StopAutomationExecution",
      "SendCommand",
      "automation parameter mutation",
      "automation target mutation",
      "raw output or logs",
      "raw secrets",
      "kernel Outcome adoption"
    ]
  },
  "forbidden": [
    "StartAutomationExecution",
    "StopAutomationExecution",
    "SendCommand",
    "UpdateDocument",
    "DeleteDocument",
    "automation_parameter_mutation",
    "automation_target_mutation",
    "raw_output_retention",
    "raw_log_retention",
    "secret_material_retention",
    "live_credential_resolution",
    "claim_connected",
    "claim_native",
    "claim_first_party",
    "adopt_kernel_outcome"
  ],
  "layer2Gaps": [
    "native SigV4 credential resolution",
    "live AWS SSM HTTPS",
    "durable provider receipt",
    "independent automation readback",
    "consented automation effects",
    "Connected/native/first-party evidence",
    "Hartevo Outcome or Work Product adoption"
  ],
  "honestNativeGap": "Native SigV4 resolution, live DescribeAutomationExecutions/GetAutomationExecution/DescribeAutomationStepExecutions HTTPS, durable provider receipts, independent readback, and any consented automation effect remain Layer-2 host work. Fixture, recording, loopback, and BLOCKED_ENV never claim Connected, native, or first-party evidence; a successful automation status is provider-state evidence only and is not a Hartevo Outcome."
}
