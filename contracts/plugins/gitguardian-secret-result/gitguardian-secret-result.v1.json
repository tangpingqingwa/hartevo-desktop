{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tangpingqingwa/hartevo-desktop/contracts/plugins/gitguardian-secret-result/gitguardian-secret-result.v1.json",
  "title": "Hartevo GitGuardian secret incident result Layer-1 contract",
  "description": "A bounded incident, occurrence, detector, and status read/proposal/record seam. It never retains secret material or occurrence content, mutates GitGuardian, or claims native or Connected authority.",
  "schemaVersion": "hartevo.gitguardian-secret-result/v1",
  "contractVersion": "gitguardian-secret-result-01-layer-1/v1",
  "pluginId": "gitguardian.secret-result",
  "pluginVersion": "0.1.0",
  "contractDigestInput": "hartevo.gitguardian-secret-result/v1|gitguardian-secret-result-01-layer-1/v1|gitguardian.secret-result|security.gitguardian.secret.result.read|gitguardian.secret-result.recording|mission.gitguardian-secret-result.consumer",
  "contractDigest": "e3374a631c20ce1ebf03027162ffb244795d44abc1653ad82580c6517b14c264",
  "layer": 1,
  "evidenceLevel": "L1_PROVIDER_CONTRACT",
  "officialReferences": [
    "https://api.gitguardian.com/docs",
    "https://docs.gitguardian.com/api-docs/authentication",
    "https://docs.gitguardian.com/api-docs/introduction"
  ],
  "service": {
    "type": "GitGuardianSecretResultService",
    "id": "security.gitguardian.secret.result.read",
    "access": "read_only",
    "operations": [
      "describe_capabilities",
      "register",
      "reverse_registration",
      "restore_registration",
      "revoke_registration",
      "list_incidents",
      "get_incident",
      "list_occurrences",
      "get_detector",
      "get_status",
      "compile_proposal",
      "record_proposal",
      "verify_recording"
    ],
    "readOnly": true,
    "proposalOnly": true,
    "liveExecution": false,
    "proposalsBelowKernel": true
  },
  "provider": {
    "type": "GitGuardianProvider",
    "id": "gitguardian.secret-result.recording",
    "version": "0.1.0",
    "apiRevision": "gitguardian-api-read-v1",
    "baseUrl": "https://api.gitguardian.com/v1",
    "allowedMethods": ["GET"],
    "allowedEndpoints": [
      "/v1/incidents/secrets",
      "/v1/incidents/secrets/{incident_id}",
      "/v1/occurrences/secrets",
      "/v1/secret_detectors/{detector_name}",
      "/v1/health"
    ],
    "locationHandling": "digest_only",
    "requiredQuery": {
      "explicitPagination": true,
      "boundedPerPage": true,
      "allowlistedFiltersOnly": true
    },
    "acceptedTransports": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
    "native": false,
    "connected": false,
    "firstParty": false,
    "externalWrites": false,
    "apiKeyOrServiceAccountSecret": "opaque_non_serializing_secret_reference_only",
    "mutations": {
      "revokeIncident": false,
      "resolveIncident": false,
      "ignoreIncident": false,
      "rotateSecret": false,
      "deleteOccurrence": false,
      "retrieveSecret": false,
      "exportOccurrenceContent": false,
      "complianceCertification": false
    },
    "httpClassification": {
      "unauthorized": 401,
      "forbidden": 403,
      "notFound": 404,
      "rateLimited": 429,
      "serviceUnavailable": 503,
      "timeout": true,
      "providerUnknown": true
    }
  },
  "consumer": {
    "type": "MissionGitGuardianSecretConsumer",
    "id": "mission.gitguardian-secret-result.consumer",
    "authority": "below-kernel-proposal-and-recording",
    "scope": [
      "workspaceId",
      "perimeterId",
      "incidentId",
      "occurrenceId",
      "detectorId",
      "repository",
      "commit",
      "projectId",
      "projectRevision",
      "missionId",
      "missionRevision",
      "workProductId",
      "workProductRevision"
    ],
    "producesDecisionProposal": true,
    "adoptsKernelOutcome": false,
    "truthAuthority": false,
    "certificationAuthority": false
  },
  "credentials": {
    "boundary": "opaque non-serializing SecretReference",
    "acceptedKinds": ["api_key", "service_account"],
    "serialized": false,
    "rawMaterialAccepted": false,
    "resolvedByLayer": 2
  },
  "permissions": {
    "required": ["incidents:read", "occurrences:read", "detectors:read", "status:read"],
    "writePermissions": false,
    "credentialResolution": "Layer-2"
  },
  "scope": {
    "required": [
      "workspaceId",
      "perimeterId",
      "incidentId",
      "occurrenceId",
      "detectorId",
      "repository",
      "commit",
      "projectId",
      "projectRevision",
      "missionId",
      "missionRevision",
      "workProductId",
      "workProductRevision",
      "permissionDigest",
      "queryDigest",
      "evidencePolicyDigest"
    ],
    "registrationBinding": [
      "pluginVersion",
      "contractVersion",
      "contractDigest",
      "providerDigest",
      "apiDigest",
      "permissionDigest",
      "scopeDigest",
      "queryDigest",
      "evidencePolicyDigest",
      "evidenceDigest",
      "secretReferenceDigest",
      "registrationRevision"
    ],
    "rawSecret": false,
    "rawOccurrenceContent": false,
    "rawProviderPayload": false
  },
  "query": {
    "explicitPagination": true,
    "allowlistedStatuses": ["TRIGGERED", "ASSIGNED", "RESOLVED", "IGNORED", "UNKNOWN"],
    "allowlistedFilters": ["status", "severity", "validity", "incident_id", "detector_digest"],
    "cursor": "opaque_digest_only"
  },
  "registration": {
    "reversible": true,
    "revocable": true,
    "activeStatuses": ["active"],
    "reversedStatuses": ["reversed"],
    "terminalStatuses": ["revoked"],
    "failClosedOn": [
      "workspace_or_perimeter_drift",
      "incident_or_occurrence_drift",
      "detector_repository_commit_drift",
      "permission_drift",
      "plugin_or_contract_drift",
      "provider_or_api_revision_drift",
      "scope_or_query_digest_drift",
      "evidence_digest_drift",
      "secret_reference_drift",
      "registration_tamper",
      "registration_revocation",
      "cursor_loop",
      "partial_evidence",
      "access_loss",
      "rate_limit"
    ]
  },
  "bounds": {
    "maxResponseBytes": 1048576,
    "maxPages": 16,
    "pageSize": 50,
    "maxIncidents": 64,
    "maxOccurrences": 128,
    "maxDetectors": 64,
    "maxRequestsPerRead": 8,
    "maxProviderErrors": 8,
    "maxIdentifierBytes": 256
  },
  "evidence": {
    "projected": [
      "incidentId",
      "incidentStatus",
      "severity",
      "validity",
      "occurrenceId",
      "occurrenceStatus",
      "presence",
      "detectorDigest",
      "workspaceDigest",
      "perimeterDigest",
      "repositoryDigest",
      "commitDigest",
      "redactedRequestReceipts",
      "redactedRateReceipts",
      "evidenceDigest"
    ],
    "notRetained": [
      "literalSecret",
      "apiKeyValue",
      "serviceAccountMaterial",
      "occurrenceContent",
      "rawCommitPath",
      "rawProviderPayload",
      "rawAuthorizationHeader",
      "rawCursor",
      "complianceCertification"
    ],
    "missingOrInsufficientDataFailsClosed": true
  },
  "provenance": {
    "fixture": "non_native_non_connected_non_first_party",
    "recording": "non_native_non_connected_non_first_party",
    "loopback": "non_native_non_connected_non_first_party",
    "BLOCKED_ENV": "non_native_non_connected_non_first_party",
    "connectedClaim": false,
    "nativeClaim": false,
    "firstPartyClaim": false,
    "durableProviderReceipt": false
  },
  "authorityBoundary": {
    "owns": [
      "typed GitGuardian incident/occurrence/detector/status reads",
      "bounded allowlisted GET request construction",
      "opaque API-key/service-account SecretReference shape",
      "redacted digest-only evidence projection",
      "reversible and revocable digest-bound registration",
      "local proposal and recording integrity checks"
    ],
    "doesNotOwn": [
      "Hartevo Truth",
      "Hartevo Consent",
      "Hartevo Effect",
      "Hartevo Receipt",
      "Hartevo Verification",
      "Hartevo Outcome",
      "native credential resolution",
      "live HTTPS execution",
      "incident revoke/resolve/ignore effects",
      "secret rotate or delete effects",
      "raw occurrence or source-content export",
      "compliance certification"
    ]
  },
  "honestNativeGap": "Native API-key/service-account resolution, live GitGuardian transport, durable provider receipts, independent reread/reconciliation, consented remediation effects, compliance certification, and verified Work Product adoption remain Layer-2 work. Fixture, recording, loopback, and BLOCKED_ENV never claim Connected, native, or first-party evidence.",
  "layer2Gaps": [
    "native_api_key_or_service_account_resolution",
    "live_https_gitguardian_transport",
    "durable_provider_receipt",
    "independent_incident_occurrence_detector_reread",
    "consented_incident_revoke_resolve_ignore_effect",
    "secret_rotate_or_delete_effect",
    "raw_occurrence_content_export",
    "compliance_certification_authority",
    "verified_work_product_adoption"
  ],
  "forbidden": [
    "revoke_incident",
    "resolve_incident",
    "ignore_incident",
    "rotate_secret",
    "delete_occurrence",
    "retrieve_secret",
    "export_occurrence_content",
    "retain_raw_provider_payload",
    "claim_connected",
    "claim_native",
    "claim_first_party",
    "claim_compliance_certification",
    "adopt_kernel_outcome"
  ]
}
