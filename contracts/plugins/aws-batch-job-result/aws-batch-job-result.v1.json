{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hartevo.local/contracts/plugins/aws-batch-job-result/aws-batch-job-result.v1.json",
  "schemaVersion": "hartevo.aws-batch-job-result-contract/v1",
  "contractVersion": "aws-batch-job-result/v1",
  "pluginVersion": "1.0.0",
  "layer": 1,
  "service": {
    "id": "aws.batch.job-result",
    "implementation": "AwsBatchJobResultService",
    "version": "1.0.0",
    "access": "read_only",
    "operations": [
      "describe_capabilities",
      "register",
      "revoke_registration",
      "read_describe_jobs",
      "read_list_jobs",
      "read_array_children",
      "read_mnp_nodes",
      "propose",
      "record",
      "verify"
    ],
    "arbitraryQuery": false,
    "liveExecution": false,
    "outcomeAuthority": false
  },
  "provider": {
    "id": "aws.batch.jobs",
    "implementation": "AwsBatchProvider",
    "version": "1.0.0",
    "apiVersion": "2016-08-10",
    "apiOperations": ["DescribeJobs", "ListJobs"],
    "iamPermissions": ["batch:DescribeJobs", "batch:ListJobs"],
    "acceptedProvenance": ["fixture", "recording", "loopback", "blocked_env"],
    "native": false,
    "connected": false,
    "liveCredentialResolution": false,
    "externalWrites": false,
    "mutationOperations": ["SubmitJob", "CancelJob", "TerminateJob", "UpdateJobQueue", "RegisterJobDefinition", "DeregisterJobDefinition"]
  },
  "consumer": {
    "id": "mission.aws-batch-job-result",
    "implementation": "MissionAwsBatchConsumer",
    "version": "1.0.0",
    "missionBound": true,
    "projectBound": true,
    "workProductBound": true,
    "adoptsOutcome": false,
    "truthAuthority": false,
    "workloadCorrectnessAuthority": false,
    "durableReceiptAuthority": false
  },
  "scope": {
    "required": [
      "awsAccountId",
      "awsRegion",
      "jobQueueId",
      "jobDefinitionId",
      "jobId",
      "arrayJobId",
      "multiNodeJobId",
      "attempt",
      "projectId",
      "projectRevision",
      "missionId",
      "missionRevision",
      "workProductId",
      "workProductRevision",
      "permissionDigest"
    ],
    "fences": ["account", "region", "job_queue", "job_definition", "job", "array_job", "multi_node_job", "attempt", "project", "mission", "work_product"],
    "secret": "opaque_non_serializing_sigv4_secret_reference_only"
  },
  "digests": {
    "required": [
      "pluginVersion",
      "contractVersion",
      "contractDigest",
      "providerDigest",
      "apiDigest",
      "permissionDigest",
      "scopeDigest",
      "jobDigest",
      "attemptDigest",
      "evidenceDigest",
      "registrationDigest"
    ],
    "secretMaterialExcluded": true,
    "pageTokensOpaque": true
  },
  "evidence": {
    "operations": ["DescribeJobs", "ListJobs"],
    "describeJobsMaxIds": 100,
    "maxPages": 4,
    "maxPageSize": 100,
    "maxJobs": 400,
    "maxChildrenPerProjection": 400,
    "maxAttemptsPerJob": 16,
    "statuses": ["SUBMITTED", "PENDING", "RUNNABLE", "STARTING", "RUNNING", "SUCCEEDED", "FAILED", "UNKNOWN"],
    "retained": ["job_identifiers", "bounded_status", "bounded_timestamps", "attempt_summaries", "exit_code_summaries", "container_metadata_digest", "artifact_metadata_digest"],
    "redacted": ["command_arguments", "environment", "logs", "container_images", "data_outputs", "raw_provider_payload", "credentials"],
    "statusesOfEvidence": ["complete", "partial", "access_lost"],
    "readProposalRecordVerify": true,
    "redactedReceipts": true,
    "independentNativeReadback": false
  },
  "registration": {
    "versionBound": true,
    "contractDigestBound": true,
    "providerDigestBound": true,
    "apiDigestBound": true,
    "permissionDigestBound": true,
    "scopeDigestBound": true,
    "jobDigestBound": true,
    "attemptDigestBound": true,
    "evidenceDigestBound": true,
    "reversible": true,
    "revocable": true,
    "failClosedOnDrift": true
  },
  "authority": {
    "readOnly": true,
    "externalWrites": false,
    "connected": false,
    "nativeProvider": false,
    "liveCredentialResolution": false,
    "rawCommandArguments": false,
    "rawEnvironment": false,
    "rawLogs": false,
    "rawImages": false,
    "rawDataOutputs": false,
    "durableProviderReceipt": false,
    "independentOutputReadback": false,
    "verificationAuthority": false,
    "workloadCorrectnessAuthority": false,
    "outcomeAuthority": false,
    "workProductAdoption": false,
    "blockedEnvironmentIsNative": false
  },
  "transport": {
    "fixture": true,
    "recording": true,
    "loopback": true,
    "blockedEnv": true,
    "productionRead": false,
    "nativeSigV4": false,
    "rawRequestsRetained": false,
    "rawResponsesRetained": false,
    "rawSecretsRetained": false
  },
  "nativeGap": {
    "status": "BLOCKED_ENV",
    "deferredTo": "layer_2_native_sigv4_connected_authority_and_independent_readback",
    "failClosedCases": [
      "missing_native_sigv4_authority",
      "missing_live_credential_resolver",
      "contract_provider_api_version_drift",
      "permission_scope_job_or_attempt_drift",
      "opaque_pagination_binding_drift",
      "unknown_or_malformed_status",
      "partial_or_access_lost_evidence",
      "tampered_evidence",
      "revoked_registration",
      "submit_cancel_terminate_request",
      "queue_or_definition_mutation_request",
      "raw_command_environment_log_image_or_output_request"
    ]
  },
  "honestNativeGap": "Layer 1 supplies bounded normalized AWS Batch execution evidence and read/proposal/record/verify seams through fixture, recording, loopback, or BLOCKED_ENV transports. It does not submit, cancel, terminate, mutate queues or job definitions, resolve SigV4 credentials, claim Connected/native status, retain raw command arguments, environment, logs, images, or data outputs, issue durable provider receipts, independently read back outputs, assert workload correctness, or adopt a Work Product outcome."
}
