{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hartevo.local/contracts/plugins/pendo-product-usage-result/pendo-product-usage-result.v1.json",
  "title": "Hartevo Pendo product-usage result Layer-1 contract",
  "description": "Bounded aggregate-only Pendo page, feature, and guide adoption evidence for a Mission decision; not visitor telemetry, PII, mutation, causality, Truth, or Outcome authority.",
  "schemaVersion": "hartevo.pendo-product-usage-result/v1",
  "contractVersion": "pendo-product-usage-result-e1/v1",
  "pluginVersion": "0.1.0",
  "evidenceLevel": "E1",
  "layer": 1,
  "authority": {
    "readOnly": true,
    "proposalOnly": true,
    "aggregateOnly": true,
    "connected": false,
    "nativeProvider": false,
    "firstParty": false,
    "durableProviderReceipt": false,
    "kernelAuthority": false,
    "truthAuthority": false,
    "outcomeAuthority": false,
    "externalWrites": false,
    "causalClaims": false
  },
  "typedSurface": {
    "service": "PendoProductUsageResultService",
    "provider": "PendoProvider",
    "consumer": "MissionPendoUsageConsumer",
    "models": [
      "PendoProductUsageScope",
      "SubscriptionId",
      "ApplicationId",
      "AccountScope",
      "VisitorKind",
      "TargetReference",
      "SegmentScope",
      "TimeWindow",
      "ProjectBinding",
      "MissionBinding",
      "WorkProductBinding",
      "ConsentScope",
      "PendoPermission",
      "SecretReference",
      "PendoRegistration",
      "AdoptionMetric",
      "PendoProductUsageEvidence",
      "PendoProductUsageProposal",
      "PendoObservationReceipt",
      "PendoVerification"
    ]
  },
  "service": {
    "id": "pendo.product-usage.result",
    "name": "PendoProductUsageResultService",
    "version": "1.0.0",
    "access": "read_only",
    "operations": [
      "issue_read_consent",
      "read_aggregate",
      "read_report_metadata",
      "compile_proposal",
      "record_observation",
      "verify_proposal",
      "revoke_registration",
      "restore_registration"
    ],
    "externalWrites": false,
    "liveExternalIo": false,
    "causalClaims": false
  },
  "provider": {
    "id": "pendo.product-usage.aggregate",
    "name": "PendoProvider",
    "version": "1.0.0",
    "apiRevision": "pendo-engage-aggregation-v1",
    "origin": "https://app.pendo.io",
    "allowlistedReads": [
      {
        "operation": "aggregate_adoption",
        "method": "POST",
        "path": "/api/v1/aggregation",
        "sources": ["pageEvents", "featureEvents", "guideEvents"],
        "aggregateOnly": true,
        "mutates": false
      },
      {
        "operation": "page_report_metadata",
        "method": "GET",
        "path": "/api/v1/page",
        "aggregateOnly": true,
        "mutates": false
      },
      {
        "operation": "feature_report_metadata",
        "method": "GET",
        "path": "/api/v1/feature",
        "aggregateOnly": true,
        "mutates": false
      },
      {
        "operation": "guide_report_metadata",
        "method": "GET",
        "path": "/api/v1/guide",
        "aggregateOnly": true,
        "mutates": false
      }
    ],
    "allowlistedWrites": [],
    "requiredAuthentication": "opaque_secret_reference",
    "transportProvenance": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
    "maxRequestsPerScope": 10,
    "maxResponseBytes": 524288,
    "maxRows": 200,
    "maxBuckets": 31,
    "maxStalenessSeconds": 86400,
    "rawIntegrationKey": false,
    "rawResponseBody": false,
    "rawVisitorRows": false,
    "rawPii": false,
    "rawEventPayloads": false,
    "guideMutation": false,
    "segmentMutation": false,
    "eventMutation": false,
    "reversible": true,
    "revocable": true,
    "native": false,
    "connected": false,
    "firstParty": false
  },
  "consumer": {
    "id": "mission.pendo.product-usage",
    "name": "MissionPendoUsageConsumer",
    "kind": "mission_product_usage_projection",
    "scope": [
      "subscription",
      "application",
      "account_digest",
      "visitor_kind",
      "page_or_feature_or_guide_digest",
      "segment_digest",
      "time_window",
      "project",
      "mission",
      "work_product",
      "consent",
      "source_evidence_digest"
    ],
    "adoptsWorkProduct": false,
    "adoptsOutcome": false,
    "kernelAuthority": false,
    "truthAuthority": false,
    "causalClaims": false
  },
  "exactScope": [
    "subscription",
    "application",
    "account",
    "visitor_kind",
    "page",
    "feature",
    "guide",
    "segment",
    "time_window",
    "project",
    "mission",
    "work_product"
  ],
  "allowlist": {
    "aggregationSources": ["pageEvents", "featureEvents", "guideEvents"],
    "metrics": [
      "page_views",
      "feature_clicks",
      "guide_views",
      "unique_visitors",
      "unique_accounts",
      "adoption_rate"
    ],
    "targetKinds": ["page", "feature", "guide"],
    "metadataFields": ["id", "name", "kind", "appId", "updatedAt", "version"],
    "writes": [],
    "forbidden": [
      "visitor_rows",
      "visitor_ids",
      "account_pii",
      "email_addresses",
      "raw_event_payloads",
      "raw_response_body",
      "guide_mutation",
      "segment_mutation",
      "page_mutation",
      "feature_mutation",
      "track_event_ingestion",
      "dashboard_or_cockpit",
      "causal_claim",
      "product_truth_authority",
      "work_product_adoption",
      "outcome_authority"
    ]
  },
  "authentication": {
    "boundary": "opaque SecretReference",
    "rawCredentialSerialized": false,
    "rawCredentialDebug": false,
    "rawCredentialRequest": false,
    "rawCredentialReceipt": false,
    "scopeBound": true,
    "resolvedByLayer": 2
  },
  "bounds": {
    "maxTimeWindowDays": 31,
    "maxRequestsPerScope": 10,
    "maxResponseBytes": 524288,
    "maxRows": 200,
    "maxBuckets": 31,
    "maxStalenessSeconds": 86400,
    "maxIdentifierBytes": 128,
    "maxDiagnosticBytes": 256
  },
  "normalization": {
    "aggregateCounts": true,
    "aggregateRatesBasisPoints": true,
    "bucketLabels": "hashed",
    "pageFeatureGuideLabels": "hashed",
    "accountAndSegmentReferences": "hashed",
    "visitorRows": "dropped_or_rejected",
    "pii": "dropped_or_rejected",
    "rawJson": false,
    "responseBodyRetained": false,
    "responseOrderIndependent": true,
    "states": [
      "PRESENT",
      "PARTIAL",
      "STALE",
      "ACCESS_LOST",
      "PROVIDER_UNKNOWN",
      "RATE_LIMITED",
      "TAMPERED",
      "REVOKED"
    ],
    "causalClaims": false
  },
  "registration": {
    "versionBound": true,
    "contractDigestBound": true,
    "providerDigestBound": true,
    "permissionDigestBound": true,
    "scopeDigestBound": true,
    "queryDigestBound": true,
    "secretReferenceDigestBound": true,
    "projectBound": true,
    "missionBound": true,
    "workProductBound": true,
    "consentBound": true,
    "timeWindowBound": true,
    "reversible": true,
    "revocable": true,
    "oldProposalsInvalidAfterRevocation": true
  },
  "nativeClaims": {
    "connected": false,
    "nativeProvider": false,
    "firstParty": false,
    "httpsTransport": false,
    "durableProviderReceipt": false,
    "independentReadback": false,
    "adoptedWorkProduct": false,
    "adoptedOutcome": false,
    "blockedEnvironmentIsNative": false
  },
  "layer2Gaps": [
    "native_integration_key_resolution",
    "native_https_aggregation_read",
    "native_https_report_metadata_read",
    "durable_provider_receipt",
    "independent_native_readback",
    "verified_work_product_adoption",
    "verified_outcome_adoption"
  ]
}
