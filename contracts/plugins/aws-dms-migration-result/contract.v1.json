{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tangpingqingwa/hartevo-desktop/contracts/plugins/aws-dms-migration-result/contract.v1.json",
  "title": "Hartevo AWS DMS migration-result Layer-1 contract",
  "description": "A bounded metadata-only AWS DMS read/proposal/record/verify seam below kernel authority.",
  "schemaVersion": "hartevo.aws-dms-migration-result.contract/v1",
  "contractVersion": "aws-dms-migration-result/v1",
  "pluginVersion": "1.0.0",
  "layer": "Layer-1",
  "officialReferences": [
    "https://docs.aws.amazon.com/dms/latest/APIReference/API_DescribeReplicationTasks.html",
    "https://docs.aws.amazon.com/dms/latest/APIReference/API_DescribeReplicationTaskAssessmentResults.html",
    "https://docs.aws.amazon.com/dms/latest/APIReference/API_DescribeReplications.html"
  ],
  "service": {
    "id": "hartevo.aws.dms.migration-result",
    "implementation": "AwsDmsMigrationService",
    "version": "1.0.0",
    "operations": [
      "describe_capabilities",
      "register",
      "revoke_registration",
      "reverse_registration",
      "restore_registration",
      "read_bounded",
      "propose",
      "record",
      "verify"
    ],
    "readOnly": true,
    "proposalOnly": true,
    "liveExecution": false,
    "externalWrites": false
  },
  "provider": {
    "id": "aws.dms",
    "implementation": "AwsDmsProvider",
    "version": "1.0.0",
    "apiRevision": "aws-dms-read-r1",
    "allowlistedOperations": [
      "DescribeReplicationTasks",
      "DescribeReplications",
      "DescribeReplicationTaskAssessmentResults"
    ],
    "allowlistedMethods": ["POST"],
    "acceptedTransports": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
    "native": false,
    "connected": false,
    "firstParty": false,
    "externalWrites": false,
    "sigV4Secret": "opaque_non_serializing_secret_reference_only",
    "providerReceipt": false
  },
  "consumer": {
    "id": "mission.aws.dms.migration-result",
    "implementation": "MissionAwsDmsConsumer",
    "version": "1.0.0",
    "missionBound": true,
    "projectBound": true,
    "workProductBound": true,
    "revisionBound": true,
    "permissionBound": true,
    "producesDecisionProposal": true,
    "adoptsOutcome": false,
    "adoptsWorkProduct": false,
    "truthAuthority": false,
    "verificationAuthority": false
  },
  "scope": {
    "required": [
      "awsAccountId",
      "awsRegion",
      "replicationTaskOrServerlessReplicationArn",
      "sourceEndpointArn",
      "targetEndpointArn",
      "replicationInstanceArnOptional",
      "taskRevision",
      "migrationWindowStartAndEnd",
      "missionIdAndRevision",
      "projectIdAndRevision",
      "workProductIdAndRevision",
      "permissionDigest",
      "secretReferenceDigest",
      "scopeDigest"
    ],
    "exactReplicationIdentity": true,
    "explicitArns": true,
    "rawEndpointCredentials": false,
    "rawTableMappings": false,
    "rawRowData": false,
    "rawAssessmentBodies": false,
    "rawUnboundedLogs": false
  },
  "registration": {
    "pluginVersionBound": true,
    "providerIdBound": true,
    "providerVersionBound": true,
    "providerRevisionBound": true,
    "providerDigestBound": true,
    "apiDigestBound": true,
    "contractVersionBound": true,
    "contractDigestBound": true,
    "permissionDigestBound": true,
    "scopeDigestBound": true,
    "evidenceDigestBound": true,
    "secretReferenceDigestBound": true,
    "reversible": true,
    "revocable": true,
    "failClosedOn": [
      "provider_or_api_revision_drift",
      "provider_or_contract_digest_drift",
      "permission_or_scope_digest_drift",
      "task_or_endpoint_drift",
      "task_revision_drift",
      "evidence_digest_drift",
      "secret_reference_revocation",
      "registration_tamper",
      "registration_revocation",
      "marker_replay_or_pagination_loop",
      "partial_or_unknown_provider_response",
      "access_loss",
      "throttling",
      "timeout",
      "recording_replay_conflict"
    ]
  },
  "bounds": {
    "maxResponseBytes": 1048576,
    "maxPages": 4,
    "maxRecords": 100,
    "maxRequestsPerRead": 12,
    "maxMigrationWindowSeconds": 604800,
    "maxIdentifierBytes": 256,
    "opaqueMarkerOnly": true
  },
  "evidence": {
    "states": [
      "COMPLETED",
      "IN_PROGRESS",
      "STOPPED",
      "FAILED",
      "NOT_FOUND",
      "PARTIAL",
      "ACCESS_LOSS",
      "THROTTLED",
      "PROVIDER_UNKNOWN",
      "REGISTRATION_REVOKED"
    ],
    "retained": [
      "task_state",
      "migration_type",
      "source_endpoint_identity_digest",
      "target_endpoint_identity_digest",
      "replication_instance_identity_digest",
      "full_load_progress_counters",
      "stop_reason_digest",
      "assessment_status",
      "assessment_date",
      "assessment_report_digest",
      "bounded_request_page_digests",
      "provenance"
    ],
    "notRetained": [
      "endpoint_credentials",
      "table_mappings",
      "row_data",
      "s3_assessment_body",
      "raw_provider_marker",
      "unbounded_logs",
      "raw_error_messages"
    ],
    "tamperRejected": true,
    "replayRejected": true,
    "paginationLoopRejected": true,
    "partialIsNonAdoptable": true,
    "accessLossIsNonAdoptable": true,
    "unknownIsNonAdoptable": true,
    "connectedClaim": false,
    "nativeClaim": false,
    "firstPartyClaim": false,
    "providerReceipt": false
  },
  "permissions": {
    "allow": [
      "dms:DescribeReplicationTasks",
      "dms:DescribeReplications",
      "dms:DescribeReplicationTaskAssessmentResults",
      "mission.scope"
    ],
    "deny": [
      "dms:CreateReplicationTask",
      "dms:ModifyReplicationTask",
      "dms:StartReplicationTask",
      "dms:StopReplicationTask",
      "dms:MoveReplicationTask",
      "dms:ReloadTables",
      "dms:CreateEndpoint",
      "dms:ModifyEndpoint",
      "dms:DeleteEndpoint",
      "dms:StartReplicationTaskAssessment",
      "dms:DeleteReplicationTask",
      "iam:PassRole",
      "s3:GetObject",
      "outcome.adopt"
    ]
  },
  "honesty": {
    "fixtureIsConnected": false,
    "recordingIsConnected": false,
    "loopbackIsConnected": false,
    "blockedEnvironmentIsConnected": false,
    "fixtureIsNative": false,
    "recordingIsNative": false,
    "loopbackIsNative": false,
    "blockedEnvironmentIsNative": false,
    "firstPartyClaim": false,
    "layer1Boundary": "Layer 1 emits bounded external evidence and a Mission review proposal only. Native SigV4/HTTPS, durable receipts, independent target read-back, consented effects, assessment execution, migration safety claims, and verified Work Product adoption remain Layer-2 host authority."
  },
  "layer2Gaps": [
    "native_sigv4_transport_and_credential_resolution",
    "durable_provider_receipt",
    "independent_source_and_target_readback",
    "consented_replication_task_effects",
    "assessment_execution_and_raw_report_access",
    "operational_migration_safety_claim",
    "verified_work_product_adoption"
  ],
  "forbidden": [
    "create_replication_task",
    "modify_replication_task",
    "start_replication_task",
    "stop_replication_task",
    "move_replication_task",
    "reload_tables",
    "create_or_modify_or_delete_endpoint",
    "start_assessment",
    "download_raw_assessment_body",
    "read_table_mappings",
    "read_row_data",
    "resolve_live_credentials",
    "claim_connected",
    "claim_native",
    "claim_first_party",
    "claim_migration_safety",
    "adopt_kernel_outcome",
    "adopt_verified_work_product"
  ]
}
