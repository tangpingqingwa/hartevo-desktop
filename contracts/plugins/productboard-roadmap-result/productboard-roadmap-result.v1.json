  "provider": {
    "id": "productboard.roadmap.read",
    "version": "1.0.0",
    "apiRevision": "productboard-rest-api-v2-read-roadmap-insight",
    "baseUrl": "https://api.productboard.com/v2",
    "documentation": "https://developer.productboard.com/reference/introduction",
    "provenance": ["fixture", "recording", "fake", "loopback", "blocked_env"],
    "connected": false,
    "native": false,
    "firstParty": false,
    "maxRequestsPerMinute": 60,
    "maxResponseBytes": 1048576,
    "maxItems": 100,
    "maxPageSize": 100,
    "readAllowlist": [
      "GET /v2/notes/configurations",
      "GET /v2/entities/configurations",
      "GET /v2/entities/configurations/{type}",
      "GET /v2/notes",
      "GET /v2/notes/{note_id}",
      "GET /v2/notes/{note_id}/relationships",
      "GET /v2/entities",
      "GET /v2/entities/{entity_id}",
      "GET /v2/entities/{entity_id}/relationships"
    ],
    "pagination": "opaque cursor digest bound to operation, exact scope, revision, permission, field allowlist, and page size",
    "fieldAllowlist": "configuration-derived allowlist only; raw note, member, and customer content is dropped",
    "rateAndBackoff": "bounded rate receipt and retry/backoff metadata only",
    "forbidden": [
      "native credential resolution",
      "native HTTPS",
      "POST",
      "PUT",
      "PATCH",
      "DELETE",
      "relationship mutation",
      "note mutation",
      "entity mutation",
      "webhooks",
      "arbitrary exports",
      "raw_public_api_token",
      "raw_note_body",
      "raw_customer_content",
      "raw_member_content",
      "raw_response",
      "durable_provider_receipt",
      "independent_native_readback",
      "verified_adoption",
      "kernel_truth",
      "kernel_consent",
      "kernel_effect",
      "kernel_receipt",
      "kernel_verification",
      "kernel_outcome"
    ]
  },
  "consumer": {
    "id": "mission.productboard-roadmap-result.consumer",
    "proposalOnly": true,
    "reviewOnly": true,
    "connected": false,
    "native": false,
    "firstParty": false,
    "outcomeAuthority": false,
    "workProductAdoption": false
  },
  "scope": {
    "required": [
      "workspace",
      "entityConfiguration",
      "note",
      "insight",
      "feature",
      "component",
      "initiative",
      "objective",
      "release",
      "project",
      "mission",
      "workProduct",
      "permissionRevision",
      "scopeRevision"
    ],
    "exactResourceScope": true,
    "revisionBound": true,
    "permissionBound": true,
    "registrationDigestBound": true,
    "hierarchy": [
      "workspace",
      "entityConfiguration",
      "note",
      "insight",
      "feature",
      "component",
      "initiative",
      "objective",
      "release"
    ]
  },
  "evidence": {
    "aggregateOnly": true,
    "rawResponseDropped": true,
    "rawPublicApiTokenDropped": true,
    "rawNoteBodiesDropped": true,
    "rawInsightContentDropped": true,
    "rawMemberContentDropped": true,
    "rawCustomerContentDropped": true,
    "rawUrlsDropped": true,
    "rawWritePayloadDropped": true,
    "relationshipDigestBound": true,
    "redactionDigestBound": true,
    "idempotencyDigestBound": true,
    "opaquePagination": true,
    "cursorBindingDigest": true,
    "presentArchivedPartialAccessLossProviderUnknownTamperStaleRevokedStates": true,
    "rateLimitedEmptyTimeoutStates": true,
    "tamperAndReplayFenced": true
  },
  "registration": {
