{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tangpingqingwa/hartevo-desktop/contracts/plugins/paddle-subscription-result/paddle-subscription-result.v1.json",
  "schemaVersion": "hartevo.paddle-subscription-result/v1",
  "contractVersion": "EXT-PADDLE-01-L1/v1",
  "title": "Hartevo Layer-1 Paddle subscription and transaction result contract",
  "description": "A bounded, read-only Paddle Billing lifecycle projection. It proposes redacted subscription, transaction, renewal, and event evidence below Hartevo billing, payment, receipt, truth, and outcome authority.",
  "layer": 1,
  "evidenceLevel": "L1",
  "status": "read_proposal_and_recording_only",
  "plugin": {
    "id": "hartevo.paddle-subscription-result",
    "version": "0.1.0",
    "oneRoot": true,
    "childLayer": false,
    "registration": {
      "versionBound": true,
      "contractDigestBound": true,
      "implementationDigestBound": true,
      "providerDigestBound": true,
      "apiDigestBound": true,
      "permissionDigestBound": true,
      "scopeDigestBound": true,
      "revisionDigestBound": true,
      "reversible": true,
      "revocable": true,
      "failClosedOnDrift": true,
      "opaqueApiKeySecretReferenceOnly": true,
      "serializedSecretReference": false
    }
  },
  "digests": [
    "version_digest",
    "plugin_version_digest",
    "contract_digest",
    "provider_digest",
    "api_digest",
    "permission_digest",
    "scope_digest",
    "revision_digest",
    "implementation_digest",
    "secret_reference_digest",
    "registration_digest",
    "request_fingerprint",
    "response_fingerprint",
    "evidence_digest",
    "proposal_digest"
  ],
  "service": {
    "type": "PaddleSubscriptionResultService",
    "provider": "PaddleBillingProvider",
    "consumer": "MissionPaddleSubscriptionConsumer",
    "operations": [
      "describe_capabilities",
      "compile_bounded_subscription_read",
      "compile_bounded_transaction_read",
      "compile_bounded_event_read",
      "read_subscription",
      "read_transaction",
      "read_transactions",
      "read_events",
      "paginate_transactions",
      "paginate_events",
      "compile_result_proposal",
      "verify_result_proposal",
      "revoke_registration",
      "restore_registration",
      "revoke_secret",
      "restore_secret"
    ],
    "readOnly": true,
    "proposalOnly": true,
    "recordingOnly": true,
    "externalWrites": false,
    "paymentInitiation": false,
    "durableNativeReceipt": false,
    "independentReadback": false,
    "kernelAuthority": false,
    "outcomeAdoption": false
  },
  "consumer": {
    "type": "MissionPaddleSubscriptionConsumer",
    "missionBound": true,
    "projectBound": true,
    "workProductBound": true,
    "adoptsWorkProduct": false,
    "kernelAuthority": false
  },
  "provider": {
    "type": "PaddleBillingProvider",
    "id": "paddle.billing.read",
    "version": "1.0.0",
    "officialHost": "https://api.paddle.com",
    "apiVersion": "1",
    "officialReferences": [
      "https://developer.paddle.com/api-reference/",
      "https://developer.paddle.com/api-reference/about/authentication",
      "https://developer.paddle.com/api-reference/about/permissions",
      "https://developer.paddle.com/api-reference/about/pagination",
      "https://developer.paddle.com/api-reference/subscriptions/",
      "https://developer.paddle.com/api-reference/transactions/",
      "https://developer.paddle.com/api-reference/events/list-events"
    ],
    "readMethods": [
      "GET /subscriptions/{subscription_id}",
      "GET /transactions/{transaction_id}",
      "GET /transactions?subscription_id={subscription_id}",
      "GET /events?event_type=subscription.*&event_type=transaction.*"
    ],
    "requestHeaders": ["Authorization: Bearer <opaque SecretReference>", "Paddle-Version: 1"],
    "permissions": ["subscription.read", "transaction.read", "notification.read"],
    "pagination": {
      "providerCursorParameter": "after",
      "providerPageParameter": "per_page",
      "providerNextUrlConsumedAsOpaqueCursor": true,
      "publicCursor": "opaque_digest_and_expiry_fenced",
      "transactionMaximum": 30,
      "eventMaximum": 200
    },
    "eventRetentionDays": 90,
    "responseByteCap": 2097152,
    "nativeStatus": "BLOCKED_ENV",
    "connected": false,
    "native": false,
    "firstParty": false,
    "provenanceClaims": {
      "fixture": { "connected": false, "native": false, "firstParty": false },
      "recording": { "connected": false, "native": false, "firstParty": false },
      "loopback": { "connected": false, "native": false, "firstParty": false },
      "BLOCKED_ENV": { "connected": false, "native": false, "firstParty": false }
    },
    "externalWrites": false,
    "rawResponseBodies": false,
    "rawSecrets": false,
    "customerData": "immutable identifier digest only",
    "paymentInstrumentData": false,
    "managementUrls": false,
    "webhookIngestion": false,
    "transportSeams": ["fixture", "recording", "loopback", "BLOCKED_ENV"]
  },
  "authentication": {
    "scheme": "bearer_api_key",
    "boundary": "opaque non-serializable SecretReference",
    "opaque": true,
    "serialized": false,
    "resolvedByLayer": "Layer-2 host secret broker",
    "rawApiKeyAccepted": false,
    "clientSideToken": false
  },
  "scope": {
    "exactFields": [
      "account_id",
      "subscription_id",
      "transaction_id",
      "event_type_set",
      "api_host",
      "api_version",
      "permission_lease",
      "hartevo_project_id",
      "mission_id",
      "work_product_id",
      "project_revision",
      "mission_revision",
      "work_product_revision",
      "scope_revision"
    ],
    "permissionRegistration": ["subscription.read", "transaction.read", "notification.read"],
    "missionProjectWorkProductBound": true,
    "arbitraryAccountDiscovery": false,
    "arbitraryCustomerDiscovery": false,
    "crossAccount": false,
    "crossSubscription": false,
    "crossTransaction": false
  },
  "registration": {
    "versionBound": true,
    "contractDigestBound": true,
    "implementationDigestBound": true,
    "providerDigestBound": true,
    "apiDigestBound": true,
    "permissionDigestBound": true,
    "scopeDigestBound": true,
    "revisionDigestBound": true,
    "secretReferenceDigestBound": true,
    "registrationDigestBound": true,
    "reversible": true,
    "revocable": true,
    "failClosedOn": [
      "provider_drift",
      "api_drift",
      "permission_drift",
      "scope_drift",
      "project_revision_drift",
      "mission_revision_drift",
      "work_product_revision_drift",
      "registration_tamper",
      "registration_revocation",
      "secret_revocation",
      "cursor_expiry",
      "cursor_replay"
    ]
  },
  "projection": {
    "subscription": [
      "immutable account and subscription IDs",
      "active/trialing/past_due/paused/canceled/provider_unknown status",
      "created/started/first_billed/next_billed/paused/canceled timestamps",
      "current billing period",
      "scheduled change action and effective timestamp",
      "currency and bounded amount summaries",
      "customer and item metadata digests"
    ],
    "transaction": [
      "immutable account/subscription/transaction IDs",
      "draft/ready/billed/paid/completed/canceled/past_due/refunded/provider_unknown status",
      "origin and billing period",
      "currency and bounded amount summaries",
      "payment attempt status and amount only",
      "customer, item, and error digests"
    ],
    "event": [
      "subscription.* and transaction.* event type",
      "immutable event and related entity IDs",
      "occurred timestamp",
      "status projection and data digest only"
    ],
    "rawCustomerFields": false,
    "rawItemFields": false,
    "rawPaymentInstrumentFields": false,
    "rawProviderBody": false
  },
  "statusSemantics": {
    "subscriptionStatuses": ["active", "trialing", "past_due", "paused", "canceled"],
    "transactionStatuses": ["draft", "ready", "billed", "paid", "completed", "past_due", "canceled", "refunded"],
    "paymentAttemptStatuses": ["created", "authorized", "authorized_flagged", "pending_no_action_required", "action_required", "captured", "error", "canceled", "dropped", "unknown"],
    "unknownProviderStates": "provider_unknown",
    "malformedOrPartial": "reject or emit bounded provider_unknown/partial evidence",
    "renewalEvidence": "subscription next_billed_at and transaction origin subscription_recurring are evidence, not a guaranteed future charge"
  },
  "evidence": {
    "bounded": true,
    "redacted": true,
    "provenance": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
    "connected": false,
    "native": false,
    "firstParty": false,
    "proposalOnly": true,
    "recordingOnly": true,
    "durableNativeReceipt": false,
    "independentReadback": false,
    "kernelAuthority": false,
    "outcomeAdoption": false,
    "rawCustomer": false,
    "rawItems": false,
    "rawPaymentInstrument": false,
    "rawProviderBody": false,
    "rawApiKey": false
  },
  "authority": {
    "connected": false,
    "native": false,
    "firstParty": false,
    "readOnly": true,
    "externalWrites": false,
    "paymentInitiation": false,
    "subscriptionMutation": false,
    "transactionMutation": false,
    "refund": false,
    "customerPortal": false,
    "webhookEffect": false,
    "durableNativeReceipt": false,
    "independentReadback": false,
    "kernelAuthority": false,
    "outcomeAdoption": false
  },
  "fences": [
    "stale_snapshot",
    "project_revision_drift",
    "mission_revision_drift",
    "work_product_revision_drift",
    "scope_revision_drift",
    "provider_digest_drift",
    "api_digest_drift",
    "permission_digest_drift",
    "contract_digest_drift",
    "implementation_digest_drift",
    "account_mismatch",
    "subscription_mismatch",
    "transaction_mismatch",
    "event_scope_mismatch",
    "registration_tamper",
    "registration_revocation",
    "secret_revocation",
    "cursor_scope_mismatch",
    "cursor_expiry",
    "cursor_replay",
    "response_replay_divergence",
    "response_byte_cap",
    "partial_response",
    "access_loss"
  ],
  "failureHandling": {
    "http": [401, 403, 404, 409, 429],
    "retryable": ["429", "timeout", "5xx"],
    "nonRetryable": [401, 403, 404, 409, "malformed", "partial", "cursor_expired", "scope_mismatch"],
    "backoff": "bounded recorded retry advice without network sleep",
    "redaction": "provider error text is replaced by a bounded class, status, retryable flag, and digest"
  },
  "forbiddenAuthorities": [
    "checkout",
    "payment_initiation",
    "capture",
    "refund",
    "subscription_create",
    "subscription_update",
    "subscription_pause",
    "subscription_resume",
    "subscription_cancel",
    "customer_portal_session",
    "management_url_exposure",
    "webhook_effect",
    "raw_customer_data",
    "raw_payment_instrument_data",
    "raw_item_metadata",
    "durable_native_receipt",
    "independent_write_readback",
    "kernel_truth",
    "kernel_effect",
    "kernel_receipt",
    "kernel_verification",
    "outcome_adoption",
    "financial_advice",
    "connected_claim",
    "native_claim",
    "first_party_claim"
  ],
  "nonOverlap": {
    "money01": "Hartevo internal billing and credits authority remains MONEY-01 (#78/#104)",
    "xero": "Xero owns accounting evidence (#407), not Paddle subscription lifecycle evidence",
    "shopify": "Shopify owns store order and fulfillment evidence (#428), not Paddle billing lifecycle evidence"
  },
  "nativeGaps": [
    "native_api_key_secret_resolution",
    "live_paddle_https_transport",
    "live_account_probe",
    "durable_native_receipts",
    "independent_read_back",
    "verified_work_product_adoption",
    "connected_native_first_party_evidence"
  ],
  "honestNativeGap": "Fixture, recording, loopback, and BLOCKED_ENV are bounded Layer-1 evidence only and never Connected/native/first-party evidence. Layer 2 requires consent, effect, receipt, independent read-back, and ambiguity recovery."
}
