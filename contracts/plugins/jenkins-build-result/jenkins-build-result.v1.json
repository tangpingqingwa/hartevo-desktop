{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tangpingqingwa/hartevo-desktop/contracts/plugins/jenkins-build-result/jenkins-build-result.v1.json",
  "title": "Hartevo Jenkins build-result Layer-1 contract",
  "description": "Bounded GET-only Jenkins Remote Access JSON evidence for one exact build and Project/Mission/Work Product scope.",
  "schemaVersion": "hartevo.jenkins-build-result/v1",
  "contractVersion": "jenkins-build-result-e1/v1",
  "pluginVersion": "0.1.0",
  "pluginId": "jenkins-build-result",
  "layer": "Layer-1",
  "evidenceLevel": "L1_PROVIDER_CONTRACT",
  "officialReferences": [
    "https://www.jenkins.io/doc/book/using/remote-access-api/"
  ],
  "authority": {
    "readOnly": true,
    "proposalOnly": true,
    "connected": false,
    "native": false,
    "externalWrites": false,
    "kernelAuthority": false,
    "truthAuthority": false,
    "outcomeAuthority": false,
    "workProductAdoption": false,
    "credentialAuthority": false,
    "consoleLogAuthority": false,
    "rawArtifactAuthority": false,
    "sourceAuthority": false
  },
  "typedSurface": {
    "service": "JenkinsBuildResultService",
    "provider": "JenkinsProvider",
    "consumer": "MissionJenkinsBuildConsumer",
    "models": [
      "JenkinsBuildResultScope",
      "ProjectBinding",
      "MissionBinding",
      "WorkProductBinding",
      "SecretReference",
      "JenkinsCursor",
      "JenkinsPermissionSnapshot",
      "JenkinsRegistration",
      "JenkinsBuildResultStatus",
      "JenkinsBuildResultEvidence",
      "JenkinsBuildResultProposal"
    ]
  },
  "service": {
    "id": "jenkins.build-result",
    "name": "JenkinsBuildResultService",
    "version": "1.0.0",
    "access": "read_only",
    "operations": [
      "describe_capabilities",
      "read_controller",
      "read_folder",
      "read_job",
      "read_build",
      "read_branch",
      "read_commit",
      "read_test_summary",
      "read_artifact_metadata",
      "compile_proposal",
      "verify_proposal",
      "revoke_registration",
      "restore_registration",
      "consume_observation"
    ],
    "externalWrites": false,
    "liveExternalIo": false,
    "kernelAuthority": false
  },
  "provider": {
    "id": "jenkins.remote-access",
    "name": "JenkinsProvider",
    "version": "1.0.0",
    "apiRevision": "jenkins-remote-access-json-r1",
    "allowedMethods": ["GET"],
    "allowlistedReads": [
      {"operation": "read_controller", "path": "/api/json", "method": "GET"},
      {"operation": "read_folder", "path": "/job/{folder}/api/json", "method": "GET"},
      {"operation": "read_job", "path": "/job/{folder...}/{job}/api/json", "method": "GET"},
      {"operation": "read_build", "path": "/job/{folder...}/{job}/{branch?}/{build}/api/json", "method": "GET"},
      {"operation": "read_branch", "path": "/job/{folder...}/{job}/{branch}/api/json", "method": "GET"},
      {"operation": "read_commit", "path": "/job/{folder...}/{job}/{branch?}/{build}/api/json", "method": "GET"},
      {"operation": "read_test_summary", "path": "/job/{folder...}/{job}/{branch?}/{build}/testReport/api/json", "method": "GET"},
      {"operation": "read_artifact_metadata", "path": "/job/{folder...}/{job}/{branch?}/{build}/api/json", "method": "GET"}
    ],
    "permissions": [
      "jenkins.controller.read",
      "jenkins.folder.read",
      "jenkins.job.read",
      "jenkins.branch.read",
      "jenkins.build.read",
      "jenkins.commit.read",
      "jenkins.test-summary.read",
      "jenkins.artifact-metadata.read"
    ],
    "forbiddenOperations": [
      "trigger_build",
      "stop_build",
      "replay_build",
      "rebuild_build",
      "create_job",
      "delete_job",
      "configure_job",
      "install_plugin",
      "plugin_manager_mutation",
      "console_log",
      "progressive_console_text",
      "raw_artifact_download",
      "source_export",
      "script_output",
      "credential_resolution",
      "kernel_authority"
    ],
    "transportProvenance": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
    "native": false,
    "connected": false,
    "externalWrites": false,
    "rawResponseBody": false,
    "rawArtifacts": false,
    "rawSource": false,
    "rawScripts": false,
    "credentials": "opaque_non_serializing_reference"
  },
  "consumer": {
    "id": "mission.jenkins-build-result",
    "name": "MissionJenkinsBuildConsumer",
    "scope": [
      "controller",
      "folder_path",
      "job_name",
      "build_number",
      "branch_name",
      "commit_sha",
      "project_id",
      "project_revision",
      "mission_id",
      "mission_revision",
      "work_product_id",
      "work_product_revision",
      "registration_digest",
      "evidence_digest"
    ],
    "proposalOnly": true,
    "adoptsOutcome": false,
    "adoptsWorkProduct": false,
    "kernelAuthority": false,
    "replayFence": true
  },
  "exactScope": {
    "required": [
      "controller",
      "folder_path",
      "job_name",
      "build_number",
      "branch_name",
      "commit_sha",
      "project_id",
      "project_revision",
      "mission_id",
      "mission_revision",
      "work_product_id",
      "work_product_revision"
    ],
    "projectMissionWorkProductExact": true,
    "identifiersInEvidence": "digest_only_when_provider_payload_derived",
    "maxFolderDepth": 16,
    "maxIdentifierBytes": 256
  },
  "registration": {
    "versionDigestBound": true,
    "contractDigestBound": true,
    "providerDigestBound": true,
    "permissionDigestBound": true,
    "scopeDigestBound": true,
    "evidenceDigestBound": true,
    "secretReferenceDigestBound": true,
    "registrationDigestBound": true,
    "reversible": true,
    "revocable": true,
    "rotationOnStateChange": true,
    "failClosedOn": [
      "version_drift",
      "contract_drift",
      "provider_drift",
      "permission_drift",
      "scope_drift",
      "evidence_digest_drift",
      "secret_reference_drift",
      "project_drift",
      "mission_drift",
      "work_product_drift",
      "registration_revocation",
      "proposal_replay",
      "response_tamper",
      "cursor_scope_mismatch"
    ]
  },
  "statuses": [
    "QUEUED",
    "RUNNING",
    "SUCCESS",
    "UNSTABLE",
    "FAILURE",
    "ABORTED",
    "NOT_BUILT",
    "PARTIAL",
    "EXPIRED",
    "ACCESS_LOST",
    "PROVIDER_UNKNOWN",
    "TAMPERED",
    "REVOKED"
  ],
  "bounds": {
    "maxResponseBytes": 1048576,
    "maxOperations": 8,
    "maxFolderDepth": 16,
    "maxJobs": 256,
    "maxArtifacts": 128,
    "maxRequestsPerMinute": 60,
    "maxCursorBytes": 256,
    "maxCursorPage": 16,
    "maxDiagnosticBytes": 512
  },
  "normalization": {
    "responseOrderIndependent": true,
    "rawJson": false,
    "rawResponseBody": false,
    "rawConsoleLogs": false,
    "rawArtifacts": false,
    "rawSource": false,
    "rawScripts": false,
    "jobNamesFromPayload": "digest_only",
    "branchNamesFromPayload": "digest_only",
    "commitIdentifiers": "digest_only",
    "artifactNamesAndPaths": "digest_only",
    "cursor": "opaque_digest_only",
    "timestamps": "normalized_epoch_millis",
    "statuses": ["QUEUED", "RUNNING", "SUCCESS", "UNSTABLE", "FAILURE", "ABORTED", "NOT_BUILT", "PARTIAL", "EXPIRED", "ACCESS_LOST", "PROVIDER_UNKNOWN", "TAMPERED", "REVOKED"]
  },
  "receipts": {
    "method": "GET",
    "operation": true,
    "pathDigest": true,
    "requestDigest": true,
    "responseStatus": true,
    "responseBytes": true,
    "responseDigest": true,
    "providerDigest": true,
    "permissionDigest": true,
    "rawHeaders": false,
    "rawResponseBody": false,
    "credentialMaterial": false
  },
  "honesty": {
    "fixtureNative": false,
    "recordingNative": false,
    "loopbackNative": false,
    "blockedEnvNative": false,
    "fixtureConnected": false,
    "recordingConnected": false,
    "loopbackConnected": false,
    "blockedEnvConnected": false,
    "nativeHttpsTransport": "layer_2_gap",
    "nativeCredentialResolution": "layer_2_gap",
    "nativeReadback": "layer_2_gap",
    "providerReceipt": false,
    "absenceIsSuccess": false,
    "rawArtifactOrLogAuthority": false,
    "kernelOutcomeAuthority": false,
    "workProductAdoption": false
  },
  "documentation": [
    "https://www.jenkins.io/doc/book/using/remote-access-api/"
  ],
  "layer2Gaps": [
    "native_secret_resolution",
    "native_jenkins_https_transport",
    "durable_native_provider_receipt",
    "console_log_or_progressive_text",
    "raw_artifact_download",
    "source_or_script_export",
    "build_trigger_stop_replay_rebuild",
    "job_configuration_or_plugin_mutation",
    "kernel_receipt_and_outcome_authority",
    "verified_work_product_adoption"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "$id",
    "schemaVersion",
    "contractVersion",
    "pluginVersion",
    "pluginId",
    "layer",
    "authority",
    "typedSurface",
    "service",
    "provider",
    "consumer",
    "exactScope",
    "registration",
    "statuses",
    "bounds",
    "normalization",
    "receipts",
    "honesty",
    "documentation",
    "layer2Gaps"
  ]
}
