{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hartevo://contracts/plugins/launchdarkly-release/feature-release.v1.schema.json",
  "title": "Hartevo LaunchDarkly Layer 1 feature-release contract",
  "description": "Read, semantic-patch proposal, approval/audit evidence, and recording-only result seam. It never grants write, Connected, native, first-party, Effect, Receipt, Verification, Truth, Consent, or Outcome authority.",
  "type": "object",
  "required": ["schemaVersion", "capability", "scope", "registration", "evidence", "boundaries"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "hartevo.launchdarkly-release/v1" },
    "capability": {
      "type": "object",
      "required": ["serviceId", "providerId", "consumerId", "operations", "mode"],
      "additionalProperties": false,
      "properties": {
        "serviceId": { "const": "feature-release" },
        "providerId": { "const": "launchdarkly-release" },
        "consumerId": { "const": "mission-feature-release" },
        "mode": { "const": "read_proposal_record" },
        "operations": {
          "type": "array",
          "items": {
            "enum": [
              "describe_release",
              "read_flag_evidence",
              "compile_release_proposal",
              "record_release_receipt",
              "verify_release_result"
            ]
          },
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "accountId",
        "baseUrl",
        "projectKey",
        "environmentKey",
        "environmentId",
        "flagKey",
        "flagVersion",
        "allowedVariationPaths",
        "allowedTargetingPaths",
        "approvalPolicy",
        "missionId",
        "projectId",
        "workProductId",
        "consentRevision",
        "policyRevision",
        "scopeDigest"
      ],
      "additionalProperties": false,
      "properties": {
        "accountId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "baseUrl": { "type": "string", "format": "uri", "maxLength": 512 },
        "projectKey": { "type": "string", "minLength": 1, "maxLength": 128 },
        "environmentKey": { "type": "string", "minLength": 1, "maxLength": 128 },
        "environmentId": { "type": ["string", "null"], "maxLength": 128 },
        "flagKey": { "type": "string", "minLength": 1, "maxLength": 128 },
        "flagVersion": { "type": "integer", "minimum": 1 },
        "allowedVariationPaths": {
          "type": "array",
          "items": { "type": "string", "pattern": "^/", "maxLength": 256 },
          "uniqueItems": true
        },
        "allowedTargetingPaths": {
          "type": "array",
          "items": { "type": "string", "pattern": "^/", "maxLength": 256 },
          "uniqueItems": true
        },
        "approvalPolicy": {
          "type": "object",
          "required": ["policyId", "revision", "required"],
          "additionalProperties": false,
          "properties": {
            "policyId": { "type": "string", "minLength": 1, "maxLength": 128 },
            "revision": { "type": "integer", "minimum": 1 },
            "required": { "type": "boolean" }
          }
        },
        "missionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "workProductId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "consentRevision": { "type": "integer", "minimum": 1 },
        "policyRevision": { "type": "integer", "minimum": 1 },
        "scopeDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "registration": {
      "type": "object",
      "required": [
        "pluginId",
        "pluginVersion",
        "contractDigest",
        "adapterRevision",
        "apiRevision",
        "serviceDefinitionDigest",
        "permissionSnapshotDigest",
        "secretReferenceDigest",
        "secretRevocationRevision",
        "approvalPolicyRevision",
        "scopeDigest",
        "registrationRevision",
        "lifecycle",
        "registrationDigest"
      ],
      "additionalProperties": false,
      "properties": {
        "pluginId": { "const": "launchdarkly-release" },
        "pluginVersion": {
          "type": "object",
          "required": ["major", "minor", "patch"],
          "additionalProperties": false,
          "properties": {
            "major": { "type": "integer", "minimum": 0, "maximum": 65535 },
            "minor": { "type": "integer", "minimum": 0, "maximum": 65535 },
            "patch": { "type": "integer", "minimum": 0, "maximum": 65535 }
          }
        },
        "contractDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "adapterRevision": { "type": "string", "minLength": 1, "maxLength": 128 },
        "apiRevision": { "type": "string", "minLength": 1, "maxLength": 128 },
        "serviceDefinitionDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "permissionSnapshotDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "secretReferenceDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "secretRevocationRevision": { "type": "integer", "minimum": 0 },
        "approvalPolicyRevision": { "type": "integer", "minimum": 1 },
        "scopeDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "registrationRevision": { "type": "integer", "minimum": 1 },
        "lifecycle": { "enum": ["active", "revoked", "unregistered"] },
        "registrationDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["flag", "approval", "audit", "claims"],
      "additionalProperties": false,
      "properties": {
        "flag": {
          "type": "object",
          "required": [
            "accountId",
            "baseUrl",
            "projectKey",
            "environmentKey",
            "environmentId",
            "flagKey",
            "flagVersion",
            "variationDigest",
            "targetingDigest",
            "semanticDigest",
            "observedAt"
          ],
          "additionalProperties": false,
          "properties": {
            "accountId": { "type": "string", "minLength": 1, "maxLength": 128 },
            "baseUrl": { "type": "string", "format": "uri", "maxLength": 512 },
            "projectKey": { "type": "string", "minLength": 1, "maxLength": 128 },
            "environmentKey": { "type": "string", "minLength": 1, "maxLength": 128 },
            "environmentId": { "type": ["string", "null"], "maxLength": 128 },
            "flagKey": { "type": "string", "minLength": 1, "maxLength": 128 },
            "flagVersion": { "type": "integer", "minimum": 1 },
            "variationDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "targetingDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "semanticDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "observedAt": { "type": "integer", "minimum": 0 }
          }
        },
        "approval": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "requestId",
              "status",
              "projectKey",
              "environmentKey",
              "environmentId",
              "flagKey",
              "flagVersion",
              "policyRevision",
              "scopeDigest",
              "decisionDigest",
              "evidenceDigest",
              "observedAt"
            ],
            "additionalProperties": false,
            "properties": {
              "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "status": { "enum": ["pending", "approved", "declined", "conflicted", "stale", "unknown"] },
              "projectKey": { "type": "string", "minLength": 1, "maxLength": 128 },
              "environmentKey": { "type": "string", "minLength": 1, "maxLength": 128 },
              "environmentId": { "type": ["string", "null"], "maxLength": 128 },
              "flagKey": { "type": "string", "minLength": 1, "maxLength": 128 },
              "flagVersion": { "type": "integer", "minimum": 1 },
              "policyRevision": { "type": "integer", "minimum": 1 },
              "scopeDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "decisionDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "evidenceDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "observedAt": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "audit": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": [
              "entryId",
              "eventKind",
              "providerId",
              "accountId",
              "baseUrl",
              "projectKey",
              "environmentKey",
              "environmentId",
              "flagKey",
              "flagVersion",
              "actorDigest",
              "descriptionDigest",
              "relatedApprovalId",
              "relatedApprovalDigest",
              "relatedProposalDigest",
              "scopeDigest",
              "observedAt",
              "bounded",
              "evidenceDigest"
            ],
            "additionalProperties": false,
            "properties": {
              "entryId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "eventKind": { "enum": ["approval_requested", "approval_decided", "change_scheduled", "change_applied", "change_failed", "unknown"] },
              "providerId": { "const": "launchdarkly-release" },
              "accountId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "baseUrl": { "type": "string", "format": "uri", "maxLength": 512 },
              "projectKey": { "type": "string", "minLength": 1, "maxLength": 128 },
              "environmentKey": { "type": "string", "minLength": 1, "maxLength": 128 },
              "environmentId": { "type": ["string", "null"], "maxLength": 128 },
              "flagKey": { "type": "string", "minLength": 1, "maxLength": 128 },
              "flagVersion": { "type": "integer", "minimum": 1 },
              "actorDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "descriptionDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "relatedApprovalId": { "type": ["string", "null"], "maxLength": 128 },
              "relatedApprovalDigest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
              "relatedProposalDigest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
              "scopeDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "observedAt": { "type": "integer", "minimum": 0 },
              "bounded": { "const": true },
              "evidenceDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        },
        "claims": {
          "type": "object",
          "required": ["connected", "native", "firstParty", "writeEffect", "outcomeAuthority"],
          "additionalProperties": false,
          "properties": {
            "connected": { "const": false },
            "native": { "const": false },
            "firstParty": { "const": false },
            "writeEffect": { "const": false },
            "outcomeAuthority": { "const": false }
          }
        }
      }
    },
    "boundaries": {
      "type": "object",
      "required": ["forbiddenOperations", "forbiddenAuthorities", "blockedEnvironmentStatus", "auditDescription", "targeting", "secretMaterial"],
      "additionalProperties": false,
      "properties": {
        "forbiddenOperations": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 10,
          "uniqueItems": true
        },
        "forbiddenAuthorities": {
          "type": "array",
          "items": { "enum": ["Truth", "Consent", "Effect", "Receipt", "Verification", "Outcome"] },
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true
        },
        "blockedEnvironmentStatus": { "const": "BLOCKED_ENV" },
        "auditDescription": { "const": "digest_only_bounded" },
        "targeting": { "const": "digest_only_no_context_attributes" },
        "secretMaterial": { "const": "never_serialized" }
      }
    }
  }
}
