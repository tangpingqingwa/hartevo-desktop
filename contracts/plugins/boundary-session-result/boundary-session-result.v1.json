{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tangpingqingwa/hartevo-desktop/contracts/plugins/boundary-session-result/boundary-session-result.v1.json",
  "title": "Hartevo HashiCorp Boundary session-result Layer-1 contract",
  "description": "A bounded read-only session and target metadata evidence proposal seam. It is not a Boundary authorization, connection, cancellation, credential, recording, Truth, Verification, Receipt, or Outcome authority.",
  "schemaVersion": "hartevo.boundary-session-result.contract/v1",
  "contractVersion": "boundary-session-result/v1",
  "pluginVersion": "1.0.0",
  "layer": "Layer-1",
  "service": {
    "id": "boundary.session.result",
    "implementation": "BoundarySessionResultService",
    "version": "1.0.0",
    "operations": [
      "describe_capabilities",
      "register",
      "revoke_registration",
      "list_sessions",
      "read_session",
      "read_target",
      "compile_proposal",
      "record_local",
      "verify_integrity"
    ],
    "readOnly": true,
    "proposalOnly": true,
    "liveExecution": false
  },
  "provider": {
    "id": "hashicorp.boundary.session",
    "implementation": "BoundaryProvider",
    "version": "1.0.0",
    "apiVersion": "v1",
    "officialApiBasis": [
      "https://developer.hashicorp.com/boundary/api-docs/session-service",
      "https://developer.hashicorp.com/boundary/docs/targets/sessions",
      "https://developer.hashicorp.com/boundary/docs/api"
    ],
    "allowlistedMethods": ["GET"],
    "allowlistedReads": [
      "GET /v1/sessions",
      "GET /v1/sessions/{id}",
      "GET /v1/targets/{id}"
    ],
    "acceptedTransports": ["fixture", "recording", "fake", "loopback", "BLOCKED_ENV"],
    "native": false,
    "connected": false,
    "firstParty": false,
    "authorize": false,
    "connect": false,
    "cancel": false,
    "credentialBrokering": false,
    "targetMutation": false,
    "hostMutation": false,
    "authMethodMutation": false,
    "ssh": false,
    "rdp": false,
    "recordingDownload": false
  },
  "consumer": {
    "id": "mission.boundary-session-result",
    "implementation": "MissionBoundarySessionConsumer",
    "version": "1.0.0",
    "missionBound": true,
    "projectBound": true,
    "workProductBound": true,
    "hostBound": true,
    "scopeBound": true,
    "organizationBound": true,
    "targetBound": true,
    "sessionBound": true,
    "authMethodBound": true,
    "accountBound": true,
    "principalDigestBound": true,
    "truthAuthority": false,
    "consentAuthority": false,
    "effectAuthority": false,
    "receiptAuthority": false,
    "verificationAuthority": false,
    "outcomeAuthority": false
  },
  "scope": {
    "required": [
      "apiHost",
      "hostId",
      "scopeIdAndRevision",
      "organizationIdAndRevision",
      "projectIdAndRevision",
      "targetIdAndRevision",
      "sessionIdAndRevision",
      "authMethodIdAndRevision",
      "accountIdAndRevision",
      "principalDigest",
      "missionIdAndRevision",
      "workProductIdAndRevision",
      "permissionDigest",
      "scopeDigest",
      "opaqueSecretReference"
    ],
    "apiHost": "exact_https_boundary_controller_origin",
    "secret": "opaque_token_or_oidc_secret_reference_only",
    "identifiers": "opaque_id_only",
    "principal": "digest_only"
  },
  "registration": {
    "pluginVersionBound": true,
    "contractVersionBound": true,
    "contractDigestBound": true,
    "providerIdBound": true,
    "providerImplementationBound": true,
    "providerVersionBound": true,
    "providerRevisionBound": true,
    "providerDigestBound": true,
    "permissionDigestBound": true,
    "scopeDigestBound": true,
    "evidenceDigestBound": true,
    "missionRevisionBound": true,
    "projectRevisionBound": true,
    "workProductRevisionBound": true,
    "reversible": true,
    "revocable": true,
    "failClosedOn": [
      "plugin_version_drift",
      "contract_version_or_digest_drift",
      "provider_identity_or_revision_drift",
      "permission_or_scope_digest_drift",
      "host_scope_organization_project_drift",
      "target_or_session_revision_drift",
      "auth_method_account_principal_drift",
      "mission_or_work_product_revision_drift",
      "evidence_digest_drift",
      "registration_tamper",
      "registration_revocation",
      "secret_reference_revocation"
    ]
  },
  "bounds": {
    "maxResponseBytes": 1048576,
    "maxIdentifierBytes": 128,
    "maxListTokenBytes": 256,
    "maxPages": 4,
    "maxSessionsPerPage": 64,
    "maxConnections": 64,
    "maxTimestampBytes": 64
  },
  "evidence": {
    "allowlistedFields": [
      "hostId",
      "scopeId",
      "organizationId",
      "projectId",
      "targetId",
      "sessionId",
      "authMethodId",
      "accountId",
      "principalDigest",
      "targetRevision",
      "sessionRevision",
      "sessionState",
      "createdAt",
      "updatedAt",
      "expirationAt",
      "terminatedAt",
      "connectionCounts",
      "targetMetadataDigests",
      "requestDigest",
      "responseDigest",
      "sourceDigest",
      "evidenceDigest",
      "registrationDigest",
      "missionProjectWorkProductScopeDigest"
    ],
    "rawProviderBody": false,
    "credentials": false,
    "hostSets": false,
    "hostAddresses": false,
    "connectionDetails": false,
    "recordingBytes": false,
    "usernames": false,
    "tokens": false,
    "rawTargetName": false,
    "rawTargetAddress": false
  },
  "projections": {
    "states": [
      "PENDING",
      "ACTIVE",
      "CANCELING",
      "TERMINATED",
      "EXPIRED",
      "PARTIAL",
      "ACCESS_LOST",
      "PROVIDER_UNKNOWN",
      "TAMPERED",
      "REVOKED"
    ],
    "failClosed": true,
    "lifecycleMonotonic": true,
    "expiryExplicit": true,
    "partialExplicit": true,
    "accessLostExplicit": true,
    "providerUnknownExplicit": true,
    "authorizationCorrectnessClaim": false,
    "reachabilityClaim": false,
    "userActivityClaim": false,
    "truthAuthority": false,
    "outcomeAuthority": false
  },
  "authority": {
    "readOnly": true,
    "proposalOnly": true,
    "authorize": false,
    "connect": false,
    "cancel": false,
    "credentialBrokering": false,
    "targetMutation": false,
    "hostMutation": false,
    "authMethodMutation": false,
    "ssh": false,
    "rdp": false,
    "recordingDownload": false,
    "effect": false,
    "receipt": false,
    "verification": false,
    "truth": false,
    "consent": false,
    "outcome": false,
    "workProductAdoption": false,
    "connected": false,
    "native": false,
    "firstParty": false
  },
  "redaction": {
    "secretReference": "opaque_digest_only",
    "listToken": "opaque_digest_only",
    "targetName": "digest_only",
    "targetAddress": "digest_only",
    "principal": "digest_only",
    "rawProviderBody": false,
    "credentials": false,
    "hostSets": false,
    "hostAddresses": false,
    "connectionDetails": false,
    "recordingBytes": false,
    "usernames": false,
    "tokens": false
  },
  "honesty": {
    "nativeStatus": "BLOCKED_ENV",
    "blockedEnvironmentIsNative": false,
    "fixtureIsNative": false,
    "recordingIsNative": false,
    "fakeIsNative": false,
    "loopbackIsNative": false,
    "connectedClaim": false,
    "firstPartyClaim": false,
    "durableProviderReceiptClaim": false,
    "sessionStateIsAuthorizationCorrectness": false,
    "sessionStateIsReachability": false,
    "sessionStateIsUserActivity": false,
    "layer1Boundary": "Layer 1 retains only opaque IDs, lifecycle timestamps, bounded connection counts and redacted digests; it never authorizes, connects, cancels, brokers credentials, mutates Boundary resources, executes SSH/RDP, downloads recordings, or adopts Hartevo authority."
  },
  "layer2Gaps": [
    "native_boundary_token_or_oidc_resolution",
    "authenticated_live_https_reads",
    "durable_provider_receipt",
    "independent_repeat_read_reconciliation",
    "authorization_correctness_and_reachability_verification",
    "session_connect_or_cancel_effects",
    "credential_brokering",
    "ssh_rdp_and_recording_access",
    "host_owned_consent_effect_and_outcome_authority",
    "verified_work_product_adoption"
  ],
  "forbidden": [
    "authorize_session",
    "connect_session",
    "cancel_session",
    "credential_brokering",
    "target_mutation",
    "host_mutation",
    "auth_method_mutation",
    "ssh_execution",
    "rdp_execution",
    "recording_download",
    "credential_serialization",
    "host_set_serialization",
    "host_address_serialization",
    "connection_detail_serialization",
    "recording_bytes_serialization",
    "username_serialization",
    "token_serialization",
    "raw_provider_body_serialization",
    "truth_authority",
    "consent_authority",
    "effect_authority",
    "receipt_authority",
    "verification_authority",
    "outcome_authority"
  ]
}
