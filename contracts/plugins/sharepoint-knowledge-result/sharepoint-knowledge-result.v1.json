{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hartevo.sharepoint-knowledge-result/v1",
  "title": "Hartevo Layer 1 Microsoft SharePoint knowledge-result contract",
  "schemaVersion": "hartevo.sharepoint-knowledge-result/v1",
  "contractVersion": "EXT-SHAREPOINT-KNOWLEDGE-01-L1/v1",
  "layer": 1,
  "plugin": {
    "id": "sharepoint-knowledge-result",
    "version": "1.0.0",
    "digestBound": true,
    "scopeBound": true,
    "permissionBound": true,
    "reversible": true,
    "revocable": true
  },
  "service": {
    "id": "SharePointKnowledgeResultService",
    "providerId": "MicrosoftGraphSharePointProvider",
    "consumerId": "MissionSharePointKnowledgeConsumer",
    "operations": [
      "describe_scope",
      "read_drive_item_metadata",
      "read_drive_item_children",
      "search_drive_items",
      "read_drive_item_versions",
      "read_drive_item_delta",
      "compile_knowledge_result"
    ],
    "effectAuthority": "none",
    "readOnly": true
  },
  "api": {
    "version": "v1.0",
    "basePath": "/v1.0",
    "nationalCloudBound": true,
    "siteBound": true,
    "boundedSeams": [
      "driveItem.metadata",
      "driveItem.children",
      "driveItem.search",
      "driveItem.versions",
      "driveItem.delta"
    ],
    "pathTemplates": {
      "metadata": "/v1.0/sites/{site-id}/drives/{drive-id}/items/{item-id}",
      "children": "/v1.0/sites/{site-id}/drives/{drive-id}/items/{item-id}/children",
      "search": "/v1.0/sites/{site-id}/drives/{drive-id}/root/search(q='[redacted]')",
      "versions": "/v1.0/sites/{site-id}/drives/{drive-id}/items/{item-id}/versions",
      "delta": "/v1.0/sites/{site-id}/drives/{drive-id}/items/{item-id}/delta"
    },
    "odataNextLink": true,
    "opaqueNextLink": true,
    "nativeHttps": false
  },
  "scope": {
    "exactFields": [
      "tenantId",
      "nationalCloud",
      "siteId",
      "siteHostname",
      "driveId",
      "listId",
      "itemId",
      "itemVersion",
      "searchScope",
      "permissionDigest",
      "projectId",
      "missionId",
      "workProductId",
      "workProductRevision",
      "consentScope",
      "consentId",
      "policyRevision",
      "capabilities"
    ],
    "tenantFenced": true,
    "nationalCloudFenced": true,
    "siteFenced": true,
    "driveFenced": true,
    "listFenced": true,
    "itemFenced": true,
    "versionFenced": true,
    "searchFenced": true,
    "permissionFenced": true,
    "projectMissionWorkProductFenced": true,
    "consentFenced": true
  },
  "registration": {
    "boundFields": [
      "pluginVersion",
      "contractVersion",
      "contractDigest",
      "providerId",
      "providerVersion",
      "providerRevision",
      "providerManifestDigest",
      "tenantDigest",
      "nationalCloud",
      "siteDigest",
      "driveDigest",
      "listDigest",
      "itemDigest",
      "versionDigest",
      "searchScopeDigest",
      "permissionDigest",
      "scopeDigest",
      "projectDigest",
      "missionDigest",
      "workProductDigest",
      "consentScopeDigest",
      "entraSecretReferenceDigest",
      "registrationDigest"
    ],
    "reversible": true,
    "revocable": true,
    "failClosedOnDrift": true
  },
  "readBoundaries": {
    "driveItemMetadata": true,
    "driveItemChildren": true,
    "driveItemSearch": true,
    "driveItemVersions": true,
    "driveItemDelta": true,
    "metadataOnly": true,
    "contentBytes": false,
    "downloadUrls": false,
    "maxResponseBytes": 1048576,
    "maxResponseFieldBytes": 4096,
    "maxChildren": 256,
    "maxSearchHits": 128,
    "maxVersions": 64,
    "maxDeltaEntries": 256,
    "maxPages": 4,
    "pageSize": 50
  },
  "redaction": {
    "rawBytes": false,
    "rawContent": false,
    "downloadUrls": false,
    "rawOdataNextLink": false,
    "rawSearchQuery": false,
    "rawItemNames": false,
    "rawPaths": false,
    "pii": false,
    "rawAuthorization": false,
    "credentialMaterial": false,
    "digests": [
      "metadata",
      "children",
      "search",
      "versions",
      "delta",
      "permission",
      "scope",
      "provider",
      "registration",
      "result"
    ]
  },
  "authority": {
    "externalWrite": false,
    "upload": false,
    "create": false,
    "update": false,
    "delete": false,
    "move": false,
    "share": false,
    "permissionMutation": false,
    "webhooks": false,
    "dashboard": false,
    "documentStore": false,
    "durableNativeReceipt": false,
    "independentReadback": false,
    "kernelOutcome": false,
    "workProductAdoption": false,
    "effect": false,
    "keyring": false,
    "browserProfile": false
  },
  "transportProvenance": [
    "recording",
    "fixture",
    "loopback",
    "BLOCKED_ENV"
  ],
  "native": {
    "credentials": "BLOCKED_ENV",
    "httpsReads": "BLOCKED_ENV",
    "connected": false,
    "fixtureConnected": false,
    "recordingConnected": false,
    "loopbackConnected": false,
    "blockedEnvConnected": false,
    "fixtureNative": false,
    "recordingNative": false,
    "loopbackNative": false,
    "blockedEnvNative": false,
    "nativeContentReadback": false,
    "nativeReceipt": false,
    "workProductAdoption": false
  },
  "typedHttpStatuses": [401, 403, 404, 409, 429, 500, 502, 503, 504],
  "secretBoundary": {
    "opaqueEntraSecretReferenceOnly": true,
    "nonSerializable": true,
    "rawAccessTokenInScope": false,
    "rawAccessTokenInDebug": false,
    "rawAuthorizationInDebug": false,
    "rawAuthorizationInReceipt": false
  },
  "forbiddenOperations": [
    "upload",
    "create",
    "update",
    "delete",
    "move",
    "share",
    "permission_mutation",
    "webhooks",
    "dashboard",
    "document_store"
  ],
  "layer2Gaps": [
    "native Microsoft Entra credential resolution",
    "native Connected status",
    "bounded native Microsoft Graph HTTPS reads",
    "raw SharePoint content and download handling",
    "native provider receipt",
    "independent content readback and reconciliation",
    "upload/create/update/delete/move/share/permission mutation",
    "webhooks/dashboard/document store",
    "verified Work Product adoption",
    "kernel Consent/Effect/Outcome authority"
  ],
  "honestNativeGap": "Layer 1 records only redacted metadata projections from fixture, recording, loopback, or BLOCKED_ENV seams. It never claims Connected or native access. Native credentials, content, readback, receipt, verification, and Work Product adoption remain Layer 2."
}
