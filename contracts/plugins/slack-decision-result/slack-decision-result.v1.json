{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tangpingqingwa/hartevo-desktop/contracts/plugins/slack-decision-result/slack-decision-result.v1.json",
  "title": "Hartevo governed Slack collaboration-decision result Layer-1 contract",
  "description": "A bounded, redacted conversations.history/conversations.replies decision-evidence seam. It is not a Slack sender, transcript store, consent authority, or Hartevo Truth authority.",
  "schemaVersion": "hartevo.slack-decision-result.contract/v1",
  "contractVersion": "slack-decision-result/v1",
  "pluginVersion": "1.0.0",
  "layer": "Layer-1",
  "officialReferences": [
    "https://api.slack.com/methods/conversations.history",
    "https://api.slack.com/methods/conversations.replies"
  ],
  "service": {
    "id": "slack.decision.result",
    "implementation": "SlackDecisionService",
    "version": "1.0.0",
    "operations": [
      "describe_capabilities",
      "register",
      "revoke_registration",
      "read_bounded",
      "propose",
      "record",
      "verify"
    ],
    "readOnly": true,
    "proposalOnly": true,
    "liveExecution": false,
    "externalWrites": false
  },
  "provider": {
    "id": "slack.conversations.read",
    "implementation": "SlackProvider",
    "version": "1.0.0",
    "apiRevision": "slack-conversations-read-r1",
    "allowlistedOperations": [
      "conversations.history",
      "conversations.replies"
    ],
    "allowlistedMethods": ["GET"],
    "acceptedTransports": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
    "native": false,
    "connected": false,
    "firstParty": false,
    "externalWrites": false,
    "rawMessageExport": false,
    "rawAttachmentExport": false,
    "opaqueSecretReference": true
  },
  "consumer": {
    "id": "mission.slack.decision-result",
    "implementation": "MissionSlackDecisionConsumer",
    "version": "1.0.0",
    "workspaceBound": true,
    "teamBound": true,
    "channelBound": true,
    "threadBound": true,
    "timeWindowBound": true,
    "decisionFingerprintBound": true,
    "missionBound": true,
    "projectBound": true,
    "workProductBound": true,
    "revisionBound": true,
    "producesDecisionProposal": true,
    "adoptsOutcome": false,
    "truthAuthority": false
  },
  "scope": {
    "required": [
      "workspace",
      "team",
      "channel",
      "thread",
      "timestamp_window",
      "decision_fingerprint",
      "mission_id_and_revision",
      "project_id_and_revision",
      "work_product_id_and_revision",
      "token_scope_digest",
      "secret_reference_digest"
    ],
    "target": "exactly_one_channel_and_optional_thread_projection",
    "secret": "opaque_non_serializing_bot_or_user_reference_only",
    "rawMessageText": false,
    "rawAttachments": false,
    "memberPii": false,
    "transcriptStore": false
  },
  "registration": {
    "pluginVersionBound": true,
    "contractVersionBound": true,
    "contractDigestBound": true,
    "providerIdBound": true,
    "providerVersionBound": true,
    "providerRevisionBound": true,
    "providerDigestBound": true,
    "apiDigestBound": true,
    "tokenScopeDigestBound": true,
    "scopeDigestBound": true,
    "evidenceDigestBound": true,
    "secretReferenceDigestBound": true,
    "registrationDigestBound": true,
    "reversible": true,
    "revocable": true,
    "failClosedOn": [
      "plugin_version_drift",
      "contract_version_or_digest_drift",
      "provider_or_api_revision_drift",
      "provider_or_api_digest_drift",
      "token_scope_drift",
      "workspace_team_channel_thread_scope_drift",
      "timestamp_window_drift",
      "decision_fingerprint_drift",
      "mission_project_work_product_revision_drift",
      "evidence_policy_drift",
      "secret_reference_revocation",
      "registration_tamper",
      "registration_revocation",
      "cursor_loop_or_replay",
      "retention_loss",
      "redaction_loss",
      "provider_unknown"
    ]
  },
  "bounds": {
    "maxResponseBytes": 1048576,
    "maxPages": 4,
    "pageSize": 50,
    "maxMessages": 256,
    "maxReplies": 256,
    "maxRequestsPerRead": 6,
    "maxCursorBytes": 512,
    "maxIdentifierBytes": 128,
    "maxWindowSeconds": 604800
  },
  "evidence": {
    "operations": ["conversations.history", "conversations.replies"],
    "states": [
      "complete",
      "empty",
      "partial",
      "retention_unavailable",
      "access_loss",
      "rate_limited",
      "timeout",
      "provider_unknown",
      "cursor_loop",
      "redaction_loss",
      "scope_drift",
      "replay_detected",
      "revoked"
    ],
    "retained": [
      "workspace_digest",
      "team_digest",
      "channel_digest",
      "thread_digest",
      "timestamp_window_digest",
      "decision_fingerprint",
      "mission_project_work_product_revision_digests",
      "bounded_participant_count",
      "bounded_message_count",
      "bounded_reply_count",
      "first_last_timestamp",
      "reaction_digest",
      "decision_marker_digest",
      "content_fingerprint_digest",
      "page_and_evidence_digests",
      "provider_error_kind"
    ],
    "notRetained": [
      "raw_message_text",
      "raw_message_payload",
      "raw_attachments",
      "files",
      "member_ids",
      "member_names",
      "emails",
      "user_profile_fields",
      "credentials",
      "raw_cursor",
      "raw_error_message",
      "transcript"
    ],
    "participantPii": false,
    "rawTranscript": false,
    "aggregateOnly": true
  },
  "redaction": {
    "secretMaterial": false,
    "rawCursor": false,
    "rawProviderPayload": false,
    "rawMessageText": false,
    "rawAttachments": false,
    "memberPii": false,
    "errorMessages": false,
    "unredactedPageFailsClosed": true
  },
  "transport": {
    "fixture": true,
    "recording": true,
    "loopback": true,
    "blockedEnv": true,
    "connected": false,
    "native": false,
    "firstParty": false,
    "safeBackoff": true
  },
  "authority": {
    "readOnly": true,
    "proposalOnly": true,
    "externalWrites": false,
    "chatPostMessage": false,
    "reactionMutation": false,
    "channelMutation": false,
    "memberMutation": false,
    "rawTranscriptExport": false,
    "messageSearch": false,
    "credentialResolution": false,
    "kernelAuthority": false,
    "consentAuthority": false,
    "effectAuthority": false,
    "receiptAuthority": false,
    "verificationAuthority": false,
    "workProductAdoption": false,
    "connected": false,
    "native": false,
    "durableNativeReceipt": false
  },
  "honesty": {
    "fixtureIsNative": false,
    "recordingIsNative": false,
    "loopbackIsNative": false,
    "blockedEnvironmentIsNative": false,
    "nativeStatus": "BLOCKED_ENV",
    "layer1Boundary": "Layer 1 emits bounded, redacted Slack conversation evidence and a Mission decision proposal only. Native token resolution, HTTPS calls, consent, durable receipts, independent reread, verification authority and Work Product adoption remain Layer-2 host exits."
  },
  "layer2Gaps": [
    "native_opaque_bot_or_user_token_resolution",
    "native_https_conversations_history",
    "native_https_conversations_replies",
    "durable_native_provider_receipt",
    "independent_readback_and_replay_store",
    "host_owned_consent_and_effect_authority",
    "verified_work_product_adoption"
  ],
  "forbidden": [
    "chat.postMessage",
    "reactions.add",
    "reactions.remove",
    "channel_create_or_update",
    "member_invite_or_remove",
    "raw_message_export",
    "raw_attachment_export",
    "member_pii_export",
    "unbounded_message_search",
    "transcript_storage",
    "credential_resolution",
    "claim_connected",
    "claim_native",
    "kernel_authority",
    "consent_authority",
    "durable_native_receipt",
    "verified_work_product_adoption"
  ]
}
