{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hartevo.local/contracts/plugins/github-deployment-status-result/github-deployment-status-result.v1.json",
  "title": "Hartevo GitHub deployment-status result Layer-1 contract",
  "description": "Bounded GitHub Deployment metadata and paginated Deployment Status history for a Mission decision; not a deployment effect, webhook, log/source/artifact store, generic release dashboard, or Outcome authority.",
  "schemaVersion": "hartevo.github-deployment-status-result/v1",
  "contractVersion": "github-deployment-status-result-e1/v1",
  "pluginVersion": "0.1.0",
  "layer": 1,
  "authority": {
    "readOnly": true,
    "proposalOnly": true,
    "connected": false,
    "nativeProvider": false,
    "durableReceipt": false,
    "kernelAuthority": false,
    "truthAuthority": false,
    "outcomeAuthority": false,
    "externalWrites": false,
    "deploymentWriteAuthority": false,
    "webhookAuthority": false,
    "releaseDashboardAuthority": false
  },
  "typedSurface": {
    "service": "GithubDeploymentStatusService",
    "provider": "GithubDeploymentStatusProvider",
    "consumer": "MissionGithubDeploymentStatusConsumer",
    "models": [
      "GithubDeploymentStatusScope",
      "GithubDeploymentStatusScopeSpec",
      "GithubAppInstallationId",
      "GithubOrganization",
      "GithubRepository",
      "GithubDeploymentId",
      "GithubRef",
      "GithubCommitSha",
      "GithubEnvironment",
      "GithubDeploymentStatusState",
      "GithubTimestamp",
      "ProjectBinding",
      "MissionBinding",
      "WorkProductBinding",
      "GithubDeploymentStatusPermissions",
      "SecretReference",
      "GithubDeploymentMetadata",
      "GithubDeploymentStatusMetadata",
      "GithubDeploymentStatusRegistration",
      "GithubDeploymentStatusEvidence",
      "GithubDeploymentStatusResultProposal",
      "GithubDeploymentStatusObservationReceipt"
    ]
  },
  "service": {
    "id": "github.deployment-status.result",
    "name": "GithubDeploymentStatusService",
    "version": "1.0.0",
    "access": "read_only",
    "operations": [
      "read_deployment_metadata",
      "read_deployment_status_history",
      "compile_result_proposal",
      "record_observation_receipt",
      "verify_proposal",
      "revoke_registration",
      "restore_registration"
    ],
    "externalWrites": false,
    "liveExternalIo": false,
    "createDeployment": false,
    "createDeploymentStatus": false,
    "webhookAcceptance": false
  },
  "provider": {
    "id": "github.deployments.deployment-status",
    "name": "GithubDeploymentStatusProvider",
    "version": "1.0.0",
    "apiRevision": "github-deployments-rest-v3",
    "apis": [
      "repos_deployments_get",
      "repos_deployment_statuses_get"
    ],
    "allowlistedGetPaths": [
      "/repos/{org}/{repo}/deployments/{deployment_id}",
      "/repos/{org}/{repo}/deployments/{deployment_id}/statuses"
    ],
    "requiredPermissions": ["deployments:read", "metadata:read"],
    "authentication": [
      "opaque_github_app_secret_reference",
      "opaque_github_oauth_secret_reference"
    ],
    "transportProvenance": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
    "maxPages": 8,
    "maxStatuses": 256,
    "maxHistoryDays": 90,
    "maxResponseBytes": 1048576,
    "rawCredentialSerialized": false,
    "rawCredentialDebug": false,
    "rawCredentialRequest": false,
    "rawCredentialReceipt": false,
    "rawResponseBody": false,
    "rawUrlValues": false,
    "rawDeploymentPayload": false,
    "rawCreatorOrReviewerPii": false,
    "logs": false,
    "source": false,
    "artifactBytes": false,
    "writes": false,
    "reversible": true,
    "revocable": true,
    "native": false,
    "connected": false
  },
  "consumer": {
    "id": "mission.github.deployment-status.result",
    "name": "MissionGithubDeploymentStatusConsumer",
    "kind": "mission_github_deployment_status_projection",
    "scope": [
      "installation",
      "organization",
      "repository",
      "deployment",
      "ref",
      "commit",
      "environment",
      "project",
      "mission",
      "work_product",
      "permission_digest",
      "source_evidence_digest"
    ],
    "adoptsOutcome": false,
    "kernelAuthority": false,
    "truthAuthority": false,
    "outcomeAuthority": false
  },
  "exactScope": [
    "installation",
    "organization",
    "repository",
    "deployment",
    "ref",
    "commit",
    "environment",
    "project",
    "mission",
    "work_product",
    "permissions"
  ],
  "allowlist": {
    "reads": [
      {
        "operation": "deployment_metadata",
        "method": "GET",
        "path": "/repos/{org}/{repo}/deployments/{deployment_id}",
        "metadataOnly": true
      },
      {
        "operation": "deployment_status_history",
        "method": "GET",
        "path": "/repos/{org}/{repo}/deployments/{deployment_id}/statuses",
        "metadataOnly": true,
        "opaquePagination": true,
        "historyRetentionDays": 90,
        "urlValues": "digest_only"
      }
    ],
    "writes": [],
    "forbidden": [
      "create_deployment",
      "create_deployment_status",
      "webhook_acceptance",
      "deployment_delete",
      "raw_token_export",
      "secret_resolution",
      "raw_response_body_export",
      "raw_deployment_payload_export",
      "raw_url_export",
      "log_body_export",
      "source_export",
      "artifact_byte_export",
      "creator_or_reviewer_pii_export",
      "generic_release_dashboard",
      "kernel_truth_adoption",
      "kernel_receipt_authority",
      "verified_work_product_adoption",
      "connected_claim",
      "native_provider_claim"
    ]
  },
  "authentication": {
    "boundary": "opaque GitHub App/OAuth SecretReference",
    "rawCredentialSerialized": false,
    "rawCredentialDebug": false,
    "rawCredentialRequest": false,
    "rawCredentialReceipt": false,
    "resolvedByLayer": 2
  },
  "bounds": {
    "maxPages": 8,
    "maxStatuses": 256,
    "maxHistoryDays": 90,
    "maxIdentifierBytes": 128,
    "maxRefBytes": 256,
    "maxEnvironmentBytes": 128,
    "maxTimestampBytes": 64,
    "maxUrlBytes": 2048,
    "maxResponseBytes": 1048576,
    "maxDiagnosticBytes": 512,
    "maxOpaqueHeaderBytes": 512
  },
  "normalization": {
    "deploymentIdentity": "repository_deployment_ref_sha_environment_bound",
    "deploymentStatusState": "typed_provider_reported",
    "timestamps": "bounded_rfc3339_text",
    "responseOrderIndependent": true,
    "statusHistory": "newest_first_with_90_day_truncation",
    "urlValues": "redacted_to_sha256_digest",
    "opaqueEtags": "digest_only",
    "opaquePagination": "digest_only",
    "rawJson": false,
    "rawPayload": false,
    "rawLogs": false,
    "rawSource": false,
    "rawArtifacts": false,
    "states": [
      "queued",
      "pending",
      "in_progress",
      "success",
      "failure",
      "error",
      "inactive",
      "partial",
      "history_truncated",
      "access_lost",
      "not_found",
      "rate_limited",
      "stale_state",
      "provider_unknown"
    ],
    "absenceIsSuccess": false,
    "causalClaims": false
  },
  "digests": {
    "version": true,
    "contract": true,
    "provider": true,
    "api": true,
    "installation": true,
    "permission": true,
    "scope": true,
    "repository": true,
    "deployment": true,
    "ref": true,
    "commit": true,
    "environment": true,
    "status": true,
    "url": true,
    "response": true,
    "evidence": true,
    "registration": true
  },
  "registration": {
    "versionBound": true,
    "contractDigestBound": true,
    "providerDigestBound": true,
    "permissionDigestBound": true,
    "scopeDigestBound": true,
    "secretReferenceDigestBound": true,
    "registrationDigestBound": true,
    "reversible": true,
    "revocable": true,
    "rotationOnStateChange": true,
    "failClosedOn": [
      "version_drift",
      "contract_drift",
      "provider_drift",
      "api_drift",
      "installation_drift",
      "organization_drift",
      "repository_drift",
      "deployment_drift",
      "ref_drift",
      "sha_drift",
      "environment_drift",
      "permission_drift",
      "pagination_cursor_mismatch",
      "etag_mismatch",
      "history_truncation",
      "stale_state",
      "registration_revocation",
      "tamper",
      "replay"
    ]
  },
  "receipts": {
    "request": true,
    "response": true,
    "etagDigest": true,
    "paginationDigest": true,
    "observation": true,
    "durableNativeReceipt": false,
    "rawHeaders": false,
    "rawResponseBody": false,
    "rawUrlValues": false
  },
  "honesty": {
    "fixtureNative": false,
    "recordingNative": false,
    "loopbackNative": false,
    "blockedEnvNative": false,
    "fixtureConnected": false,
    "recordingConnected": false,
    "loopbackConnected": false,
    "blockedEnvConnected": false,
    "nativeGithubAppOrOauth": "layer_2_gap",
    "nativeHttpsTransport": "layer_2_gap",
    "durableProviderReceipt": "layer_2_gap",
    "independentDeploymentReadback": "layer_2_gap",
    "independentStatusReadback": "layer_2_gap",
    "createDeployment": "layer_2_forbidden_until_consented_effect",
    "createDeploymentStatus": "layer_2_forbidden_until_consented_effect",
    "webhookAcceptance": "layer_2_gap",
    "absenceIsSuccess": false,
    "statusIsCausalTruth": false,
    "statusIsOutcomeAuthority": false,
    "verifiedWorkProductAdoption": "layer_2_gap"
  },
  "authorityBoundary": {
    "externalRead": "typed_bounded_deployment_and_status_get_only",
    "externalWrite": false,
    "createDeployment": false,
    "createDeploymentStatus": false,
    "webhookAcceptance": false,
    "logs": false,
    "source": false,
    "artifacts": false,
    "connected": false,
    "native": false,
    "kernelReceipt": false,
    "kernelTruth": false,
    "kernelOutcome": false,
    "consentAuthority": false
  },
  "distinction": {
    "notGithubIssuesOrPullRequests": true,
    "notGithubActionsWorkflowResult": true,
    "notGithubArtifactAttestation": true,
    "notDeploymentCreation": true,
    "notDeploymentStatusCreation": true,
    "notWebhookIngestion": true,
    "notSourceStore": true,
    "notArtifactStore": true,
    "providerDomain": "GitHub Deployment and Deployment Status metadata only"
  },
  "documentation": [
    "https://docs.github.com/en/rest/deployments/deployments?apiVersion=2022-11-28",
    "https://docs.github.com/en/rest/deployments/statuses?apiVersion=2022-11-28"
  ],
  "errorHandling": [
    "HTTP_400",
    "HTTP_401",
    "HTTP_403",
    "HTTP_404",
    "HTTP_409",
    "HTTP_422",
    "HTTP_429",
    "HTTP_5XX",
    "BLOCKED_ENV",
    "TIMEOUT",
    "MALFORMED_RESPONSE",
    "RESPONSE_TOO_LARGE",
    "PAGINATION_CURSOR_MISMATCH",
    "ETAG_MISMATCH",
    "SCOPE_MISMATCH",
    "STALE_STATE",
    "HISTORY_TRUNCATED",
    "TAMPER",
    "REPLAY",
    "REVOCATION"
  ],
  "layer2Gaps": [
    "native_github_app_or_oauth_resolution",
    "native_github_deployment_https_transport",
    "durable_provider_receipt",
    "independent_deployment_readback",
    "independent_status_readback",
    "consented_create_deployment_effect",
    "consented_create_deployment_status_effect",
    "webhook_acceptance_and_reconciliation",
    "kernel_receipt_persistence",
    "kernel_truth_or_outcome_authority",
    "verified_work_product_adoption"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "$id",
    "schemaVersion",
    "contractVersion",
    "pluginVersion",
    "layer",
    "authority",
    "typedSurface",
    "service",
    "provider",
    "consumer",
    "exactScope",
    "allowlist",
    "authentication",
    "bounds",
    "normalization",
    "digests",
    "registration",
    "receipts",
    "honesty",
    "authorityBoundary",
    "distinction",
    "documentation",
    "errorHandling",
    "layer2Gaps"
  ]
}
