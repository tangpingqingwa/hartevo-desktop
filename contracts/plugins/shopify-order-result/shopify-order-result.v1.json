{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tangpingqingwa/hartevo-desktop/contracts/plugins/shopify-order-result/shopify-order-result.v1.json",
  "title": "Hartevo Shopify governed commerce order-result Layer-1 contract",
  "description": "A bounded, read/proposal/recording-only Shopify Admin GraphQL seam for order financial, fulfillment, refund, transaction, and revision evidence. It is not a payment authority, native connector, receipt authority, or Work Product adoption authority.",
  "schemaVersion": "hartevo.shopify-order-result-contract/v1",
  "contractVersion": "shopify-order-result/v1",
  "pluginVersion": "0.1.0",
  "layer": "Layer-1",
  "officialApiBasis": [
    "https://shopify.dev/docs/api/admin-graphql/latest/objects/order",
    "https://shopify.dev/docs/api/admin-graphql/latest/objects/refund"
  ],
  "apiVersion": "2026-07",
  "service": {
    "id": "shopify.order-result",
    "implementation": "ShopifyOrderResultService",
    "access": "read_proposal_recording_only",
    "readOnly": true,
    "liveExecution": false,
    "paymentAuthority": false
  },
  "provider": {
    "id": "shopify.admin",
    "implementation": "ShopifyAdminProvider",
    "version": "0.1.0",
    "native": false,
    "connected": false,
    "firstParty": false,
    "externalWrites": false,
    "acceptedProvenance": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
    "mutatingOperations": []
  },
  "consumer": {
    "id": "mission.shopify-order-result",
    "implementation": "MissionShopifyOrderConsumer",
    "missionBound": true,
    "projectBound": true,
    "workProductBound": true,
    "adoptsOutcome": false,
    "adoptsWorkProduct": false,
    "truthAuthority": false,
    "paymentAuthority": false
  },
  "scope": {
    "required": [
      "apiVersion",
      "shopDomain",
      "orderId",
      "opaqueSecretReference",
      "permissionLease",
      "permissionDigest",
      "projectIdAndRevision",
      "missionIdAndRevision",
      "workProductIdAndRevision",
      "policyRevision",
      "scopeDigest"
    ],
    "secret": "opaque_non_serializable_reference_only"
  },
  "digests": [
    "pluginVersionDigest",
    "contractDigest",
    "providerDigest",
    "providerImplementationDigest",
    "permissionDigest",
    "scopeDigest",
    "registrationDigest",
    "orderRevisionDigest",
    "proposalDigest",
    "evidenceDigest",
    "adoptionProposalDigest",
    "responseDigest"
  ],
  "queryPolicy": {
    "oneOrderOnly": true,
    "allowlistedSelectionOnly": true,
    "allow": [
      "order.id",
      "order.updatedAt",
      "order.createdAt",
      "order.currencyCode",
      "order.displayFinancialStatus",
      "order.displayFulfillmentStatus",
      "order.currentTotalPriceSet.shopMoney.amount",
      "order.currentTotalPriceSet.shopMoney.currencyCode",
      "order.totalRefundedSet.shopMoney.amount",
      "order.totalRefundedSet.shopMoney.currencyCode",
      "order.fulfillmentOrders.nodes.id",
      "order.fulfillmentOrders.nodes.status",
      "order.fulfillmentOrders.nodes.requestStatus",
      "order.fulfillmentOrders.nodes.createdAt",
      "order.fulfillmentOrders.nodes.updatedAt",
      "order.fulfillmentOrders.pageInfo.hasNextPage",
      "order.fulfillmentOrders.pageInfo.endCursor",
      "order.fulfillments.id",
      "order.fulfillments.status",
      "order.fulfillments.createdAt",
      "order.fulfillments.updatedAt",
      "order.refunds.id",
      "order.refunds.createdAt",
      "order.refunds.processedAt",
      "order.refunds.updatedAt",
      "order.refunds.totalRefundedSet.shopMoney.amount",
      "order.refunds.totalRefundedSet.shopMoney.currencyCode",
      "order.refunds.transactions.nodes.id",
      "order.refunds.transactions.nodes.status",
      "order.refunds.transactions.pageInfo.hasNextPage",
      "order.refunds.transactions.pageInfo.endCursor",
      "order.transactions.id",
      "order.transactions.kind",
      "order.transactions.status",
      "order.transactions.amountSet.shopMoney.amount",
      "order.transactions.amountSet.shopMoney.currencyCode",
      "order.transactions.createdAt",
      "order.transactions.processedAt"
    ],
    "deny": [
      "mutation",
      "customer",
      "email",
      "phone",
      "shippingAddress",
      "billingAddress",
      "lineItems",
      "paymentInstrument",
      "paymentDetails",
      "gateway",
      "note",
      "rawGraphqlBody",
      "arbitraryQuery",
      "externalWrite"
    ]
  },
  "bounds": {
    "maxResponseBytes": 1048576,
    "maxPages": 4,
    "pageSize": 25,
    "maxFulfillmentOrders": 64,
    "maxFulfillments": 64,
    "maxRefunds": 64,
    "maxTransactions": 128,
    "maxIdentifierBytes": 256,
    "maxTimestampBytes": 64,
    "maxRetryAttempts": 3,
    "maxRetryAfterMilliseconds": 600000
  },
  "evidence": {
    "states": [
      "pending",
      "authorized",
      "succeeded",
      "failed",
      "partially_refunded",
      "unknown",
      "unfulfilled",
      "in_progress",
      "partially_fulfilled",
      "fulfilled",
      "cancelled"
    ],
    "projectionStates": [
      "complete",
      "partial",
      "access_lost",
      "deleted",
      "expired",
      "conflict",
      "rate_limited",
      "provider_unknown",
      "BLOCKED_ENV"
    ],
    "bounded": true,
    "responseStatusRecorded": true,
    "responseSizeRecorded": true,
    "responseDigestRecorded": true,
    "providerRevisionRecorded": true,
    "rawGraphqlBodyRetained": false,
    "rawGraphqlErrorsRetained": false,
    "customerPiiRetained": false,
    "lineItemsRetained": false,
    "addressesRetained": false,
    "paymentInstrumentRetained": false,
    "durableNativeReceipt": false
  },
  "registration": {
    "boundFields": [
      "pluginVersion",
      "contractVersion",
      "contractDigest",
      "providerDigest",
      "providerImplementationDigest",
      "apiVersion",
      "shopDomain",
      "orderId",
      "opaqueSecretReferenceDigest",
      "credentialRevision",
      "permissionLeaseRevision",
      "permissionDigest",
      "scopeDigest",
      "projectIdAndRevision",
      "missionIdAndRevision",
      "workProductIdAndRevision",
      "policyRevision"
    ],
    "reversible": true,
    "revocable": true,
    "failClosedOn": [
      "api_version_drift",
      "shop_drift",
      "order_drift",
      "provider_drift",
      "permission_drift",
      "permission_expiry",
      "scope_drift",
      "project_revision_drift",
      "mission_revision_drift",
      "work_product_revision_drift",
      "policy_drift",
      "registration_tamper",
      "registration_revocation",
      "external_write_request"
    ]
  },
  "authority": {
    "connected": false,
    "native": false,
    "firstParty": false,
    "externalWrites": false,
    "paymentAuthority": false,
    "truthAuthority": false,
    "consentAuthority": false,
    "effectAuthority": false,
    "receiptAuthority": false,
    "verificationAuthority": false,
    "outcomeAuthority": false,
    "independentReadBack": false,
    "verifiedWorkProductAdoption": false
  },
  "evidenceModes": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
  "forbidden": [
    "nativeCredentialResolution",
    "nativeConnectedClaim",
    "firstPartyProviderClaim",
    "createOrder",
    "updateOrder",
    "capturePayment",
    "refundPayment",
    "cancelOrder",
    "rawCredentialMaterial",
    "rawGraphqlBodyRetention",
    "customerPiiRetention",
    "lineItemRetention",
    "addressRetention",
    "paymentInstrumentRetention",
    "durableNativeReceipt",
    "independentWriteReadBack",
    "verifiedAdoption"
  ],
  "layer2Gaps": [
    "consented_native_secret_resolution",
    "bounded_native_shopify_https_transport",
    "durable_provider_receipt",
    "independent_read_back_after_any_effect",
    "ambiguity_recovery",
    "verified_work_product_adoption"
  ],
  "honestNativeGap": "Fixture, recording, loopback, and BLOCKED_ENV evidence are always connected=false, native=false, and first_party=false. Layer 1 has no payment/refund authority, external write, durable native receipt, independent read-back, verification, or Work Product adoption authority."
}
