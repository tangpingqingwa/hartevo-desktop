{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tangpingqingwa/hartevo-desktop/contracts/plugins/openai-responses-result/openai-responses-result.v1.json",
  "title": "Hartevo OpenAI Responses direct result Layer-1 contract",
  "description": "A bounded, redacted, proposal-and-recording-only seam for direct OpenAI Responses. It is not Batch, a native connector, a tool registry, a model catalog, or kernel authority.",
  "schemaVersion": "hartevo.openai-responses-result.contract/v1",
  "contractVersion": "openai-responses-result/v1",
  "pluginVersion": "0.1.0",
  "layer": "Layer-1",
  "serviceId": "hartevo.openai.responses.result",
  "providerId": "openai.responses",
  "consumerId": "mission.openai.responses.result",
  "api": "responses.create",
  "scope": [
    "organization_id_and_revision",
    "project_id_and_revision",
    "opaque_secret_reference_digest",
    "responses_permission",
    "model_id_and_immutable_snapshot",
    "input_policy_and_revision",
    "structured_output_schema_digest",
    "tool_policy",
    "response_policy",
    "mission_id_and_revision",
    "work_product_id_and_revision",
    "consent_id_and_revision"
  ],
  "digests": [
    "plugin_version_digest",
    "contract_digest",
    "provider_digest",
    "organization_digest",
    "project_digest",
    "model_snapshot_digest",
    "input_policy_digest",
    "structured_schema_digest",
    "tool_policy_digest",
    "permission_digest",
    "consent_digest",
    "scope_digest",
    "registration_digest",
    "request_digest",
    "response_digest",
    "output_content_digest",
    "error_digest"
  ],
  "registration": {
    "versionAndContractBound": true,
    "providerBound": true,
    "permissionAndScopeBound": true,
    "modelSnapshotBound": true,
    "policySchemaAndToolBound": true,
    "reversible": true,
    "revocable": true,
    "failClosedOn": [
      "organization_drift",
      "project_revision_drift",
      "model_snapshot_drift",
      "input_policy_drift",
      "structured_schema_drift",
      "tool_policy_drift",
      "permission_drift",
      "consent_drift",
      "registration_tamper",
      "registration_revocation",
      "proposal_replay",
      "evidence_replay"
    ]
  },
  "inputAllowlist": {
    "text": true,
    "imageReference": true,
    "fileReference": true,
    "rawImageBytes": false,
    "rawFileBytes": false,
    "uploads": false,
    "undeclaredFiles": false,
    "unboundedContent": false
  },
  "structuredOutputs": {
    "optional": true,
    "jsonSchema": true,
    "strict": true,
    "rawSchemaRetention": false
  },
  "toolPolicy": {
    "default": "disabled",
    "arbitraryToolExecution": false,
    "toolCallArguments": false,
    "webSearch": false
  },
  "responseStatuses": [
    "queued",
    "running",
    "completed",
    "incomplete",
    "failed",
    "cancelled",
    "expired",
    "rate_limited",
    "access_lost",
    "provider_unknown"
  ],
  "evidenceModes": [
    "fixture",
    "recording",
    "loopback",
    "BLOCKED_ENV"
  ],
  "authority": {
    "connected": false,
    "native": false,
    "externalWrites": false,
    "nativeCredentialResolution": false,
    "durableProviderReceipt": false,
    "independentReadBack": false,
    "kernelTruth": false,
    "kernelVerification": false,
    "kernelOutcomeAdoption": false,
    "toolExecution": false,
    "webSearch": false,
    "batchLifecycle": false
  },
  "forbidden": [
    "raw_token_serialization",
    "raw_prompt_retention",
    "raw_output_retention",
    "hidden_reasoning_capture",
    "tool_call_arguments",
    "arbitrary_tool_execution",
    "web_search",
    "file_upload",
    "batch_jsonl_files",
    "batch_24_hour_orchestration",
    "fine_tuning",
    "model_deployment",
    "organization_project_or_key_mutation",
    "generic_model_registry",
    "dashboard_authority",
    "native_connected_claim",
    "kernel_receipt",
    "kernel_verification",
    "kernel_outcome_adoption"
  ],
  "layer2Gaps": [
    "native_credential_resolution",
    "bounded_https_responses_inference",
    "durable_provider_receipt",
    "independent_result_readback",
    "verified_work_product_adoption"
  ],
  "nonOverlap": {
    "batchIssue": 405,
    "purpose": "Direct bounded Responses result only; Batch file lifecycle and 24-hour orchestration remain separately owned."
  }
}
