{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tangpingqingwa/hartevo-desktop/contracts/plugins/aws-api-gateway-result/aws-api-gateway-result.v1.json",
  "title": "Hartevo AWS API Gateway deployment result Layer-1 contract",
  "description": "A bounded, read/proposal/record/verify-only API Gateway stage and deployment metadata seam. It is not an API invocation, deployment receipt, availability certification, route mutation, or Hartevo Truth authority.",
  "schemaVersion": "hartevo.aws-api-gateway-result.contract/v1",
  "contractVersion": "aws-api-gateway-result/v1",
  "pluginVersion": "1.0.0",
  "layer": "Layer-1",
  "officialReferences": [
    "https://docs.aws.amazon.com/apigateway/latest/api/API_GetStage.html",
    "https://docs.aws.amazon.com/apigateway/latest/api/API_GetDeployment.html",
    "https://docs.aws.amazon.com/apigateway/latest/api/API_GetDeployments.html",
    "https://docs.aws.amazon.com/apigatewayv2/latest/api-reference/apis-apiid-stages-stagename.html"
  ],
  "service": {
    "id": "hartevo.aws.api-gateway.deployment-result",
    "implementation": "AwsApiGatewayService",
    "version": "1.0.0",
    "operations": [
      "describe_capabilities",
      "register",
      "revoke_registration",
      "read_get_stage",
      "read_get_deployment",
      "read_get_deployments",
      "propose",
      "record",
      "verify"
    ],
    "readOnly": true,
    "proposalOnly": true,
    "liveExecution": false
  },
  "provider": {
    "id": "aws.api-gateway",
    "implementation": "AwsApiGatewayProvider",
    "version": "aws-api-gateway-provider/v1",
    "apiRevision": "aws-apigateway-read-r1",
    "apiVersions": ["2015-07-09", "2018-11-29"],
    "allowlistedOperations": ["GetStage", "GetDeployment", "GetDeployments"],
    "allowlistedMethods": ["POST", "GET"],
    "acceptedTransports": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
    "native": false,
    "connected": false,
    "firstParty": false,
    "externalWrites": false,
    "sigV4Secret": "opaque_non_serializing_secret_reference_only"
  },
  "consumer": {
    "id": "mission.aws.api-gateway.deployment-result",
    "implementation": "MissionAwsApiGatewayConsumer",
    "version": "1.0.0",
    "deploymentBound": true,
    "missionBound": true,
    "projectBound": true,
    "workProductBound": true,
    "revisionBound": true,
    "permissionBound": true,
    "producesDecisionProposal": true,
    "adoptsOutcome": false,
    "truthAuthority": false,
    "certificationAuthority": false
  },
  "scope": {
    "required": [
      "account_id",
      "region",
      "rest_or_http_api_kind",
      "api_id_and_revision",
      "stage_name_and_revision",
      "api_deployment_id_and_revision",
      "commit_or_configuration_digest",
      "project_id_and_revision",
      "mission_id_and_revision",
      "work_product_id_and_revision",
      "deployment_id_and_revision",
      "permission_digest",
      "secret_reference_digest",
      "scope_digest"
    ],
    "allowlist": "exact_api_stage_and_deployment_only",
    "stageMetadataOnly": true,
    "apiDefinitions": false,
    "stageVariables": false,
    "authorizerSecrets": false,
    "accessLogs": false,
    "invocationPayloads": false
  },
  "registration": {
    "pluginVersionBound": true,
    "providerIdBound": true,
    "providerVersionBound": true,
    "providerRevisionBound": true,
    "providerDigestBound": true,
    "apiDigestBound": true,
    "contractVersionBound": true,
    "contractDigestBound": true,
    "permissionDigestBound": true,
    "scopeDigestBound": true,
    "secretReferenceDigestBound": true,
    "stageDigestBound": true,
    "deploymentDigestBound": true,
    "evidenceDigestBound": true,
    "reversible": true,
    "revocable": true,
    "failClosedOn": [
      "plugin_version_drift",
      "provider_or_api_revision_drift",
      "provider_or_contract_digest_drift",
      "permission_or_scope_digest_drift",
      "secret_reference_revocation",
      "stage_or_deployment_revision_drift",
      "registration_tamper",
      "registration_revocation",
      "pagination_loop_or_replay",
      "partial_or_unknown_data",
      "access_loss",
      "throttle",
      "timeout"
    ]
  },
  "bounds": {
    "maxResponseBytes": 1048576,
    "maxPages": 4,
    "pageSize": 50,
    "maxDeployments": 256,
    "maxRequestsPerRead": 10,
    "maxRetries": 2,
    "maxIdentifierBytes": 128,
    "maxCursorBytes": 512
  },
  "evidence": {
    "operations": ["GetStage", "GetDeployment", "GetDeployments"],
    "statuses": ["complete", "partial", "access_loss", "provider_unknown"],
    "digests": [
      "plugin_version",
      "provider",
      "api",
      "contract",
      "permission",
      "scope",
      "stage",
      "deployment",
      "request",
      "evidence",
      "proposal",
      "record"
    ],
    "retained": [
      "api_kind",
      "api_id",
      "api_revision",
      "stage_name",
      "stage_revision",
      "api_deployment_id",
      "deployment_revision",
      "deployment_created_at",
      "stage_last_updated",
      "canary_traffic_percentage_metadata",
      "route_auth_summary_digest",
      "commit_or_configuration_digest",
      "status_classification",
      "error_classification",
      "redacted_request_receipt",
      "redacted_cost_receipt",
      "pagination_token_digest"
    ],
    "notRetained": [
      "api_definition",
      "openapi_or_swagger_document",
      "authorizer_secret",
      "stage_variables",
      "access_logs",
      "invocation_payload",
      "credential_material",
      "raw_provider_error_message",
      "raw_next_token"
    ],
    "missingOrInsufficientDataFailsClosed": true
  },
  "redaction": {
    "secretMaterial": false,
    "rawNextToken": false,
    "rawProviderPayload": false,
    "apiDefinitions": false,
    "authorizerSecrets": false,
    "stageVariables": false,
    "accessLogs": false,
    "invocationPayloads": false,
    "providerErrorMessages": false
  },
  "authority": {
    "readOnly": true,
    "proposalOnly": true,
    "externalWrites": false,
    "createStage": false,
    "updateStage": false,
    "deleteStage": false,
    "createDeployment": false,
    "updateDeployment": false,
    "deleteDeployment": false,
    "routeMutation": false,
    "integrationMutation": false,
    "apiInvocation": false,
    "credentialResolution": false,
    "availabilityCertification": false,
    "connected": false,
    "native": false,
    "firstParty": false,
    "durableReceipt": false,
    "verificationAuthority": false,
    "kernelTruthAuthority": false,
    "consentAuthority": false,
    "effectAuthority": false,
    "outcomeAdoption": false
  },
  "honesty": {
    "nativeStatus": "BLOCKED_ENV",
    "blockedEnvironmentIsNative": false,
    "fixtureIsNative": false,
    "recordingIsNative": false,
    "loopbackIsNative": false,
    "connectedClaims": false,
    "firstPartyClaims": false,
    "metadataIsAvailabilityCertification": false,
    "layer1Boundary": "Layer 1 emits bounded external metadata evidence and a Mission decision proposal only. Native SigV4/HTTPS, durable deployment receipts, independent execute/read-back reconciliation, consented effects and verified Work Product adoption remain Layer-2 host authority."
  },
  "layer2Gaps": [
    "native_sigv4_https_transport_and_credential_resolution",
    "durable_deployment_receipt",
    "independent_post_deployment_execute_and_readback_reconciliation",
    "consented_stage_route_or_integration_effects",
    "production_availability_certification",
    "verified_work_product_adoption"
  ],
  "forbidden": [
    "create_stage",
    "update_stage",
    "delete_stage",
    "create_deployment",
    "update_deployment",
    "delete_deployment",
    "mutate_routes_or_integrations",
    "invoke_api",
    "export_stage_variables",
    "retrieve_authorizer_secrets",
    "retrieve_access_logs",
    "retrieve_invocation_payloads",
    "resolve_live_credentials",
    "claim_connected",
    "claim_native",
    "claim_first_party",
    "claim_production_availability",
    "adopt_kernel_outcome",
    "promote_work_product"
  ]
}
