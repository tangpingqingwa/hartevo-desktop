{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tangpingqingwa/hartevo-desktop/contracts/plugins/workos-directory-result/workos-directory-result.v1.json",
  "title": "Hartevo WorkOS Directory Sync result Layer-1 contract",
  "description": "Bounded, read-only WorkOS Directory Sync organization, directory, connection, user, group, and filtered membership evidence. This contract emits a Mission proposal below kernel identity and Consent authority.",
  "schemaVersion": "hartevo.workos-directory-result.contract/v1",
  "contractVersion": "workos-directory-result/v1",
  "pluginId": "hartevo.workos.directory-result",
  "pluginVersion": "1.0.0",
  "layer": "Layer-1",
  "service": {
    "id": "hartevo.workos.directory.result",
    "implementation": "WorkOsDirectoryResultService",
    "version": "1.0.0",
    "operations": [
      "describe_capabilities",
      "register",
      "reverse_registration",
      "restore_registration",
      "revoke_registration",
      "read_connection",
      "read_directory",
      "read_filtered_memberships",
      "compile_evidence_proposal",
      "verify_proposal",
      "record_proposal",
      "read_back_record"
    ],
    "readOnly": true,
    "proposalOnly": true,
    "liveExecution": false,
    "externalWrites": false
  },
  "provider": {
    "id": "workos.directory-sync.read",
    "implementation": "WorkOsDirectoryProvider",
    "version": "workos-directory-sync-api-v1",
    "apiBase": "https://api.workos.com",
    "allowlistedMethods": ["GET"],
    "allowlistedReads": [
      "GET /connections/:id",
      "GET /directories/:id",
      "GET /directory_users?directory=:directory_id&group=:group_id",
      "GET /directory_groups?directory=:directory_id&user=:user_id"
    ],
    "pagination": {
      "parameters": ["limit", "before", "after", "order"],
      "directions": ["before", "after"],
      "cursorOpaque": true,
      "cursorDigestOnlyInEvidence": true,
      "replayRejected": true,
      "expiryRejected": true,
      "maxPages": 8,
      "maxPageSize": 100
    },
    "authentication": {
      "scheme": "workos_api_key",
      "secretReference": "opaque_api_key_secret_reference_only",
      "rawApiKeySerialized": false,
      "rawApiKeyDebug": false,
      "rawApiKeyRequest": false,
      "nativeResolution": false
    },
    "acceptedTransports": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
    "native": false,
    "connected": false,
    "firstParty": false,
    "durableProviderReceipt": false,
    "externalWrites": false,
    "identityMutation": false,
    "directoryMutation": false,
    "userMutation": false,
    "groupMutation": false,
    "accessGrantAuthority": false
  },
  "consumer": {
    "id": "mission.workos-directory-result",
    "implementation": "MissionWorkOsDirectoryConsumer",
    "version": "1.0.0",
    "scope": [
      "organization",
      "directory",
      "connection",
      "user",
      "group",
      "membership_filter",
      "project",
      "mission",
      "consent",
      "permission_digest",
      "provider_revision",
      "registration_digest",
      "evidence_digest"
    ],
    "missionBound": true,
    "projectBound": true,
    "consentBound": true,
    "adoptsOutcome": false,
    "identityAuthority": false,
    "accessGrantAuthority": false,
    "truthAuthority": false,
    "consentAuthority": false,
    "effectAuthority": false
  },
  "exactScope": {
    "organization": "organization_id",
    "directory": "directory_id",
    "connection": "connection_id",
    "user": "directory_user_id_or_user_filter_digest",
    "group": "directory_group_id_or_group_filter_digest",
    "membership": "exactly_one_filtered_user_or_group",
    "project": ["project_id", "project_revision"],
    "mission": ["mission_id", "mission_revision"],
    "consent": ["consent_id", "consent_revision"],
    "permission": "permission_digest"
  },
  "registration": {
    "versionBound": true,
    "contractVersionBound": true,
    "contractDigestBound": true,
    "providerIdBound": true,
    "providerRevisionBound": true,
    "providerDigestBound": true,
    "apiDigestBound": true,
    "permissionDigestBound": true,
    "scopeDigestBound": true,
    "secretReferenceDigestBound": true,
    "missionRevisionBound": true,
    "projectRevisionBound": true,
    "consentRevisionBound": true,
    "evidenceDigestBound": true,
    "reversible": true,
    "revocable": true,
    "failClosedOn": [
      "plugin_version_drift",
      "contract_version_or_digest_drift",
      "provider_identity_or_revision_drift",
      "organization_directory_connection_scope_drift",
      "filtered_membership_scope_drift",
      "permission_digest_drift",
      "mission_project_consent_revision_drift",
      "secret_reference_revocation",
      "cursor_replay_or_expiry",
      "provider_revision_drift",
      "evidence_or_proposal_digest_drift",
      "record_or_readback_fence_drift",
      "registration_tamper",
      "registration_revocation"
    ]
  },
  "evidence": {
    "retains": [
      "organization_id",
      "directory_id",
      "connection_id",
      "directory_state",
      "connection_state",
      "directory_user_id",
      "directory_group_id",
      "user_state",
      "group_state",
      "idp_id_digest",
      "email_digest",
      "name_digest",
      "custom_attributes_digest",
      "membership_state",
      "provider_revision",
      "request_digest",
      "page_digest",
      "cursor_digest",
      "permission_digest",
      "scope_digest",
      "registration_digest",
      "evidence_digest"
    ],
    "rawIdpAttributes": false,
    "rawEmail": false,
    "rawName": false,
    "rawCustomAttributes": false,
    "rawDirectoryMetadata": false,
    "rawConnectionDomains": false,
    "rawApiKey": false,
    "rawProviderError": false,
    "rawCursor": false,
    "completePaginationRequiredForAdoption": true,
    "deactivatedStateExplicit": true,
    "connectionLossExplicit": true,
    "filteredMembershipOnly": true
  },
  "authority": {
    "readOnly": true,
    "proposalOnly": true,
    "directoryMutation": false,
    "userMutation": false,
    "groupMutation": false,
    "membershipMutation": false,
    "login": false,
    "session": false,
    "accessGrant": false,
    "identityMutation": false,
    "kernelIdentityAuthority": false,
    "kernelConsentAuthority": false,
    "effectAuthority": false,
    "receiptAuthority": false,
    "verificationAuthority": false,
    "outcomeAuthority": false,
    "connected": false,
    "native": false
  },
  "provenance": {
    "fixture": "non_native_non_connected_non_first_party",
    "recording": "non_native_non_connected_non_first_party",
    "loopback": "non_native_non_connected_non_first_party",
    "blockedEnv": "non_native_non_connected_non_first_party",
    "blockedEnvironmentIsNative": false,
    "durableProviderReceipt": false,
    "independentProviderReread": false
  },
  "forbidden": [
    "create_user",
    "update_user",
    "deactivate_user",
    "delete_user",
    "create_group",
    "update_group",
    "delete_group",
    "delete_directory",
    "directory_mutation",
    "membership_mutation",
    "raw_idp_attribute_serialization",
    "raw_api_key_serialization",
    "raw_token_serialization",
    "login_or_session_flow",
    "access_grant_authority",
    "kernel_identity_authority",
    "connected_or_native_claim",
    "verified_identity_effect",
    "kernel_consent_authority",
    "kernel_outcome_authority"
  ],
  "layer2Exits": [
    "native_api_key_resolution_and_https",
    "durable_provider_receipt",
    "independent_directory_connection_membership_reread",
    "host_consent_and_effect_authority_for_identity_effects"
  ],
  "bounds": {
    "maxResponseBytes": 1048576,
    "maxPageSize": 100,
    "maxPages": 8,
    "maxRecords": 512,
    "maxIdentifierBytes": 128,
    "maxCursorBytes": 256,
    "cursorTtlSeconds": 300
  }
}
