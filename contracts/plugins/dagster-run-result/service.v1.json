{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tangpingqingwa/hartevo-desktop/contracts/plugins/dagster-run-result/service.v1.json",
  "title": "Hartevo Dagster run-result Layer-1 service",
  "description": "Standalone read, proposal, and recording contract for bounded Dagster orchestration evidence. It is not a scheduler, worker kernel, generic data catalog, or asset truth authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractVersion",
    "serviceId",
    "providerId",
    "consumerId",
    "layer",
    "operations",
    "scope",
    "registration",
    "projections",
    "bounds",
    "honesty",
    "forbiddenEffects",
    "layer2Gaps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "hartevo.dagster-run-result/v1"
    },
    "contractVersion": {
      "const": "EXT-DAGSTER-01-L1/v1"
    },
    "serviceId": {
      "const": "DagsterRunResultService"
    },
    "providerId": {
      "const": "DagsterProvider"
    },
    "consumerId": {
      "const": "MissionDagsterRunConsumer"
    },
    "layer": {
      "const": 1
    },
    "operations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "describe_deployment",
          "describe_repository",
          "describe_code_location",
          "describe_job",
          "describe_asset",
          "read_run_evidence",
          "compile_run_result_proposal",
          "record_run_receipt",
          "verify_run_evidence"
        ]
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment",
        "repository",
        "codeLocation",
        "job",
        "run",
        "partition",
        "asset",
        "commit",
        "mission",
        "permissions"
      ],
      "properties": {
        "deployment": {
          "$ref": "#/$defs/deployment"
        },
        "repository": {
          "$ref": "#/$defs/revisionedName"
        },
        "codeLocation": {
          "$ref": "#/$defs/revisionedName"
        },
        "job": {
          "$ref": "#/$defs/revisionedName"
        },
        "run": {
          "$ref": "#/$defs/run"
        },
        "partition": {
          "anyOf": [
            {
              "$ref": "#/$defs/partition"
            },
            {
              "type": "null"
            }
          ]
        },
        "asset": {
          "$ref": "#/$defs/asset"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "mission": {
          "$ref": "#/$defs/mission"
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "deployment:read",
              "repository:read",
              "code-location:read",
              "job:read",
              "run:read",
              "event:read",
              "asset:read",
              "partition:read",
              "commit:read",
              "mission:scope"
            ]
          }
        }
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "versionDigest",
        "contractDigest",
        "providerDigest",
        "deploymentDigest",
        "repositoryDigest",
        "codeLocationDigest",
        "jobDigest",
        "runDigest",
        "partitionDigest",
        "assetDigest",
        "commitDigest",
        "missionDigest",
        "permissionDigest",
        "scopeDigest",
        "credentialDigest",
        "registrationDigest",
        "reversible",
        "revocable"
      ],
      "properties": {
        "status": {
          "enum": ["active", "unmounted", "revoked", "reversed"]
        },
        "versionDigest": {
          "$ref": "#/$defs/digest"
        },
        "contractDigest": {
          "$ref": "#/$defs/digest"
        },
        "providerDigest": {
          "$ref": "#/$defs/digest"
        },
        "deploymentDigest": {
          "$ref": "#/$defs/digest"
        },
        "repositoryDigest": {
          "$ref": "#/$defs/digest"
        },
        "codeLocationDigest": {
          "$ref": "#/$defs/digest"
        },
        "jobDigest": {
          "$ref": "#/$defs/digest"
        },
        "runDigest": {
          "$ref": "#/$defs/digest"
        },
        "partitionDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "assetDigest": {
          "$ref": "#/$defs/digest"
        },
        "commitDigest": {
          "$ref": "#/$defs/digest"
        },
        "missionDigest": {
          "$ref": "#/$defs/digest"
        },
        "permissionDigest": {
          "$ref": "#/$defs/digest"
        },
        "scopeDigest": {
          "$ref": "#/$defs/digest"
        },
        "credentialDigest": {
          "$ref": "#/$defs/digest"
        },
        "registrationDigest": {
          "$ref": "#/$defs/digest"
        },
        "reversible": {
          "const": true
        },
        "revocable": {
          "const": true
        }
      }
    },
    "projections": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "queued",
          "not_started",
          "started",
          "success",
          "failure",
          "canceled",
          "timeout",
          "invalid",
          "provider_unknown",
          "access_loss"
        ]
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxResponseBytes",
        "maxPageItems",
        "maxPages",
        "maxEvents",
        "maxStepSummaries",
        "maxMaterializations",
        "maxMetadataBytes",
        "rawLogsRetained"
      ],
      "properties": {
        "maxResponseBytes": {
          "const": 2097152
        },
        "maxPageItems": {
          "const": 256
        },
        "maxPages": {
          "const": 32
        },
        "maxEvents": {
          "const": 4096
        },
        "maxStepSummaries": {
          "const": 256
        },
        "maxMaterializations": {
          "const": 512
        },
        "maxMetadataBytes": {
          "const": 16384
        },
        "rawLogsRetained": {
          "const": false
        }
      }
    },
    "honesty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connected",
        "native",
        "firstParty",
        "recordingOnly",
        "rawTokenSerialized",
        "rawConfigRetained",
        "rawLogsRetained",
        "unboundedEventsRetained",
        "assetMutation",
        "scheduleOrSensorControl",
        "kernelOutcomeAdopted"
      ],
      "properties": {
        "connected": {
          "const": false
        },
        "native": {
          "const": false
        },
        "firstParty": {
          "const": false
        },
        "recordingOnly": {
          "const": true
        },
        "rawTokenSerialized": {
          "const": false
        },
        "rawConfigRetained": {
          "const": false
        },
        "rawLogsRetained": {
          "const": false
        },
        "unboundedEventsRetained": {
          "const": false
        },
        "assetMutation": {
          "const": false
        },
        "scheduleOrSensorControl": {
          "const": false
        },
        "kernelOutcomeAdopted": {
          "const": false
        }
      }
    },
    "forbiddenEffects": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "launch_run",
          "reexecute_run",
          "terminate_run",
          "mutate_asset",
          "select_arbitrary_operation",
          "control_schedule",
          "control_sensor",
          "resolve_native_secret",
          "retain_raw_config",
          "retain_raw_logs",
          "retain_unbounded_events",
          "adopt_kernel_outcome"
        ]
      }
    },
    "layer2Gaps": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "native_token_resolution",
          "bounded_https_graphql_reads",
          "durable_provider_receipt",
          "independent_run_reconciliation",
          "independent_materialization_readback",
          "verified_work_product_adoption"
        ]
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "revisionedName": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "revision"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "deploymentId", "revision"],
      "properties": {
        "origin": {
          "type": "string",
          "maxLength": 256
        },
        "deploymentId": {
          "type": "string",
          "maxLength": 256
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "revision"],
      "properties": {
        "runId": {
          "type": "string",
          "maxLength": 256
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      }
    },
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "revision"],
      "properties": {
        "key": {
          "type": "string",
          "maxLength": 256
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "revision"],
      "properties": {
        "path": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 256
          }
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      }
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "revision"],
      "properties": {
        "sha": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{40}([A-Fa-f0-9]{24})?$"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      }
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "missionId",
        "workProductId",
        "projectRevision",
        "missionRevision",
        "workProductRevision",
        "policyDigest",
        "consentDigest"
      ],
      "properties": {
        "projectId": {
          "type": "string",
          "maxLength": 256
        },
        "missionId": {
          "type": "string",
          "maxLength": 256
        },
        "workProductId": {
          "type": "string",
          "maxLength": 256
        },
        "projectRevision": {
          "$ref": "#/$defs/revision"
        },
        "missionRevision": {
          "$ref": "#/$defs/revision"
        },
        "workProductRevision": {
          "$ref": "#/$defs/revision"
        },
        "policyDigest": {
          "$ref": "#/$defs/digest"
        },
        "consentDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
