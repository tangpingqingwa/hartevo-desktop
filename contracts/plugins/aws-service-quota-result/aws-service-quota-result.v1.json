{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tangpingqingwa/hartevo-desktop/contracts/plugins/aws-service-quota-result/aws-service-quota-result.v1.json",
  "title": "Hartevo AWS Service Quotas posture result Layer-1 contract",
  "description": "A bounded, digest-only AWS Service Quotas read/proposal/record/verify seam. It is not a quota-increase executor, utilization authority, autoscaler, infrastructure guarantee, or Hartevo Truth authority.",
  "schemaVersion": "hartevo.aws-service-quota-result.contract/v1",
  "contractVersion": "aws-service-quota-result/v1",
  "pluginVersion": "1.0.0",
  "layer": "Layer-1",
  "officialReferences": [
    "https://docs.aws.amazon.com/servicequotas/2019-06-24/apireference/API_ListServiceQuotas.html",
    "https://docs.aws.amazon.com/servicequotas/2019-06-24/apireference/API_GetServiceQuota.html",
    "https://docs.aws.amazon.com/servicequotas/2019-06-24/apireference/API_GetAWSDefaultServiceQuota.html",
    "https://docs.aws.amazon.com/servicequotas/2019-06-24/apireference/API_ListRequestedServiceQuotaChangeHistoryByQuota.html"
  ],
  "service": {
    "id": "hartevo.aws.service-quota.result",
    "implementation": "AwsServiceQuotaService",
    "version": "1.0.0",
    "operations": [
      "describe_capabilities",
      "register",
      "revoke_registration",
      "reverse_registration",
      "restore_registration",
      "read_bounded",
      "propose",
      "record",
      "verify"
    ],
    "readOnly": true,
    "proposalOnly": true,
    "recordingOnly": true,
    "liveExecution": false,
    "externalWrites": false,
    "kernelAuthority": false,
    "outcomeAdoption": false
  },
  "provider": {
    "id": "aws.servicequotas",
    "implementation": "AwsServiceQuotaProvider",
    "version": "1.0.0",
    "apiRevision": "aws-service-quotas-read-r1",
    "apiVersion": "2019-06-24",
    "allowlistedOperations": [
      "ListServiceQuotas",
      "GetServiceQuota",
      "GetAWSDefaultServiceQuota",
      "ListRequestedServiceQuotaChangeHistoryByQuota"
    ],
    "allowlistedMethods": ["POST"],
    "acceptedTransports": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
    "native": false,
    "connected": false,
    "firstParty": false,
    "externalWrites": false,
    "providerReceipt": false,
    "sigV4Secret": "opaque_non_serializing_secret_reference_only"
  },
  "consumer": {
    "id": "mission.aws.service-quota.result",
    "implementation": "MissionAwsServiceQuotaConsumer",
    "version": "1.0.0",
    "deploymentBound": true,
    "missionBound": true,
    "projectBound": true,
    "workProductBound": true,
    "revisionBound": true,
    "permissionBound": true,
    "producesDecisionProposal": true,
    "adoptsOutcome": false,
    "truthAuthority": false,
    "certificationAuthority": false
  },
  "scope": {
    "required": [
      "deployment_id_and_revision",
      "mission_id_and_revision",
      "project_id_and_revision",
      "work_product_id_and_revision",
      "exact_account_and_region",
      "service_code_allowlist",
      "quota_code_allowlist_and_revisions",
      "usage_revision_fences",
      "bounded_history_window",
      "permission_digest",
      "secret_reference_digest",
      "scope_digest"
    ],
    "target": "exactly_one_account_and_region",
    "secret": "opaque_non_serializing_sigv4_reference_only",
    "quotaPosture": "digest_only",
    "rawUsageSeries": false,
    "rawRequester": false,
    "rawSupportCase": false,
    "rawAccountPii": false,
    "rawProviderPayload": false
  },
  "registration": {
    "pluginVersionBound": true,
    "providerIdBound": true,
    "providerVersionBound": true,
    "providerRevisionBound": true,
    "providerDigestBound": true,
    "apiDigestBound": true,
    "serviceDigestBound": true,
    "quotaDigestBound": true,
    "contractVersionBound": true,
    "contractDigestBound": true,
    "permissionDigestBound": true,
    "scopeDigestBound": true,
    "evidenceDigestBound": true,
    "secretReferenceDigestBound": true,
    "reversible": true,
    "revocable": true,
    "failClosedOn": [
      "plugin_version_drift",
      "provider_or_api_revision_drift",
      "provider_or_contract_digest_drift",
      "service_or_quota_allowlist_drift",
      "permission_or_scope_digest_drift",
      "evidence_digest_drift",
      "secret_reference_revocation",
      "registration_tamper",
      "registration_revocation_or_reversal",
      "cursor_or_filter_replay",
      "stale_usage_revision",
      "history_window_drift"
    ]
  },
  "bounds": {
    "maxResponseBytes": 1048576,
    "maxPages": 4,
    "pageSize": 50,
    "maxQuotas": 64,
    "maxHistoryEntries": 64,
    "maxHistoryWindowSeconds": 2592000,
    "maxRequestsPerRead": 6,
    "maxRetries": 2,
    "maxIdentifierBytes": 128
  },
  "pagination": {
    "cursorOpaque": true,
    "cursorDigestOnly": true,
    "cursorBoundTo": [
      "account",
      "region",
      "service_code",
      "quota_allowlist",
      "quota_revision_fences",
      "usage_revision_fences",
      "operation",
      "applied_at_level",
      "history_window",
      "page_number",
      "filter_digest"
    ],
    "filterDriftRejected": true,
    "cursorReplayRejected": true,
    "partialPageIsNonAdoptable": true
  },
  "evidence": {
    "states": [
      "complete",
      "partial",
      "stale_usage",
      "pagination_incomplete",
      "insufficient_data",
      "access_loss",
      "provider_unknown",
      "registration_revoked"
    ],
    "digestOnlyFields": [
      "quota_identity",
      "quota_unit",
      "applied_quota_value",
      "default_quota_value",
      "adjustable",
      "global_quota",
      "usage_metric_metadata",
      "request_history_states",
      "quota_posture"
    ],
    "requiredDigests": [
      "plugin_version",
      "provider",
      "api",
      "contract",
      "service",
      "quota",
      "permission",
      "scope",
      "usage_revision",
      "filter",
      "cursor",
      "page",
      "posture",
      "evidence",
      "proposal",
      "record"
    ],
    "retained": [
      "quota_identity_digest",
      "posture_component_digests",
      "usage_revision",
      "observed_at",
      "bounded_history_digest",
      "ordering_and_page_digests"
    ],
    "notRetained": [
      "raw_quota_value",
      "raw_default_value",
      "raw_usage_series",
      "raw_usage_metric_dimensions",
      "quota_name",
      "quota_arn",
      "requester",
      "support_case_id",
      "quota_request_payload",
      "raw_next_token",
      "credential_material",
      "provider_error_message"
    ],
    "missingOrInsufficientDataFailsClosed": true,
    "staleUsageFailsClosed": true
  },
  "redaction": {
    "secretMaterial": false,
    "rawNextToken": false,
    "rawProviderPayload": false,
    "rawUsageSeries": false,
    "quotaValues": false,
    "usageMetricDimensions": false,
    "requester": false,
    "supportCase": false,
    "accountPii": false,
    "errorMessages": false
  },
  "authority": {
    "readOnly": true,
    "proposalOnly": true,
    "recordingOnly": true,
    "externalWrites": false,
    "quotaIncrease": false,
    "quotaTemplateMutation": false,
    "supportCaseMutation": false,
    "quotaUtilizationReportStart": false,
    "autoscaling": false,
    "infrastructureMutation": false,
    "financialGuarantee": false,
    "infrastructureGuarantee": false,
    "credentialResolution": false,
    "connected": false,
    "native": false,
    "firstParty": false,
    "durableReceipt": false,
    "verificationAuthority": false,
    "kernelOutcomeAdoption": false,
    "truthAuthority": false
  },
  "honesty": {
    "nativeStatus": "BLOCKED_ENV",
    "blockedEnvironmentIsNative": false,
    "fixtureIsNative": false,
    "recordingIsNative": false,
    "loopbackIsNative": false,
    "completeIsCapacityGuarantee": false,
    "completeIsInfrastructureGuarantee": false,
    "completeIsFinancialGuarantee": false,
    "layer1Boundary": "Layer 1 emits bounded digest-only external evidence and a Mission decision proposal. Native SigV4 execution, live HTTPS, independent utilization reread, durable provider receipt, consented quota effects, autoscaling, infrastructure authority and verified Work Product adoption remain Layer-2 host authority."
  },
  "layer2Gaps": [
    "native_sigv4_transport_and_credential_resolution",
    "live_service_quotas_https",
    "independent_utilization_readback_and_reconciliation",
    "durable_provider_receipt",
    "consented_quota_effects",
    "quota_increase_or_template_mutation",
    "support_case_creation",
    "autoscaling_or_infrastructure_authority",
    "financial_or_capacity_guarantee",
    "verified_work_product_adoption"
  ],
  "forbidden": [
    "RequestServiceQuotaIncrease",
    "PutServiceQuotaIncreaseRequestIntoTemplate",
    "ListServiceQuotaIncreaseRequestsInTemplate",
    "StartQuotaUtilizationReport",
    "StartAutoManagement",
    "StopAutoManagement",
    "UpdateAutoManagement",
    "CreateSupportCase",
    "mutate_quota_template",
    "mutate_quota",
    "retain_raw_usage_series",
    "retain_raw_requester_or_support_case",
    "resolve_live_credentials",
    "claim_connected",
    "claim_native",
    "claim_capacity_guarantee",
    "claim_infrastructure_guarantee",
    "adopt_kernel_outcome"
  ]
}
