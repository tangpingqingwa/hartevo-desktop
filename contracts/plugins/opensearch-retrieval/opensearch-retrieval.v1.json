  "mapping": {
    "digestBound": true,
    "revisionBound": true,
    "driftIsFailClosed": true,
    "queryAndSortFieldsMustBeAllowlisted": true,
    "sourceFieldsMustBeAllowlisted": true
  },
  "queryPolicy": {
    "representation": "typed_bounded_allowlist_ast",
    "allowedClauses": ["match", "term", "prefix", "range", "bool"],
    "allowedBoolDepth": 4,
    "allowedClauseCount": 32,
    "maxPageSize": 100,
    "maxPages": 32,
    "maxHits": 1000,
    "maxSourceFieldBytes": 4096,
    "scroll": "forbidden",
    "rawDsl": "forbidden",
    "stableSort": "required_with_unique_id_tiebreaker"
  },
  "pagination": {
    "pointInTime": "required",
    "searchAfter": "required_for_next_page",
    "cursorLoop": "fail_closed",
    "pitExpiry": "typed_failure",
    "deepFromSize": "forbidden",
    "unboundedScroll": "forbidden"
  },
  "evidence": {
    "hitFields": [
