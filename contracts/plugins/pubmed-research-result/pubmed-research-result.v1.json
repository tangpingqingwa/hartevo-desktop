{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hartevo.local/contracts/plugins/pubmed-research-result/pubmed-research-result.v1.json",
  "title": "Hartevo PubMed biomedical research evidence result Layer-1 contract",
  "description": "Bounded, redacted PubMed publication metadata evidence for a Mission proposal; not clinical advice, citation truth, publication-quality, full-text, abstract, Truth, Receipt, Verification, or Outcome authority.",
  "schemaVersion": "hartevo.pubmed-research-result/v1",
  "contractVersion": "pubmed-research-result-e1/v1",
  "pluginVersion": "0.1.0",
  "layer": 1,
  "authority": {
    "readOnly": true,
    "proposalOnly": true,
    "connected": false,
    "nativeProvider": false,
    "firstParty": false,
    "durableReceipt": false,
    "kernelAuthority": false,
    "truthAuthority": false,
    "consentAuthority": false,
    "verificationAuthority": false,
    "outcomeAuthority": false,
    "externalWrites": false,
    "clinicalAdviceAuthority": false,
    "citationTruthAuthority": false,
    "publicationQualityAuthority": false,
    "fullTextAuthority": false
  },
  "typedSurface": {
    "service": "PubMedResearchResultService",
    "provider": "NcbiEutilsProvider",
    "consumer": "MissionPubMedResearchConsumer",
    "models": [
      "PubMedResearchScope",
      "PubMedQuery",
      "PubMedPermission",
      "PubMedRegistration",
      "SecretReference",
      "OpaqueCursor",
      "OpaqueHistory",
      "PubMedRequest",
      "PubMedArticleProjection",
      "PubMedLinkProjection",
      "PubMedResearchEvidence",
      "PubMedResearchProposal",
      "PubMedObservationReceipt"
    ]
  },
  "service": {
    "id": "pubmed.research-result",
    "name": "PubMedResearchResultService",
    "version": "1.0.0",
    "access": "read_only",
    "operations": [
      "issue_read_consent",
      "read_esearch",
      "read_esummary",
      "read_efetch_metadata",
      "read_elink",
      "compile_research_proposal",
      "record_observation_receipt",
      "verify_evidence",
      "verify_proposal",
      "revoke_registration",
      "restore_registration"
    ],
    "externalWrites": false,
    "liveExternalIo": false,
    "emitsOutcome": false
  },
  "provider": {
    "id": "ncbi.eutils.pubmed",
    "name": "NcbiEutilsProvider",
    "version": "1.0.0",
    "apiRevision": "ncbi-eutils-v1",
    "baseUrl": "https://eutils.ncbi.nlm.nih.gov/entrez/eutils",
    "allowlistedGetPaths": [
      "/esearch.fcgi",
      "/esummary.fcgi",
      "/efetch.fcgi",
      "/elink.fcgi"
    ],
    "requiredPermission": "metadata.read",
    "authentication": ["opaque_secret_reference"],
    "transportProvenance": ["fixture", "recording", "fake", "loopback", "BLOCKED_ENV"],
    "maxRequestsPerMinute": 50,
    "maxResponseBytes": 1048576,
    "maxResults": 25,
    "rawCredentialSerialized": false,
    "rawQuerySerialized": false,
    "rawPmidSerialized": false,
    "rawPmcidSerialized": false,
    "rawMeshSerialized": false,
    "rawHistorySerialized": false,
    "rawResponseBody": false,
    "abstractRetention": false,
    "fullTextRetention": false,
    "reversible": true,
    "revocable": true,
    "native": false,
    "connected": false,
    "firstParty": false
  },
  "consumer": {
    "id": "mission.pubmed-research-result",
    "name": "MissionPubMedResearchConsumer",
    "kind": "mission_biomedical_metadata_projection",
    "scope": [
      "database",
      "query_digest",
      "pmid_digest",
      "pmcid_digest",
      "mesh_digest",
      "project",
      "mission",
      "work_product",
      "operation",
      "consent_digest",
      "mission_revision",
      "work_product_revision",
      "source_evidence_digest"
    ],
    "adoptsOutcome": false,
    "adoptsWorkProduct": false,
    "kernelAuthority": false,
    "truthAuthority": false
  },
  "exactScope": [
    "database",
    "query_digest",
    "pmid_digest",
    "pmcid_digest",
    "mesh_digest",
    "project",
    "mission",
    "work_product",
    "operation",
    "max_results",
    "scope_revision",
    "consent",
    "cursor_binding",
    "history_binding"
  ],
  "allowlist": {
    "reads": [
      {
        "operation": "esearch",
        "method": "GET",
        "path": "/esearch.fcgi",
        "permission": "metadata.read",
        "aggregateOnly": true,
        "rawQuery": false,
        "historyServer": true
      },
      {
        "operation": "esummary",
        "method": "GET",
        "path": "/esummary.fcgi",
        "permission": "metadata.read",
        "aggregateOnly": true,
        "rawIdentifiers": false,
        "historyServer": true
      },
      {
        "operation": "efetch_metadata",
        "method": "GET",
        "path": "/efetch.fcgi",
        "permission": "metadata.read",
        "aggregateOnly": true,
        "metadataOnly": true,
        "rawAbstract": false,
        "rawFullText": false,
        "historyServer": true
      },
      {
        "operation": "elink",
        "method": "GET",
        "path": "/elink.fcgi",
        "permission": "metadata.read",
        "aggregateOnly": true,
        "rawIdentifiers": false,
        "historyServer": true
      }
    ],
    "writes": [],
    "forbidden": [
      "clinical_advice",
      "diagnosis",
      "treatment",
      "publication_quality_claim",
      "citation_truth_claim",
      "ranking_claim",
      "abstract_retention",
      "full_text_retention",
      "raw_query_export",
      "raw_pmid_export",
      "raw_pmcid_export",
      "raw_mesh_export",
      "raw_history_export",
      "raw_response_export",
      "content_mutation",
      "member_mutation",
      "reference_mutation",
      "kernel_truth_authority",
      "kernel_consent_authority",
      "kernel_receipt_authority",
      "kernel_verification_authority",
      "kernel_outcome_authority",
      "verified_work_product_adoption"
    ]
  },
  "authentication": {
    "boundary": "opaque SecretReference",
    "requiredPermission": "metadata.read",
    "rawCredentialSerialized": false,
    "rawCredentialDebug": false,
    "rawCredentialRequest": false,
    "rawCredentialReceipt": false,
    "resolvedByLayer": 2
  },
  "bounds": {
    "maxResults": 25,
    "maxResponseBytes": 1048576,
    "maxIdentifierBytes": 128,
    "maxDiagnosticBytes": 512,
    "maxRequestsPerMinute": 50,
    "maxRetryAfterSeconds": 3600,
    "maxCursorBytes": 512,
    "maxHistoryBytes": 512
  },
  "normalization": {
    "responseOrderIndependent": true,
    "resultsSortedByDigest": true,
    "duplicatePmidDigestRejected": true,
    "query": "digest_only",
    "pmid": "digest_only",
    "pmcid": "digest_only",
    "mesh": "digest_only",
    "title": "digest_only",
    "history": "digest_only",
    "rawJson": false,
    "partialResults": true,
    "emptyIsSuccess": false,
    "abstractIsRetained": false,
    "fullTextIsRetained": false
  },
  "digests": {
    "pluginVersion": true,
    "contractVersion": true,
    "contract": true,
    "provider": true,
    "permission": true,
    "scope": true,
    "query": true,
    "pmid": true,
    "pmcid": true,
    "mesh": true,
    "secretReference": true,
    "cursor": true,
    "history": true,
    "registration": true,
    "consent": true,
    "request": true,
    "idempotency": true,
    "evidence": true,
    "proposal": true,
    "receipt": true,
    "response": true
  },
  "registration": {
    "versionBound": true,
    "contractDigestBound": true,
    "providerDigestBound": true,
    "permissionDigestBound": true,
    "scopeDigestBound": true,
    "secretReferenceDigestBound": true,
    "cursorHistoryBinding": true,
    "evidenceDigestBound": true,
    "registrationDigestBound": true,
    "revisionFence": true,
    "idempotencyFence": true,
    "reversible": true,
    "revocable": true,
    "rotationOnStateChange": true,
    "failClosedOn": [
      "plugin_version_drift",
      "contract_drift",
      "provider_drift",
      "permission_drift",
      "scope_drift",
      "consent_drift",
      "secret_reference_drift",
      "cursor_replay",
      "history_drift",
      "evidence_drift",
      "registration_revocation",
      "replay",
      "tamper"
    ]
  },
  "receipts": {
    "observation": true,
    "rateLimit": ["limitPerMinute", "remaining", "retryAfterSeconds", "throttled"],
    "rawHeaders": false,
    "rawResponseBody": false,
    "requestDigest": true,
    "idempotencyDigest": true,
    "durableNativeReceipt": false
  },
  "honesty": {
    "fixtureConnected": false,
    "fixtureNative": false,
    "fixtureFirstParty": false,
    "recordingConnected": false,
    "recordingNative": false,
    "recordingFirstParty": false,
    "fakeConnected": false,
    "fakeNative": false,
    "fakeFirstParty": false,
    "loopbackConnected": false,
    "loopbackNative": false,
    "loopbackFirstParty": false,
    "blockedEnvConnected": false,
    "blockedEnvNative": false,
    "blockedEnvFirstParty": false,
    "nativeHttpsTransport": "layer_2_gap",
    "nativeCredentialResolution": "layer_2_gap",
    "nativeReadback": "layer_2_gap",
    "clinicalAdvice": false,
    "diagnosis": false,
    "treatment": false,
    "citationTruth": false,
    "publicationQuality": false,
    "abstractRetention": false,
    "fullTextRetention": false,
    "workProductAdoption": "layer_2_gap",
    "absenceIsSuccess": false
  },
  "authorityBoundary": {
    "externalRead": "typed_bounded_ncbi_eutilities_metadata_get_only",
    "externalWrite": false,
    "clinicalAdvice": false,
    "diagnosis": false,
    "treatment": false,
    "publicationQuality": false,
    "citationTruth": false,
    "abstractRetention": false,
    "fullTextRetention": false,
    "contentMutation": false,
    "memberMutation": false,
    "referenceMutation": false,
    "genericSearchAuthority": false,
    "connected": false,
    "native": false,
    "firstParty": false,
    "kernelTruth": false,
    "kernelConsent": false,
    "kernelReceipt": false,
    "kernelVerification": false,
    "kernelOutcome": false
  },
  "documentation": [
    "https://www.ncbi.nlm.nih.gov/books/NBK25501/",
    "https://www.ncbi.nlm.nih.gov/books/NBK25499/"
  ],
  "errorHandling": [
    "HTTP_400",
    "HTTP_401_DENIED",
    "HTTP_403_DENIED",
    "HTTP_404_EMPTY",
    "HTTP_429_RATE_LIMITED",
    "HTTP_5XX",
    "BLOCKED_ENV",
    "MALFORMED_RESPONSE",
    "RESPONSE_TOO_LARGE",
    "RESPONSE_REORDER_NORMALIZED",
    "RESPONSE_TRUNCATION_PARTIAL",
    "INVALID_SCOPE",
    "MISSING_PERMISSION",
    "CURSOR_MISMATCH",
    "HISTORY_MISMATCH",
    "CURSOR_REPLAY",
    "TAMPER",
    "STALE_SCOPE",
    "REGISTRATION_REVOCATION",
    "REPLAY"
  ],
  "layer2Gaps": [
    "native_secret_reference_resolution",
    "native_ncbi_https_transport",
    "durable_native_provider_receipt",
    "independent_native_readback",
    "clinical_or_biomedical_advice",
    "citation_truth_or_publication_quality",
    "abstract_or_full_text_retention",
    "verified_work_product_adoption",
    "kernel_truth_consent_effect_receipt_verification_outcome_authority"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "$id",
    "schemaVersion",
    "contractVersion",
    "pluginVersion",
    "layer",
    "authority",
    "typedSurface",
    "service",
    "provider",
    "consumer",
    "exactScope",
    "allowlist",
    "authentication",
    "bounds",
    "normalization",
    "digests",
    "registration",
    "receipts",
    "honesty",
    "authorityBoundary",
    "documentation",
    "errorHandling",
    "layer2Gaps"
  ]
}
