{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tangpingqingwa/hartevo-desktop/contracts/plugins/tailscale-network-posture-result/tailscale-network-posture-result.v1.json",
  "title": "Hartevo Tailscale network posture result Layer-1 contract",
  "description": "A bounded read/proposal/recording-only Tailscale network posture evidence seam. It is not a connected client, network reachability guarantee, effective authorization decision, access certification, or Hartevo authority.",
  "schemaVersion": "hartevo.tailscale-network-posture-result/v1",
  "contractVersion": "EXT-TAILSCALE-01-L1/v1",
  "pluginVersion": "0.1.0",
  "pluginId": "tailscale.network-posture-result",
  "layer": 1,
  "evidenceLevel": "L1_PROVIDER_CONTRACT",
  "status": "read_proposal_recording_only",
  "service": {
    "type": "TailscaleNetworkPostureResultService",
    "id": "tailscale.network-posture-result.read",
    "operations": [
      "describe_capabilities",
      "describe_scope",
      "register",
      "revoke_registration",
      "reverse_registration",
      "restore_registration",
      "revoke_secret_reference",
      "read_devices",
      "read_device_posture",
      "read_acl_policy",
      "read_grants",
      "compile_posture_proposal",
      "record_redacted_proposal",
      "verify_posture_proposal"
    ],
    "readOnly": true,
    "proposalOnly": true,
    "recordingOnly": true,
    "externalWrites": false,
    "networkMutation": false,
    "deviceMutation": false,
    "aclMutation": false,
    "keyMutation": false,
    "accessCertification": false,
    "kernelAuthority": false,
    "outcomeAdoption": false,
    "workProductAdoption": false
  },
  "provider": {
    "type": "TailscaleProvider",
    "id": "tailscale.network-posture.recording",
    "version": "0.1.0",
    "apiRevision": "tailscale-api-v2-network-posture-read-r1",
    "documentation": "https://tailscale.com/docs/reference/tailscale-api",
    "operations": [
      "GET /api/v2/tailnet/{tailnet}/devices",
      "GET /api/v2/device/{deviceId}",
      "GET /api/v2/tailnet/{tailnet}/acl",
      "GET /api/v2/tailnet/{tailnet}/acl (grants section)"
    ],
    "allowedTransportProvenance": [
      "fixture",
      "recording",
      "fake",
      "loopback",
      "blocked_env"
    ],
    "authentication": {
      "scheme": "tailscale_api_token_or_oauth",
      "secretReference": "opaque_non_serializing_digest_only",
      "nativeResolution": false,
      "rawCredentialMaterial": false
    },
    "connected": false,
    "native": false,
    "firstParty": false,
    "durableProviderReceipt": false
  },
  "consumer": {
    "type": "MissionTailscaleNetworkConsumer",
    "id": "mission.tailscale-network-posture.consumer",
    "authority": "mission_review_projection_below_kernel",
    "binding": [
      "tailnetId",
      "tailnetRevision",
      "deviceId",
      "deviceRevision",
      "tagId",
      "tagRevision",
      "postureId",
      "postureRevision",
      "aclPolicyId",
      "aclPolicyRevision",
      "grantId",
      "grantRevision",
      "projectId",
      "projectRevision",
      "missionId",
      "missionRevision",
      "workProductId",
      "workProductRevision",
      "permissionDigest",
      "consentDigest",
      "registrationDigest"
    ],
    "adoptsOutcome": false,
    "adoptsWorkProduct": false,
    "truthAuthority": false,
    "accessCertification": false
  },
  "scope": {
    "required": [
      "tailnet",
      "device",
      "tag",
      "posture",
      "acl",
      "grant",
      "project",
      "mission",
      "workProduct",
      "permissionSnapshot",
      "consentScope",
      "scopeRevision",
      "opaqueSecretReference"
    ],
    "exactRevisionFence": true,
    "scopeDigest": "sha256_of_canonical_typed_scope",
    "deviceDigest": "sha256_of_scoped_device_identity",
    "postureDigest": "sha256_of_scoped_posture_identity",
    "policyDigest": "sha256_of_scoped_acl_and_grant_identity",
    "rawTailnetName": false,
    "rawNodeAddresses": false,
    "rawCredentialMaterial": false
  },
  "permissions": {
    "requiredReadOnly": [
      "tailnet:read",
      "device:read",
      "device_posture:read",
      "tag:read",
      "acl:read",
      "grant:read",
      "mission.scope",
      "work_product.proposal"
    ],
    "forbidden": [
      "device:create",
      "device:update",
      "device:delete",
      "tag:write",
      "acl:write",
      "grant:write",
      "key:create",
      "key:revoke",
      "raw_node_addresses",
      "raw_acl_policy",
      "raw_grant_principals",
      "network_reachability_guarantee",
      "access_certification",
      "outcome.adopt",
      "verified_work_product_adoption"
    ],
    "permissionDigestBound": true
  },
  "bounds": {
    "maxResponseBytes": 1048576,
    "maxDevices": 128,
    "maxTags": 64,
    "maxAclRules": 256,
    "maxGrants": 256,
    "maxRequestsPerMinute": 60,
    "maxRetryAfterSeconds": 3600,
    "maxIdentifierBytes": 128
  },
  "evidence": {
    "states": [
      "allowed",
      "denied",
      "expired",
      "unknown",
      "partial",
      "rate_limited",
      "provider_unknown",
      "tamper",
      "access_loss",
      "registration_revoked"
    ],
    "requiredDigests": [
      "pluginVersionDigest",
      "contractDigest",
      "providerDigest",
      "apiDigest",
      "deviceDigest",
      "postureDigest",
      "policyDigest",
      "scopeDigest",
      "revisionFenceDigest",
      "permissionDigest",
      "consentDigest",
      "requestDigest",
      "idempotencyKeyDigest",
      "responseDigest",
      "evidenceDigest",
      "proposalDigest",
      "recordDigest"
    ],
    "retained": [
      "bounded_device_count",
      "tag_count_and_tag_digest",
      "typed_posture_state",
      "bounded_acl_rule_count",
      "bounded_grant_count",
      "typed_access_decision",
      "typed_failure_state",
      "redacted_receipts",
      "revision_fences"
    ],
    "notRetained": [
      "raw_provider_payload",
      "raw_node_addresses",
      "raw_tailnet_name",
      "raw_device_hostname",
      "raw_tags",
      "raw_acl_expressions",
      "raw_grant_principals",
      "api_token",
      "oauth_secret",
      "effective_authorization",
      "access_certification"
    ]
  },
  "redaction": {
    "receipt": "digest_and_bounded_counts_only",
    "secretReference": "digest_only",
    "rawPayload": false,
    "rawNodeAddresses": false,
    "rawTailnetName": false,
    "rawTags": false,
    "rawAclExpressions": false,
    "rawGrantPrincipals": false,
    "credentialMaterial": false
  },
  "registration": {
    "versionBound": true,
    "contractDigestBound": true,
    "providerRevisionBound": true,
    "providerDigestBound": true,
    "scopeDigestBound": true,
    "revisionFenceBound": true,
    "permissionDigestBound": true,
    "consentDigestBound": true,
    "secretReferenceDigestBound": true,
    "reversible": true,
    "revocable": true,
    "stateTransitions": [
      "active_to_reversed_to_active",
      "active_to_revoked"
    ],
    "failClosedOn": [
      "scope_drift",
      "revision_drift",
      "permission_drift",
      "consent_drift",
      "contract_drift",
      "provider_drift",
      "evidence_tamper",
      "idempotency_conflict",
      "registration_revocation"
    ]
  },
  "authority": {
    "connected": false,
    "native": false,
    "firstParty": false,
    "networkReachability": false,
    "effectiveAuthorization": false,
    "accessCertification": false,
    "deviceMutation": false,
    "aclMutation": false,
    "grantMutation": false,
    "keyMutation": false,
    "durableProviderReceipt": false,
    "independentReadBack": false,
    "kernelOutcomeAdoption": false,
    "workProductAdoption": false
  },
  "nativeGap": {
    "status": "BLOCKED_ENV",
    "connected": false,
    "deferredTo": "Layer-2 host authority",
    "gaps": [
      "native_opaque_api_token_or_oauth_resolution",
      "live_tailscale_api_device_reads",
      "live_tailscale_api_posture_reads",
      "live_tailscale_api_acl_and_grant_reads",
      "durable_provider_receipts",
      "independent_provider_reread",
      "consented_device_acl_grant_or_key_effects",
      "network_reachability_verification",
      "access_certification",
      "verified_work_product_adoption",
      "verified_outcome_adoption"
    ]
  },
  "primaryApiBasis": [
    "https://tailscale.com/docs/reference/tailscale-api"
  ]
}
