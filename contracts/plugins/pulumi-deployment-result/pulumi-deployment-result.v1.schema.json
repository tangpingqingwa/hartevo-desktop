{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hartevo.pulumi-deployment-result/v1",
  "title": "Hartevo Layer 1 Pulumi Cloud deployment-result contract",
  "description": "Read, proposal, and recording evidence only. This contract never creates or mutates a Pulumi deployment and never adopts a kernel Outcome.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractVersion",
    "layer",
    "plugin",
    "service",
    "provider",
    "scopeFence",
    "evidence",
    "registration",
    "provenanceFence",
    "forbiddenOperations",
    "nativeGap"
  ],
  "properties": {
    "schemaVersion": { "const": "hartevo.pulumi-deployment-result/v1" },
    "contractVersion": { "const": "EXT-PULUMI-01-L1/v1" },
    "layer": { "const": 1 },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "reversible", "revocable", "contractDigestBound"],
      "properties": {
        "id": { "const": "hartevo.pulumi-deployment-result" },
        "version": { "const": "1.0.0" },
        "reversible": { "const": true },
        "revocable": { "const": true },
        "contractDigestBound": { "const": true }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provider", "consumer", "operations", "readOnly", "proposalOnly", "recordingOnly", "externalWrites", "kernelAuthority", "outcomeAdoption"],
      "properties": {
        "id": { "const": "pulumi.deployment.result.read" },
        "provider": { "const": "pulumi.cloud.deployment" },
        "consumer": { "const": "mission.pulumi.deployment.result" },
        "operations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "describe_stack",
              "read_deployment_evidence",
              "record_deployment_receipt",
              "verify_deployment_result",
              "mission_result_proposal",
              "registration",
              "revocation"
            ]
          }
        },
        "readOnly": { "const": true },
        "proposalOnly": { "const": true },
        "recordingOnly": { "const": true },
        "externalWrites": { "const": false },
        "kernelAuthority": { "const": false },
        "outcomeAdoption": { "const": false }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "officialApi", "readMethods", "secretReferenceOnly", "authorizationObscured404", "connectedEvidence", "nativeStatus"],
      "properties": {
        "id": { "const": "pulumi.cloud.deployment" },
        "version": { "const": "1.0.0" },
        "officialApi": { "const": "Pulumi Cloud REST API" },
        "readMethods": { "const": ["GET"] },
        "secretReferenceOnly": { "const": true },
        "authorizationObscured404": { "const": "not_found_or_unauthorized" },
        "connectedEvidence": { "const": false },
        "nativeStatus": { "const": "BLOCKED_ENV" }
      }
    },
    "scopeFence": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "https_api_base",
          "organization",
          "organization_revision",
          "pulumi_project",
          "pulumi_project_revision",
          "stack",
          "stack_revision",
          "deployment_id",
          "source_repository",
          "source_branch",
          "source_directory",
          "commit_sha",
          "update_id",
          "update_version",
          "policy_digest",
          "policy_revision",
          "hartevo_project_id",
          "mission_id",
          "work_product_id",
          "mission_revision",
          "work_product_revision",
          "consent_revision",
          "permission_snapshot"
        ]
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bounded", "deployment", "updates", "steps", "statusTransitions", "policy", "audit", "rawLogs", "rawState", "rawSecrets", "revisionFences"],
      "properties": {
        "bounded": { "const": true },
        "deployment": { "const": true },
        "updates": { "const": true },
        "steps": { "const": true },
        "statusTransitions": { "const": true },
        "policy": { "const": true },
        "audit": { "const": true },
        "rawLogs": { "const": false },
        "rawState": { "const": false },
        "rawSecrets": { "const": false },
        "revisionFences": { "const": true }
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["versionBound", "contractDigestBound", "providerBound", "permissionSnapshotBound", "scopeDigestBound", "opaqueSecretReferenceOnly", "reversible", "revocable", "failClosedDrift"],
      "properties": {
        "versionBound": { "const": true },
        "contractDigestBound": { "const": true },
        "providerBound": { "const": true },
        "permissionSnapshotBound": { "const": true },
        "scopeDigestBound": { "const": true },
        "opaqueSecretReferenceOnly": { "const": true },
        "reversible": { "const": true },
        "revocable": { "const": true },
        "failClosedDrift": { "const": true }
      }
    },
    "provenanceFence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture", "recording", "loopback", "blockedEnv", "connectedNative"],
      "properties": {
        "fixture": { "const": "never_connected_or_native" },
        "recording": { "const": "never_connected_or_native" },
        "loopback": { "const": "never_connected_or_native" },
        "blockedEnv": { "const": "never_connected_or_native" },
        "connectedNative": { "const": false }
      }
    },
    "forbiddenOperations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "deployment_create",
          "deployment_cancel",
          "deployment_resume",
          "stack_mutation",
          "config_mutation",
          "policy_mutation",
          "resource_mutation",
          "raw_logs",
          "raw_state",
          "raw_secrets",
          "generic_iac_registry",
          "kernel_authority",
          "outcome_adoption"
        ]
      }
    },
    "nativeGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "deferredTo", "gaps"],
      "properties": {
        "status": { "const": "BLOCKED_ENV" },
        "deferredTo": { "const": "optional_layer_2_draft" },
        "gaps": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
