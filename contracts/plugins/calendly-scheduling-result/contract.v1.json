{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hartevo://contracts/plugins/calendly-scheduling-result/contract.v1",
  "schema": "hartevo.calendly-scheduling-result/contract",
  "contractVersion": "1.0.0",
  "layer": 1,
  "pluginId": "hartevo.calendly-scheduling-result",
  "service": {
    "id": "calendly.scheduling-result.service",
    "implementation": "CalendlySchedulingResultService",
    "operations": [
      "describe_capabilities",
      "register",
      "revoke_registration",
      "read_organization_user",
      "read_event_type",
      "read_scheduled_event",
      "read_invitee_status",
      "read_webhook_change_signals",
      "compile_adoption_proposal",
      "record_redacted_evidence"
    ],
    "readOnly": true,
    "proposalOnly": true,
    "externalWrites": false,
    "calendarAuthority": false,
    "bookingAuthority": false
  },
  "provider": {
    "id": "calendly.scheduling-result.provider",
    "implementation": "CalendlyProvider",
    "api": "Calendly API v2",
    "apiRevision": "v2",
    "providerRevision": "calendly-api-v2-layer1-r1",
    "modes": ["fixture", "recording", "loopback", "blocked_env"],
    "acceptedProvenance": ["fixture", "controlled_recording", "loopback_recording", "blocked_environment"],
    "connected": false,
    "native": false,
    "firstParty": false,
    "liveTransport": false,
    "reversible": true,
    "revocable": true
  },
  "consumer": {
    "id": "mission.calendly-meeting.consumer",
    "implementation": "MissionCalendlyMeetingConsumer",
    "scope": "project_mission_work_product_revision_bound",
    "mutatesExternalState": false,
    "adoptsWorkProduct": false,
    "adoptsOutcome": false,
    "calendarAuthority": false
  },
  "calendlyApi": {
    "origin": "https://api.calendly.com",
    "readEndpoints": [
      "GET /organizations/{organization_uuid}",
      "GET /users/{user_uuid}",
      "GET /event_types/{event_type_uuid}",
      "GET /scheduled_events/{event_uuid}",
      "GET /scheduled_events/{event_uuid}/invitees",
      "GET /scheduled_events/{event_uuid}/invitees/{invitee_uuid}",
      "GET /invitee_no_shows/{uuid}"
    ],
    "webhookSignals": [
      "invitee.created",
      "invitee.canceled",
      "invitee_no_show.created",
      "invitee_no_show.deleted"
    ],
    "webhookSubscriptionOperations": [],
    "bookingOperations": [],
    "calendarOperations": []
  },
  "permissions": {
    "requiredReadScopes": ["users:read", "event_types:read", "scheduled_events:read"],
    "webhookReadScopeOptional": "webhooks:read",
    "writeScopesRequested": [],
    "permissionLeaseDigest": "sha256(canonical-json)",
    "secret": "opaque_secret_reference_only"
  },
  "scope": {
    "required": [
      "organization_uri",
      "user_uri",
      "event_type_uri",
      "scheduled_event_uri",
      "project_id",
      "project_revision",
      "mission_id",
      "mission_revision",
      "work_product_id",
      "work_product_revision",
      "event_revision",
      "date_window",
      "permission_digest"
    ],
    "uriRepresentation": "opaque_api_v2_uri",
    "digestAlgorithm": "sha256(canonical-json)",
    "maxDateWindowDays": 31,
    "maxInvitees": 32
  },
  "projection": {
    "states": ["scheduled", "canceled", "rescheduled", "no_show", "unknown"],
    "completeness": ["complete", "partial", "unknown"],
    "bounded": true,
    "fields": [
      "organization_uri",
      "user_uri",
      "event_type_uri",
      "scheduled_event_uri",
      "start_time_millis",
      "end_time_millis",
      "timezone",
      "location_kind",
      "status",
      "cancellation_actor",
      "cancellation_reason_digest",
      "rescheduled",
      "old_invitee_uri",
      "new_invitee_uri",
      "no_show",
      "invitee_status_counts",
      "tracking_digests",
      "event_digest",
      "invitee_digest",
      "scope_digest",
      "revision_digest"
    ],
    "inviteePii": false,
    "rawTrackingValues": false,
    "rawWebhookPayload": false,
    "rawLocationOrJoinUrl": false
  },
  "bounds": {
    "maxPages": 8,
    "maxInvitees": 32,
    "maxWebhookSignals": 32,
    "maxDateWindowDays": 31,
    "maxTimestampSkewSeconds": 300,
    "maxIdentifierBytes": 256,
    "maxResponseBytes": 1048576
  },
  "httpOutcomes": [401, 403, 404, 409, 429, "5xx", "timeout"],
  "webhookIntegrity": {
    "replayRejected": true,
    "futureTimestampRejected": true,
    "payloadStoredAsDigest": true,
    "deliveryIdBound": true,
    "signatureMaterialStored": false
  },
  "registration": {
    "pluginVersionBound": true,
    "apiRevisionBound": true,
    "contractDigestBound": true,
    "providerDigestBound": true,
    "implementationDigestBound": true,
    "permissionDigestBound": true,
    "scopeDigestBound": true,
    "eventRevisionBound": true,
    "reversible": true,
    "revocable": true,
    "failClosedOnDrift": true
  },
  "honesty": {
    "fixtureConnected": false,
    "recordingConnected": false,
    "loopbackConnected": false,
    "blockedEnvConnected": false,
    "fixtureNative": false,
    "recordingNative": false,
    "loopbackNative": false,
    "blockedEnvNative": false,
    "fixtureFirstParty": false,
    "recordingFirstParty": false,
    "loopbackFirstParty": false,
    "blockedEnvFirstParty": false,
    "durableNativeReceipt": false,
    "independentWriteReadBack": false,
    "adoptedWorkProduct": false,
    "adoptedOutcome": false
  },
  "forbiddenLayer1Effects": [
    "create_invitee",
    "cancel_scheduled_event",
    "reschedule_invitee",
    "mark_invitee_no_show",
    "remove_invitee_no_show",
    "create_webhook_subscription",
    "delete_webhook_subscription",
    "write_calendar_event",
    "serialize_pat_or_oauth_token",
    "serialize_invitee_pii",
    "serialize_join_or_cancel_url",
    "adopt_work_product",
    "adopt_outcome"
  ],
  "layer2Gaps": [
    "native_pat_or_oauth21_resolution",
    "native_calendly_api_v2_https_transport",
    "consent_and_permission_lease_refresh",
    "durable_native_receipt",
    "independent_write_readback",
    "verified_work_product_or_outcome_adoption",
    "calendar_or_booking_authority"
  ]
}
