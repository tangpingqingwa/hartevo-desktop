{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tangpingqingwa/hartevo-desktop/contracts/plugins/aws-compute-optimizer-result/aws-compute-optimizer-result.v1.json",
  "title": "Hartevo AWS Compute Optimizer recommendation evidence Layer-1 contract",
  "description": "Bounded AWS Compute Optimizer EC2 and Auto Scaling Group recommendation evidence for a Mission capacity decision. This contract is evidence-only and never a savings guarantee or effect executor.",
  "schemaVersion": "hartevo-aws-compute-optimizer-result-contract/v1",
  "contractVersion": "aws-compute-optimizer-result-l1/v1",
  "pluginVersion": "0.1.0",
  "layer": 1,
  "evidenceLevel": "E1",
  "service": {
    "id": "aws.compute-optimizer.result.read",
    "implementation": "AwsComputeOptimizerService",
    "version": "1.0.0",
    "operations": [
      "GetEC2InstanceRecommendations",
      "GetAutoScalingGroupRecommendations",
      "compile_result_proposal",
      "record_observation_receipt",
      "verify_result_proposal",
      "revoke_registration",
      "restore_registration"
    ],
    "readOnly": true,
    "proposalOnly": true,
    "externalWrites": false,
    "preferenceMutation": false,
    "resourceResize": false,
    "savingsGuarantee": false,
    "outcomeAdoption": false,
    "liveExecution": false
  },
  "provider": {
    "id": "aws.compute-optimizer.result",
    "implementation": "AwsComputeOptimizerProvider",
    "version": "1.0.0",
    "apiRevision": "aws-compute-optimizer-read-v1",
    "allowlistedOperations": [
      "GetEC2InstanceRecommendations",
      "GetAutoScalingGroupRecommendations"
    ],
    "allowlistedMethods": ["POST"],
    "acceptedTransports": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
    "native": false,
    "connected": false,
    "externalWrites": false,
    "sigV4Secret": "opaque_non_serializing_secret_reference_only",
    "liveCredentialResolution": false,
    "rawRecommendationPayload": false,
    "rawUtilizationSeries": false
  },
  "consumer": {
    "id": "mission.aws.compute-optimizer.result",
    "implementation": "MissionAwsComputeOptimizerConsumer",
    "version": "1.0.0",
    "accountBound": true,
    "regionBound": true,
    "resourceAllowlistBound": true,
    "recommendationWindowBound": true,
    "missionBound": true,
    "projectBound": true,
    "workProductBound": true,
    "permissionBound": true,
    "producesDecisionProposal": true,
    "adoptsOutcome": false,
    "truthAuthority": false,
    "kernelAuthority": false
  },
  "scope": {
    "required": [
      "accountDigest",
      "region",
      "resourceAllowlist",
      "recommendationWindow",
      "projectDigest",
      "missionDigest",
      "workProductDigest",
      "workProductRevision",
      "permissionDigest",
      "consentDigest",
      "maxRecommendationAgeSeconds",
      "scopeDigest"
    ],
    "rawAccountId": false,
    "rawResourceIdentifier": false,
    "rawRecommendationPayload": false,
    "rawUtilizationSeries": false,
    "pii": false
  },
  "allowlistedReads": [
    {
      "operation": "GetEC2InstanceRecommendations",
      "method": "POST",
      "bounded": true,
      "resourceScoped": true,
      "opaquePagination": true
    },
    {
      "operation": "GetAutoScalingGroupRecommendations",
      "method": "POST",
      "bounded": true,
      "resourceScoped": true,
      "opaquePagination": true
    }
  ],
  "bounds": {
    "maxResources": 128,
    "maxRecommendationsPerPage": 64,
    "maxRecommendations": 256,
    "maxPagesPerResourceKind": 4,
    "maxResponseBytes": 1048576,
    "maxIdentifierBytes": 256,
    "maxRecommendationWindowSeconds": 2678400,
    "maxRecommendationAgeSeconds": 604800,
    "maxRetryAfterSeconds": 3600
  },
  "redaction": {
    "secret": "opaque_digest_only",
    "account": "digest_only",
    "resourceIdentifier": "sha256_digest_only",
    "recommendationIdentifier": "sha256_digest_only",
    "configuration": "digest_only",
    "utilizationSeries": "dropped",
    "rawProviderPayload": "dropped",
    "paginationToken": "digest_only",
    "receipt": "proposal_scope_registration_provenance_digest_only"
  },
  "evidenceStates": [
    "complete",
    "partial",
    "stale",
    "resource_not_found",
    "access_lost",
    "throttled",
    "provider_unknown",
    "tampered",
    "revoked"
  ],
  "registration": {
    "pluginVersionBound": true,
    "contractVersionBound": true,
    "contractDigestBound": true,
    "providerDigestBound": true,
    "apiDigestBound": true,
    "permissionDigestBound": true,
    "scopeDigestBound": true,
    "resourceAllowlistDigestBound": true,
    "recommendationWindowDigestBound": true,
    "secretReferenceDigestBound": true,
    "evidencePolicyDigestBound": true,
    "reversible": true,
    "revocable": true,
    "failClosedOn": [
      "version_drift",
      "contract_drift",
      "provider_or_api_drift",
      "account_or_region_drift",
      "resource_allowlist_drift",
      "recommendation_window_drift",
      "mission_project_work_product_drift",
      "permission_drift",
      "stale_recommendation",
      "pagination_token_replay",
      "response_tamper",
      "registration_revocation"
    ]
  },
  "authority": {
    "connected": false,
    "nativeProvider": false,
    "externalWrites": false,
    "preferenceMutation": false,
    "resourceResize": false,
    "savingsGuarantee": false,
    "rawResourceExport": false,
    "rawUtilizationSeries": false,
    "durableProviderReceipt": false,
    "independentReadBack": false,
    "kernelConsentAuthority": false,
    "kernelEffectAuthority": false,
    "kernelReceiptAuthority": false,
    "kernelOutcomeAdoption": false,
    "workProductAdoption": false
  },
  "evidenceModes": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
  "layer2Gaps": [
    "native_sigv4_secret_resolution",
    "native_compute_optimizer_https_read",
    "durable_provider_receipt",
    "independent_post_change_readback",
    "kernel_owned_consent_effect_receipt_authority",
    "consented_preference_or_resource_resize_effects"
  ],
  "honestNativeGap": "Layer 1 records, replays, and projects bounded recommendation evidence only. It never resolves native credentials, signs SigV4, calls a live AWS endpoint, mutates Compute Optimizer preferences, resizes a resource, exports utilization series or raw payloads, guarantees savings, claims Connected/native, or adopts a kernel Outcome."
}
