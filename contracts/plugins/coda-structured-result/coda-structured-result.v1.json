{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hartevo.local/contracts/plugins/coda-structured-result/coda-structured-result.v1.json",
  "title": "Hartevo Coda structured-result Layer-1 contract",
  "description": "Bounded redacted Coda API v1 metadata evidence for a Mission proposal; not a Coda connector, knowledge registry, formula engine, or mutation authority.",
  "schemaVersion": "hartevo.coda-structured-result/v1",
  "contractVersion": "EXT-CODA-01-L1/v1",
  "pluginVersion": "0.1.0",
  "layer": 1,
  "authority": {
    "readOnly": true,
    "proposalOnly": true,
    "recordingOnly": true,
    "connected": false,
    "native": false,
    "firstParty": false,
    "externalWrites": false,
    "rowWrites": false,
    "pageWrites": false,
    "buttonWrites": false,
    "formulaExecution": false,
    "genericKnowledgeRegistry": false,
    "kernelAuthority": false,
    "outcomeAuthority": false,
    "workProductAdoption": false,
    "durableProviderReceipt": false,
    "independentReadback": false
  },
  "typedSurface": {
    "service": "CodaStructuredResultService",
    "provider": "CodaProvider",
    "consumer": "MissionCodaStructuredConsumer",
    "models": [
      "CodaStructuredResultScope",
      "CodaWorkspaceId",
      "CodaDocId",
      "CodaPageId",
      "CodaTableId",
      "CodaViewId",
      "CodaRowId",
      "CodaColumnId",
      "Revision",
      "Project",
      "Mission",
      "WorkProduct",
      "SecretReference",
      "CodaPageToken",
      "CodaStructuredResultEvidence",
      "CodaStructuredResultProposal",
      "CodaRegistration"
    ]
  },
  "api": {
    "reference": "https://coda.io/developers/apis/v1",
    "baseUrl": "https://coda.io/apis/v1",
    "version": "v1",
    "authentication": "opaque_api_token_secret_reference",
    "allowlistedReads": [
      { "operation": "doc_metadata", "method": "GET", "path": "/docs/{docId}" },
      { "operation": "page_metadata", "method": "GET", "path": "/docs/{docId}/pages/{pageId}" },
      { "operation": "table_metadata", "method": "GET", "path": "/docs/{docId}/tables/{tableId}" },
      { "operation": "view_metadata", "method": "GET", "path": "/docs/{docId}/tables/{viewId}?tableTypes=view" },
      { "operation": "column_metadata", "method": "GET", "path": "/docs/{docId}/tables/{tableId}/columns/{columnId}" },
      { "operation": "row_metadata", "method": "GET", "path": "/docs/{docId}/tables/{tableId}/rows/{rowId}" }
    ],
    "writes": [],
    "formulaReads": false,
    "richTextReads": false,
    "buttonReads": false
  },
  "scope": {
    "exactFields": [
      "workspace",
      "doc",
      "page_allowlist",
      "table_allowlist",
      "view_allowlist",
      "row_allowlist",
      "column_allowlist",
      "revision",
      "project",
      "mission",
      "work_product"
    ],
    "allowlistOnly": true,
    "revisionFenced": true,
    "queryDigestBound": true,
    "identifiersInEvidence": "digest_only"
  },
  "bounds": {
    "maxIdentifierBytes": 128,
    "maxPageSize": 100,
    "maxPages": 8,
    "maxPageTokenBytes": 512,
    "maxResponseBytes": 1048576,
    "maxMetadataRecords": 100,
    "maxRequestsPerMinute": 60,
    "maxRetryAfterSeconds": 3600
  },
  "pagination": {
    "tokenField": "nextPageToken",
    "opaqueToken": true,
    "tokenDigestOnly": true,
    "tokenBoundTo": ["operation", "scopeDigest", "pageNumber"],
    "loopRejected": true,
    "filterDriftRejected": true,
    "truncationIsNonAdoptable": true
  },
  "evidence": {
    "states": [
      "present",
      "empty",
      "partial",
      "denied",
      "rate_limited",
      "provider_unknown",
      "tampered",
      "registration_revoked",
      "revision_drift"
    ],
    "requiredDigests": [
      "pluginVersionDigest",
      "contractDigest",
      "providerDigest",
      "scopeDigest",
      "queryDigest",
      "docDigest",
      "tableDigest",
      "rowDigest",
      "responseDigest",
      "registrationDigest",
      "evidenceDigest"
    ],
    "rawResponseBody": false,
    "rawRichText": false,
    "rawPii": false,
    "formulaValues": false,
    "tamperRejected": true,
    "replayRejected": true,
    "revisionDriftRejected": true,
    "partialIsNonAdoptable": true
  },
  "redaction": {
    "requestReceipts": "operation_and_digest_fields_only",
    "evidence": "bounded_metadata_and_digests_only",
    "removed": [
      "api_token",
      "authorization_header",
      "raw_page_token",
      "raw_rich_text",
      "raw_formula",
      "raw_cell_values",
      "raw_row_values",
      "email_addresses",
      "person_names",
      "user_identifiers",
      "raw_provider_payload"
    ]
  },
  "registration": {
    "boundDigests": [
      "pluginVersion",
      "contractVersion",
      "contractDigest",
      "providerDigest",
      "scopeDigest",
      "secretReferenceDigest",
      "registrationRevision",
      "registrationDigest"
    ],
    "reversible": true,
    "revocable": true,
    "rotationOnStateChange": true,
    "failClosedOn": [
      "scope_drift",
      "revision_drift",
      "provider_drift",
      "contract_drift",
      "secret_reference_drift",
      "registration_revocation",
      "tamper",
      "replay"
    ]
  },
  "transports": {
    "fixture": { "allowed": true, "connected": false, "native": false, "firstParty": false },
    "recording": { "allowed": true, "connected": false, "native": false, "firstParty": false },
    "fake": { "allowed": true, "connected": false, "native": false, "firstParty": false },
    "loopback": { "allowed": true, "connected": false, "native": false, "firstParty": false },
    "BLOCKED_ENV": { "allowed": true, "connected": false, "native": false, "firstParty": false }
  },
  "forbidden": [
    "row_write",
    "page_write",
    "button_press",
    "formula_execution",
    "raw_rich_text_export",
    "raw_pii_export",
    "generic_knowledge_registry",
    "native_token_resolution",
    "live_coda_https",
    "durable_provider_receipt",
    "independent_readback",
    "kernel_outcome_authority",
    "verified_work_product_adoption"
  ],
  "layer2Gaps": [
    "native opaque API-token resolution",
    "live Coda API v1 HTTPS metadata reads",
    "durable provider receipt",
    "independent reread and revision reconciliation",
    "consented row/page/button effects",
    "formula and rich-text handling",
    "verified Work Product or kernel Outcome adoption"
  ],
  "honesty": {
    "fixtureNative": false,
    "recordingNative": false,
    "fakeNative": false,
    "loopbackNative": false,
    "blockedEnvNative": false,
    "fixtureConnected": false,
    "recordingConnected": false,
    "fakeConnected": false,
    "loopbackConnected": false,
    "blockedEnvConnected": false,
    "firstParty": false,
    "nativeCredentialResolution": "layer_2_gap",
    "liveHttps": "layer_2_gap",
    "absenceIsSuccess": false,
    "partialIsComplete": false,
    "rateLimitIsSuccess": false
  }
}
