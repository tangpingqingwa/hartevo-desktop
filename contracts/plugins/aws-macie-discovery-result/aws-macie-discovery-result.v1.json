{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hartevo.local/contracts/plugins/aws-macie-discovery-result/aws-macie-discovery-result.v1.json",
  "title": "Hartevo AWS Macie discovery-result Layer-1 contract",
  "description": "A bounded, read/proposal/record/verify-only Amazon Macie discovery finding seam. It retains normalized metadata and deterministic digests, never raw sensitive data or provider payloads.",
  "schemaVersion": "hartevo.aws-macie-discovery-result-contract/v1",
  "contractVersion": "aws-macie-discovery-result/v1",
  "pluginVersion": "1.0.0",
  "layer": 1,
  "officialReferences": [
    "https://docs.aws.amazon.com/macie/latest/APIReference/findings.html",
    "https://docs.aws.amazon.com/macie/latest/APIReference/findings-describe.html"
  ],
  "service": {
    "id": "aws.macie.discovery-result",
    "implementation": "MacieDiscoveryResultService",
    "version": "1.0.0",
    "access": "read_only",
    "operations": [
      "describe_capabilities",
      "register",
      "revoke_registration",
      "read_list_findings",
      "read_get_findings",
      "propose",
      "record",
      "verify"
    ],
    "readOnly": true,
    "proposalOnly": true,
    "externalWrites": false,
    "native": false,
    "connected": false,
    "firstParty": false
  },
  "provider": {
    "id": "aws.macie.discovery-findings",
    "implementation": "MacieProvider",
    "apiVersion": "2017-12-19",
    "operations": ["ListFindings", "GetFindings"],
    "permissions": ["macie2:ListFindings", "macie2:GetFindings"],
    "acceptedProvenance": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
    "native": false,
    "connected": false,
    "firstParty": false,
    "liveCredentialResolution": false,
    "externalWrites": false,
    "mutationOperations": [
      "create_classification_job",
      "archive_findings",
      "suppress_findings",
      "mutate_s3",
      "mutate_iam",
      "download_samples"
    ],
    "rawProviderPayload": false,
    "secretReference": "opaque_non_serializing_sigv4_only"
  },
  "consumer": {
    "id": "mission.aws-macie-discovery-result",
    "implementation": "MissionMacieDiscoveryConsumer",
    "version": "1.0.0",
    "missionBound": true,
    "projectBound": true,
    "consentBound": true,
    "workProductBound": false,
    "truthAuthority": false,
    "consentAuthority": false,
    "effectAuthority": false,
    "receiptAuthority": false,
    "verificationAuthority": false,
    "outcomeAuthority": false,
    "adoptsOutcome": false,
    "adoptsWorkProduct": false
  },
  "scope": {
    "required": [
      "awsAccountId",
      "awsRegion",
      "findingIdAllowlist",
      "resourceId",
      "resourceType",
      "classificationScope",
      "policyId",
      "policyRevision",
      "missionId",
      "missionRevision",
      "projectId",
      "projectRevision",
      "consentId",
      "consentRevision",
      "permissionDigest"
    ],
    "exactAccountAndRegion": true,
    "exactResourceBinding": true,
    "exactClassificationBinding": true,
    "exactPolicyBinding": true,
    "secret": "opaque_non_serializable_sigv4_secret_reference",
    "scopeDigest": true,
    "rawObjectKeys": false,
    "rawObjectPaths": false,
    "rawPii": false
  },
  "bounds": {
    "maxResponseBytes": 1048576,
    "maxPages": 4,
    "maxListPageSize": 50,
    "maxFindingIdsPerGet": 50,
    "maxFindings": 200,
    "maxClassificationTypes": 32,
    "maxIdentifierBytes": 256,
    "maxTimestampBytes": 64
  },
  "pagination": {
    "cursorOpaque": true,
    "cursorDigestOnly": true,
    "cursorBoundTo": [
      "account",
      "region",
      "classificationScope",
      "policyScope",
      "resourceScope",
      "filterDigest",
      "pageNumber",
      "pageSize"
    ],
    "filterDriftRejected": true,
    "scopeDriftRejected": true,
    "repeatedCursorRejected": true,
    "unboundedList": false
  },
  "allowlist": {
    "listProducesFindingIdsOnly": true,
    "getRequiresListProducedIds": true,
    "maxIdsPerGet": 50,
    "duplicateIdsRejected": true,
    "outOfAllowlistFindingsRejected": true,
    "rawProviderFindingPayload": false
  },
  "findingProjection": {
    "retained": [
      "findingId",
      "accountId",
      "region",
      "severity",
      "classificationCategory",
      "classificationTypeDigests",
      "classificationCountMetadata",
      "classificationStatus",
      "resourceType",
      "resourceReferenceDigest",
      "createdAt",
      "updatedAt",
      "findingLifecycle",
      "policyKind",
      "policyRevision",
      "policyActionDigest",
      "policyFirstSeen",
      "policyLastSeen",
      "findingDigest"
    ],
    "redacted": [
      "description",
      "title",
      "detailedResultsLocation",
      "jobArn",
      "jobId",
      "objectKey",
      "objectPath",
      "sampleData",
      "sensitiveDataOccurrences",
      "cellReferences",
      "lineRanges",
      "offsetRanges",
      "recordContents",
      "actorIdentity",
      "ipAddress",
      "rawTags",
      "rawProviderPayload",
      "providerCredentialMaterial"
    ],
    "rawPiiRetained": false,
    "rawObjectKeysRetained": false,
    "rawObjectPathsRetained": false,
    "fullDescriptionsRetained": false,
    "sampleDownload": false
  },
  "lifecycle": {
    "findingStatuses": [
      "new",
      "open",
      "updated",
      "archived",
      "suppressed",
      "expired",
      "provider_unknown"
    ],
    "evidenceStatuses": [
      "complete",
      "partial",
      "access_lost",
      "stale",
      "tampered",
      "provider_unknown"
    ],
    "archivedIsNotSuppressionAuthority": true,
    "expiredIsNonAdoptable": true,
    "partialIsNonAdoptable": true,
    "accessLostIsNonAdoptable": true,
    "providerUnknownIsNonAdoptable": true
  },
  "digests": {
    "required": [
      "pluginVersionDigest",
      "contractDigest",
      "providerDigest",
      "permissionDigest",
      "scopeDigest",
      "classificationDigest",
      "policyDigest",
      "findingDigest",
      "listResponseDigest",
      "getResponseDigest",
      "evidenceDigest"
    ],
    "secretMaterialExcluded": true,
    "rawProviderPayloadExcluded": true,
    "deterministic": true
  },
  "registration": {
    "versionBound": true,
    "contractVersionBound": true,
    "contractDigestBound": true,
    "providerRevisionBound": true,
    "providerDigestBound": true,
    "permissionDigestBound": true,
    "scopeDigestBound": true,
    "evidenceDigestBound": true,
    "secretReferenceDigestBound": true,
    "reversible": true,
    "revocable": true,
    "failClosedOnDrift": true,
    "failClosedCases": [
      "provider_unknown",
      "stale_registration",
      "stale_evidence",
      "tampered_evidence",
      "scope_drift",
      "permission_drift",
      "filter_drift",
      "repeated_cursor",
      "out_of_allowlist_finding",
      "raw_payload_request",
      "mutation_request"
    ]
  },
  "authority": {
    "readOnly": true,
    "proposalOnly": true,
    "externalWrites": false,
    "jobCreation": false,
    "archiveFindings": false,
    "suppressFindings": false,
    "s3Mutation": false,
    "iamMutation": false,
    "sampleDownload": false,
    "rawPii": false,
    "truthAuthority": false,
    "consentAuthority": false,
    "effectAuthority": false,
    "receiptAuthority": false,
    "verificationAuthority": false,
    "outcomeAuthority": false,
    "workProductAdoption": false,
    "connected": false,
    "native": false,
    "firstParty": false,
    "durableReceipt": false,
    "independentLiveReadback": false
  },
  "transport": {
    "fixture": "connected_false_native_false_first_party_false",
    "recording": "connected_false_native_false_first_party_false",
    "loopback": "connected_false_native_false_first_party_false",
    "BLOCKED_ENV": "connected_false_native_false_first_party_false",
    "liveHttps": false,
    "liveSigV4Resolution": false,
    "rawRequestsRetained": false,
    "rawResponsesRetained": false,
    "rawSecretsRetained": false
  },
  "nativeGap": {
    "status": "BLOCKED_ENV",
    "deferredTo": "layer_2_native_sigv4_and_connected_authority",
    "requires": [
      "native_sigv4_credential_resolution",
      "live_https_ListFindings",
      "live_https_GetFindings",
      "durable_provider_receipt",
      "independent_readback",
      "consented_remediation_effects"
    ],
    "honest": "Layer 1 provides bounded normalized Macie discovery evidence through fixture, recording, loopback, or BLOCKED_ENV seams only. None is Connected, native, first-party, a durable provider receipt, kernel Truth/Consent/Effect/Receipt/Verification/Outcome authority, or adoption."
  }
}
