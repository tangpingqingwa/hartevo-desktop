{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hartevo.local/contracts/plugins/openalex-research-result/openalex-research-result.v1.json",
  "title": "Hartevo OpenAlex research-result Layer-1 contract",
  "description": "Bounded, redacted OpenAlex scholarly metadata evidence for a Mission proposal; not ranking, full-text, identity, citation truth, research Truth, Work Product, or Outcome authority.",
  "schemaVersion": "hartevo.openalex-research-result/v1",
  "contractVersion": "openalex-research-result-e1/v1",
  "pluginVersion": "0.1.0",
  "layer": 1,
  "authority": {
    "readOnly": true,
    "proposalOnly": true,
    "connected": false,
    "nativeProvider": false,
    "durableReceipt": false,
    "kernelAuthority": false,
    "truthAuthority": false,
    "researchTruthAuthority": false,
    "rankingAuthority": false,
    "fullTextAuthority": false,
    "authorIdentityAuthority": false,
    "citationTruthAuthority": false,
    "workProductAuthority": false,
    "outcomeAuthority": false,
    "externalWrites": false
  },
  "typedSurface": {
    "service": "OpenAlexResearchResultService",
    "provider": "OpenAlexProvider",
    "consumer": "MissionOpenAlexResearchConsumer",
    "models": [
      "OpenAlexResearchScope",
      "OpenAlexQuery",
      "OpenAlexCursor",
      "OpenAlexPermission",
      "OpenAlexRegistration",
      "SecretReference",
      "OpenAlexRequest",
      "OpenAlexWorkProjection",
      "OpenAlexAuthorProjection",
      "OpenAlexInstitutionProjection",
      "OpenAlexConceptProjection",
      "OpenAlexCitationProjection",
      "OpenAlexResearchEvidence",
      "OpenAlexResearchProposal",
      "OpenAlexObservationReceipt"
    ]
  },
  "service": {
    "id": "openalex.research-result",
    "name": "OpenAlexResearchResultService",
    "version": "1.0.0",
    "access": "read_only",
    "operations": [
      "issue_read_consent",
      "read_metadata",
      "compile_research_proposal",
      "record_observation_receipt",
      "verify_evidence",
      "verify_proposal",
      "revoke_registration",
      "restore_registration"
    ],
    "externalWrites": false,
    "liveExternalIo": false,
    "emitsOutcome": false
  },
  "provider": {
    "id": "openalex.metadata.rest",
    "name": "OpenAlexProvider",
    "version": "1.0.0",
    "apiRevision": "openalex-rest-api-v1",
    "baseUrl": "https://api.openalex.org",
    "allowlistedGetPaths": [
      "/works",
      "/works/{id}",
      "/authors",
      "/authors/{id}",
      "/institutions",
      "/institutions/{id}",
      "/concepts",
      "/concepts/{id}",
      "/works?filter=cites:{id}",
      "/works?filter=cited_by:{id}"
    ],
    "requiredPermission": "metadata.read",
    "authentication": ["opaque_secret_reference"],
    "transportProvenance": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
    "maxRequestsPerMinute": 100,
    "maxResponseBytes": 1048576,
    "maxResults": 25,
    "maxCursorBytes": 512,
    "rawCredentialSerialized": false,
    "rawQuerySerialized": false,
    "rawFilterSerialized": false,
    "rawEntityIdSerialized": false,
    "rawCursorSerialized": false,
    "rawResponseBody": false,
    "reversible": true,
    "revocable": true,
    "native": false,
    "connected": false
  },
  "consumer": {
    "id": "mission.openalex.research-result",
    "name": "MissionOpenAlexResearchConsumer",
    "kind": "mission_research_evidence_projection",
    "scope": [
      "project",
      "mission",
      "work_product",
      "entity",
      "operation",
      "query_digest",
      "filter_digest",
      "cursor_digest",
      "scope_revision",
      "consent_digest",
      "source_evidence_digest",
      "idempotency_digest"
    ],
    "adoptsOutcome": false,
    "adoptsWorkProduct": false,
    "kernelAuthority": false,
    "truthAuthority": false
  },
  "exactScope": [
    "project",
    "mission",
    "work_product",
    "entity",
    "operation",
    "selector_digest",
    "filter_digest",
    "cursor_digest",
    "page_size",
    "scope_revision",
    "consent"
  ],
  "allowlist": {
    "reads": [
      {
        "operation": "list_or_search_metadata",
        "method": "GET",
        "paths": ["/works", "/authors", "/institutions", "/concepts"],
        "permission": "metadata.read",
        "aggregateOnly": false,
        "rawQuery": false,
        "rawResponse": false
      },
      {
        "operation": "get_metadata",
        "method": "GET",
        "paths": ["/{entity}/{id}"],
        "permission": "metadata.read",
        "rawEntityId": false,
        "rawResponse": false
      },
      {
        "operation": "bounded_citation_projection",
        "method": "GET",
        "paths": ["/works?filter=cites:{id}", "/works?filter=cited_by:{id}"],
        "permission": "metadata.read",
        "providerReportedOnly": true,
        "citationTruth": false,
        "rawEntityId": false,
        "rawResponse": false
      }
    ],
    "writes": [],
    "forbidden": [
      "full_text_retrieval",
      "content_download",
      "semantic_search",
      "relevance_sort",
      "ranking_claim",
      "quality_claim",
      "author_identity_enrichment",
      "citation_truth_claim",
      "research_truth_claim",
      "raw_query_export",
      "raw_filter_export",
      "raw_entity_id_export",
      "raw_cursor_export",
      "raw_title_export",
      "raw_abstract_export",
      "raw_response_export",
      "api_key_export",
      "metadata_mutation",
      "kernel_receipt",
      "kernel_truth_authority",
      "kernel_verification_authority",
      "verified_work_product_adoption",
      "outcome_adoption"
    ]
  },
  "authentication": {
    "boundary": "opaque SecretReference",
    "requiredPermission": "metadata.read",
    "rawCredentialSerialized": false,
    "rawCredentialDebug": false,
    "rawCredentialRequest": false,
    "rawCredentialReceipt": false,
    "resolvedByLayer": 2
  },
  "bounds": {
    "maxResults": 25,
    "maxResponseBytes": 1048576,
    "maxIdentifierBytes": 128,
    "maxQueryBytes": 512,
    "maxFilterBytes": 512,
    "maxCursorBytes": 512,
    "maxDiagnosticBytes": 512,
    "maxRequestsPerMinute": 100,
    "maxRetryAfterSeconds": 3600,
    "maxWorkAuthors": 1000,
    "maxWorkInstitutions": 1000,
    "maxWorkConcepts": 1000,
    "maxCitations": 25
  },
  "normalization": {
    "responseOrderIndependent": true,
    "resultsSortedByEntityDigest": true,
    "duplicateEntityDigestRejected": true,
    "query": "digest_only",
    "filter": "digest_only",
    "entityId": "digest_only",
    "cursor": "digest_only_and_scope_bound",
    "title": "digest_only",
    "abstract": "dropped",
    "rawJson": false,
    "partialResults": true,
    "emptyIsSuccess": false,
    "citationCountsAreProviderMetadataOnly": true,
    "citationEdgesAreProviderReportedOnly": true,
    "rankingClaims": false,
    "researchTruthClaims": false
  },
  "digests": {
    "pluginVersion": true,
    "contractVersion": true,
    "contract": true,
    "provider": true,
    "permission": true,
    "scope": true,
    "query": true,
    "filter": true,
    "cursor": true,
    "secretReference": true,
    "registration": true,
    "consent": true,
    "request": true,
    "idempotency": true,
    "evidence": true,
    "proposal": true,
    "receipt": true,
    "response": true
  },
  "registration": {
    "versionBound": true,
    "contractDigestBound": true,
    "providerDigestBound": true,
    "permissionDigestBound": true,
    "scopeDigestBound": true,
    "secretReferenceDigestBound": true,
    "consentDigestBound": true,
    "registrationDigestBound": true,
    "reversible": true,
    "revocable": true,
    "rotationOnStateChange": true,
    "failClosedOn": [
      "plugin_version_drift",
      "contract_drift",
      "provider_drift",
      "permission_drift",
      "scope_drift",
      "consent_drift",
      "cursor_drift",
      "secret_reference_drift",
      "evidence_drift",
      "registration_revocation",
      "replay"
    ]
  },
  "receipts": {
    "observation": true,
    "idempotencyFence": true,
    "rateLimit": ["limitPerMinute", "remaining", "retryAfterSeconds", "throttled"],
    "rawHeaders": false,
    "rawResponseBody": false,
    "durableNativeReceipt": false
  },
  "honesty": {
    "fixtureConnected": false,
    "fixtureNative": false,
    "recordingConnected": false,
    "recordingNative": false,
    "loopbackConnected": false,
    "loopbackNative": false,
    "blockedEnvConnected": false,
    "blockedEnvNative": false,
    "nativeHttpsTransport": "layer_2_gap",
    "nativeCredentialResolution": "layer_2_gap",
    "durableNativeProviderReceipt": "layer_2_gap",
    "independentNativeReadback": "layer_2_gap",
    "verifiedWorkProductAdoption": "layer_2_gap",
    "rankingAuthority": false,
    "fullTextAuthority": false,
    "authorIdentityAuthority": false,
    "citationTruthAuthority": false,
    "researchTruthAuthority": false,
    "absenceIsSuccess": false
  },
  "authorityBoundary": {
    "externalRead": "typed_bounded_metadata_get_only",
    "externalWrite": false,
    "fullText": false,
    "ranking": false,
    "authorIdentity": false,
    "citationTruth": false,
    "researchTruth": false,
    "connected": false,
    "native": false,
    "kernelTruth": false,
    "kernelConsent": false,
    "kernelReceipt": false,
    "kernelVerification": false,
    "kernelOutcome": false
  },
  "documentation": [
    "https://developers.openalex.org/api-reference/introduction",
    "https://developers.openalex.org/api-reference/works/list-works",
    "https://developers.openalex.org/guides/key-concepts"
  ],
  "errorHandling": [
    "HTTP_400",
    "HTTP_401",
    "HTTP_403",
    "HTTP_404",
    "HTTP_429_RATE_LIMITED",
    "HTTP_5XX",
    "BLOCKED_ENV",
    "MALFORMED_RESPONSE",
    "RESPONSE_TOO_LARGE",
    "RESPONSE_REORDER_NORMALIZED",
    "RESPONSE_TRUNCATION_PARTIAL",
    "INVALID_SCOPE",
    "MISSING_PERMISSION",
    "CURSOR_BINDING_MISMATCH",
    "TAMPER",
    "STALE_REVISION",
    "REGISTRATION_REVOCATION",
    "REPLAY"
  ],
  "layer2Gaps": [
    "native_secret_reference_resolution",
    "native_openalex_https_transport",
    "durable_native_provider_receipt",
    "independent_native_readback",
    "verified_work_product_adoption",
    "kernel_truth_consent_effect_receipt_verification_outcome_authority"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "$id",
    "schemaVersion",
    "contractVersion",
    "pluginVersion",
    "layer",
    "authority",
    "typedSurface",
    "service",
    "provider",
    "consumer",
    "exactScope",
    "allowlist",
    "authentication",
    "bounds",
    "normalization",
    "digests",
    "registration",
    "receipts",
    "honesty",
    "authorityBoundary",
    "documentation",
    "errorHandling",
    "layer2Gaps"
  ]
}
