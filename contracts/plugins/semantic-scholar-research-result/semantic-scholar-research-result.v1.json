  "contractVersion": "EXT-SEMANTIC-SCHOLAR-01-L1/v1",
  "layer": 1,
  "contractDigestInput": "hartevo.semantic-scholar-research-result/v1|layer=1|service=semantic-scholar.research-result|provider=semantic-scholar.academic-graph|consumer=mission.semantic-scholar.research-result|contract=EXT-SEMANTIC-SCHOLAR-01-L1/v1",
  "contractDigest": "05a06cdcb0a4c6f3f644617e237a39a70a5e51607efdcab4a5de648871035b8a",
  "plugin": {
    "id": "semantic-scholar.research-result",
