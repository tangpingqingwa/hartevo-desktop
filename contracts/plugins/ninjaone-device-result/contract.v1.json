{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hartevo://contracts/plugins/ninjaone-device-result/contract.v1",
  "title": "Hartevo NinjaOne endpoint-device result Layer-1 contract",
  "description": "A standalone bounded read, proposal, and recording-only NinjaOne endpoint-device projection. It is not a native NinjaOne connection, endpoint-control effect, raw activity log, generic connector registry, or Domain Kernel authority.",
  "schemaVersion": "hartevo.ninjaone-device-result.contract/v1",
  "contractVersion": "EXT-NINJAONE-01-L1/v1",
  "pluginVersion": "1.0.0",
  "layer": 1,
  "pluginId": "ninjaone.device-result",
  "service": {
    "id": "ninjaone.device-result.service",
    "implementation": "NinjaOneDeviceResultService",
    "operations": [
      "describe_capabilities",
      "read_device_result",
      "compile_device_result_proposal",
      "record_redacted_evidence",
      "verify_device_result",
      "unmount",
      "remount",
      "revoke",
      "reverse"
    ],
    "access": "read_proposal_recording_only",
    "readOnly": true,
    "proposalOnly": true,
    "externalWrites": false,
    "endpointControlAuthority": false,
    "kernelAuthority": false
  },
  "provider": {
    "id": "ninjaone.device-health",
    "implementation": "NinjaOneProvider",
    "api": "NinjaOne Public API 2.0",
    "apiOrigin": "https://app.ninjarmm.com",
    "apiRevision": "ninjaone-public-api-v2-r1",
    "method": "GET",
    "routes": [
      "GET /v2/organizations",
      "GET /v2/devices",
      "GET /v2/device/{id}/alerts",
      "GET /v2/queries/device-health",
      "GET /v2/device/{id}/os-patches",
      "GET /v2/device/{id}/software-patches",
      "GET /v2/device/{id}/activities"
    ],
    "requiredOAuthAccess": ["Monitoring"],
    "transportModes": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
    "connected": false,
    "native": false,
    "liveTransport": false,
    "backoff": "bounded_retry_advisory_without_sleep",
    "receipts": "redacted_request_and_response_digests_only",
    "bounds": {
      "maxResponseBytes": 1048576,
      "maxPages": 4,
      "maxPageSize": 100,
      "maxAlerts": 64,
      "maxPatches": 64,
      "maxActivities": 32,
      "maxReceipts": 16
    }
  },
  "consumer": {
    "id": "mission.ninjaone-device-result",
    "implementation": "MissionNinjaOneDeviceConsumer",
    "scopeCheck": "exact_organization_site_device_agent_alert_patch_health_activity_mission_project_consent_revisions",
    "mutatesExternalState": false,
    "adoptsWorkProduct": false,
    "adoptsOutcome": false,
    "kernelAuthority": false
  },
  "scope": {
    "required": [
      "organization_id",
      "site_id",
      "device_id",
      "agent_id",
      "alert_id",
      "patch_health_id",
      "activity_id",
      "mission_id",
      "project_id",
      "consent_id",
      "organization_revision",
      "site_revision",
      "device_revision",
      "agent_revision",
      "alert_revision",
      "patch_health_revision",
      "activity_revision",
      "mission_revision",
      "project_revision",
      "consent_revision",
      "permission_digest"
    ],
    "identifierSemantics": "opaque_bounded_provider_ids",
    "digestAlgorithm": "sha256(canonical-json)",
    "absenceOfAlertsMeansHealthy": false
  },
  "projection": {
    "states": [
      "healthy",
      "degraded",
      "offline",
      "alerted",
      "patch_pending",
      "partial",
      "retention_gap",
      "access_lost",
      "provider_unknown"
    ],
    "fields": [
      "organization_identity_digest",
      "site_identity_digest",
      "device_identity_digest",
      "agent_identity_digest",
      "alert_metadata_without_body",
      "patch_health_metadata_without_patch_payload",
      "activity_metadata_without_message_or_data",
      "scope_digest",
      "revision_digest",
      "registration_digest",
      "provider_digest",
      "redacted_receipts"
    ],
    "rawPii": false,
    "rawLogs": false,
    "rawAlertBodies": false,
    "rawScripts": false,
    "rawIpAddresses": false,
    "rawSerials": false,
    "rawUsernames": false
  },
  "registration": {
    "pluginVersionBound": true,
    "contractDigestBound": true,
    "providerDigestBound": true,
    "apiDigestBound": true,
    "implementationDigestBound": true,
    "permissionDigestBound": true,
    "scopeDigestBound": true,
    "revisionDigestBound": true,
    "secretReferenceDigestBound": true,
    "reversible": true,
    "revocable": true,
    "failClosedOnDrift": true,
    "secretSerializable": false
  },
  "honesty": {
    "fixtureConnected": false,
    "recordingConnected": false,
    "loopbackConnected": false,
    "blockedEnvConnected": false,
    "fixtureNative": false,
    "recordingNative": false,
    "loopbackNative": false,
    "blockedEnvNative": false,
    "durableNativeReceipt": false,
    "independentReadBack": false,
    "adoptedWorkProduct": false,
    "adoptedOutcome": false
  },
  "forbiddenLayer1Effects": [
    "reboot_device",
    "run_script",
    "install_patch",
    "scan_or_apply_patch",
    "mutate_policy",
    "acknowledge_alert",
    "reset_alert",
    "remote_control",
    "software_deployment",
    "create_or_update_organization",
    "create_or_update_device",
    "serialize_oauth_token",
    "serialize_authorization_header",
    "retain_raw_api_payload",
    "retain_raw_activity_log",
    "retain_serial_username_ip_or_alert_body",
    "register_generic_connector",
    "kernel_authority",
    "mission_work_product_adoption"
  ],
  "httpOutcomes": [401, 403, 404, 409, 429, "5xx", "timeout"],
  "layer2Gaps": [
    "native_oauth_reference_resolution",
    "native_https_transport",
    "consented_endpoint_effects",
    "durable_provider_receipts",
    "independent_status_readback",
    "verified_work_product_or_outcome_adoption"
  ]
}
