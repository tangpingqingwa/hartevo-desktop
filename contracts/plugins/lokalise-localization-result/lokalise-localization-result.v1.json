{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hartevo.local/contracts/plugins/lokalise-localization-result/lokalise-localization-result.v1.json",
  "title": "Hartevo Lokalise localization-result Layer-1 contract",
  "description": "Bounded Lokalise project, translation, review, QA, task and export-process evidence for a Mission proposal; not a localization mutation or publication authority.",
  "schemaVersion": "hartevo.lokalise-localization-result/v1",
  "contractVersion": "lokalise-localization-result-e1/v1",
  "pluginVersion": "0.1.0",
  "layer": 1,
  "authority": {
    "readOnly": true,
    "proposalOnly": true,
    "connected": false,
    "nativeProvider": false,
    "firstParty": false,
    "durableReceipt": false,
    "kernelAuthority": false,
    "truthAuthority": false,
    "consentAuthority": false,
    "effectAuthority": false,
    "verificationAuthority": false,
    "outcomeAuthority": false,
    "externalWrites": false
  },
  "typedSurface": {
    "service": "LokaliseLocalizationResultService",
    "provider": "LokaliseProvider",
    "consumer": "MissionLokaliseLocalizationConsumer",
    "models": [
      "TeamId",
      "ProjectId",
      "BranchName",
      "KeyId",
      "FileId",
      "LanguageId",
      "LanguageIso",
      "TranslationId",
      "TaskId",
      "BuildId",
      "ProjectBinding",
      "MissionBinding",
      "WorkProductBinding",
      "ConsentScope",
      "LokaliseLocalizationScope",
      "LokalisePermissionSet",
      "SecretReference",
      "LokaliseTranslationSummary",
      "LokaliseTaskSummary",
      "LokaliseBuildSummary",
      "LokaliseLocalizationResultEvidence",
      "LokaliseLocalizationResultProposal"
    ]
  },
  "service": {
    "id": "lokalise.localization-result",
    "name": "LokaliseLocalizationResultService",
    "version": "1.0.0",
    "access": "read_only",
    "operations": [
      "issue_read_consent",
      "read_localization_result",
      "compile_localization_result_proposal",
      "record_observation_receipt",
      "verify_proposal",
      "read_back_proposal_only",
      "revoke_registration",
      "restore_registration"
    ],
    "externalWrites": false,
    "liveExternalIo": false,
    "adoptsKernelOutcome": false
  },
  "provider": {
    "id": "lokalise.localization-result",
    "name": "LokaliseProvider",
    "version": "1.0.0",
    "apiRevision": "lokalise-rest-api-v2",
    "baseHost": "https://api.lokalise.com",
    "allowlistedGetPaths": [
      "/api2/projects/{project_id}",
      "/api2/projects/{project_id}:{branch}/languages",
      "/api2/projects/{project_id}:{branch}/files",
      "/api2/projects/{project_id}:{branch}/translations",
      "/api2/projects/{project_id}:{branch}/tasks",
      "/api2/projects/{project_id}/processes"
    ],
    "requiredPermissions": [
      "read_projects",
      "read_languages",
      "read_files",
      "read_translations",
      "read_tasks",
      "read_background_processes"
    ],
    "authentication": ["opaque_secret_reference"],
    "transportProvenance": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
    "maxRequestsPerMinute": 60,
    "maxResponseBytes": 1048576,
    "maxPageSize": 100,
    "maxCursorBytes": 256,
    "rawApiToken": false,
    "rawOAuthCredential": false,
    "rawResponseBody": false,
    "rawSourceText": false,
    "rawTranslatedText": false,
    "rawTranslatorIdentity": false,
    "rawComments": false,
    "rawScreenshots": false,
    "reversible": true,
    "revocable": true,
    "native": false,
    "connected": false,
    "firstParty": false
  },
  "consumer": {
    "id": "mission.lokalise.localization-result",
    "name": "MissionLokaliseLocalizationConsumer",
    "kind": "mission_localization_result_projection",
    "scope": [
      "team",
      "project",
      "branch",
      "file",
      "language",
      "permission",
      "project_revision",
      "mission",
      "mission_revision",
      "work_product",
      "work_product_revision",
      "consent",
      "source_evidence_digest",
      "content_digest",
      "build_digest"
    ],
    "adoptsOutcome": false,
    "kernelAuthority": false,
    "truthAuthority": false
  },
  "exactScope": [
    "team",
    "project",
    "project_revision",
    "branch",
    "branch_revision",
    "file",
    "file_revision",
    "language",
    "language_revision",
    "permission",
    "mission",
    "mission_revision",
    "work_product",
    "work_product_revision",
    "consent"
  ],
  "allowlist": {
    "reads": [
      {"operation": "project_metadata", "method": "GET", "path": "/api2/projects/{project_id}", "requiredPermission": "read_projects", "aggregateOnly": true},
      {"operation": "language_metadata", "method": "GET", "path": "/api2/projects/{project_id}:{branch}/languages", "requiredPermission": "read_languages", "aggregateOnly": true},
      {"operation": "file_metadata", "method": "GET", "path": "/api2/projects/{project_id}:{branch}/files", "requiredPermission": "read_files", "aggregateOnly": true},
      {"operation": "translation_items", "method": "GET", "path": "/api2/projects/{project_id}:{branch}/translations", "requiredPermission": "read_translations", "aggregateOnly": true},
      {"operation": "task_review_status", "method": "GET", "path": "/api2/projects/{project_id}:{branch}/tasks", "requiredPermission": "read_tasks", "aggregateOnly": true},
      {"operation": "export_build_metadata", "method": "GET", "path": "/api2/projects/{project_id}/processes", "requiredPermission": "read_background_processes", "aggregateOnly": true}
    ],
    "writes": [],
    "forbidden": [
      "key_mutation",
      "translation_submission",
      "task_creation",
      "approval",
      "file_upload",
      "file_delete",
      "export_trigger",
      "download_translated_bytes",
      "webhook_registration",
      "ota_publication",
      "raw_source_export",
      "raw_translation_export",
      "translator_identity_export",
      "comment_export",
      "screenshot_export",
      "generic_cms_registry",
      "kernel_truth_authority",
      "kernel_consent_authority",
      "kernel_effect_authority",
      "kernel_receipt_authority",
      "kernel_verification_authority",
      "kernel_outcome_authority",
      "verified_work_product_adoption"
    ]
  },
  "authentication": {
    "boundary": "opaque SecretReference",
    "rawCredentialSerialized": false,
    "rawCredentialDebug": false,
    "rawCredentialRequest": false,
    "rawCredentialReceipt": false,
    "resolvedByLayer": 2
  },
  "bounds": {
    "maxIdentifierBytes": 128,
    "maxTranslations": 256,
    "maxTasks": 64,
    "maxBuilds": 64,
    "maxResponseBytes": 1048576,
    "maxPageSize": 100,
    "maxCursorBytes": 256,
    "maxRequestsPerMinute": 60,
    "maxRetryAfterSeconds": 3600,
    "maxDiagnosticBytes": 512
  },
  "normalization": {
    "states": [
      "untranslated",
      "translated",
      "unverified",
      "reviewed",
      "qa_issue",
      "building",
      "ready",
      "expired",
      "partial",
      "rate_limited",
      "access_lost",
      "provider_unknown"
    ],
    "countsOnly": true,
    "languageMetadata": "bounded_iso_and_name_digest",
    "sourceText": "digest_only",
    "translatedText": "digest_only",
    "translatorIdentity": "dropped",
    "comments": "dropped",
    "screenshots": "dropped",
    "rawJson": false,
    "responseOrderIndependent": true,
    "qualityClaims": false,
    "publicationClaims": false,
    "partialIsExplicit": true,
    "expiredIsExplicit": true
  },
  "digests": {
    "pluginVersion": true,
    "contract": true,
    "provider": true,
    "permission": true,
    "scope": true,
    "revision": true,
    "privacy": true,
    "registration": true,
    "team": true,
    "project": true,
    "branch": true,
    "file": true,
    "language": true,
    "content": true,
    "build": true,
    "request": true,
    "response": true,
    "proposal": true
  },
  "registration": {
    "versionBound": true,
    "contractDigestBound": true,
    "providerDigestBound": true,
    "permissionDigestBound": true,
    "scopeDigestBound": true,
    "revisionDigestBound": true,
    "privacyDigestBound": true,
    "secretReferenceDigestBound": true,
    "registrationDigestBound": true,
    "reversible": true,
    "revocable": true,
    "rotationOnStateChange": true,
    "failClosedOn": [
      "version_drift",
      "contract_drift",
      "provider_drift",
      "team_drift",
      "project_drift",
      "project_revision_drift",
      "branch_drift",
      "file_drift",
      "language_drift",
      "permission_drift",
      "mission_stale",
      "work_product_stale",
      "consent_drift",
      "privacy_digest_drift",
      "registration_revocation",
      "secret_revocation",
      "replay"
    ]
  },
  "receipts": {
    "rateLimit": ["limitPerMinute", "remaining", "retryAfterSeconds", "throttled"],
    "observation": true,
    "readback": true,
    "durableNativeReceipt": false,
    "rawHeaders": false,
    "rawResponseBody": false,
    "rawDownloadUrl": false
  },
  "honesty": {
    "fixtureNative": false,
    "recordingNative": false,
    "loopbackNative": false,
    "blockedEnvNative": false,
    "fixtureConnected": false,
    "recordingConnected": false,
    "loopbackConnected": false,
    "blockedEnvConnected": false,
    "fixtureFirstParty": false,
    "recordingFirstParty": false,
    "loopbackFirstParty": false,
    "blockedEnvFirstParty": false,
    "nativeHttpsTransport": "layer_2_gap",
    "nativeCredentialResolution": "layer_2_gap",
    "mutationEffects": "layer_2_gap",
    "durableReceipts": "layer_2_gap",
    "independentReadback": "layer_2_gap",
    "verifiedWorkProductAdoption": "layer_2_gap",
    "translationQualityTruth": false,
    "publicationTruth": false,
    "absenceIsSuccess": false
  },
  "authorityBoundary": {
    "externalRead": "typed_bounded_get_only",
    "externalWrite": false,
    "keyManagement": false,
    "translationManagement": false,
    "taskManagement": false,
    "approval": false,
    "exportTrigger": false,
    "download": false,
    "publication": false,
    "genericCatalog": false,
    "connected": false,
    "native": false,
    "firstParty": false,
    "kernelTruth": false,
    "kernelConsent": false,
    "kernelEffect": false,
    "kernelReceipt": false,
    "kernelVerification": false,
    "kernelOutcome": false
  }
}
