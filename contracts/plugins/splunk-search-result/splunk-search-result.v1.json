{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hartevo.local/contracts/plugins/splunk-search-result/splunk-search-result.v1.json",
  "title": "Hartevo Splunk saved-search result Layer-1 contract",
  "description": "Bounded status and aggregate projection for one already-running, explicitly scoped Splunk saved-search job; not search dispatch, raw event, administration, kernel, native, or Outcome authority.",
  "schemaVersion": "hartevo.splunk-search-result/v1",
  "contractVersion": "splunk-search-result-e1/v1",
  "pluginVersion": "0.1.0",
  "layer": 1,
  "layerName": "Layer-1",
  "authority": {
    "readOnly": true,
    "proposalOnly": true,
    "externalWrites": false,
    "searchDispatch": false,
    "jobCancel": false,
    "savedSearchMutation": false,
    "indexMutation": false,
    "arbitrarySpl": false,
    "rawEventAccess": false,
    "rawEventStorage": false,
    "credentialResolution": false,
    "nativeHttps": false,
    "connected": false,
    "nativeProvider": false,
    "firstPartyEvidence": false,
    "kernelTruthAuthority": false,
    "kernelConsentAuthority": false,
    "kernelEffectAuthority": false,
    "kernelReceiptAuthority": false,
    "kernelVerificationAuthority": false,
    "kernelOutcomeAuthority": false,
    "outcomeAdoption": false,
    "workProductAdoption": false
  },
  "typedSurface": {
    "service": "SplunkSavedSearchResultService",
    "provider": "SplunkProvider",
    "consumer": "MissionSplunkSearchConsumer",
    "models": [
      "SplunkSavedSearchResultScope",
      "SplunkProviderResourceScope",
      "SplunkSearchResultTimeWindow",
      "SplunkIndexAllowlist",
      "ProjectBinding",
      "MissionBinding",
      "WorkProductBinding",
      "SecretReference",
      "SplunkRegistration",
      "SplunkEvidenceStatus",
      "SplunkFieldDefinition",
      "SplunkAggregateCell",
      "SplunkAggregateRow",
      "SplunkSavedSearchResultEvidence",
      "SplunkSavedSearchResultProposal"
    ]
  },
  "service": {
    "id": "hartevo.splunk.search-result",
    "name": "SplunkSavedSearchResultService",
    "version": "1.0.0",
    "access": "read_only",
    "operations": [
      "describe_scope",
      "register",
      "issue_read_consent_scope",
      "read_job_status",
      "read_bounded_aggregate_results",
      "compile_mission_proposal",
      "verify_digest_fence",
      "revoke_registration",
      "restore_registration"
    ],
    "externalWrites": false,
    "liveExternalIo": false,
    "kernelTruthAuthority": false,
    "kernelConsentAuthority": false,
    "kernelEffectAuthority": false,
    "kernelReceiptAuthority": false,
    "kernelVerificationAuthority": false,
    "kernelOutcomeAuthority": false
  },
  "provider": {
    "id": "splunk.search.saved-search-result",
    "name": "SplunkProvider",
    "version": "1.0.0",
    "apiRevision": "splunk-search-job-read-v1",
    "officialApiBasis": "https://help.splunk.com/en/splunk-cloud-platform/leverage-rest-apis/rest-api-reference/10.3.2512/search-endpoints/search-endpoint-descriptions",
    "allowlistedMethods": ["GET"],
    "allowlistedOperations": [
      "search_job_status",
      "search_job_bounded_results"
    ],
    "allowlistedPaths": [
      "/services/search/jobs/{sid}",
      "/services/search/jobs/{sid}/results"
    ],
    "acceptedTransports": [
      "fixture",
      "recording",
      "loopback",
      "BLOCKED_ENV"
    ],
    "authentication": {
      "schemes": ["token", "oauth"],
      "secretReference": "opaque_non_serializing_only",
      "nativeResolution": false,
      "rawCredentialMaterial": false
    },
    "resourceScope": [
      "https_host",
      "tenant",
      "app",
      "owner",
      "saved_search",
      "sid",
      "index_allowlist",
      "search_revision",
      "time_window",
      "project",
      "mission",
      "work_product"
    ],
    "readOnly": true,
    "externalWrites": false,
    "connected": false,
    "native": false,
    "first_party": false,
    "providerReceiptAuthority": false
  },
  "consumer": {
    "id": "mission.splunk.search-result",
    "name": "MissionSplunkSearchConsumer",
    "kind": "mission_saved_search_result_projection",
    "scope": [
      "project",
      "mission",
      "work_product",
      "project_revision",
      "mission_revision",
      "work_product_revision",
      "provider_resource_scope_digest",
      "search_digest",
      "sid_digest",
      "time_window_digest",
      "result_digest"
    ],
    "proposalOnly": true,
    "adoptsOutcome": false,
    "adoptsWorkProduct": false,
    "truthAuthority": false,
    "consentAuthority": false,
    "effectAuthority": false,
    "receiptAuthority": false,
    "verificationAuthority": false,
    "outcomeAuthority": false,
    "native": false,
    "connected": false,
    "first_party": false
  },
  "exactScope": [
    "https_host",
    "tenant",
    "app",
    "owner",
    "saved_search",
    "sid",
    "index_allowlist",
    "search_revision",
    "time_window",
    "project",
    "mission",
    "work_product",
    "consent_scope",
    "opaque_secret_reference"
  ],
  "allowlist": {
    "reads": [
      {
        "operation": "search_job_status",
        "method": "GET",
        "path": "/services/search/jobs/{sid}",
        "preexistingSidOnly": true,
        "aggregateOnly": true
      },
      {
        "operation": "search_job_bounded_results",
        "method": "GET",
        "path": "/services/search/jobs/{sid}/results",
        "preexistingSidOnly": true,
        "aggregateOnly": true,
        "boundedPagination": true
      }
    ],
    "writes": [],
    "forbidden": [
      "search_dispatch",
      "arbitrary_spl",
      "job_creation",
      "job_cancel",
      "saved_search_create",
      "saved_search_update",
      "saved_search_delete",
      "index_mutation",
      "input_mutation",
      "output_mutation",
      "alert_execution",
      "action_execution",
      "admin_api",
      "raw_event_read",
      "raw_event_storage",
      "_raw",
      "source_value",
      "host_value",
      "token_export",
      "pii_export",
      "kernel_truth",
      "kernel_consent",
      "kernel_effect",
      "kernel_receipt",
      "kernel_verification",
      "kernel_outcome",
      "verified_work_product_adoption"
    ]
  },
  "authentication": {
    "boundary": "opaque SecretReference",
    "acceptedSchemes": ["token", "oauth"],
    "rawCredentialSerialized": false,
    "rawCredentialDebug": false,
    "rawCredentialRequest": false,
    "rawCredentialReceipt": false,
    "resolvedByLayer": 2
  },
  "bounds": {
    "maxResponseBytes": 1048576,
    "maxPages": 4,
    "maxCellsPerPage": 64,
    "maxAggregateCells": 256,
    "maxFields": 32,
    "maxFieldNameBytes": 64,
    "maxCellBytes": 256,
    "maxDiagnosticBytes": 512,
    "maxIdentifierBytes": 128,
    "maxIndexAllowlist": 16,
    "maxTimeWindowDays": 31,
    "maxDurationMilliseconds": 86400000
  },
  "normalization": {
    "status": "explicit_uppercase_enum",
    "timing": "bounded_duration_only",
    "fieldSchema": "bounded_sorted_projection",
    "aggregateCells": "bounded_sorted_projection",
    "stringCells": "sha256_digest_only",
    "rawEvents": "rejected_and_not_retained",
    "rawJson": false,
    "_raw": false,
    "sourceValues": false,
    "hostValues": false,
    "searchExpression": "never_accepted",
    "responseOrderIndependent": true
  },
  "statuses": [
    "QUEUED",
    "RUNNING",
    "DONE",
    "FAILED",
    "EXPIRED",
    "PARTIAL",
    "EMPTY",
    "ACCESS_LOST",
    "PROVIDER_UNKNOWN",
    "TAMPERED",
    "REVOKED"
  ],
  "digests": {
    "version": true,
    "contract": true,
    "provider": true,
    "scope": true,
    "resourceScope": true,
    "revision": true,
    "privacy": true,
    "secretReference": true,
    "registration": true,
    "search": true,
    "sid": true,
    "page": true,
    "result": true,
    "response": true,
    "timing": true
  },
  "registration": {
    "pluginVersionBound": true,
    "contractVersionBound": true,
    "contractDigestBound": true,
    "providerDigestBound": true,
    "scopeDigestBound": true,
    "resourceScopeDigestBound": true,
    "revisionDigestBound": true,
    "privacyDigestBound": true,
    "secretReferenceDigestBound": true,
    "registrationDigestBound": true,
    "reversible": true,
    "revocable": true,
    "rotationOnStateChange": true,
    "failClosedOn": [
      "plugin_version_drift",
      "contract_version_drift",
      "contract_digest_drift",
      "provider_or_api_revision_drift",
      "provider_digest_drift",
      "https_host_drift",
      "tenant_drift",
      "app_drift",
      "owner_drift",
      "saved_search_drift",
      "sid_drift",
      "index_allowlist_drift",
      "search_revision_drift",
      "time_window_drift",
      "project_drift",
      "mission_stale",
      "work_product_drift",
      "consent_scope_drift",
      "secret_reference_revocation",
      "registration_tamper",
      "registration_revocation",
      "pagination_replay",
      "result_bound_exceeded",
      "raw_event_or_spl_input",
      "native_claim"
    ]
  },
  "honestyBoundary": {
    "layer1": [
      "offline fixture/recording/loopback/BLOCKED_ENV transports only",
      "typed status and bounded aggregate projection",
      "digest-bound proposal and reversible registration"
    ],
    "layer2Gaps": [
      "native HTTPS transport",
      "token or OAuth resolution",
      "native consent flow",
      "durable kernel receipt",
      "independent native reread",
      "verified Mission adoption",
      "kernel Truth, Effect, Verification, and Outcome authority",
      "search dispatch or any search/job mutation"
    ],
    "connected": false,
    "native": false,
    "first_party": false
  }
}
