{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tangpingqingwa/hartevo-desktop/contracts/plugins/vertex-ai-generation-result/vertex-ai-generation-result.v1.json",
  "title": "Hartevo Vertex AI Gemini generation result Layer-1 contract",
  "description": "A scoped, proposal/recording-only Vertex AI generateContent seam. It is not a native Google connector, model registry, grounding authority, kernel Receipt, or Work Product adoption authority.",
  "schemaVersion": "hartevo.vertex-ai-generation-result.contract/v1",
  "contractVersion": "vertex-ai-generation-result/v1",
  "pluginVersion": "0.1.0",
  "layer": "Layer-1",
  "serviceId": "hartevo.vertex-ai.generation.result",
  "providerId": "google.vertex-ai.gemini.generate-content",
  "consumerId": "mission.vertex-ai.generation.result",
  "operation": "generateContent",
  "endpoint": {
    "apiVersion": "v1",
    "regional": true,
    "publisher": "google",
    "hostnamePattern": "{location}-aiplatform.googleapis.com"
  },
  "scope": [
    "google_cloud_project_id_and_revision",
    "regional_location",
    "regional_endpoint",
    "publisher",
    "immutable_model_id_and_snapshot",
    "input_policy_and_modality_allowlist",
    "response_policy_and_output_schema_digest",
    "safety_policy",
    "tool_grounding_policy",
    "permission_scope_and_opaque_secret_reference_digest",
    "consent_scope_and_revision",
    "project_id_and_revision",
    "mission_id_and_revision",
    "work_product_id_and_revision"
  ],
  "allowlist": {
    "models": "stable_gemini_family_with_immutable_snapshot",
    "modalities": ["text", "image_reference", "document_reference"],
    "imageMediaTypes": ["image/jpeg", "image/png", "image/webp"],
    "documentMediaTypes": ["application/json", "application/pdf", "text/markdown", "text/plain"],
    "responseContent": "bounded_candidate_metadata_and_content_digests_only",
    "outputSchema": "optional_external_digest_bound_json_schema",
    "tools": false,
    "grounding": false,
    "searchGrounding": false,
    "mapsGrounding": false,
    "streaming": false,
    "providerSelection": "one_explicit_google_vertex_route_no_silent_failover"
  },
  "bounds": {
    "maxInputParts": 16,
    "maxInputBytes": 8388608,
    "maxTextInputBytes": 1048576,
    "maxImageReferenceBytes": 8388608,
    "maxDocumentReferenceBytes": 8388608,
    "maxResponseBytes": 4194304,
    "maxOutputBytes": 4194304,
    "maxOutputTokens": 8192,
    "maxCandidates": 8,
    "maxSafetyRatings": 16,
    "maxSchemaBytes": 65536
  },
  "responseStates": [
    "complete",
    "partial",
    "blocked",
    "failed",
    "cancelled",
    "expired",
    "rate_limited",
    "access_lost",
    "provider_unknown"
  ],
  "metadata": {
    "responseId": true,
    "modelVersion": true,
    "candidateFinishReason": true,
    "candidateSafetyRatings": true,
    "promptFeedback": true,
    "usageMetadata": true,
    "contentDigest": true,
    "rawPrompt": false,
    "rawOutput": false,
    "hiddenReasoning": false,
    "groundingChunks": false,
    "toolArguments": false,
    "fileBytes": false
  },
  "registration": {
    "versionBound": true,
    "contractBound": true,
    "providerBound": true,
    "permissionBound": true,
    "scopeBound": true,
    "digestBound": true,
    "reversible": true,
    "revocable": true,
    "failClosedOn": [
      "project_drift",
      "location_drift",
      "publisher_drift",
      "model_drift",
      "snapshot_drift",
      "input_policy_drift",
      "safety_policy_drift",
      "tool_grounding_policy_drift",
      "response_policy_drift",
      "permission_drift",
      "consent_drift",
      "mission_revision_drift",
      "work_product_revision_drift",
      "registration_tamper",
      "registration_revocation",
      "replay"
    ]
  },
  "provenance": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
  "authority": {
    "connected": false,
    "native": false,
    "externalWrites": false,
    "durableReceipt": false,
    "independentReadBack": false,
    "kernelOutcomeAdoption": false,
    "verifiedWorkProductAdoption": false,
    "blockedEnvIsNative": false
  },
  "forbidden": [
    "raw_prompt_retention",
    "raw_output_retention",
    "hidden_reasoning_retention",
    "grounding_chunk_retention",
    "tool_argument_retention_or_execution",
    "raw_file_bytes",
    "native_credential_resolution",
    "native_generate_content_execution",
    "model_mutation",
    "deployment_mutation",
    "tuning_mutation",
    "arbitrary_model_registry",
    "search_grounding_authority",
    "maps_grounding_authority",
    "external_write",
    "silent_provider_failover",
    "native_connected_claim"
  ],
  "transports": {
    "fixture": {"connected": false, "native": false},
    "recording": {"connected": false, "native": false},
    "loopback": {"connected": false, "native": false},
    "BLOCKED_ENV": {"connected": false, "native": false}
  },
  "layer2Gaps": [
    "native_service_account_or_oauth_credential_resolution",
    "consented_regional_https_generate_content_inference",
    "durable_provider_receipt",
    "independent_result_read_back_and_reconciliation",
    "verified_work_product_adoption",
    "kernel_truth_verification_and_outcome_authority"
  ],
  "nonOverlap": {
    "huggingFace": "HF inference provider result seam is separate",
    "bedrock": "AWS Bedrock result seam is separate",
    "anthropic": "Anthropic result seam is separate",
    "openAiResponses": "OpenAI Responses result seam is separate",
    "openAiBatch": "OpenAI Batch asynchronous file/orchestration seam is separate"
  }
}
