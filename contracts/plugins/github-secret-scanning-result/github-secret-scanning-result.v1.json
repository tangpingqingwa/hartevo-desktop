{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tangpingqingwa/hartevo-desktop/contracts/plugins/github-secret-scanning-result/github-secret-scanning-result.v1.json",
  "title": "Hartevo GitHub Secret Scanning result Layer-1 contract",
  "description": "A bounded read/proposal/record-only seam for repository and organization GitHub secret-scanning alert evidence. It never reveals secret material, retains raw location context, mutates GitHub, or exercises Hartevo kernel authority.",
  "schemaVersion": "hartevo.github-secret-scanning-result/v1",
  "contractVersion": "github-secret-scanning-result-01-layer-1/v1",
  "pluginId": "github.secret-scanning-result",
  "pluginVersion": "0.1.0",
  "contractDigestInput": "hartevo.github-secret-scanning-result/v1|github-secret-scanning-result-01-layer-1/v1|github.secret-scanning-result|security.github.secret-scanning.result.read|github.secret-scanning.result.recording|mission.github-secret-scanning-result.consumer",
  "contractDigest": "3e541308d78e82fcf84915c86a77cb3d448c123a0bb1f8ddfc5ed70b4360025d",
  "layer": 1,
  "evidenceLevel": "L1_PROVIDER_CONTRACT",
  "officialReferences": [
    "https://docs.github.com/en/rest/secret-scanning/secret-scanning?apiVersion=2026-03-10",
    "https://docs.github.com/en/rest/secret-scanning/secret-scanning#list-secret-scanning-alerts-for-an-organization",
    "https://docs.github.com/en/rest/secret-scanning/secret-scanning#list-secret-scanning-alerts-for-a-repository",
    "https://docs.github.com/en/rest/secret-scanning/secret-scanning#get-a-secret-scanning-alert"
  ],
  "service": {
    "type": "GithubSecretScanningService",
    "id": "security.github.secret-scanning.result.read",
    "access": "read_only",
    "operations": [
      "describe_capabilities",
      "register",
      "reverse_registration",
      "revoke_registration",
      "list_repository_alerts",
      "list_organization_alerts",
      "get_repository_alert",
      "get_organization_alert_from_bounded_list",
      "compile_proposal",
      "record_proposal",
      "verify_recording"
    ],
    "readOnly": true,
    "proposalOnly": true,
    "liveExecution": false,
    "proposalsBelowKernel": true
  },
  "provider": {
    "type": "GithubSecretScanningProvider",
    "id": "github.secret-scanning.result.recording",
    "version": "0.1.0",
    "apiRevision": "github-secret-scanning-read-v1",
    "allowedMethods": ["GET"],
    "allowedEndpoints": [
      "/repos/{owner}/{repo}/secret-scanning/alerts",
      "/repos/{owner}/{repo}/secret-scanning/alerts/{alert_number}",
      "/orgs/{org}/secret-scanning/alerts"
    ],
    "locationHandling": "digest_only_bounded_first_location_metadata",
    "requiredQuery": {
      "hide_secret": true,
      "explicitPagination": true,
      "boundedPerPage": true
    },
    "acceptedTransports": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
    "native": false,
    "connected": false,
    "firstParty": false,
    "externalWrites": false,
    "appOrOAuthSecret": "opaque_non_serializing_secret_reference_only",
    "mutations": {
      "resolveAlert": false,
      "reopenAlert": false,
      "bypassPushProtection": false,
      "mutateCustomPatterns": false,
      "retrieveSecret": false,
      "exportLocation": false,
      "exportRawCode": false,
      "webhookAuthority": false,
      "remediationCommit": false
    },
    "httpClassification": {
      "unauthorized": 401,
      "forbidden": 403,
      "notFound": 404,
      "conflict": 409,
      "unprocessable": 422,
      "rateLimited": 429,
      "serviceUnavailable": 503,
      "timeout": true
    }
  },
  "consumer": {
    "type": "MissionGithubSecretScanningConsumer",
    "id": "mission.github-secret-scanning-result.consumer",
    "authority": "below-kernel-proposal-and-recording",
    "scope": [
      "installationId",
      "organization",
      "repository",
      "ref",
      "commit",
      "alertNumber",
      "secretTypeDigest",
      "locationDigest",
      "projectId",
      "projectRevision",
      "missionId",
      "missionRevision",
      "workProductId",
      "workProductRevision"
    ],
    "producesDecisionProposal": true,
    "adoptsKernelOutcome": false,
    "truthAuthority": false,
    "certificationAuthority": false
  },
  "credentials": {
    "boundary": "opaque SecretReference",
    "acceptedKinds": ["app", "oauth"],
    "serialized": false,
    "rawMaterialAccepted": false,
    "resolvedByLayer": 2
  },
  "permissions": {
    "required": ["secret_scanning_alerts:read", "metadata:read"],
    "writePermissions": false,
    "installationRepositoryDriftFailsClosed": true
  },
  "scope": {
    "required": [
      "installationId",
      "organization",
      "repository",
      "ref",
      "commit",
      "alertNumber",
      "expectedAlertState",
      "expectedValidity",
      "permissionDigest",
      "queryDigest",
      "evidencePolicyDigest",
      "projectId",
      "projectRevision",
      "missionId",
      "missionRevision",
      "workProductId",
      "workProductRevision"
    ],
    "registrationBinding": [
      "pluginVersion",
      "contractVersion",
      "contractDigest",
      "providerDigest",
      "apiDigest",
      "permissionDigest",
      "scopeDigest",
    "queryDigest",
    "evidencePolicyDigest",
    "evidenceDigest",
    "secretReferenceDigest",
      "evidenceDigest",
      "registrationRevision"
    ],
    "rawSecret": false,
    "rawLocation": false,
    "rawCode": false,
    "reviewerPii": false
  },
  "query": {
    "hideSecret": true,
    "explicitPagination": true,
    "allowedStates": ["open", "resolved"],
    "allowedValidities": ["active", "inactive", "unknown"],
    "cursor": "opaque_digest_only",
    "filters": ["state", "secret_type_digest_allowlist", "validity", "is_bypassed"],
    "rawSecretType": false
  },
  "registration": {
    "reversible": true,
    "revocable": true,
    "activeStatuses": ["active"],
    "reversedStatuses": ["reversed"],
    "terminalStatuses": ["revoked"],
    "failClosedOn": [
      "installation_drift",
      "repository_drift",
      "permission_drift",
      "plugin_version_drift",
      "provider_or_api_revision_drift",
      "contract_or_provider_digest_drift",
      "scope_or_query_digest_drift",
      "evidence_digest_drift",
      "secret_reference_drift",
      "registration_tamper",
      "registration_revocation",
      "cursor_loop",
      "stale_alert_state",
      "partial_evidence",
      "access_loss"
    ]
  },
  "bounds": {
    "maxResponseBytes": 1048576,
    "maxPages": 16,
    "pageSize": 50,
    "maxAlerts": 256,
    "maxLocations": 64,
    "maxRequestsPerRead": 8,
    "maxProviderErrors": 8,
    "maxIdentifierBytes": 256
  },
  "evidence": {
    "projected": [
      "alertNumber",
      "alertState",
      "openedAt",
      "resolvedAt",
      "secretTypeDigest",
      "validityClass",
      "installationDigest",
      "organizationDigest",
      "repositoryDigest",
      "refDigest",
      "commitDigest",
      "pathRegionDigests",
      "pushProtectionMetadata",
      "redactedRequestReceipts",
      "redactedRateReceipts"
    ],
    "notRetained": [
      "literalSecret",
      "tokenValue",
      "rawSecretTypeName",
      "rawLocationPath",
      "rawLocationContext",
      "codeLines",
      "comments",
      "reviewerPii",
      "rawProviderPayload",
      "rawAuthorizationHeader",
      "rawCursor",
      "webhookPayload"
    ],
    "missingOrInsufficientDataFailsClosed": true
  },
  "provenance": {
    "fixture": "non_native_non_connected_non_first_party",
    "recording": "non_native_non_connected_non_first_party",
    "loopback": "non_native_non_connected_non_first_party",
    "BLOCKED_ENV": "non_native_non_connected_non_first_party",
    "connectedClaim": false,
    "nativeClaim": false,
    "firstPartyClaim": false,
    "durableProviderReceipt": false
  },
  "authorityBoundary": {
    "owns": [
      "typed GitHub secret-scanning service/provider/consumer",
      "bounded repository and organization alert reads",
      "hide_secret=true request construction",
      "opaque App/OAuth SecretReference shape",
      "digest-only secret/location evidence projection",
      "reversible and revocable registration fences",
      "local proposal and recording integrity checks"
    ],
    "doesNotOwn": [
      "Hartevo Truth",
      "Hartevo Consent",
      "Hartevo Effect",
      "Hartevo Receipt",
      "Hartevo Verification",
      "Hartevo Outcome",
      "native App/OAuth resolution",
      "live HTTPS execution",
      "alert resolve or reopen",
      "push-protection bypass",
      "custom-pattern mutation",
      "secret retrieval",
      "location or raw-code export",
      "webhook authority",
      "remediation commit",
      "security certification"
    ]
  },
  "honestNativeGap": "Native App/OAuth resolution, live HTTPS reads, durable provider receipts, independent reread/reconciliation, consented remediation, and verified Work Product adoption remain Layer-2 work. Fixture, recording, loopback, and BLOCKED_ENV never claim Connected, native, or first-party evidence.",
  "layer2Gaps": [
    "native_github_app_or_oauth_resolution",
    "live_https_github_transport",
    "durable_provider_receipt",
    "independent_commit_and_alert_readback",
    "consented_secret_remediation",
    "push_protection_bypass_authority",
    "custom_pattern_management",
    "verified_work_product_adoption",
    "security_certification_authority"
  ],
  "forbidden": [
    "resolve_secret_scanning_alert",
    "reopen_secret_scanning_alert",
    "bypass_push_protection",
    "mutate_custom_patterns",
    "retrieve_secret",
    "export_raw_location",
    "export_raw_code",
    "retain_comments",
    "retain_reviewer_pii",
    "webhook_authority",
    "remediation_commit",
    "claim_connected",
    "claim_native",
    "claim_first_party",
    "claim_security_certification",
    "adopt_kernel_outcome"
  ]
