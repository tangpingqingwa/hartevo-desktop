{
  "schemaVersion": "hartevo.shippo-fulfillment-result-contract/v1",
  "contractVersion": "shippo-fulfillment-result/v1",
  "layer": 1,
  "serviceId": "shippo.fulfillment-result",
  "providerId": "shippo.provider",
  "consumerId": "mission.shippo-fulfillment-result",
  "apiVersion": "2018-02-08",
  "apiOrigin": "https://api.goshippo.com",
  "apiAreas": {
    "shipments": "shipments/{shipment_id}",
    "transactions": "transactions/{transaction_id}",
    "tracking": "tracks/{carrier}/{tracking_number}"
  },
  "transportProvenance": ["fixture", "recording", "loopback", "blocked_env", "production_read"],
  "operations": [
    "describe_capabilities",
    "register",
    "revoke_registration",
    "read_shipment",
    "read_transaction",
    "read_tracking",
    "compile_proposal",
    "consume_observation"
  ],
  "readOnly": true,
  "mutatingProviderOperations": [],
  "allowlistedMethods": ["GET"],
  "forbiddenOperations": [
    "create_shipment",
    "create_transaction",
    "purchase_label",
    "download_label",
    "mutate_address",
    "mutate_parcel",
    "register_webhook",
    "payment_or_refund",
    "carrier_command",
    "generic_fulfillment_registry"
  ],
  "authority": {
    "externalWrites": false,
    "labelPurchase": false,
    "labelDownload": false,
    "recipientPii": false,
    "rawLabels": false,
    "rawTrackingPayload": false,
    "connected": false,
    "nativeProvider": false,
    "effect": false,
    "receipt": false,
    "verification": false,
    "outcome": false,
    "workProductAdoption": false
  },
  "registration": {
    "boundFields": [
      "pluginVersion",
      "contractVersion",
      "contractDigest",
      "providerId",
      "providerRevision",
      "providerDigest",
      "accountId",
      "secretReference",
      "shipmentId",
      "transactionId",
      "carrier",
      "trackingNumber",
      "projectIdAndRevision",
      "missionIdAndRevision",
      "workProductIdAndRevision",
      "consentScopeAndRevision"
    ],
    "reversible": true,
    "revocable": true,
    "failClosedOnDrift": true
  },
  "scopeFence": [
    "pluginVersion",
    "contractVersion",
    "contractDigest",
    "providerId",
    "providerRevision",
    "providerDigest",
    "accountId",
    "organizationId",
    "shipmentId",
    "transactionId",
    "carrier",
    "trackingNumber",
    "projectIdAndRevision",
    "missionIdAndRevision",
    "workProductIdAndRevision",
    "consentScopeAndRevision",
    "shipmentRevision",
    "transactionRevision",
    "trackingRevision"
  ],
  "bounds": {
    "maxResponseBytes": 1048576,
    "maxTrackingEvents": 128,
    "maxCarrierEvidence": 32,
    "maxPages": 1,
    "maxCursorBytes": 256,
    "maxWindowDays": 366,
    "maxRetries": 2
  },
  "redaction": {
    "recipientAddresses": true,
    "recipientNames": true,
    "recipientPhonesAndEmails": true,
    "customsData": true,
    "rawLabels": true,
    "rawTrackingPayload": true,
    "credentialMaterial": true
  },
  "receipts": {
    "requestMethodAndPath": true,
    "apiVersion": true,
    "responseStatus": true,
    "responseSize": true,
    "responseDigest": true,
    "providerRevision": true,
    "rawProviderPayload": false,
    "rawLabels": false,
    "rawTrackingPayload": false,
    "recipientPii": false,
    "credentialMaterial": false
  },
  "statusVocabulary": [
    "label_created",
    "in_transit",
    "delivered",
    "exception",
    "returned",
    "unknown",
    "partial",
    "retention_gap",
    "access_lost",
    "provider_unknown"
  ],
  "nativeGap": {
    "status": "BLOCKED_ENV",
    "deferredTo": "layer_2_native_shippo_credential_and_receipt_authority",
    "failClosedCases": [
      "missing_native_secret_resolution",
      "missing_native_api_token",
      "api_version_drift",
      "provider_or_account_scope_drift",
      "shipment_transaction_tracking_revision_drift",
      "project_mission_work_product_consent_scope_drift",
      "raw_label_or_recipient_pii_request",
      "create_purchase_download_mutation_webhook_payment_request"
    ]
  },
  "honestNativeGap": "Fixture, recording, loopback, and BLOCKED_ENV transports are non-native and never Connected; this root does not resolve native Shippo credentials, purchase or download labels, create shipments or transactions, mutate addresses or parcels, register webhooks, expose recipient PII or raw tracking payloads, perform payments or carrier commands, emit durable provider receipts, verify delivery, or adopt a kernel Outcome."
}
