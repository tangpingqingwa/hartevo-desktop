{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hartevo.local/contracts/plugins/github-actions-result/github-actions-result.v1.json",
  "title": "Hartevo GitHub Actions workflow result Layer-1 contract",
  "description": "Bounded GitHub Actions workflow-run, job, and artifact metadata for a Mission decision; not a scheduler, source store, log store, artifact-byte store, or Outcome authority.",
  "schemaVersion": "hartevo.github-actions-result/v1",
  "contractVersion": "github-actions-result-e1/v1",
  "pluginVersion": "0.1.0",
  "layer": 1,
  "authority": {
    "readOnly": true,
    "proposalOnly": true,
    "connected": false,
    "nativeProvider": false,
    "durableReceipt": false,
    "kernelAuthority": false,
    "outcomeAuthority": false,
    "externalWrites": false,
    "workflowEffectAuthority": false,
    "greenCiAuthority": false,
    "sourceAuthority": false,
    "artifactBytesAuthority": false
  },
  "typedSurface": {
    "service": "GithubActionsResultService",
    "provider": "GithubActionsProvider",
    "consumer": "MissionGithubActionsConsumer",
    "models": [
      "GithubActionsScope",
      "GithubActionsScopeSpec",
      "GithubAppInstallationId",
      "GithubOrganization",
      "GithubRepository",
      "GithubWorkflowId",
      "GithubWorkflowRunId",
      "GithubJobId",
      "GithubRunAttempt",
      "GithubCommitSha",
      "ProjectBinding",
      "MissionBinding",
      "WorkProductBinding",
      "GithubActionsPermissions",
      "SecretReference",
      "OpaqueEtag",
      "OpaquePageToken",
      "GithubWorkflowRunMetadata",
      "GithubJobMetadata",
      "GithubArtifactMetadata",
      "GithubActionsRegistration",
      "GithubActionsEvidence",
      "GithubActionsResultProposal",
      "GithubActionsObservationReceipt"
    ]
  },
  "service": {
    "id": "github.actions.result",
    "name": "GithubActionsResultService",
    "version": "1.0.0",
    "access": "read_only",
    "operations": [
      "read_workflow_run_metadata",
      "read_job_metadata",
      "read_artifact_metadata",
      "compile_result_proposal",
      "record_observation_receipt",
      "verify_proposal",
      "revoke_registration",
      "restore_registration"
    ],
    "externalWrites": false,
    "liveExternalIo": false,
    "dispatch": false,
    "rerun": false,
    "cancel": false,
    "sarifUpload": false,
    "artifactUpload": false,
    "logDownload": false,
    "sourceDownload": false,
    "artifactByteDownload": false
  },
  "provider": {
    "id": "github.actions.workflow-result",
    "name": "GithubActionsProvider",
    "version": "1.0.0",
    "apiRevision": "github-actions-rest-v3",
    "apis": [
      "actions_workflow_runs_get",
      "actions_workflow_jobs_get",
      "actions_artifacts_get"
    ],
    "allowlistedGetPaths": [
      "/repos/{org}/{repo}/actions/runs/{run_id}",
      "/repos/{org}/{repo}/actions/runs/{run_id}/attempts/{attempt}/jobs",
      "/repos/{org}/{repo}/actions/runs/{run_id}/artifacts"
    ],
    "requiredPermissions": ["actions:read", "metadata:read"],
    "authentication": ["opaque_github_app_secret_reference", "opaque_github_oauth_secret_reference"],
    "transportProvenance": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
    "maxPages": 8,
    "maxJobs": 256,
    "maxArtifacts": 256,
    "maxResponseBytes": 1048576,
    "rawCredentialSerialized": false,
    "rawCredentialDebug": false,
    "rawCredentialRequest": false,
    "rawCredentialReceipt": false,
    "rawResponseBody": false,
    "logs": false,
    "source": false,
    "artifactZipBytes": false,
    "writes": false,
    "reversible": true,
    "revocable": true,
    "native": false,
    "connected": false
  },
  "consumer": {
    "id": "mission.github.actions.result",
    "name": "MissionGithubActionsConsumer",
    "kind": "mission_github_actions_result_projection",
    "scope": [
      "installation",
      "organization",
      "repository",
      "workflow",
      "run",
      "job",
      "attempt",
      "commit",
      "project",
      "mission",
      "work_product",
      "permission_digest",
      "source_evidence_digest"
    ],
    "adoptsOutcome": false,
    "kernelAuthority": false,
    "truthAuthority": false,
    "greenCiAuthority": false
  },
  "exactScope": [
    "installation",
    "organization",
    "repository",
    "workflow",
    "run",
    "job",
    "attempt",
    "commit",
    "project",
    "mission",
    "work_product",
    "permissions"
  ],
  "allowlist": {
    "reads": [
      {
        "operation": "workflow_run_metadata",
        "method": "GET",
        "path": "/repos/{org}/{repo}/actions/runs/{run_id}",
        "metadataOnly": true
      },
      {
        "operation": "job_metadata",
        "method": "GET",
        "path": "/repos/{org}/{repo}/actions/runs/{run_id}/attempts/{attempt}/jobs",
        "metadataOnly": true,
        "opaquePagination": true
      },
      {
        "operation": "artifact_metadata",
        "method": "GET",
        "path": "/repos/{org}/{repo}/actions/runs/{run_id}/artifacts",
        "metadataOnly": true,
        "opaquePagination": true,
        "digestOnly": true
      }
    ],
    "writes": [],
    "forbidden": [
      "workflow_dispatch",
      "workflow_rerun",
      "workflow_cancel",
      "sarif_upload",
      "artifact_upload",
      "log_download",
      "source_download",
      "artifact_zip_download",
      "secret_resolution",
      "raw_token_export",
      "raw_response_body_export",
      "green_ci_from_missing_jobs",
      "kernel_outcome_adoption",
      "connected_claim",
      "native_provider_claim"
    ]
  },
  "authentication": {
    "boundary": "opaque GitHub App/OAuth SecretReference",
    "rawCredentialSerialized": false,
    "rawCredentialDebug": false,
    "rawCredentialRequest": false,
    "rawCredentialReceipt": false,
    "resolvedByLayer": 2
  },
  "bounds": {
    "maxPages": 8,
    "maxJobs": 256,
    "maxArtifacts": 256,
    "maxIdentifierBytes": 128,
    "maxArtifactNameBytes": 256,
    "maxArtifactSizeBytes": 1073741824,
    "maxResponseBytes": 1048576,
    "maxDiagnosticBytes": 512,
    "maxTimestampBytes": 64,
    "maxOpaqueHeaderBytes": 512
  },
  "normalization": {
    "runStatus": "typed",
    "runConclusion": "provider_reported_typed",
    "jobStatus": "typed",
    "jobConclusion": "provider_reported_typed",
    "timestamps": "bounded_rfc3339_text",
    "commit": "lowercase_sha256_identifier",
    "artifactDigest": "sha256_digest_only",
    "responseOrderIndependent": true,
    "opaqueEtags": "digest_only",
    "opaquePagination": "digest_only",
    "rawJson": false,
    "rawLogs": false,
    "rawSource": false,
    "rawArtifactBytes": false,
    "states": [
      "complete",
      "partial",
      "run_in_progress",
      "artifact_expired",
      "access_lost",
      "rate_limited",
      "provider_unknown"
    ],
    "absenceIsSuccess": false,
    "greenCiClaim": false,
    "causalClaims": false
  },
  "digests": {
    "version": true,
    "contract": true,
    "provider": true,
    "api": true,
    "installation": true,
    "permission": true,
    "scope": true,
    "workflow": true,
    "run": true,
    "job": true,
    "attempt": true,
    "commit": true,
    "artifact": true,
    "response": true,
    "evidence": true,
    "registration": true
  },
  "registration": {
    "versionBound": true,
    "contractDigestBound": true,
    "providerDigestBound": true,
    "apiDigestBound": true,
    "installationDigestBound": true,
    "permissionDigestBound": true,
    "scopeDigestBound": true,
    "runDigestBound": true,
    "evidenceDigestBound": true,
    "secretReferenceDigestBound": true,
    "registrationDigestBound": true,
    "reversible": true,
    "revocable": true,
    "rotationOnStateChange": true,
    "failClosedOn": [
      "version_drift",
      "contract_drift",
      "provider_drift",
      "api_drift",
      "installation_drift",
      "organization_drift",
      "repository_drift",
      "workflow_drift",
      "run_drift",
      "job_drift",
      "attempt_drift",
      "commit_drift",
      "permission_drift",
      "pagination_cursor_mismatch",
      "etag_mismatch",
      "partial_metadata",
      "expired_artifact",
      "stale_head",
      "registration_revocation",
      "replay"
    ]
  },
  "receipts": {
    "request": true,
    "response": true,
    "etagDigest": true,
    "paginationDigest": true,
    "observation": true,
    "durableNativeReceipt": false,
    "rawHeaders": false,
    "rawResponseBody": false,
    "rawArtifactBytes": false
  },
  "honesty": {
    "fixtureNative": false,
    "recordingNative": false,
    "loopbackNative": false,
    "blockedEnvNative": false,
    "fixtureConnected": false,
    "recordingConnected": false,
    "loopbackConnected": false,
    "blockedEnvConnected": false,
    "nativeGithubAppOrOauth": "layer_2_gap",
    "nativeHttpsTransport": "layer_2_gap",
    "nativeCredentialResolution": "layer_2_gap",
    "durableProviderReceipt": "layer_2_gap",
    "independentRunReadback": "layer_2_gap",
    "independentArtifactReadback": "layer_2_gap",
    "consentedWorkflowEffects": "layer_2_gap",
    "absenceIsSuccess": false,
    "greenCiFromMissingJobs": false,
    "statusIsCausalTruth": false,
    "conclusionIsOutcomeAuthority": false
  },
  "authorityBoundary": {
    "externalRead": "typed_bounded_metadata_get_only",
    "externalWrite": false,
    "workflowDispatch": false,
    "workflowRerun": false,
    "workflowCancel": false,
    "sarifUpload": false,
    "artifactUpload": false,
    "logDownload": false,
    "sourceDownload": false,
    "artifactByteDownload": false,
    "connected": false,
    "native": false,
    "kernelOutcome": false,
    "truth": false,
    "greenCi": false,
    "consentAuthority": false
  },
  "distinction": {
    "notGithubIssuesOrPullRequests": true,
    "notCodeScanningAlerts": true,
    "notCiScheduler": true,
    "notSourceStore": true,
    "notArtifactStore": true,
    "providerDomain": "GitHub Actions workflow-run, job, and artifact metadata only"
  },
  "documentation": [
    "https://docs.github.com/en/rest/actions/workflow-runs?apiVersion=2022-11-28",
    "https://docs.github.com/en/rest/actions/workflow-jobs?apiVersion=2022-11-28",
    "https://docs.github.com/en/rest/actions/artifacts?apiVersion=2022-11-28"
  ],
  "errorHandling": [
    "HTTP_400",
    "HTTP_401",
    "HTTP_403",
    "HTTP_404",
    "HTTP_409",
    "HTTP_429",
    "HTTP_5XX",
    "BLOCKED_ENV",
    "TIMEOUT",
    "MALFORMED_RESPONSE",
    "RESPONSE_TOO_LARGE",
    "STALE_HEAD",
    "ATTEMPT_MISMATCH",
    "PAGINATION_CURSOR_MISMATCH",
    "ETAG_MISMATCH",
    "PARTIAL_METADATA",
    "EXPIRED_ARTIFACT",
    "TAMPER",
    "REPLAY",
    "REVOCATION"
  ],
  "layer2Gaps": [
    "native_github_app_or_oauth_resolution",
    "native_github_actions_https_transport",
    "durable_provider_receipt",
    "independent_run_and_job_readback",
    "independent_artifact_readback",
    "workflow_dispatch",
    "workflow_rerun",
    "workflow_cancel",
    "sarif_or_artifact_upload",
    "log_source_or_zip_bytes",
    "kernel_outcome_persistence",
    "verified_work_product_adoption"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "$id",
    "schemaVersion",
    "contractVersion",
    "pluginVersion",
    "layer",
    "authority",
    "typedSurface",
    "service",
    "provider",
    "consumer",
    "exactScope",
    "allowlist",
    "authentication",
    "bounds",
    "normalization",
    "digests",
    "registration",
    "receipts",
    "honesty",
    "authorityBoundary",
    "distinction",
    "documentation",
    "errorHandling",
    "layer2Gaps"
  ]
}
