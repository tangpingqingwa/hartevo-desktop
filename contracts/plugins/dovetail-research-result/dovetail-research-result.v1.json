{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hartevo.local/contracts/plugins/dovetail-research-result/dovetail-research-result.v1.json",
  "title": "Hartevo Dovetail customer-research result Layer-1 contract",
  "description": "Bounded Dovetail research metadata, theme/highlight summaries, and review-only proposal seam. This contract never retains research bodies, participant data, media, or mutation authority.",
  "schemaVersion": "hartevo.dovetail-research-result-contract/v1",
  "contractVersion": "EXT-DOVETAIL-01-L1/v1",
  "pluginVersion": "1.0.0",
  "layer": 1,
  "service": {
    "id": "DovetailResearchResultService",
    "providerId": "DovetailProvider",
    "consumerId": "MissionDovetailResearchConsumer",
    "operations": [
      "describe_capabilities",
      "register",
      "revoke_registration",
      "read_bounded_metadata",
      "compile_research_result_proposal",
      "record_research_result"
    ],
    "readOnly": true,
    "liveExecution": false,
    "kernelAuthority": false
  },
  "provider": {
    "id": "DovetailProvider",
    "apiBaseUrl": "https://dovetail.com/api/v1",
    "apiRevision": "dovetail-public-api-v1-metadata-read",
    "authentication": "opaque_secret_reference_only",
    "allowlistedGetPaths": [
      "/projects",
      "/folders",
      "/data",
      "/highlights",
      "/tags",
      "/insights",
      "/docs"
    ],
    "acceptedHttpStatuses": [200],
    "boundedRetryStatuses": [429, 500, 502, 503, 504],
    "accessLostStatuses": [401, 403],
    "retentionGapStatuses": [404, 410],
    "transportProvenance": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
    "connected": false,
    "native": false
  },
  "scope": {
    "requiredFields": [
      "pluginVersion",
      "contractVersion",
      "contractDigest",
      "providerId",
      "providerRevision",
      "workspaceIdAndRevision",
      "workspaceDigest",
      "dovetailProjectIdAndRevision",
      "dovetailProjectDigest",
      "dovetailFolderIdAndRevision",
      "dovetailFolderDigest",
      "dovetailDataIdsAndRevisionDigest",
      "hartevoProjectIdAndRevision",
      "hartevoProjectDigest",
      "missionIdAndRevision",
      "missionDigest",
      "workProductIdAndRevision",
      "workProductDigest",
      "consentScope",
      "consentDigest",
      "permissionDigest",
      "registrationDigest",
      "scopeDigest"
    ],
    "registrationBound": true,
    "versionBound": true,
    "providerBound": true,
    "workspaceBound": true,
    "projectBound": true,
    "folderBound": true,
    "dataBound": true,
    "missionBound": true,
    "workProductBound": true,
    "consentBound": true,
    "digestBound": true,
    "failClosedOnDrift": true
  },
  "reads": {
    "operations": [
      "list_project_metadata",
      "list_folder_metadata",
      "list_data_point_metadata",
      "list_highlight_summaries",
      "list_theme_tag_summaries",
      "list_insight_metadata",
      "list_document_metadata"
    ],
    "method": "GET",
    "arbitraryQuery": false,
    "arbitraryPath": false,
    "cursor": "opaque_bounded",
    "timeWindow": "optional_bounded",
    "maxPageSize": 100,
    "maxPagesPerOperation": 8,
    "maxResponseBytes": 1048576,
    "maxRetries": 3,
    "rawProviderPayloadRetained": false
  },
  "redaction": {
    "transcripts": false,
    "audioVideoMedia": false,
    "mediaLinks": false,
    "participantNames": false,
    "participantContactData": false,
    "rawNotes": false,
    "comments": false,
    "freeFormInsightBodies": false,
    "freeFormDocumentBodies": false,
    "titleAndLabelValues": "digest_only",
    "boundedCounts": true,
    "themeIds": true,
    "timestamps": true,
    "deterministicResultDigests": true,
    "deterministicRevisionDigests": true
  },
  "states": [
    "indexed",
    "processing",
    "present",
    "partial",
    "retention_gap",
    "access_lost",
    "provider_unknown"
  ],
  "proposal": {
    "reviewOnly": true,
    "adoptsOutcome": false,
    "adoptsWorkProduct": false,
    "sentimentTruth": false,
    "themeAbsenceProvesCompleteness": false,
    "providerReceipt": false
  },
  "recording": {
    "localOnly": true,
    "idempotent": true,
    "rawProviderPayload": false,
    "secretMaterial": false,
    "participantPii": false,
    "connected": false,
    "native": false
  },
  "authority": {
    "externalWrites": false,
    "upload": false,
    "mutation": false,
    "exportOrDownload": false,
    "webhooks": false,
    "transcriptAccess": false,
    "mediaAccess": false,
    "kernelAuthority": false,
    "truthAuthority": false,
    "connectedAuthority": false
  },
  "forbidden": [
    "create_or_upload_data",
    "patch_or_delete_data",
    "create_or_edit_tags",
    "create_or_edit_insights",
    "create_or_edit_docs",
    "comments",
    "export_data",
    "export_insight",
    "export_doc",
    "webhook_registration",
    "transcript_retrieval",
    "audio_video_retrieval",
    "participant_directory",
    "generic_crm_registry",
    "kernel_outcome_adoption"
  ],
  "nativeGap": {
    "status": "BLOCKED_ENV",
    "fixtureConnected": false,
    "recordingConnected": false,
    "loopbackConnected": false,
    "blockedEnvConnected": false,
    "fixtureNative": false,
    "recordingNative": false,
    "loopbackNative": false,
    "blockedEnvNative": false,
    "layer2Gaps": [
      "host-owned Dovetail API-token resolution",
      "native bounded HTTPS GET execution",
      "durable provider receipt and independent readback",
      "consented research-data effects",
      "verified Work Product adoption",
      "any transcript/media access",
      "any participant identity access",
      "webhook reconciliation"
    ]
  },
  "officialReferences": [
    "https://developers.dovetail.com/docs/introduction",
    "https://developers.dovetail.com/docs/authorization",
    "https://developers.dovetail.com/docs/pagination",
    "https://developers.dovetail.com/docs/rate-limits",
    "https://developers.dovetail.com/reference/get_v1-data",
    "https://developers.dovetail.com/reference/get_v1-insights",
    "https://developers.dovetail.com/reference/get_v1-docs"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "$id",
    "schemaVersion",
    "contractVersion",
    "pluginVersion",
    "layer",
    "service",
    "provider",
    "scope",
    "reads",
    "redaction",
    "states",
    "proposal",
    "recording",
    "authority",
    "forbidden",
    "nativeGap",
    "officialReferences"
  ]
}
