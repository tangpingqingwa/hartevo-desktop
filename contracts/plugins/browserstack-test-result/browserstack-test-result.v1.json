{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tangpingqingwa/hartevo-desktop/contracts/plugins/browserstack-test-result/browserstack-test-result.v1.json",
  "title": "Hartevo BrowserStack Automate and App Automate Layer-1 test-result evidence contract",
  "description": "A bounded, read/proposal/recording-only BrowserStack test-result seam. It is not a native connector, upload/launch authority, kernel receipt, verification authority, or Outcome authority.",
  "schemaVersion": "hartevo.browserstack-test-result.contract/v1",
  "contractVersion": "browserstack-test-result/v1",
  "pluginVersion": "1.0.0",
  "layer": 1,
  "serviceId": "browserstack.test-result",
  "providerId": "browserstack.automate-test-result",
  "consumerId": "mission.browserstack-test-result",
  "products": ["automate", "app_automate"],
  "officialRestApis": {
    "automate": "https://api.browserstack.com/automate",
    "appAutomate": "https://api-cloud.browserstack.com/app-automate"
  },
  "transportProvenance": ["fixture", "recording", "loopback", "BLOCKED_ENV", "production_read"],
  "operations": [
    "describe_capabilities",
    "register",
    "revoke_registration",
    "propose_build_session_read",
    "read_build_metadata",
    "read_session_pages",
    "read_session_detail",
    "record_evidence",
    "consume_observation"
  ],
  "readOnly": true,
  "mutatingProviderOperations": [],
  "scope": [
    "account_id",
    "group_id",
    "browserstack_project_id",
    "product",
    "build_id",
    "session_id",
    "build_revision",
    "session_revision",
    "commit",
    "artifact",
    "hartevo_project_id_and_revision",
    "mission_id_and_revision",
    "work_product_id_and_revision",
    "permission_revision_and_digest",
    "opaque_username_secret_reference",
    "opaque_access_key_secret_reference"
  ],
  "digests": [
    "plugin_version_digest",
    "contract_digest",
    "provider_digest",
    "scope_digest",
    "permission_digest",
    "registration_digest",
    "build_digest",
    "sessions_digest",
    "matrix_digest",
    "outcome_digest",
    "response_digest",
    "evidence_digest"
  ],
  "authority": {
    "connected": false,
    "native": false,
    "externalWrites": false,
    "upload": false,
    "testLaunch": false,
    "markPassFail": false,
    "renameDelete": false,
    "rawLogs": false,
    "rawNetwork": false,
    "rawHar": false,
    "rawVideo": false,
    "rawScreenshots": false,
    "arbitraryCapabilities": false,
    "truth": false,
    "consent": false,
    "effect": false,
    "receipt": false,
    "verification": false,
    "outcome": false,
    "workProductAdoption": false
  },
  "registration": {
    "versionBound": true,
    "contractDigestBound": true,
    "providerDigestBound": true,
    "scopeDigestBound": true,
    "permissionDigestBound": true,
    "secretReferenceDigestBound": true,
    "reversible": true,
    "revocable": true,
    "failClosedOn": [
      "provider_revision_drift",
      "scope_drift",
      "build_revision_drift",
      "session_revision_drift",
      "commit_mismatch",
      "artifact_mismatch",
      "permission_drift",
      "registration_tamper",
      "registration_revocation"
    ]
  },
  "bounds": {
    "maxResponseBytes": 1048576,
    "maxPages": 4,
    "maxPageSize": 100,
    "maxSessions": 128,
    "maxOutcomeCount": 10000,
    "maxReceipts": 32,
    "maxIdentifierBytes": 256
  },
  "evidence": {
    "buildMetadata": ["id", "status", "duration", "start", "finish", "commit", "artifact"],
    "sessionMetadata": ["id", "status", "duration", "start", "finish", "device", "browser", "os"],
    "outcomeCounts": ["total", "passed", "failed", "skipped", "timed_out", "unknown"],
    "pagination": "bounded_offset_loop_with_repeat_detection",
    "rateLimits": [401, 403, 404, 409, 429, 500, 502, 503, 504],
    "responseDigest": true,
    "rawProviderPayloadRetained": false,
    "credentialMaterialRetained": false
  },
  "forbidden": [
    "upload",
    "test_launch",
    "mark_pass",
    "mark_fail",
    "rename",
    "delete",
    "raw_logs",
    "network_logs",
    "har",
    "video",
    "screenshots",
    "arbitrary_capability_payloads",
    "kernel_truth",
    "kernel_consent",
    "kernel_effect",
    "kernel_receipt",
    "kernel_verification",
    "kernel_outcome"
  ],
  "nativeGap": {
    "status": "BLOCKED_ENV",
    "deferredTo": "layer_2_native_secret_resolution_and_connected_read_authority",
    "fixtureRecordingLoopbackBlockedEnvAreNative": false,
    "connectedClaim": false,
    "failClosedCases": [
      "missing_secret_authority",
      "scope_or_revision_drift",
      "artifact_or_commit_mismatch",
      "provider_deletion_or_access_loss",
      "retention_expiry",
      "partial_page_or_rate_limit",
      "tampered_or_unredacted_recording",
      "external_write_request"
    ]
  },
  "honestNativeGap": "This root records bounded typed read evidence from official BrowserStack Automate/App Automate REST shapes only. It never claims Connected or native status, never retains raw provider payloads or debugging media, and never authorizes kernel Truth, Consent, Effect, Receipt, Verification, Outcome, or Work Product adoption."
}
