  "nonOverlap": {
    "airbyteIssue": "#354 owns source-to-destination Airbyte sync-attempt evidence; Confluent owns Cloud connector/task, Kafka consumer-group lag, and bounded metrics projections.",
    "fivetranIssue": "#411 owns Fivetran connector sync evidence; it does not own Confluent Cloud connector or Kafka REST projections.",
    "datadogIssue": "#337 owns Datadog SLO outcome evidence; it does not own Confluent Metrics API resource-scoped time-series digests.",
    "grafanaIssue": "#421 owns Grafana alert/result evidence; it does not own Confluent Cloud or Kafka consumer-group state.",
