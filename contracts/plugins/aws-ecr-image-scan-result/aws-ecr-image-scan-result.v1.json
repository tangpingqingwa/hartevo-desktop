{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tangpingqingwa/hartevo-desktop/contracts/plugins/aws-ecr-image-scan-result/aws-ecr-image-scan-result.v1.json",
  "title": "Hartevo AWS ECR image scan result Layer-1 contract",
  "description": "Bounded digest-pinned ECR image scan evidence and Mission proposal; not an image registry, scanner mutation, remediation, deployment gate, Snyk project snapshot, CodeQL code analysis, or kernel authority.",
  "schemaVersion": "hartevo.aws-ecr-image-scan-result-contract/v1",
  "contractVersion": "aws-ecr-image-scan-result/v1",
  "pluginVersion": "1.0.0",
  "layer": "Layer-1",
  "officialReferences": [
    "https://docs.aws.amazon.com/AmazonECR/latest/APIReference/API_DescribeImages.html",
    "https://docs.aws.amazon.com/AmazonECR/latest/APIReference/API_DescribeImageScanFindings.html",
    "https://docs.aws.amazon.com/AmazonECR/latest/userguide/describe-scan-findings.html"
  ],
  "service": {
    "id": "hartevo.aws.ecr.image-scan.result",
    "implementation": "EcrImageScanResultService",
    "version": "1.0.0",
    "operations": [
      "describe_capabilities",
      "register",
      "revoke_registration",
      "restore_registration",
      "describe_images",
      "describe_image_scan_findings",
      "read_scan",
      "propose",
      "record",
      "verify"
    ],
    "readOnly": true,
    "proposalOnly": true,
    "liveExecution": false,
    "externalWrites": false
  },
  "provider": {
    "id": "aws.ecr.image-scan",
    "implementation": "EcrProvider",
    "version": "1.0.0",
    "apiRevision": "aws-ecr-image-scan-read-r1",
    "allowlistedOperations": ["DescribeImages", "DescribeImageScanFindings"],
    "allowlistedMethods": ["POST"],
    "permissions": ["ecr:DescribeImages", "ecr:DescribeImageScanFindings"],
    "acceptedTransports": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
    "native": false,
    "connected": false,
    "externalWrites": false,
    "resolvesCredentials": false,
    "sigV4Secret": "opaque_non_serializing_reference_only",
    "rawResponseBody": false
  },
  "consumer": {
    "id": "mission.aws.ecr.image-scan.result",
    "implementation": "MissionEcrImageConsumer",
    "version": "1.0.0",
    "registryBound": true,
    "accountBound": true,
    "regionBound": true,
    "repositoryBound": true,
    "imageDigestBound": true,
    "scanTypeBound": true,
    "scanRevisionBound": true,
    "findingRevisionBound": true,
    "projectBound": true,
    "missionBound": true,
    "workProductBound": true,
    "permissionBound": true,
    "producesDecisionProposal": true,
    "adoptsOutcome": false,
    "truthAuthority": false,
    "deploymentAuthority": false,
    "remediationAuthority": false
  },
  "scope": {
    "required": [
      "registry",
      "account_id",
      "region",
      "repository",
      "image_digest",
      "scan_type",
      "scan_revision",
      "inspector_finding_revision",
      "project_id_and_revision",
      "mission_id_and_revision",
      "work_product_id_and_revision",
      "permission_digest",
      "secret_reference_digest",
      "scope_digest"
    ],
    "target": "one_exact_registry_account_region_repository_image_digest",
    "secret": "opaque_non_serializing_sigv4_reference_only",
    "pagination": "opaque_request_bound_digest_only",
    "findingIdentityRetention": "finding_cve_package_fix_digests_only",
    "rawTags": false,
    "rawLayers": false,
    "rawImageBytes": false,
    "rawPii": false
  },
  "allowlist": {
    "reads": [
      {
        "operation": "DescribeImages",
        "method": "POST",
        "permission": "ecr:DescribeImages",
        "bounded": true,
        "digestPinned": true,
        "retainsImageBytes": false
      },
      {
        "operation": "DescribeImageScanFindings",
        "method": "POST",
        "permission": "ecr:DescribeImageScanFindings",
        "bounded": true,
        "digestPinned": true,
        "retainsFindings": "redacted_bounded_metadata_only"
      }
    ],
    "writes": [],
    "forbidden": [
      "StartImageScan",
      "PutImage",
      "BatchDeleteImage",
      "image_push",
      "image_delete",
      "image_tag_mutation",
      "inspector_remediation",
      "repository_export",
      "raw_layers",
      "raw_image_bytes",
      "raw_tags",
      "raw_pii",
      "raw_provider_response",
      "raw_pagination_token",
      "credential_resolution",
      "native_sigv4",
      "deployment_gate_effect",
      "durable_native_receipt",
      "independent_readback",
      "verified_adoption",
      "snyk_project_snapshot",
      "codeql_code_analysis"
    ]
  },
  "registration": {
    "boundFields": [
      "pluginVersion",
      "versionDigest",
      "contractVersion",
      "contractDigest",
      "providerDigest",
      "permissionDigest",
      "scopeDigest",
      "secretReferenceDigest",
      "registryDigest",
      "accountDigest",
      "regionDigest",
      "repositoryDigest",
      "imageDigest",
      "scanTypeDigest",
      "scanRevisionDigest",
      "findingRevisionDigest",
      "projectDigest",
      "missionDigest",
      "workProductDigest"
    ],
    "reversible": true,
    "revocable": true,
    "failClosedOn": [
      "plugin_version_drift",
      "contract_digest_drift",
      "provider_or_api_revision_drift",
      "permission_digest_drift",
      "scope_digest_drift",
      "secret_reference_revocation",
      "registration_tamper",
      "pagination_replay",
      "scan_revision_drift",
      "finding_revision_drift",
      "stale_mission_or_work_product"
    ]
  },
  "bounds": {
    "maxResponseBytes": 1048576,
    "maxPages": 4,
    "pageSize": 100,
    "maxFindings": 256,
    "maxSeverityEntries": 8,
    "maxIdentifierBytes": 128,
    "maxRepositoryBytes": 256,
    "maxCursorBytes": 512,
    "maxDiagnosticBytes": 512,
    "maxPackageMetadataBytes": 512
  },
  "evidence": {
    "states": [
      "pending",
      "complete",
      "failed",
      "inactive",
      "expired",
      "partial",
      "stale",
      "access_lost",
      "tampered",
      "provider_unknown"
    ],
    "digests": [
      "version",
      "contract",
      "provider",
      "permission",
      "scope",
      "registration",
      "describe_images_request",
      "findings_request",
      "image",
      "findings",
      "response",
      "evidence",
      "proposal"
    ],
    "retained": [
      "registry_digest",
      "account_id",
      "region",
      "repository_digest",
      "image_digest",
      "scan_type",
      "scan_revision",
      "inspector_finding_revision",
      "severity_counts",
      "cve_digest",
      "package_digest",
      "fix_status",
      "fixed_version_digest",
      "page_count",
      "redacted_provider_error_digest"
    ],
    "notRetained": [
      "credentials",
      "raw_image_layers",
      "image_bytes",
      "raw_tags",
      "raw_cve_text",
      "raw_package_text",
      "raw_fix_text",
      "package_paths",
      "source_layer_hashes",
      "reference_urls",
      "provider_response_body",
      "next_token",
      "pii"
    ],
    "missingOrInsufficientDataFailsClosed": true
  },
  "redaction": {
    "secretMaterial": false,
    "rawPaginationToken": false,
    "rawProviderPayload": false,
    "rawImageLayers": false,
    "rawImageBytes": false,
    "rawTags": false,
    "rawCve": false,
    "rawPackageMetadata": false,
    "rawFixMetadata": false,
    "pii": false,
    "errorMessages": false
  },
  "authority": {
    "readOnly": true,
    "proposalOnly": true,
    "externalWrites": false,
    "imagePush": false,
    "imageDelete": false,
    "imageTagMutation": false,
    "startImageScan": false,
    "inspectorRemediation": false,
    "rawLayers": false,
    "rawImageBytes": false,
    "rawPii": false,
    "credentialResolution": false,
    "connected": false,
    "native": false,
    "durableReceipt": false,
    "independentReadback": false,
    "deploymentAuthority": false,
    "remediationAuthority": false,
    "kernelOutcomeAdoption": false,
    "workProductAdoption": false,
    "snykProjectSnapshot": false,
    "codeqlCodeAnalysis": false
  },
  "honesty": {
    "nativeStatus": "BLOCKED_ENV",
    "blockedEnvironmentIsNative": false,
    "fixtureIsNative": false,
    "recordingIsNative": false,
    "loopbackIsNative": false,
    "layer1Boundary": "Layer 1 emits bounded digest-pinned ECR image scan evidence and a Mission decision proposal. Native SigV4 credential resolution, native HTTPS, live execution, durable receipts, independent readback, remediation, deployment gate effects, verified Work Product adoption, Snyk snapshots, and CodeQL analysis remain outside this slice."
  },
  "distinction": {
    "notSnykProjectSnapshot": true,
    "notCodeQlCodeAnalysis": true,
    "providerDomain": "Amazon ECR registry image-digest scan evidence only"
  },
  "layer2Gaps": [
    "native_sigv4_transport_and_credential_resolution",
    "live_ecr_describe_images_execution",
    "live_ecr_describe_image_scan_findings_execution",
    "durable_native_provider_receipt",
    "independent_provider_readback",
    "consented_deployment_gate_effect",
    "image_scan_start_or_rescan",
    "image_push_delete_tag_mutation",
    "inspector_remediation",
    "verified_work_product_adoption",
    "snyk_project_snapshot",
    "codeql_code_analysis"
  ]
}
