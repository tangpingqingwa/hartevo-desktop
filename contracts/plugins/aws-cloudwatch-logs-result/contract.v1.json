{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tangpingqingwa/hartevo-desktop/contracts/plugins/aws-cloudwatch-logs-result/contract.v1.json",
  "title": "Hartevo AWS CloudWatch Logs Insights result Layer-1 contract",
  "description": "A bounded, revision-fenced CloudWatch Logs Insights summary seam. It is not a log export, incident authority, or native AWS connector.",
  "schemaVersion": "hartevo.aws-cloudwatch-logs-result.contract/v1",
  "contractVersion": "EXT-AWS-CLOUDWATCH-LOGS-01-L1/v1",
  "pluginVersion": "1.0.0",
  "pluginId": "aws.cloudwatch.logs.result",
  "layer": "Layer-1",
  "evidenceLevel": "L1_PROVIDER_CONTRACT",
  "officialReferences": [
    "https://docs.aws.amazon.com/AmazonCloudWatchLogs/latest/APIReference/API_StartQuery.html",
    "https://docs.aws.amazon.com/AmazonCloudWatchLogs/latest/APIReference/API_GetQueryResults.html",
    "https://docs.aws.amazon.com/AmazonCloudWatchLogs/latest/APIReference/API_DescribeQueries.html"
  ],
  "service": {
    "id": "aws.cloudwatch.logs.result.read",
    "implementation": "AwsCloudWatchLogsService",
    "version": "1.0.0",
    "operations": [
      "describe_capabilities",
      "register",
      "reverse_registration",
      "restore_registration",
      "revoke_registration",
      "read_bounded",
      "propose",
      "record",
      "verify"
    ],
    "readOnly": true,
    "proposalOnly": true,
    "liveExecution": false,
    "externalWrites": false
  },
  "provider": {
    "id": "aws.cloudwatch.logs.result.recording",
    "implementation": "AwsCloudWatchLogsProvider",
    "version": "1.0.0",
    "apiRevision": "cloudwatch-logs-start-query-get-query-results-describe-queries-1",
    "allowlistedOperations": [
      "StartQuery",
      "GetQueryResults",
      "DescribeQueries"
    ],
    "allowlistedMethods": ["POST"],
    "acceptedTransports": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
    "native": false,
    "connected": false,
    "firstParty": false,
    "externalWrites": false,
    "providerReceipt": false,
    "sigV4Secret": "opaque_non_serializing_secret_reference_only"
  },
  "consumer": {
    "id": "mission.aws-cloudwatch-logs.consumer",
    "implementation": "MissionAwsCloudWatchLogsConsumer",
    "version": "1.0.0",
    "deploymentBound": true,
    "serviceRevisionBound": true,
    "missionBound": true,
    "projectBound": true,
    "workProductBound": true,
    "revisionBound": true,
    "permissionBound": true,
    "producesDecisionProposal": true,
    "adoptsOutcome": false,
    "truthAuthority": false,
    "verifiedWorkProductAdoption": false
  },
  "scope": {
    "required": [
      "deployment_id_and_revision",
      "service_revision",
      "mission_id_and_revision",
      "project_id_and_revision",
      "work_product_id_and_revision",
      "exact_account_and_region",
      "allowlisted_log_groups",
      "allowlisted_query_templates",
      "bounded_time_window",
      "permission_digest",
      "secret_reference_digest",
      "scope_digest"
    ],
    "query": "allowlisted_parameterized_ast_only",
    "arbitraryQueryText": false,
    "rawLogEvents": false,
    "rawMessages": false,
    "rawStackTraces": false,
    "rawRequestBodies": false,
    "rawPii": false,
    "rawPtrValues": false
  },
  "registration": {
    "pluginVersionBound": true,
    "providerIdBound": true,
    "providerVersionBound": true,
    "providerRevisionBound": true,
    "providerDigestBound": true,
    "apiDigestBound": true,
    "contractVersionBound": true,
    "contractDigestBound": true,
    "queryDigestBound": true,
    "queryPolicyDigestBound": true,
    "permissionDigestBound": true,
    "scopeDigestBound": true,
    "evidenceDigestBound": true,
    "secretReferenceDigestBound": true,
    "reversible": true,
    "revocable": true,
    "failClosedOn": [
      "plugin_or_contract_version_drift",
      "provider_or_api_revision_drift",
      "provider_or_contract_digest_drift",
      "query_template_or_parameter_drift",
      "permission_or_scope_digest_drift",
      "evidence_policy_drift",
      "secret_reference_revocation",
      "registration_tamper",
      "registration_reversal_or_revocation",
      "query_or_window_or_log_group_drift",
      "deployment_or_service_revision_drift",
      "pagination_or_result_truncation",
      "query_replay"
    ]
  },
  "bounds": {
    "maxIdentifierBytes": 128,
    "maxLogGroups": 64,
    "maxQueryTemplates": 16,
    "maxParameters": 16,
    "maxPages": 4,
    "maxPageSize": 100,
    "maxResults": 256,
    "maxResponseBytes": 1048576,
    "maxWindowSeconds": 86400,
    "maxErrorClasses": 32,
    "maxCorrelationFingerprints": 128
  },
  "evidence": {
    "states": [
      "complete",
      "running",
      "partial",
      "expired",
      "access_loss",
      "provider_unknown",
      "failed",
      "replay",
      "tampered",
      "registration_revoked"
    ],
    "digests": [
      "plugin_version",
      "provider",
      "api",
      "contract",
      "query_template",
      "query",
      "scope",
      "permission",
      "execution",
      "page_tokens",
      "summary",
      "evidence",
      "proposal",
      "record",
      "verification"
    ],
    "retained": [
      "allowlisted_query_template_id",
      "parameter_digests",
      "log_group_name",
      "time_window",
      "deployment_and_service_revision",
      "query_status",
      "query_timestamps",
      "bounded_event_and_byte_counts",
      "allowlisted_field_names",
      "typed_error_class_aggregates",
      "correlation_fingerprint_digests",
      "opaque_page_token_digests"
    ],
    "notRetained": [
      "raw_query_text",
      "raw_log_event",
      "@message",
      "@ptr",
      "stack_trace",
      "request_body",
      "pii",
      "secret_material",
      "provider_payload",
      "raw_next_token",
      "error_message"
    ],
    "nonAdoptableStates": [
      "running",
      "partial",
      "expired",
      "access_loss",
      "provider_unknown",
      "failed",
      "replay",
      "tampered",
      "registration_revoked"
    ],
    "tamperRejected": true,
    "replayRejected": true,
    "revocationRejected": true,
    "truncationFailsClosed": true
  },
  "redaction": {
    "secretMaterial": false,
    "rawQueryText": false,
    "rawNextToken": false,
    "rawProviderPayload": false,
    "rawLogEvents": false,
    "messages": false,
    "stackTraces": false,
    "requestBodies": false,
    "pii": false,
    "ptrValues": false
  },
  "authority": {
    "readOnly": true,
    "proposalOnly": true,
    "externalWrites": false,
    "startQueryMutation": false,
    "logSubscription": false,
    "metricFilterMutation": false,
    "alarmMutation": false,
    "logExport": false,
    "credentialResolution": false,
    "connected": false,
    "native": false,
    "firstParty": false,
    "durableProviderReceipt": false,
    "verificationAuthority": false,
    "kernelOutcomeAdoption": false,
    "truthAuthority": false,
    "incidentAuthority": false
  },
  "honesty": {
    "nativeStatus": "BLOCKED_ENV",
    "blockedEnvironmentIsNative": false,
    "fixtureIsNative": false,
    "recordingIsNative": false,
    "loopbackIsNative": false,
    "connectedClaim": false,
    "nativeClaim": false,
    "firstPartyClaim": false,
    "layer1Boundary": "Layer 1 emits bounded external evidence and a Mission review proposal only. Native SigV4/HTTPS, bounded execution receipts, independent repeat-read reconciliation, consented effects, incident authority, raw log access, and verified Work Product adoption remain Layer-2 host authority."
  },
  "layer2Gaps": [
    "native_sigv4_transport_and_credential_resolution",
    "native_start_query_get_query_results_describe_queries",
    "durable_provider_execution_receipt",
    "independent_repeat_read_reconciliation",
    "consented_log_export_or_effects",
    "verified_work_product_adoption",
    "incident_and_availability_authority"
  ],
  "forbidden": [
    "accept_arbitrary_query_text",
    "retain_raw_log_events",
    "retain_message_or_stack_trace",
    "retain_request_body_or_pii",
    "retain_ptr_values",
    "resolve_live_credentials",
    "sign_native_sigv4",
    "claim_connected",
    "claim_native",
    "claim_first_party",
    "export_logs",
    "create_subscription_filter",
    "put_metric_filter",
    "put_retention_policy",
    "create_alarm",
    "adopt_kernel_outcome",
    "claim_incident_or_availability_truth"
  ]
}
