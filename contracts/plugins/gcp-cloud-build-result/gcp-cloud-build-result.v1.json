{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hartevo.local/contracts/plugins/gcp-cloud-build-result/gcp-cloud-build-result.v1.json",
  "title": "Hartevo Google Cloud Build result Layer-1 contract",
  "description": "Bounded Google Cloud Build list/get evidence for a source revision; not a build executor, deployer, log reader, correctness authority, or Outcome authority.",
  "schemaVersion": "hartevo.gcp-cloud-build-result/v1",
  "contractVersion": "gcp-cloud-build-result/v1",
  "pluginVersion": "0.1.0",
  "layer": 1,
  "authority": {
    "readOnly": true,
    "proposalOnly": true,
    "connected": false,
    "nativeProvider": false,
    "firstParty": false,
    "credentialResolution": false,
    "durableProviderReceipt": false,
    "independentReadback": false,
    "kernelTruthAuthority": false,
    "outcomeAuthority": false,
    "workProductAdoption": false,
    "externalWrites": false
  },
  "typedSurface": {
    "service": "GcpCloudBuildResultService",
    "provider": "GcpCloudBuildProvider",
    "consumer": "MissionGcpBuildConsumer",
    "models": [
      "GcpCloudBuildScope",
      "ProjectBinding",
      "MissionBinding",
      "WorkProductBinding",
      "BuildSelector",
      "SourceScope",
      "SecretReference",
      "PermissionScope",
      "ConsentScope",
      "GcpCloudBuildRegistration",
      "CloudBuildSummary",
      "GcpCloudBuildEvidence",
      "CloudBuildReadProposal",
      "CloudBuildReadRecord"
    ]
  },
  "service": {
    "id": "gcp.cloud-build.result",
    "name": "GcpCloudBuildResultService",
    "version": "1.0.0",
    "access": "read_only",
    "proposalOnly": true,
    "operations": [
      "describe_capabilities",
      "register",
      "revoke_registration",
      "restore_registration",
      "propose_builds_list",
      "propose_build_get",
      "read_builds_list_bounded",
      "read_build_get",
      "record_observation",
      "verify_proposal",
      "verify_observation",
      "consume_mission_projection"
    ],
    "externalWrites": false,
    "liveExternalIo": false,
    "createsBuilds": false,
    "cancelsBuilds": false,
    "retriesBuilds": false,
    "mutatesTriggers": false,
    "deploysArtifacts": false,
    "readsRawLogs": false
  },
  "provider": {
    "id": "gcp.cloud-build",
    "name": "GcpCloudBuildProvider",
    "version": "1.0.0",
    "apiRevision": "cloud-build-rest-v1-projects-builds-list-get",
    "apis": [
      "projects.builds.list",
      "projects.builds.get"
    ],
    "baseUrl": "https://cloudbuild.googleapis.com",
    "allowlistedMethods": [
      {
        "method": "GET",
        "path": "/v1/projects/{projectId}/builds",
        "operation": "list"
      },
      {
        "method": "GET",
        "path": "/v1/projects/{projectId}/builds/{buildId}",
        "operation": "get"
      }
    ],
    "requiredPermissions": [
      "cloudbuild.builds.list",
      "cloudbuild.builds.get"
    ],
    "authentication": ["opaque_secret_reference"],
    "transportProvenance": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
    "maxPages": 16,
    "maxPageSize": 100,
    "maxBuilds": 500,
    "maxResponseBytes": 1048576,
    "maxStepsPerBuild": 256,
    "maxArtifactsPerBuild": 64,
    "rawResponseBody": false,
    "rawLogs": false,
    "rawSteps": false,
    "rawStepArguments": false,
    "rawEnvironment": false,
    "rawSecrets": false,
    "rawArtifactBytes": false,
    "native": false,
    "connected": false,
    "firstParty": false,
    "reversible": true,
    "revocable": true
  },
  "consumer": {
    "id": "mission.gcp.cloud-build.result",
    "name": "MissionGcpBuildConsumer",
    "kind": "mission_build_result_projection",
    "scope": [
      "gcp_project",
      "location",
      "build_selector",
      "trigger",
      "source_repository",
      "source_commit",
      "project",
      "mission",
      "work_product",
      "consent",
      "permission",
      "registration",
      "mission_revision",
      "work_product_revision"
    ],
    "adoptsOutcome": false,
    "kernelAuthority": false,
    "truthAuthority": false,
    "workProductAdoption": false
  },
  "allowlist": {
    "reads": [
      "GET /v1/projects/{projectId}/builds",
      "GET /v1/projects/{projectId}/builds/{buildId}"
    ],
    "writes": [],
    "forbidden": [
      "create_build",
      "cancel_build",
      "retry_build",
      "trigger_mutation",
      "deploy_artifact",
      "raw_log_read",
      "raw_step_export",
      "step_argument_export",
      "environment_variable_export",
      "secret_value_export",
      "unbounded_artifact_export",
      "build_correctness_claim",
      "kernel_truth_authority",
      "kernel_outcome_adoption",
      "verified_work_product_adoption"
    ]
  },
  "authentication": {
    "boundary": "opaque SecretReference",
    "rawCredentialSerialized": false,
    "rawCredentialDebug": false,
    "rawCredentialRequest": false,
    "rawCredentialReceipt": false,
    "resolvedByLayer": 2
  },
  "normalization": {
    "statuses": [
      "QUEUED",
      "WORKING",
      "SUCCESS",
      "FAILURE",
      "INTERNAL_ERROR",
      "TIMEOUT",
      "CANCELLED",
      "EXPIRED",
      "UNKNOWN"
    ],
    "evidenceStates": [
      "complete",
      "partial",
      "stale",
      "access_lost",
      "not_found",
      "conflict",
      "rate_limited",
      "timeout",
      "provider_unknown"
    ],
    "responseOrderIndependent": true,
    "sourceAndCommitRetained": true,
    "durationRetained": true,
    "artifactMetadataRetained": true,
    "stepAndResultDigestsOnly": true,
    "rawJson": false
  },
  "digests": {
    "version": true,
    "contract": true,
    "provider": true,
    "api": true,
    "permission": true,
    "scope": true,
    "source": true,
    "trigger": true,
    "registration": true,
    "request": true,
    "response": true,
    "result": true,
    "evidence": true,
    "replay": true
  },
  "registration": {
    "versionBound": true,
    "contractDigestBound": true,
    "providerDigestBound": true,
    "permissionDigestBound": true,
    "scopeDigestBound": true,
    "sourceDigestBound": true,
    "triggerDigestBound": true,
    "evidencePolicyDigestBound": true,
    "secretReferenceDigestBound": true,
    "registrationDigestBound": true,
    "reversible": true,
    "revocable": true,
    "oldProposalsFailClosed": true
  },
  "fences": {
    "opaquePageTokens": true,
    "paginationLoop": true,
    "requestTamper": true,
    "responseTamper": true,
    "digestTamper": true,
    "projectDrift": true,
    "locationDrift": true,
    "sourceDrift": true,
    "commitDrift": true,
    "triggerDrift": true,
    "staleMissionRevision": true,
    "replay": true,
    "registrationRevocation": true
  },
  "nativeGap": {
    "layer": 2,
    "nativeCredentialResolution": false,
    "httpsTransport": false,
    "durableProviderReceipt": false,
    "independentReadback": false,
    "consentedBuildEffects": false,
    "verifiedWorkProductAdoption": false,
    "transportBlockedMarker": "BLOCKED_ENV"
  }
}
