{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tangpingqingwa/hartevo-desktop/contracts/plugins/aws-ecs-deployment-result/aws-ecs-deployment-result.v1.json",
  "title": "Hartevo AWS ECS deployment result Layer-1 contract",
  "description": "A bounded, read/proposal/record/verify-only AWS ECS deployment evidence seam. It is not an ECS control plane, deployment authority, task shell, log reader, or outcome adopter.",
  "schemaVersion": "hartevo.aws-ecs-deployment-result.contract/v1",
  "contractVersion": "aws-ecs-deployment-result/v1",
  "pluginVersion": "1.0.0",
  "layer": "Layer-1",
  "evidenceLevel": "L1_PROVIDER_CONTRACT",
  "service": {
    "id": "aws.ecs.deployment.result",
    "implementation": "EcsDeploymentResultService",
    "operations": [
      "describe_capabilities",
      "register",
      "revoke_registration",
      "read_bounded",
      "propose",
      "record",
      "verify"
    ],
    "readOnly": true,
    "proposalOnly": true,
    "liveExecution": false,
    "outcomeAdoption": false
  },
  "provider": {
    "id": "aws.ecs.deployment.read",
    "implementation": "EcsProvider",
    "apiVersion": "2014-11-13",
    "providerVersion": "aws-ecs-provider/v1",
    "apiRevision": "ecs-describe-services-describe-tasks-describe-task-definition-list-tasks-r1",
    "allowlistedOperations": [
      "DescribeServices",
      "DescribeTasks",
      "DescribeTaskDefinition",
      "ListTasks"
    ],
    "acceptedTransports": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
    "native": false,
    "connected": false,
    "firstParty": false,
    "externalWrites": false,
    "sigV4Secret": "opaque_non_serializing_secret_reference_only"
  },
  "consumer": {
    "id": "mission.aws.ecs.deployment",
    "implementation": "MissionEcsDeploymentConsumer",
    "missionBound": true,
    "projectBound": true,
    "workProductBound": true,
    "revisionBound": true,
    "permissionBound": true,
    "consentBound": true,
    "producesDecisionProposal": true,
    "adoptsOutcome": false,
    "truthAuthority": false,
    "certificationAuthority": false
  },
  "scope": {
    "required": [
      "awsAccountIdAndRevision",
      "awsRegionAndRevision",
      "clusterAndRevision",
      "serviceAndRevision",
      "deploymentAndGeneration",
      "taskDefinitionFamilyAndRevision",
      "taskAllowlistAndRevision",
      "missionIdAndRevision",
      "projectIdAndRevision",
      "workProductIdAndRevision",
      "permissionRevisionAndDigest",
      "consentRevisionAndDigest",
      "secretReferenceDigest",
      "scopeDigest"
    ],
    "identifiersInEvidence": "typed_and_digest_bound",
    "rawTaskDefinitionContainerDefinitions": false,
    "rawStoppedReason": false,
    "rawEnvironmentValues": false,
    "rawSecrets": false
  },
  "registration": {
    "pluginVersionBound": true,
    "contractVersionBound": true,
    "contractDigestBound": true,
    "providerIdBound": true,
    "providerRevisionBound": true,
    "providerDigestBound": true,
    "apiDigestBound": true,
    "permissionDigestBound": true,
    "consentDigestBound": true,
    "scopeDigestBound": true,
    "secretReferenceDigestBound": true,
    "evidenceDigestBound": true,
    "registrationRevisionBound": true,
    "reversible": true,
    "revocable": true,
    "failClosedOn": [
      "plugin_version_drift",
      "contract_digest_drift",
      "provider_or_api_revision_drift",
      "provider_digest_drift",
      "permission_or_consent_drift",
      "scope_or_entity_revision_drift",
      "secret_reference_revocation",
      "registration_tamper",
      "registration_revocation",
      "cursor_or_filter_replay",
      "stale_deployment_generation",
      "stale_task_definition_revision",
      "stale_mission_revision"
    ]
  },
  "bounds": {
    "maxResponseBytes": 1048576,
    "maxPages": 4,
    "maxItems": 256,
    "pageSize": 100,
    "maxRequestsPerRead": 6,
    "maxRetries": 2,
    "maxIdentifierBytes": 128
  },
  "normalization": {
    "service": [
      "deploymentStatus",
      "desiredCount",
      "runningCount",
      "pendingCount",
      "deploymentGeneration",
      "taskDefinitionFamily",
      "taskDefinitionRevision"
    ],
    "task": [
      "taskHealth",
      "lastStatus",
      "taskDefinitionFamily",
      "taskDefinitionRevision",
      "redactedStoppedReasonDigest"
    ],
    "pagination": [
      "pageCount",
      "itemCount",
      "cursorDigest",
      "filterDigest",
      "complete",
      "truncated"
    ]
  },
  "evidence": {
    "states": [
      "complete",
      "partial",
      "access_loss",
      "not_found",
      "throttled",
      "provider_unknown",
      "registration_revoked"
    ],
    "requiredDigests": [
      "pluginVersionDigest",
      "contractDigest",
      "providerDigest",
      "apiDigest",
      "providerRevision",
      "permissionDigest",
      "consentDigest",
      "scopeDigest",
      "filterDigest",
      "cursorDigest",
      "pageDigests",
      "evidenceDigest"
    ],
    "partialIsNonAdoptable": true,
    "accessLossIsNonAdoptable": true,
    "unknownIsNonAdoptable": true,
    "truncationIsNonAdoptable": true,
    "tamperRejected": true
  },
  "redaction": {
    "stoppedReason": "digest_only",
    "rawNextToken": false,
    "rawProviderPayload": false,
    "containerDefinitions": false,
    "environmentValues": false,
    "secretMaterial": false,
    "errorMessages": false
  },
  "authority": {
    "readOnly": true,
    "proposalOnly": true,
    "externalWrites": false,
    "runTask": false,
    "updateService": false,
    "stopTask": false,
    "createService": false,
    "deploy": false,
    "rollback": false,
    "exec": false,
    "logs": false,
    "environmentExport": false,
    "secretExport": false,
    "imageContentDownload": false,
    "kernelAuthority": false,
    "outcomeAdoption": false,
    "connected": false,
    "native": false,
    "durableReceipt": false
  },
  "honesty": {
    "nativeStatus": "BLOCKED_ENV",
    "blockedEnvironmentIsNative": false,
    "fixtureIsNative": false,
    "recordingIsNative": false,
    "loopbackIsNative": false,
    "layer1Boundary": "Layer 1 emits bounded normalized ECS deployment evidence and a Mission decision proposal only. Native SigV4 resolution, live ECS HTTPS, durable provider receipts, independent post-deployment readback, consented deployment effects, and verified Work Product adoption remain Layer-2 host authority."
  },
  "layer2Gaps": [
    "native_sigv4_transport_and_credential_resolution",
    "live_ecs_https_describe_operations",
    "durable_provider_receipt",
    "independent_post_deployment_readback",
    "consented_run_or_update_or_stop_effects",
    "ecs_exec_and_logs",
    "environment_or_secret_export",
    "image_content_download",
    "kernel_authority_and_outcome_adoption"
  ],
  "forbidden": [
    "RunTask",
    "UpdateService",
    "StopTask",
    "CreateService",
    "deploy",
    "rollback",
    "execute_command",
    "read_logs",
    "export_environment",
    "export_secrets",
    "download_image_content",
    "resolve_live_credentials",
    "claim_connected",
    "claim_native",
    "adopt_kernel_outcome"
  ]
}
