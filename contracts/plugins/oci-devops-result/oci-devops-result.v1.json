{
  "schemaVersion": "hartevo.oci-devops-result-contract/v1",
  "contractVersion": "oci-devops-result/v1",
  "layer": 1,
  "serviceId": "oci.devops-result",
  "providerId": "oci.devops",
  "consumerId": "mission.oci-devops-result",
  "apiVersion": "20210630",
  "apiOriginPattern": "https://devops.{region}.oci.oraclecloud.com",
  "apiPaths": {
    "listDeployments": "/20210630/deployments",
    "getDeployment": "/20210630/deployments/{deploymentId}",
    "listBuildRuns": "/20210630/buildRuns",
    "getBuildRun": "/20210630/buildRuns/{buildRunId}",
    "listWorkRequests": "/20210630/workRequests",
    "getWorkRequest": "/20210630/workRequests/{workRequestId}"
  },
  "transportProvenance": [
    "fixture",
    "recording",
    "loopback",
    "blocked_env",
    "production_read"
  ],
  "operations": [
    "describe_capabilities",
    "register",
    "revoke_registration",
    "list_deployments",
    "get_deployment",
    "list_build_runs",
    "get_build_run",
    "list_work_requests",
    "get_work_request",
    "consume_observation",
    "propose_delivery_decision",
    "record_delivery_decision",
    "verify_readback"
  ],
  "readOnly": true,
  "mutatingProviderOperations": [],
  "authority": {
    "externalWrites": false,
    "run": false,
    "cancel": false,
    "approve": false,
    "redeploy": false,
    "rawLogs": false,
    "rawArtifacts": false,
    "rawEnvironment": false,
    "rawSecrets": false,
    "connected": false,
    "effect": false,
    "receipt": false,
    "verification": false,
    "outcome": false,
    "workProductAdoption": false
  },
  "registration": {
    "boundFields": [
      "pluginVersion",
      "providerVersion",
      "contractVersion",
      "contractDigest",
      "permissionDigest",
      "region",
      "tenancyId",
      "compartmentId",
      "ociProjectId",
      "pipelineId",
      "buildId",
      "deploymentId",
      "workRequestId",
      "missionScope",
      "hartevoProjectScope",
      "workProductScope",
      "secretReferenceDigest",
      "credentialRevision",
      "scopeDigest",
      "evidenceDigest"
    ],
    "reversible": true,
    "revocable": true,
    "failClosedOnDrift": true
  },
  "scopeFence": [
    "region",
    "tenancyId",
    "compartmentId",
    "ociProjectId",
    "pipelineId",
    "buildId",
    "deploymentId",
    "workRequestId",
    "missionIdAndRevision",
    "projectIdAndRevision",
    "workProductIdAndRevision",
    "deploymentRevision",
    "buildRevision",
    "workRequestRevision",
    "stageIdAndStateAndRevision",
    "reconcileResourceIdAndRevision"
  ],
  "bounds": {
    "maxResponseBytes": 1048576,
    "maxResults": 50,
    "maxPages": 4,
    "maxDeployments": 64,
    "maxBuildRuns": 64,
    "maxWorkRequests": 64,
    "maxStages": 64,
    "maxArtifactMetadata": 128,
    "maxNextPageTokenBytes": 2048,
    "maxStateBytes": 128
  },
  "redaction": {
    "retained": [
      "ocid",
      "lifecycleState",
      "stageState",
      "revision",
      "timestamps",
      "boundedCounts",
      "contentFingerprints",
      "artifactMetadataFingerprint",
      "logMetadataFingerprint"
    ],
    "redacted": [
      "rawLogs",
      "rawArtifacts",
      "artifactDownloadUrls",
      "environmentVariables",
      "secretMaterial",
      "userPii",
      "rawProviderBody"
    ],
    "explicitReadProjectionRequired": true
  },
  "receipts": {
    "requestPathAndQuery": true,
    "requestBody": false,
    "responseStatus": true,
    "responseSize": true,
    "responseDigest": true,
    "providerRevision": true,
    "apiVersion": true,
    "pageTokenDigest": true,
    "rawProviderPayload": false,
    "rawLogs": false,
    "rawArtifacts": false,
    "credentialMaterial": false
  },
  "nativeGap": {
    "status": "BLOCKED_ENV",
    "deferredTo": "layer_2_native_oci_signing_and_connected",
    "failClosedCases": [
      "missing_native_signing_authority",
      "missing_signing_key",
      "region_or_tenancy_drift",
      "compartment_project_pipeline_resource_drift",
      "permission_scope_drift",
      "stage_state_or_revision_mismatch",
      "ambiguous_work_request",
      "raw_log_or_artifact_request",
      "run_cancel_approve_redeploy_request",
      "response_or_registration_tamper"
    ]
  },
  "honestNativeGap": "Native OCI signing and HTTPS authority, durable provider receipts, independent read-back, consented deployment effects, run/cancel/approve/redeploy authority, raw logs and artifact bytes, environment or secret disclosure, verification authority, Outcome authority, and Work Product adoption remain deferred to a later layer; this root is bounded read evidence with local deterministic proposal and read-back checks only."
}
