{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hartevo.local/contracts/plugins/crossref-research-result/crossref-research-result.v1.json",
  "title": "Hartevo Crossref research metadata result Layer-1 contract",
  "description": "Bounded, redacted Crossref metadata evidence for a Mission proposal; not a search, citation, source-quality, bibliography, Truth, Receipt, Verification, or Outcome authority.",
  "schemaVersion": "hartevo.crossref-research-result/v1",
  "contractVersion": "crossref-research-result-e1/v1",
  "pluginVersion": "0.1.0",
  "layer": 1,
  "authority": {
    "readOnly": true,
    "proposalOnly": true,
    "connected": false,
    "nativeProvider": false,
    "firstParty": false,
    "durableReceipt": false,
    "kernelAuthority": false,
    "truthAuthority": false,
    "consentAuthority": false,
    "verificationAuthority": false,
    "outcomeAuthority": false,
    "externalWrites": false,
    "bibliographyAuthority": false,
    "citationTruthAuthority": false,
    "sourceQualityAuthority": false
  },
  "typedSurface": {
    "service": "CrossrefResearchResultService",
    "provider": "CrossrefProvider",
    "consumer": "MissionCrossrefResearchConsumer",
    "models": [
      "CrossrefResearchScope",
      "CrossrefQuery",
      "CrossrefPermission",
      "CrossrefRegistration",
      "SecretReference",
      "CrossrefRequest",
      "CrossrefWorkProjection",
      "CrossrefResearchEvidence",
      "CrossrefResearchProposal",
      "CrossrefObservationReceipt"
    ]
  },
  "service": {
    "id": "crossref.research-result",
    "name": "CrossrefResearchResultService",
    "version": "1.0.0",
    "access": "read_only",
    "operations": [
      "issue_read_consent",
      "read_metadata",
      "compile_research_proposal",
      "record_observation_receipt",
      "verify_evidence",
      "verify_proposal",
      "revoke_registration",
      "restore_registration"
    ],
    "externalWrites": false,
    "liveExternalIo": false,
    "emitsOutcome": false
  },
  "provider": {
    "id": "crossref.metadata.rest",
    "name": "CrossrefProvider",
    "version": "1.0.0",
    "apiRevision": "crossref-rest-api-v1",
    "baseUrl": "https://api.crossref.org",
    "allowlistedGetPaths": [
      "/works",
      "/works/{doi}"
    ],
    "requiredPermission": "metadata.read",
    "authentication": ["opaque_secret_reference"],
    "transportProvenance": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
    "maxRequestsPerMinute": 50,
    "maxResponseBytes": 1048576,
    "maxResults": 25,
    "rawCredentialSerialized": false,
    "rawQuerySerialized": false,
    "rawDoiSerialized": false,
    "rawResponseBody": false,
    "reversible": true,
    "revocable": true,
    "native": false,
    "connected": false,
    "firstParty": false
  },
  "consumer": {
    "id": "mission.crossref-research-result",
    "name": "MissionCrossrefResearchConsumer",
    "kind": "mission_research_metadata_projection",
    "scope": [
      "project",
      "mission",
      "work_product",
      "operation",
      "query_digest",
      "consent_digest",
      "mission_revision",
      "work_product_revision",
      "source_evidence_digest"
    ],
    "adoptsOutcome": false,
    "adoptsWorkProduct": false,
    "kernelAuthority": false,
    "truthAuthority": false
  },
  "exactScope": [
    "project",
    "mission",
    "work_product",
    "operation",
    "query_digest",
    "filter_digest",
    "max_results",
    "scope_revision",
    "consent"
  ],
  "allowlist": {
    "reads": [
      {
        "operation": "search_works",
        "method": "GET",
        "path": "/works",
        "permission": "metadata.read",
        "aggregateOnly": true,
        "rawQuery": false
      },
      {
        "operation": "retrieve_work",
        "method": "GET",
        "path": "/works/{doi}",
        "permission": "metadata.read",
        "aggregateOnly": true,
        "rawDoi": false
      }
    ],
    "writes": [],
    "forbidden": [
      "content_registration",
      "metadata_mutation",
      "member_mutation",
      "reference_mutation",
      "raw_query_export",
      "raw_doi_export",
      "raw_title_export",
      "raw_response_export",
      "citation_truth_claim",
      "source_quality_claim",
      "bibliography_authority",
      "kernel_truth_authority",
      "kernel_consent_authority",
      "kernel_receipt_authority",
      "kernel_verification_authority",
      "kernel_outcome_authority",
      "verified_work_product_adoption"
    ]
  },
  "authentication": {
    "boundary": "opaque SecretReference",
    "requiredPermission": "metadata.read",
    "rawCredentialSerialized": false,
    "rawCredentialDebug": false,
    "rawCredentialRequest": false,
    "rawCredentialReceipt": false,
    "resolvedByLayer": 2
  },
  "bounds": {
    "maxResults": 25,
    "maxResponseBytes": 1048576,
    "maxIdentifierBytes": 128,
    "maxDiagnosticBytes": 512,
    "maxRequestsPerMinute": 50,
    "maxRetryAfterSeconds": 3600,
    "maxMetadataAuthors": 1000,
    "maxTitleBytes": 256
  },
  "normalization": {
    "responseOrderIndependent": true,
    "resultsSortedByDoiDigest": true,
    "duplicateDoiDigestRejected": true,
    "query": "digest_only",
    "doi": "digest_only",
    "title": "digest_only",
    "rawJson": false,
    "partialResults": true,
    "emptyIsSuccess": false,
    "citationCountIsProviderMetadataOnly": true
  },
  "digests": {
    "pluginVersion": true,
    "contractVersion": true,
    "contract": true,
    "provider": true,
    "permission": true,
    "scope": true,
    "secretReference": true,
    "registration": true,
    "consent": true,
    "evidence": true,
    "proposal": true,
    "receipt": true,
    "response": true
  },
  "registration": {
    "versionBound": true,
    "contractDigestBound": true,
    "providerDigestBound": true,
    "permissionDigestBound": true,
    "scopeDigestBound": true,
    "secretReferenceDigestBound": true,
    "evidenceDigestBound": true,
    "registrationDigestBound": true,
    "reversible": true,
    "revocable": true,
    "rotationOnStateChange": true,
    "failClosedOn": [
      "plugin_version_drift",
      "contract_drift",
      "provider_drift",
      "permission_drift",
      "scope_drift",
      "consent_drift",
      "secret_reference_drift",
      "evidence_drift",
      "registration_revocation",
      "replay"
    ]
  },
  "receipts": {
    "observation": true,
    "rateLimit": ["limitPerMinute", "remaining", "retryAfterSeconds", "throttled"],
    "rawHeaders": false,
    "rawResponseBody": false,
    "durableNativeReceipt": false
  },
  "honesty": {
    "fixtureConnected": false,
    "fixtureNative": false,
    "fixtureFirstParty": false,
    "recordingConnected": false,
    "recordingNative": false,
    "recordingFirstParty": false,
    "loopbackConnected": false,
    "loopbackNative": false,
    "loopbackFirstParty": false,
    "blockedEnvConnected": false,
    "blockedEnvNative": false,
    "blockedEnvFirstParty": false,
    "nativeHttpsTransport": "layer_2_gap",
    "nativeCredentialResolution": "layer_2_gap",
    "nativeReadback": "layer_2_gap",
    "workProductAdoption": "layer_2_gap",
    "citationTruth": false,
    "sourceQualityTruth": false,
    "absenceIsSuccess": false
  },
  "authorityBoundary": {
    "externalRead": "typed_bounded_metadata_get_only",
    "externalWrite": false,
    "contentRegistration": false,
    "metadataMutation": false,
    "memberMutation": false,
    "referenceMutation": false,
    "genericSearchAuthority": false,
    "bibliographyAuthority": false,
    "citationTruthAuthority": false,
    "sourceQualityAuthority": false,
    "connected": false,
    "native": false,
    "firstParty": false,
    "kernelTruth": false,
    "kernelConsent": false,
    "kernelReceipt": false,
    "kernelVerification": false,
    "kernelOutcome": false
  },
  "documentation": [
    "https://api.crossref.org/",
    "https://www.crossref.org/documentation/retrieve-metadata/rest-api/"
  ],
  "errorHandling": [
    "HTTP_400",
    "HTTP_401",
    "HTTP_403",
    "HTTP_404",
    "HTTP_429_RATE_LIMITED",
    "HTTP_5XX",
    "BLOCKED_ENV",
    "MALFORMED_RESPONSE",
    "RESPONSE_TOO_LARGE",
    "RESPONSE_REORDER_NORMALIZED",
    "RESPONSE_TRUNCATION_PARTIAL",
    "INVALID_SCOPE",
    "MISSING_PERMISSION",
    "TAMPER",
    "STALE_SCOPE",
    "REGISTRATION_REVOCATION",
    "REPLAY"
  ],
  "layer2Gaps": [
    "native_secret_reference_resolution",
    "native_crossref_https_transport",
    "durable_native_provider_receipt",
    "independent_native_readback",
    "verified_work_product_adoption",
    "kernel_truth_consent_effect_receipt_verification_outcome_authority"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "$id",
    "schemaVersion",
    "contractVersion",
    "pluginVersion",
    "layer",
    "authority",
    "typedSurface",
    "service",
    "provider",
    "consumer",
    "exactScope",
    "allowlist",
    "authentication",
    "bounds",
    "normalization",
    "digests",
    "registration",
    "receipts",
    "honesty",
    "authorityBoundary",
    "documentation",
    "errorHandling",
    "layer2Gaps"
  ]
}
