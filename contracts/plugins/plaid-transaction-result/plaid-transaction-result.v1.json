{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tangpingqingwa/hartevo-desktop/contracts/plugins/plaid-transaction-result/plaid-transaction-result.v1.json",
  "title": "Hartevo Plaid Transactions sync result Layer-1 contract",
  "description": "A bounded, redacted, read-only Plaid /transactions/sync evidence and proposal seam. It is not a Link flow, a native connector, a payment effect, financial advice, or kernel authority.",
  "schemaVersion": "hartevo.plaid-transaction-result.contract/v1",
  "contractVersion": "plaid-transaction-result/v1",
  "pluginVersion": "0.1.0",
  "layer": "Layer-1",
  "serviceId": "hartevo.plaid.transaction.result",
  "providerId": "plaid.transactions",
  "consumerId": "mission.plaid.transaction.result",
  "api": "/transactions/sync",
  "method": "POST",
  "apiVersion": "2020-09-14",
  "scope": [
    "environment",
    "opaque_item_id_digest_and_revision",
    "opaque_account_id_digests_and_bounded_filter",
    "opaque_secret_reference_digest_and_revision",
    "transactions_read_permission",
    "cursor_digest_and_revision",
    "bounded_update_window_and_revision",
    "transaction_revision_and_high_water_digest",
    "project_id_and_revision",
    "mission_id_and_revision",
    "work_product_id_and_revision"
  ],
  "digests": [
    "plugin_version_digest",
    "contract_digest",
    "provider_digest",
    "api_version_digest",
    "scope_digest",
    "permission_digest",
    "secret_reference_digest",
    "registration_digest",
    "request_digest",
    "response_digest",
    "evidence_digest",
    "transaction_id_digest",
    "account_id_digest",
    "amount_digest",
    "category_digest",
    "entity_digest",
    "pending_posted_linkage_digest",
    "request_id_digest",
    "failure_digest"
  ],
  "registration": {
    "versionAndContractBound": true,
    "providerAndApiBound": true,
    "permissionAndScopeBound": true,
    "cursorAndWindowBound": true,
    "projectMissionWorkProductBound": true,
    "reversible": true,
    "revocable": true,
    "failClosedOn": [
      "provider_drift",
      "api_version_drift",
      "permission_drift",
      "item_revision_drift",
      "account_filter_drift",
      "cursor_drift",
      "update_window_drift",
      "transaction_revision_drift",
      "project_revision_drift",
      "mission_revision_drift",
      "work_product_revision_drift",
      "registration_tamper",
      "registration_revocation",
      "secret_revocation",
      "evidence_replay",
      "proposal_replay"
    ]
  },
  "sync": {
    "readOnly": true,
    "boundedCountMax": 500,
    "boundedPageMax": 64,
    "boundedTransactionMax": 500,
    "paginationMutation": "restart_from_first_page_cursor",
    "paginationMutationRestartMax": 1,
    "cursorLoop": "reject",
    "webhookRole": "signed_change_signal_only; /transactions/sync_remains_source_of_truth"
  },
  "transactionStates": [
    "pending",
    "posted",
    "modified",
    "removed"
  ],
  "updateStatuses": [
    "complete",
    "in_progress",
    "unknown"
  ],
  "allowlistedEvidence": [
    "opaque_item_id_digest",
    "opaque_account_id_digest",
    "opaque_transaction_id_digest",
    "pending_posted_linkage_digest",
    "pending_posted_state",
    "modified_state",
    "removed_state",
    "bounded_amount_bucket",
    "amount_digest",
    "currency_code",
    "bounded_transaction_dates",
    "category_digest",
    "entity_digest",
    "update_status",
    "cursor_high_water_digest",
    "bounded_page_and_transaction_counts",
    "request_response_and_failure_digests",
    "redacted_request_id_digest"
  ],
  "evidenceModes": [
    "fixture",
    "recording",
    "loopback",
    "BLOCKED_ENV"
  ],
  "authority": {
    "connected": false,
    "native": false,
    "externalWrites": false,
    "linkTokenCreation": false,
    "publicTokenCreation": false,
    "itemRefresh": false,
    "transactionsRefresh": false,
    "payments": false,
    "accountMutation": false,
    "durableProviderReceipt": false,
    "independentReadBack": false,
    "financialAdvice": false,
    "dashboardAuthority": false,
    "kernelTruth": false,
    "kernelConsent": false,
    "kernelEffect": false,
    "kernelReceipt": false,
    "kernelVerification": false,
    "kernelOutcomeAdoption": false
  },
  "forbidden": [
    "raw_access_token",
    "raw_client_credentials",
    "raw_item_id",
    "raw_account_id",
    "raw_transaction_id",
    "account_number",
    "routing_number",
    "balances",
    "raw_merchant_description",
    "merchant_name",
    "merchant_address",
    "geolocation",
    "raw_transaction_payload",
    "link_token_creation",
    "public_token_creation",
    "item_refresh",
    "transactions_refresh",
    "payments",
    "money_movement",
    "account_mutation",
    "financial_advice",
    "finance_dashboard",
    "kernel_truth",
    "kernel_consent",
    "kernel_effect",
    "kernel_receipt",
    "kernel_verification",
    "kernel_outcome_adoption",
    "native_connected_claim"
  ],
  "layer2Gaps": [
    "native_credential_resolution",
    "live_https_transport",
    "host_store_and_keyring_wiring",
    "durable_provider_receipts",
    "independent_transaction_readback",
    "verified_work_product_adoption"
  ],
  "officialDocs": [
    "https://plaid.com/docs/api/products/transactions/",
    "https://plaid.com/docs/transactions/",
    "https://plaid.com/docs/transactions/transactions-data/",
    "https://plaid.com/docs/transactions/webhooks/",
    "https://plaid.com/docs/transactions/sync-migration/"
  ],
  "nonOverlap": {
    "purpose": "user-authorized bounded transaction activity and incremental reconciliation only",
    "rampIssue": 495,
    "xeroIssue": 407,
    "netsuiteIssue": 487,
    "awsCostExplorerIssue": 374,
    "paddleIssue": 430
  }
}
