{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tangpingqingwa/hartevo-desktop/contracts/plugins/onetrust-consent-result/onetrust-consent-result.v1.json",
  "title": "Hartevo OneTrust consent-evidence Layer-1 contract",
  "description": "A bounded read-only OneTrust consent and preference evidence proposal seam. It is not a consent authority, receipt writer, preference mutator, or kernel adoption authority.",
  "schemaVersion": "hartevo.onetrust-consent-result.contract/v1",
  "contractVersion": "onetrust-consent-result/v1",
  "pluginVersion": "1.0.0",
  "layer": "Layer-1",
  "service": {
    "id": "hartevo.onetrust.consent-evidence",
    "implementation": "OneTrustConsentEvidenceService",
    "version": "1.0.0",
    "operations": [
      "describe_capabilities",
      "register",
      "revoke_registration",
      "read_bounded_consent_evidence",
      "compile_evidence_proposal",
      "record_proposal",
      "verify_proposal"
    ],
    "readOnly": true,
    "proposalOnly": true,
    "liveExecution": false
  },
  "provider": {
    "id": "onetrust.consent",
    "implementation": "OneTrustConsentProvider",
    "version": "1.0.0",
    "apiFamilies": ["consent_v4", "realtime_preferences_v2", "transactions_v2"],
    "allowlistedMethods": ["GET", "POST"],
    "allowlistedReads": [
      "get_datasubject_details_v4",
      "get_realtime_preferences_v2",
      "get_transactions_v2"
    ],
    "acceptedTransports": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
    "native": false,
    "connected": false,
    "externalWrites": false,
    "officialApiSurfaces": [
      "/rest/api/consent/v4/datasubjects/details",
      "https://consent-api.onetrust.com/v2/preferences",
      "/api/consent/v2/transactions"
    ]
  },
  "consumer": {
    "id": "mission.onetrust-consent-result",
    "implementation": "MissionOneTrustConsentConsumer",
    "version": "1.0.0",
    "missionBound": true,
    "projectBound": true,
    "consentBound": true,
    "workProductBound": true,
    "adoptsOutcome": false,
    "truthAuthority": false,
    "consentAuthority": false,
    "effectAuthority": false
  },
  "scope": {
    "required": [
      "tenant",
      "region",
      "purposeId",
      "purposeVersion",
      "collectionPoint",
      "consentWindow",
      "subjectReferenceHash",
      "policyRevision",
      "missionIdAndRevision",
      "projectIdAndRevision",
      "consentIdAndRevision",
      "workProductIdAndRevision",
      "permissionDigest",
      "scopeDigest"
    ],
    "secret": "opaque_secret_reference_only",
    "subject": "scope_bound_salted_opaque_hash_only",
    "tenantBound": true,
    "purposeBound": true,
    "policyRevisionBound": true,
    "missionBound": true,
    "projectBound": true,
    "consentBound": true,
    "workProductBound": true
  },
  "registration": {
    "versionBound": true,
    "contractDigestBound": true,
    "providerIdBound": true,
    "providerImplementationBound": true,
    "providerVersionBound": true,
    "providerRevisionBound": true,
    "providerDigestBound": true,
    "provenanceBound": true,
    "scopeDigestBound": true,
    "permissionDigestBound": true,
    "missionRevisionBound": true,
    "projectRevisionBound": true,
    "consentRevisionBound": true,
    "workProductRevisionBound": true,
    "evidenceDigestBound": true,
    "sharedLiveRevocationFence": true,
    "reversible": true,
    "revocable": true,
    "failClosedOn": [
      "plugin_version_drift",
      "contract_version_or_digest_drift",
      "provider_identity_or_revision_drift",
      "scope_or_permission_digest_drift",
      "mission_project_consent_work_product_revision_drift",
      "evidence_digest_drift",
      "registration_tamper",
      "registration_revocation",
      "secret_reference_revocation"
    ]
  },
  "recording": {
    "replayFence": "registration_request_proposal_receipt_mission_tuple",
    "duplicateReplay": "reject",
    "resealedReplay": "reject",
    "maxReplayKeys": 256,
    "stateDurability": "process_lifecycle_bounded_not_restart_durable"
  },
  "bounds": {
    "maxResponseBytes": 1048576,
    "maxPages": 4,
    "pageSize": 50,
    "maxRequestsPerMinute": 5,
    "maxConsentWindowHours": 24,
    "maxObservations": 256,
    "maxIdentifierBytes": 128,
    "maxCursorBytes": 256,
    "maxRecordingReplayKeys": 256
  },
  "evidence": {
    "allowlistedFields": [
      "tenant",
      "region",
      "purposeId",
      "purposeVersion",
      "consentStatus",
      "consentTimestamp",
      "withdrawalTimestamp",
      "expiryTimestamp",
      "collectionPoint",
      "transactionIdDigest",
      "policyRevision",
      "boundedPaginationCursorDigest",
      "requestReceiptDigest",
      "responseReceiptDigest",
      "readCount",
      "partialProjection",
      "rationaleDigest",
      "replayDigest",
      "sourceDigest",
      "resultDigest",
      "subjectReferenceHash"
    ],
    "rawPreferencePayload": false,
    "rawSubjectIdentifier": false,
    "rawJwt": false,
    "rawPii": false
  },
  "projections": {
    "states": [
      "granted",
      "denied",
      "pending",
      "withdrawn",
      "expired",
      "no_record",
      "partial",
      "access_lost",
      "stale",
      "provider_unknown"
    ],
    "failClosed": true,
    "adopted": false,
    "kernelAuthority": false,
    "partial": true
  },
  "authority": {
    "readOnly": true,
    "proposalOnly": true,
    "consentReceiptCreation": false,
    "consentWithdrawal": false,
    "preferenceUpdate": false,
    "preferenceCenterWrite": false,
    "dataSubjectMutation": false,
    "externalWrites": false,
    "effect": false,
    "receipt": false,
    "verification": false,
    "truth": false,
    "outcome": false,
    "workProductAdoption": false,
    "connected": false,
    "native": false
  },
  "redaction": {
    "rawPreferencePayload": false,
    "rawSubjectIdentifier": false,
    "rawJwt": false,
    "rawPii": false,
    "rawAccessToken": false,
    "rawProviderError": false
  },
  "honesty": {
    "nativeStatus": "BLOCKED_ENV",
    "replayStateDurability": "process_lifecycle_bounded_not_restart_durable",
    "blockedEnvironmentIsNative": false,
    "fixtureIsNative": false,
    "recordingIsNative": false,
    "loopbackIsNative": false,
    "connectedClaim": false,
    "firstPartyEvidenceClaim": false,
    "layer1Boundary": "Layer 1 hashes the supplied subject reference into a scope-bound opaque digest and retains only allowlisted consent metadata and cryptographic receipts; native credentials, raw subject identifiers, raw JWTs, consent transactions, provider receipt creation, independent read-back, verification, kernel Truth, Consent, Effect, Receipt, Outcome, and Work Product adoption remain outside this root."
  },
  "layer2Gaps": [
    "native_onetrust_credential_and_subject_reference_resolution",
    "consented_authenticated_onetrust_reads",
    "durable_provider_consent_receipts",
    "consent_receipt_creation_or_withdrawal_effects",
    "preference_center_or_data_subject_mutation",
    "independent_provider_readback",
    "verified_work_product_adoption",
    "restart_durable_replay_and_revocation_state",
    "host_owned_kernel_consent_and_effect_authority"
  ],
  "forbidden": [
    "consent_receipt_creation",
    "consent_withdrawal",
    "consent_update",
    "preference_center_write",
    "data_subject_mutation",
    "raw_preference_payload_serialization",
    "raw_subject_identifier_serialization",
    "raw_jwt_serialization",
    "raw_pii_serialization",
    "connected_or_first_party_claim",
    "kernel_consent_authority",
    "kernel_effect_authority",
    "kernel_outcome_authority",
    "work_product_adoption"
  ]
}
