{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hartevo.local/contracts/plugins/aws-trusted-advisor-result/contract.v1.json",
  "title": "Hartevo AWS Trusted Advisor recommendation result Layer-1 contract",
  "description": "Bounded AWS Support Trusted Advisor check evidence and Mission proposal seam; not an optimizer, remediation executor, or Truth authority.",
  "schemaVersion": "hartevo-aws-trusted-advisor-result-contract/v1",
  "contractVersion": "aws-trusted-advisor-result-l1/v1",
  "pluginVersion": "0.1.0",
  "layer": 1,
  "evidenceLevel": "E1",
  "service": {
    "id": "aws.trusted-advisor.result.read",
    "name": "AwsTrustedAdvisorService",
    "version": "1.0.0",
    "operations": [
      "describe_trusted_advisor_checks",
      "describe_trusted_advisor_check_refresh_statuses",
      "describe_trusted_advisor_check_result",
      "compile_result_proposal",
      "record_observation_receipt",
      "verify_result_proposal",
      "revoke_registration",
      "restore_registration"
    ],
    "readOnly": true,
    "proposalOnly": true,
    "externalWrites": false,
    "refreshChecks": false,
    "remediation": false,
    "supportCaseMutation": false,
    "liveExecution": false
  },
  "provider": {
    "id": "aws.trusted-advisor.result",
    "name": "AwsTrustedAdvisorProvider",
    "version": "1.0.0",
    "apiRevision": "aws-support-trusted-advisor-read-v1",
    "endpointRegion": "us-east-1",
    "apis": [
      "DescribeTrustedAdvisorChecks",
      "DescribeTrustedAdvisorCheckRefreshStatuses",
      "DescribeTrustedAdvisorCheckResult"
    ],
    "acceptedProvenance": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
    "supportPlans": ["business", "enterprise_on_ramp", "enterprise"],
    "native": false,
    "connected": false,
    "firstParty": false,
    "liveCredentialResolution": false,
    "opaqueSecretReference": true,
    "rawSupportPayload": false,
    "rawResourceMetadata": false,
    "refreshMutation": false,
    "remediation": false
  },
  "consumer": {
    "id": "mission.aws-trusted-advisor.result",
    "name": "MissionAwsTrustedAdvisorConsumer",
    "projectBound": true,
    "missionBound": true,
    "workProductBound": true,
    "permissionBound": true,
    "consentBound": true,
    "adoptsOutcome": false,
    "adoptsWorkProduct": false,
    "truthAuthority": false,
    "kernelAuthority": false
  },
  "scope": {
    "required": [
      "accountDigest",
      "supportPlan",
      "supportEndpointRegion",
      "checkId",
      "category",
      "projectDigest",
      "missionDigest",
      "workProductDigest",
      "workProductRevision",
      "permissionDigest",
      "consentDigest",
      "maxRefreshAgeSeconds"
    ],
    "endpointRegion": "us-east-1",
    "rawAccountId": false,
    "rawResourceIdentifier": false,
    "rawDescriptions": false,
    "rawMetadataArrays": false,
    "pii": false
  },
  "allowlistedReads": [
    {
      "operation": "describe_trusted_advisor_checks",
      "method": "POST",
      "api": "DescribeTrustedAdvisorChecks",
      "bounded": true,
      "checkScoped": true
    },
    {
      "operation": "describe_trusted_advisor_check_refresh_statuses",
      "method": "POST",
      "api": "DescribeTrustedAdvisorCheckRefreshStatuses",
      "bounded": true,
      "checkScoped": true
    },
    {
      "operation": "describe_trusted_advisor_check_result",
      "method": "POST",
      "api": "DescribeTrustedAdvisorCheckResult",
      "bounded": true,
      "checkScoped": true,
      "digestOnlyFlaggedResources": true
    }
  ],
  "bounds": {
    "maxCheckDefinitions": 64,
    "maxResultPages": 4,
    "maxFlaggedResourcesPerPage": 64,
    "maxFlaggedResources": 128,
    "maxResponseBytes": 1048576,
    "maxIdentifierBytes": 256,
    "maxRetryAfterSeconds": 3600,
    "maxRefreshAgeSeconds": 604800
  },
  "redaction": {
    "secret": "opaque_digest_only",
    "account": "digest_only",
    "flaggedResourceIdentifier": "sha256_digest_only",
    "flaggedResourceRegion": "bounded_typed_region",
    "description": "dropped",
    "metadataArrays": "dropped",
    "rawSupportPayload": "dropped",
    "requestReceipt": "operation_scope_check_category_page_digest_only"
  },
  "evidenceStates": [
    "complete",
    "partial",
    "unsupported_support_plan",
    "refresh_stale",
    "refresh_in_progress",
    "refresh_failed",
    "access_lost",
    "throttled",
    "check_not_found",
    "provider_unknown",
    "tampered",
    "revoked"
  ],
  "resultStatuses": ["ok", "warning", "error", "not_available", "unknown"],
  "registration": {
    "versionBound": true,
    "contractDigestBound": true,
    "providerDigestBound": true,
    "providerApiRevisionBound": true,
    "permissionDigestBound": true,
    "scopeDigestBound": true,
    "checkIdBound": true,
    "categoryBound": true,
    "checkIdDigestBound": true,
    "categoryDigestBound": true,
    "evidencePolicyDigestBound": true,
    "secretReferenceDigestBound": true,
    "reversible": true,
    "revocable": true,
    "failClosedOn": [
      "version_drift",
      "contract_drift",
      "provider_drift",
      "support_plan_drift",
      "account_drift",
      "region_drift",
      "check_id_drift",
      "category_drift",
      "permission_drift",
      "consent_withdrawal",
      "scope_drift",
      "stale_refresh",
      "partial_result",
      "response_tamper",
      "registration_revocation"
    ]
  },
  "authority": {
    "connected": false,
    "nativeProvider": false,
    "firstPartyEvidence": false,
    "externalWrites": false,
    "refreshMutation": false,
    "supportCaseMutation": false,
    "remediation": false,
    "rawResourceExport": false,
    "durableProviderReceipt": false,
    "independentReadBack": false,
    "kernelConsentAuthority": false,
    "kernelEffectAuthority": false,
    "kernelReceiptAuthority": false,
    "kernelOutcomeAdoption": false,
    "workProductAdoption": false
  },
  "evidenceModes": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
  "layer2Gaps": [
    "native_sigv4_secret_resolution",
    "native_aws_support_https_readback",
    "durable_provider_receipt",
    "independent_repeat_read_verification",
    "kernel_owned_consent_effect_receipt_authority",
    "consented_recommendation_remediation"
  ],
  "honestNativeGap": "Layer 1 only records, replays, and projects bounded Trusted Advisor check evidence from fixture, recording, loopback, or BLOCKED_ENV transports. It never resolves a native SigV4 secret, calls AWS Support, refreshes a check, opens a support case, applies remediation, claims savings or availability causality, retains raw resource metadata, reports Connected/native/first-party, or adopts a kernel Outcome."
}
