{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tangpingqingwa/hartevo-desktop/contracts/plugins/semgrep-security-result/service.v1.json",
  "title": "Hartevo Semgrep security-result Layer-1 service",
  "description": "Standalone bounded Semgrep Code, Secrets, and Supply Chain finding evidence contract. It is not a scanner registry, remediation authority, source exporter, or kernel Outcome authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "serviceId",
    "providerId",
    "version",
    "layer",
    "operations",
    "scope",
    "registration",
    "findingStatuses",
    "findingTypes",
    "projections",
    "bounds",
    "honesty",
    "layer2Gaps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "hartevo.semgrep-security-result/v1"
    },
    "serviceId": {
      "const": "security.semgrep.result.read"
    },
    "providerId": {
      "const": "semgrep"
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor", "patch"],
      "properties": {
        "major": {"const": 0},
        "minor": {"const": 1},
        "patch": {"const": 0}
      }
    },
    "layer": {
      "const": 1
    },
    "operations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "describe_organization_project",
          "read_scan_evidence",
          "compile_security_decision_proposal",
          "record_security_receipt",
          "verify_security_result"
        ]
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "apiHost",
        "organizationId",
        "organizationSlug",
        "projectId",
        "repository",
        "ref",
        "scanId",
        "findingIds",
        "ruleIds",
        "ruleRevisionDigest",
        "commitSha",
        "findingTypes",
        "mission",
        "permissions"
      ],
      "properties": {
        "apiVersion": {"const": "v1"},
        "apiHost": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^/@:]+(?::[0-9]+)?$"
        },
        "organizationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "organizationSlug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "owner", "name", "url"],
          "properties": {
            "provider": {"type": "string", "minLength": 1, "maxLength": 256},
            "owner": {"type": "string", "minLength": 1, "maxLength": 256},
            "name": {"type": "string", "minLength": 1, "maxLength": 256},
            "url": {
              "type": "string",
              "maxLength": 512,
              "pattern": "^(https|ssh)://"
            }
          }
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "scanId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "findingIds": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 256,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "ruleIds": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 256,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "ruleRevisionDigest": {"$ref": "#/$defs/digest"},
        "commitSha": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{40}([A-Fa-f0-9]{24})?$"
        },
        "findingTypes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"enum": ["sast", "secrets", "sca"]}
        },
        "mission": {
          "$ref": "#/$defs/missionScope"
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "organization:read",
              "project:read",
              "scan:read",
              "finding:read",
              "rule:read",
              "secrets:read"
            ]
          }
        }
      }
    },
    "registration": {
      "type": "object",
      "description": "Only digests are recordable. The SecretReference is opaque and is never serialized.",
      "additionalProperties": false,
      "required": [
        "versionDigest",
        "contractDigest",
        "providerDigest",
        "apiHostDigest",
        "organizationDigest",
        "projectDigest",
        "repositoryDigest",
        "refDigest",
        "scanDigest",
        "findingDigest",
        "ruleDigest",
        "commitDigest",
        "permissionDigest",
        "scopeDigest",
        "credentialDigest",
        "registrationDigest",
        "reversible",
        "revocable",
        "status"
      ],
      "properties": {
        "versionDigest": {"$ref": "#/$defs/digest"},
        "contractDigest": {"$ref": "#/$defs/digest"},
        "providerDigest": {"$ref": "#/$defs/digest"},
        "apiHostDigest": {"$ref": "#/$defs/digest"},
        "organizationDigest": {"$ref": "#/$defs/digest"},
        "projectDigest": {"$ref": "#/$defs/digest"},
        "repositoryDigest": {"$ref": "#/$defs/digest"},
        "refDigest": {"$ref": "#/$defs/digest"},
        "scanDigest": {"$ref": "#/$defs/digest"},
        "findingDigest": {"$ref": "#/$defs/digest"},
        "ruleDigest": {"$ref": "#/$defs/digest"},
        "commitDigest": {"$ref": "#/$defs/digest"},
        "permissionDigest": {"$ref": "#/$defs/digest"},
        "scopeDigest": {"$ref": "#/$defs/digest"},
        "credentialDigest": {"$ref": "#/$defs/digest"},
        "registrationDigest": {"$ref": "#/$defs/digest"},
        "reversible": {"const": true},
        "revocable": {"const": true},
        "status": {"enum": ["active", "unmounted", "revoked"]}
      }
    },
    "findingStatuses": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "open",
          "reviewing",
          "to_fix",
          "fixed",
          "ignored",
          "removed",
          "provisionally_ignored",
          "unknown"
        ]
      }
    },
    "findingTypes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["sast", "secrets", "sca"]}
    },
    "projections": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "no_findings",
          "findings_present",
          "incomplete",
          "access_loss",
          "provider_unknown",
          "stale",
          "revoked"
        ]
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxHostBytes",
        "maxIdentifierBytes",
        "maxRefBytes",
        "maxFindingIds",
        "maxRuleIds",
        "maxFindings",
        "maxPageCount",
        "maxPageItems",
        "maxResponseBytes"
      ],
      "properties": {
        "maxHostBytes": {"const": 256},
        "maxIdentifierBytes": {"const": 256},
        "maxRefBytes": {"const": 512},
        "maxFindingIds": {"const": 256},
        "maxRuleIds": {"const": 256},
        "maxFindings": {"const": 4096},
        "maxPageCount": {"const": 32},
        "maxPageItems": {"const": 256},
        "maxResponseBytes": {"const": 2097152}
      }
    },
    "honesty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connected",
        "native",
        "firstParty",
        "recordingOnly",
        "rawTokenSerialized",
        "rawSourceRetained",
        "unboundedFindingsExported",
        "triageWritesEnabled",
        "codeMutationEnabled",
        "kernelOutcomeAdopted"
      ],
      "properties": {
        "connected": {"const": false},
        "native": {"const": false},
        "firstParty": {"const": false},
        "recordingOnly": {"const": true},
        "rawTokenSerialized": {"const": false},
        "rawSourceRetained": {"const": false},
        "unboundedFindingsExported": {"const": false},
        "triageWritesEnabled": {"const": false},
        "codeMutationEnabled": {"const": false},
        "kernelOutcomeAdopted": {"const": false}
      }
    },
    "layer2Gaps": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "native_api_token_resolution",
          "native_oidc_token_resolution",
          "bounded_https_reads",
          "durable_provider_receipt",
          "independent_scan_reconciliation",
          "verified_work_product_adoption"
        ]
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "missionScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "missionId",
        "workProductId",
        "projectRevision",
        "missionRevision",
        "workProductRevision",
        "policyDigest",
        "consentDigest"
      ],
      "properties": {
        "projectId": {"type": "string", "minLength": 1, "maxLength": 256},
        "missionId": {"type": "string", "minLength": 1, "maxLength": 256},
        "workProductId": {"type": "string", "minLength": 1, "maxLength": 256},
        "projectRevision": {"type": "integer", "minimum": 1},
        "missionRevision": {"type": "integer", "minimum": 1},
        "workProductRevision": {"type": "integer", "minimum": 1},
        "policyDigest": {"$ref": "#/$defs/digest"},
        "consentDigest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
