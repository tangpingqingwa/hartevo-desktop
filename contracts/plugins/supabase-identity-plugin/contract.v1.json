{
  "schemaVersion": "hartevo.supabase.identity-policy/v1",
  "contractVersion": "supabase-identity-policy-layer1/v1",
  "pluginId": "hartevo.supabase.identity-policy",
  "providerId": "supabase",
  "providerApiRevision": "supabase-management-auth-postgrest-metadata/v1",
  "evidenceLevel": "external-identity-claims-grant-rls-evidence-layer1",
  "readOnly": true,
  "proposalOnly": true,
  "connected": false,
  "native": false,
  "identityAuthority": false,
  "truthAuthority": false,
  "effectAuthority": false,
  "outcomeAuthority": false,
  "operations": [
    "describe_capabilities",
    "probe_registration",
    "read_project_metadata",
    "read_auth_identity",
    "read_jwt_claim_evidence",
    "read_database_grants",
    "read_rls_policy_metadata",
    "compile_policy_decision_proposal"
  ],
  "transport": {
    "managementApi": "https_metadata_seam",
    "authApi": "https_auth_metadata_seam",
    "postgrestApi": "https_postgrest_metadata_seam",
    "liveNativeTransport": false,
    "fixtureConnectedClaim": false,
    "recordingConnectedClaim": false,
    "loopbackConnectedClaim": false,
    "blockedEnvConnectedClaim": false
  },
  "authentication": {
    "accepted": ["project_scoped_oauth", "project_scoped_anon_reference"],
    "serviceRole": "explicitly_rejected_at_mission_boundary",
    "secretMaterial": "opaque_secret_reference_only",
    "rawJwt": false,
    "rawAccessToken": false,
    "rawAnonKey": false,
    "rawServiceRoleKey": false,
    "tokenMinting": false
  },
  "scope": {
    "exact": [
      "supabase_project_ref",
      "supabase_region",
      "management_auth_postgrest_api_hosts",
      "hartevo_project_id",
      "mission_id",
      "mission_revision",
      "work_product_id",
      "consent_reference",
      "consent_revision",
      "tenant_id",
      "auth_audience",
      "auth_issuer",
      "subject_user_id",
      "allowed_roles",
      "schema_table_allowlist",
      "column_allowlist",
      "function_allowlist",
      "grant_revision",
      "rls_policy_revision"
    ],
    "providerIdsImmutable": true,
    "tenantCrossing": false,
    "roleCrossing": false,
    "tableCrossing": false
  },
  "registration": {
    "bindings": [
      "plugin_version",
      "provider_id",
      "provider_api_revision",
      "contract_digest",
      "provider_digest",
      "permission_digest",
      "scope_digest"
    ],
    "states": ["active", "reversed", "revoked"],
    "reversible": true,
    "revocable": true,
    "failClosedOnDrift": true
  },
  "evidence": {
    "bounded": true,
    "allowlistedColumnsOnly": true,
    "rawUserProfile": false,
    "email": false,
    "password": false,
    "pii": false,
    "rawJwt": false,
    "rawClaimsDocument": false,
    "rawDatabaseRows": false,
    "rawPolicySql": false,
    "serviceRoleData": false,
    "providerRevisionRequired": true,
    "responseDigestRequired": true,
    "tamperProjection": true,
    "absentProjection": true,
    "deniedProjection": true,
    "expiredProjection": true,
    "scopeMismatchProjection": true,
    "providerUnknownProjection": true
  },
  "bounds": {
    "maxRoles": 32,
    "maxTables": 64,
    "maxColumnsPerTable": 64,
    "maxFunctions": 32,
    "maxGrants": 512,
    "maxPolicies": 512,
    "maxResponseBytes": 1048576
  },
  "forbiddenLayer1Actions": [
    "create_user",
    "delete_user",
    "issue_or_refresh_token",
    "reset_password",
    "write_table",
    "execute_sql",
    "create_or_alter_rls_policy",
    "change_database_grant",
    "read_service_role_data",
    "persist_raw_jwt",
    "persist_raw_secret",
    "adopt_policy_decision",
    "emit_native_receipt",
    "claim_connected",
    "claim_native"
  ],
  "layer2Gaps": [
    "explicit_consented_user_or_policy_effect",
    "durable_native_receipt",
    "independent_rls_readback",
    "adoption",
    "native_project_credentials"
  ]
}
