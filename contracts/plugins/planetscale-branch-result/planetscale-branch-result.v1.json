{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hartevo.planetscale-branch-result/v1",
  "title": "Hartevo Layer 1 PlanetScale database branch result contract",
  "schemaVersion": "hartevo.planetscale-branch-result/v1",
  "contractVersion": "EXT-PLANETSCALE-01-L1/v1",
  "layer": 1,
  "status": "proposal_and_recording_only",
  "plugin": {
    "id": "hartevo.planetscale-branch-result",
    "version": "1.0.0",
    "digestBound": true,
    "registration": "provider_manifest_scope_consent_revision_digest_and_opaque_secret_reference",
    "reversibleRegistration": true,
    "idempotencyFence": true
  },
  "service": {
    "id": "planetscale-branch-result.service",
    "operations": [
      "bounded_branch_deploy_schema_posture_read",
      "branch_posture_proposal",
      "deploy_posture_proposal",
      "schema_metadata_proposal",
      "redacted_record",
      "verify",
      "registration",
      "revocation"
    ],
    "effectAuthority": "proposal_and_recording_only",
    "liveTransport": false,
    "branchCreate": false,
    "branchDelete": false,
    "deployRequestCreate": false,
    "deployRequestApply": false,
    "deployRequestCancel": false,
    "schemaDeploy": false,
    "queryExecution": false,
    "rawSql": false,
    "durableWorkProductAdoption": false
  },
  "provider": {
    "id": "planetscale.branch-result",
    "version": "1.0.0",
    "apiRevision": "planetscale-api-read-posture-v1",
    "readOnly": true,
    "boundedReads": [
      "database_branch_metadata",
      "deploy_request_metadata",
      "branch_schema_metadata"
    ],
    "writes": [],
    "queryExecution": false,
    "capabilities": [
      "capability_probe",
      "branch_posture_read",
      "deploy_posture_read",
      "schema_metadata_read",
      "branch_posture_proposal",
      "deploy_posture_proposal",
      "schema_metadata_proposal",
      "redacted_record",
      "digest_fencing",
      "cursor_fencing",
      "idempotency_fencing",
      "reversible_registration"
    ],
    "transports": ["fixture", "recording", "fake", "loopback", "BLOCKED_ENV"],
    "nativeStatus": "BLOCKED_ENV",
    "connectedEvidence": false,
    "nativeEvidence": false,
    "rawResponseRetention": false,
    "rawSecretRetention": false
  },
  "consumer": {
    "id": "mission.planetscale-branch-result.consumer",
    "binding": [
      "organization_id",
      "database_id",
      "branch_id",
      "deploy_request_id",
      "schema_id",
      "project_id",
      "project_revision",
      "mission_id",
      "mission_revision",
      "work_product_id",
      "work_product_revision",
      "consent_revision",
      "scope_digest",
      "revision_fence_digest",
      "provider_manifest_digest",
      "registration_digest",
      "proposal_digest",
      "idempotency_digest"
    ],
    "verifiedRecordRequired": true,
    "workProductAdoption": "proposal_only",
    "rawProviderPayload": false
  },
  "scope": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "organizationId",
      "databaseId",
      "branchId",
      "deployRequestId",
      "schemaId",
      "project",
      "mission",
      "workProduct",
      "consent"
    ],
    "properties": {
      "organizationId": { "type": "string" },
      "databaseId": { "type": "string" },
      "branchId": { "type": "string" },
      "deployRequestId": { "type": "string" },
      "schemaId": { "type": "string" },
      "project": { "type": "object" },
      "mission": { "type": "object" },
      "workProduct": { "type": "object" },
      "consent": { "type": "object" }
    },
    "humanNamesAreNotIdentity": true,
    "scopeDigest": "sha256_of_exact_typed_scope"
  },
  "posture": {
    "boundedKinds": ["branch", "deploy", "schema", "branch_deploy_schema"],
    "maxPageSize": 100,
    "maxItems": 100,
    "maxResponseBytes": 1048576,
    "branchStates": ["ready", "creating", "archived", "deleted", "unknown"],
    "deployStates": ["none", "queued", "running", "succeeded", "failed", "canceled", "unknown"],
    "schemaStates": ["not_requested", "available", "changed", "unknown"],
    "schemaDigestOnly": true,
    "noRawSchema": true,
    "noQueryExecution": true
  },
  "evidence": {
    "states": ["complete", "denied", "partial", "stale", "access_lost", "rate_limited", "provider_unknown", "tampered", "revoked"],
    "requiredFences": [
      "scope_digest",
      "consent_digest",
      "revision_fence_digest",
      "provider_manifest_digest",
      "registration_digest",
      "request_digest",
      "idempotency_digest",
      "response_digest"
    ],
    "rawApiBody": false,
    "rawSchema": false,
    "rawCredentials": false,
    "connected": false,
    "native": false
  },
  "registration": {
    "scopeBound": true,
    "consentBound": true,
    "revisionBound": true,
    "manifestDigestBound": true,
    "secretReferenceDigestBound": true,
    "rawSecretMaterial": false,
    "revocation": "monotonic_and_reversible_registry_removal",
    "nativeStatus": "BLOCKED_ENV"
  },
  "nativeGaps": [
    "native_secret_resolution",
    "live_planetscale_api_transport",
    "durable_provider_receipt",
    "independent_live_readback",
    "consented_branch_or_deploy_effects",
    "schema_deploy",
    "query_execution",
    "verified_work_product_adoption"
  ],
  "authority": {
    "organizationAuthority": false,
    "branchLifecycleAuthority": false,
    "deployAuthority": false,
    "schemaAuthority": false,
    "queryAuthority": false,
    "kernelAuthority": false,
    "outcomeAuthority": false,
    "workProductAdoptionAuthority": false
  }
}
