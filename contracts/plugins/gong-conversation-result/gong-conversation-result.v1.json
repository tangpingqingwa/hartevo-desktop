{
  "schemaVersion": "hartevo.gong-conversation-result-contract/v1",
  "contractVersion": "gong-conversation-result/v1",
  "layer": 1,
  "pluginId": "gong-conversation-result",
  "version": "1.0.0",
  "serviceId": "gong.conversation.result",
  "providerId": "gong.public-api.read",
  "consumerId": "mission.gong-conversation-result",
  "apiVersion": "v2",
  "apiOrigin": "provider-bound",
  "allowlistedReads": [
    "call_metadata",
    "interaction_metrics",
    "topics_trackers",
    "action_item_counts",
    "scorecard_status",
    "external_crm_context_identifiers"
  ],
  "scopeFence": [
    "account_id",
    "team_id",
    "user_ids",
    "call_id",
    "call_revision",
    "meeting_id",
    "deal_id",
    "context_ids",
    "context_revision",
    "scorecard_ids",
    "scorecard_revision",
    "tracker_ids",
    "analysis_revision",
    "mission_id_and_revision",
    "project_id_and_revision",
    "consent_id_and_revision",
    "consent_digest",
    "secret_reference_digest",
    "provider_capability_digest",
    "registration_digest"
  ],
  "transportProvenance": ["recording", "fixture", "loopback", "BLOCKED_ENV"],
  "projectionStates": [
    "analyzed",
    "processing",
    "partial",
    "consent_blocked",
    "retention_gap",
    "access_lost",
    "provider_unknown"
  ],
  "bounds": {
    "maxResponseBytes": 1048576,
    "maxPages": 4,
    "pageSize": 50,
    "maxDateWindowDays": 31,
    "requestsPerSecond": 3,
    "dailyRequestLimit": 10000,
    "maxUsers": 128,
    "maxContexts": 64,
    "maxScorecards": 64,
    "maxTrackers": 128,
    "maxTopics": 128,
    "maxActionItems": 128
  },
  "receipts": {
    "requestDigest": true,
    "allowlistedPath": true,
    "responseStatus": true,
    "responseSize": true,
    "responseDigest": true,
    "providerRevision": true,
    "rawProviderPayload": false,
    "transcript": false,
    "audio": false,
    "mediaUrls": false,
    "participantPii": false,
    "phoneNumbers": false,
    "comments": false,
    "rawCrmObjects": false,
    "credentialMaterial": false
  },
  "authority": {
    "readOnly": true,
    "externalWrites": false,
    "callUpload": false,
    "callUpdate": false,
    "callDelete": false,
    "recordingDownload": false,
    "rawTranscript": false,
    "rawAudio": false,
    "rawMedia": false,
    "crmWrite": false,
    "scorecardMutation": false,
    "commentMutation": false,
    "messaging": false,
    "genericCrmRegistry": false,
    "connected": false,
    "native": false,
    "effect": false,
    "receiptAuthority": false,
    "verification": false,
    "outcome": false,
    "kernelAuthority": false
  },
  "registration": {
    "boundFields": [
      "pluginVersion",
      "contractVersion",
      "contractDigest",
      "serviceId",
      "providerId",
      "providerVersion",
      "providerCapabilityDigest",
      "accountId",
      "teamId",
      "userIds",
      "callIdAndRevision",
      "meetingId",
      "dealId",
      "contextIds",
      "contextRevision",
      "scorecardIds",
      "scorecardRevision",
      "trackerIds",
      "missionIdAndRevision",
      "projectIdAndRevision",
      "consentIdAndRevision",
      "consentDigest",
      "secretReferenceDigest",
      "registrationRevision"
    ],
    "reversible": true,
    "revocable": true,
    "failClosedOnDrift": true
  },
  "negativeCapabilities": [
    "no_call_upload_update_delete",
    "no_raw_transcript_audio_media_or_participant_pii",
    "no_crm_write_or_generic_crm_registry",
    "no_scorecard_or_comment_mutation",
    "no_messaging",
    "no_recording_download",
    "no_connected_or_native_claim",
    "no_kernel_effect_receipt_verification_or_outcome_authority",
    "absence_of_action_items_or_trackers_is_not_deal_health_or_customer_intent"
  ],
  "nativeGap": {
    "status": "BLOCKED_ENV",
    "deferredTo": "layer_2_host_owned_gong_secret_and_connected_readback",
    "failClosedCases": [
      "missing_native_secret_authority",
      "missing_consent",
      "scope_or_revision_drift",
      "response_size_or_page_bound",
      "api_rate_or_daily_limit",
      "raw_transcript_audio_media_or_pii_request",
      "any_mutation_request"
    ]
  },
  "honestNativeGap": "Layer 1 records, replays, loops back, or reports BLOCKED_ENV for normalized read evidence only. Native Gong credential resolution, Connected status, live adoption, transcript/audio/media retrieval, writes, durable provider receipts, verification, and kernel authority remain outside this root."
}
