{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tangpingqingwa/hartevo-desktop/contracts/plugins/chargebee-subscription-result/chargebee-subscription-result.v1.json",
  "title": "Hartevo Chargebee governed subscription result Layer-1 contract",
  "description": "A bounded, redacted Chargebee subscription, entitlement, invoice, and usage observation seam. It is not a billing mutation engine, payment-instrument surface, financial adviser, or kernel authority.",
  "schemaVersion": "hartevo.chargebee-subscription-result.contract/v1",
  "contractVersion": "EXT-CHARGEBEE-01-L1/v1",
  "pluginVersion": "1.0.0",
  "layer": 1,
  "plugin": {
    "id": "hartevo.chargebee-subscription-result",
    "version": "1.0.0",
    "registration": {
      "digestBindingFields": [
        "plugin_version",
        "contract_version",
        "contract_digest",
        "provider_id",
        "provider_implementation",
        "provider_version",
        "provider_revision",
        "provider_digest",
        "permission_digest",
        "scope_digest",
        "evidence_digest"
      ],
      "reversible": true,
      "revocable": true
    }
  },
  "service": {
    "id": "ChargebeeSubscriptionResultService",
    "implementation": "ChargebeeSubscriptionResultService",
    "version": "1.0.0",
    "operations": [
      "describe_capabilities",
      "register",
      "revoke_registration",
      "read_subscription",
      "read_entitlements",
      "read_invoices",
      "read_usage",
      "compile_proposal",
      "record_proposal",
      "verify_proposal",
      "verify_read_back"
    ],
    "readOnly": true,
    "proposalOnly": true,
    "liveExecution": false,
    "externalWrites": false,
    "financialAdvice": false
  },
  "provider": {
    "id": "chargebee",
    "implementation": "ChargebeeProvider",
    "version": "1.0.0",
    "apiRevision": "chargebee-api-v2-read-r1",
    "allowlistedMethods": ["GET"],
    "allowlistedReads": [
      "read_subscription",
      "read_entitlements",
      "read_invoices",
      "read_usage"
    ],
    "acceptedTransports": [
      "fixture",
      "recording",
      "fake",
      "loopback",
      "BLOCKED_ENV"
    ],
    "native": false,
    "connected": false,
    "firstParty": false,
    "externalWrites": false,
    "subscriptionWrites": false,
    "planWrites": false,
    "entitlementWrites": false,
    "invoiceWrites": false,
    "refunds": false,
    "paymentInstrumentAccess": false,
    "rawCustomerPii": false
  },
  "consumer": {
    "id": "MissionChargebeeSubscriptionConsumer",
    "implementation": "MissionChargebeeSubscriptionConsumer",
    "version": "1.0.0",
    "siteBound": true,
    "customerBound": true,
    "subscriptionBound": true,
    "planBound": true,
    "invoiceBound": true,
    "entitlementBound": true,
    "projectBound": true,
    "missionBound": true,
    "workProductBound": true,
    "consentBound": true,
    "adoptsOutcome": false,
    "truthAuthority": false,
    "consentAuthority": false,
    "effectAuthority": false,
    "financialAdvice": false
  },
  "scope": {
    "required": [
      "siteIdAndRevision",
      "customerIdDigestAndRevision",
      "subscriptionIdAndRevision",
      "planIdAndRevision",
      "invoiceIdAndRevision",
      "entitlementIdAndRevision",
      "projectIdAndRevision",
      "missionIdAndRevision",
      "workProductIdAndRevision",
      "consentIdAndRevision",
      "permissionDigest",
      "scopeDigest"
    ],
    "credential": "opaque_non_serializing_secret_reference_only",
    "customer": "digest_only_immutable_identity",
    "revisions": "all_resource_and_hartevo_scope_revisions_are_positive_and_digest_bound",
    "exactScope": true,
    "siteBound": true,
    "customerBound": true,
    "subscriptionBound": true,
    "planBound": true,
    "invoiceBound": true,
    "entitlementBound": true,
    "projectBound": true,
    "missionBound": true,
    "workProductBound": true,
    "consentBound": true
  },
  "registration": {
    "versionBound": true,
    "contractVersionBound": true,
    "contractDigestBound": true,
    "providerIdentityBound": true,
    "providerRevisionBound": true,
    "providerDigestBound": true,
    "permissionDigestBound": true,
    "scopeDigestBound": true,
    "evidenceDigestBound": true,
    "projectRevisionBound": true,
    "missionRevisionBound": true,
    "workProductRevisionBound": true,
    "consentRevisionBound": true,
    "reversible": true,
    "revocable": true,
    "failClosedOn": [
      "plugin_version_drift",
      "contract_version_or_digest_drift",
      "provider_identity_or_revision_drift",
      "provider_digest_drift",
      "site_customer_subscription_plan_invoice_entitlement_scope_drift",
      "resource_revision_drift",
      "project_mission_work_product_consent_revision_drift",
      "permission_or_scope_digest_drift",
      "evidence_digest_drift",
      "registration_tamper",
      "registration_revocation",
      "secret_reference_revocation"
    ]
  },
  "bounds": {
    "maxResponseBytes": 1048576,
    "maxPageSize": 50,
    "maxPages": 4,
    "maxRequestsPerMinute": 5,
    "maxRecords": 128,
    "maxCursorBytes": 512,
    "maxIdentifierBytes": 128,
    "maxUsageMetricBytes": 128
  },
  "evidence": {
    "allowlistedFields": [
      "siteId",
      "customerIdDigest",
      "subscriptionId",
      "subscriptionRevision",
      "subscriptionStatus",
      "planId",
      "planRevision",
      "invoiceId",
      "invoiceRevision",
      "invoiceStatus",
      "entitlementId",
      "entitlementRevision",
      "entitlementState",
      "usageMetadata",
      "providerRevision",
      "requestReceiptDigest",
      "responseReceiptDigest",
      "queryDigest",
      "resultDigest",
      "evidenceDigest",
      "registrationDigest",
      "cursorDigest",
      "projectMissionWorkProductConsentScopeDigest"
    ],
    "rawProviderPayload": false,
    "rawCustomerPii": false,
    "rawCustomerEmail": false,
    "rawCustomerName": false,
    "paymentInstruments": false,
    "invoiceLineItems": false,
    "invoiceAmounts": false,
    "planDescription": false,
    "entitlementDescription": false,
    "rawSecretReference": false,
    "rawProviderError": false,
    "financialAdvice": false
  },
  "projections": {
    "observationStates": [
      "complete",
      "absent",
      "denied",
      "partial",
      "expired",
      "access_lost",
      "provider_unknown",
      "rate_limited",
      "tampered"
    ],
    "failClosed": true,
    "partialExplicit": true,
    "cursorExplicit": true,
    "idempotencyExplicit": true,
    "adopted": false,
    "kernelAuthority": false
  },
  "authority": {
    "readOnly": true,
    "proposalOnly": true,
    "subscriptionCreate": false,
    "subscriptionUpdate": false,
    "subscriptionCancel": false,
    "planMutation": false,
    "entitlementMutation": false,
    "invoiceMutation": false,
    "refund": false,
    "externalWrites": false,
    "paymentInstrumentAccess": false,
    "rawCustomerPii": false,
    "financialAdvice": false,
    "receiptAuthority": false,
    "verificationAuthority": false,
    "truthAuthority": false,
    "outcomeAuthority": false,
    "workProductAdoption": false,
    "consentAuthority": false,
    "effectAuthority": false,
    "connected": false,
    "native": false,
    "firstParty": false
  },
  "redaction": {
    "rawProviderPayload": false,
    "rawCustomerPii": false,
    "rawCustomerEmail": false,
    "rawCustomerName": false,
    "paymentInstruments": false,
    "invoiceLineItems": false,
    "invoiceAmounts": false,
    "planDescription": false,
    "entitlementDescription": false,
    "rawSecretReference": false,
    "rawProviderError": false,
    "financialAdvice": false
  },
  "honesty": {
    "nativeStatus": "BLOCKED_ENV",
    "blockedEnvironmentIsNative": false,
    "fixtureIsNative": false,
    "recordingIsNative": false,
    "fakeIsNative": false,
    "loopbackIsNative": false,
    "connectedClaim": false,
    "firstPartyEvidenceClaim": false,
    "financialAdviceClaim": false,
    "layer1Boundary": "Layer 1 retains only bounded immutable identifiers, a digest-only customer identity, typed subscription/entitlement/invoice states, bounded usage metadata, revisions, cursors, and cryptographic receipts. It never resolves live credentials, uses live Chargebee HTTPS, mutates billing resources, exposes payment instruments or raw customer PII, gives financial advice, or adopts Project/Mission/Work Product/Consent/Truth/Outcome/Effect authority."
  },
  "layer2Gaps": [
    "native_credential_resolution",
    "authenticated_connected_chargebee_https_reads",
    "durable_provider_receipts_and_independent_provider_readback",
    "consented_subscription_or_plan_or_entitlement_or_invoice_effects",
    "refunds_and_payment_instrument_handling",
    "host_owned_project_mission_work_product_consent_authority",
    "verified_work_product_or_outcome_adoption"
  ],
  "forbidden": [
    "subscription_create",
    "subscription_update",
    "subscription_cancel",
    "plan_mutation",
    "entitlement_mutation",
    "invoice_mutation",
    "refund",
    "payment_instrument_access",
    "raw_customer_pii_serialization",
    "raw_customer_email_serialization",
    "raw_customer_name_serialization",
    "invoice_line_item_serialization",
    "invoice_amount_serialization",
    "raw_secret_reference_serialization",
    "raw_provider_payload_serialization",
    "connected_or_first_party_claim",
    "financial_advice",
    "kernel_consent_authority",
    "kernel_effect_authority",
    "kernel_outcome_authority"
  ]
}
