{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tangpingqingwa/hartevo-desktop/contracts/plugins/gcp-alloydb-cluster-result/gcp-alloydb-cluster-result.v1.json",
  "title": "Hartevo GCP AlloyDB cluster result Layer-1 contract",
  "description": "A bounded read-only AlloyDB cluster and allowlisted instance posture seam for one exact project, location, cluster, instance, and revision. It is not a database administration plane, data-plane reader, credential authority, or Hartevo kernel authority.",
  "schemaVersion": "hartevo.gcp-alloydb-cluster-result.contract/v1",
  "contractVersion": "gcp-alloydb-cluster-result/v1",
  "pluginVersion": "1.0.0",
  "layer": "Layer-1",
  "officialReferences": [
    "https://docs.cloud.google.com/alloydb/docs/reference/rest/v1/projects.locations.clusters/get",
    "https://docs.cloud.google.com/alloydb/docs/reference/rest/v1/projects.locations.clusters.instances/get",
    "https://docs.cloud.google.com/alloydb/docs/reference/rest"
  ],
  "service": {
    "id": "hartevo.gcp.alloydb.cluster-result",
    "implementation": "GcpAlloyDbClusterResultService",
    "version": "1.0.0",
    "operations": [
      "describe_capabilities",
      "register",
      "revoke_registration",
      "restore_registration",
      "read_bounded",
      "propose",
      "record",
      "verify"
    ],
    "readOnly": true,
    "proposalOnly": true,
    "liveExecution": false,
    "externalWrites": false,
    "kernelAuthority": false
  },
  "provider": {
    "id": "gcp.alloydb.admin",
    "implementation": "GcpAlloyDbAdminProvider",
    "version": "1.0.0",
    "apiRevision": "gcp-alloydb-admin-read-r1",
    "allowlistedOperations": [
      "projects.locations.clusters.get",
      "projects.locations.clusters.instances.get"
    ],
    "allowlistedMethods": ["GET"],
    "acceptedTransports": ["fixture", "recording", "fake", "loopback", "BLOCKED_ENV"],
    "native": false,
    "connected": false,
    "firstParty": false,
    "externalWrites": false,
    "secretReference": "opaque_non_serializing_only",
    "rawProviderPayload": false
  },
  "consumer": {
    "id": "mission.gcp.alloydb.cluster-result",
    "implementation": "MissionGcpAlloyDbClusterConsumer",
    "deploymentBound": true,
    "missionBound": true,
    "projectBound": true,
    "workProductBound": true,
    "revisionBound": true,
    "permissionBound": true,
    "producesDecisionProposal": true,
    "adoptsOutcome": false,
    "adoptsWorkProduct": false,
    "truthAuthority": false,
    "consentAuthority": false,
    "effectAuthority": false,
    "receiptAuthority": false,
    "verificationAuthority": false
  },
  "scope": {
    "required": [
      "project_id_and_revision",
      "location",
      "exactly_one_cluster_id",
      "exactly_one_instance_id",
      "exact_resource_revision",
      "deployment_id_and_revision",
      "mission_id_and_revision",
      "work_product_id_and_revision",
      "permission_revision_and_digest",
      "secret_reference_digest",
      "scope_digest"
    ],
    "target": "exactly_one_project_location_cluster_instance_revision",
    "clusterProjection": [
      "lifecycle_state",
      "cluster_type",
      "availability_type",
      "database_version",
      "instance_count",
      "resource_revision"
    ],
    "instanceProjection": [
      "lifecycle_state",
      "instance_type",
      "availability_type",
      "cpu_count",
      "node_count",
      "resource_revision"
    ],
    "rawProviderPayload": false,
    "connectionInfo": false,
    "endpoints": false,
    "credentials": false,
    "users": false,
    "sqlRows": false,
    "rawBodies": false
  },
  "registration": {
    "pluginVersionBound": true,
    "versionDigestBound": true,
    "contractVersionBound": true,
    "contractDigestBound": true,
    "providerIdBound": true,
    "providerVersionBound": true,
    "providerRevisionBound": true,
    "providerDigestBound": true,
    "apiDigestBound": true,
    "permissionDigestBound": true,
    "scopeDigestBound": true,
    "evidenceDigestBound": true,
    "secretReferenceDigestBound": true,
    "reversible": true,
    "revocable": true,
    "failClosedOn": [
      "plugin_version_drift",
      "provider_or_api_revision_drift",
      "provider_or_contract_digest_drift",
      "permission_or_scope_digest_drift",
      "evidence_digest_drift",
      "secret_reference_revocation",
      "registration_tamper",
      "registration_revocation",
      "scope_drift",
      "resource_revision_drift",
      "pagination_loop",
      "replay_conflict",
      "response_truncation",
      "access_loss",
      "provider_unknown"
    ]
  },
  "bounds": {
    "maxResponseBytes": 1048576,
    "maxPagesPerOperation": 1,
    "maxOperationsPerRead": 2,
    "maxIdentifierBytes": 128,
    "maxPageTokenBytes": 256,
    "maxCpuCount": 1024,
    "maxNodeCount": 64
  },
  "evidence": {
    "states": [
      "ready",
      "stale_revision",
      "scope_drift",
      "permission_loss",
      "access_loss",
      "provider_unknown",
      "tampered",
      "truncated",
      "pagination_loop",
      "registration_revoked",
      "replay_conflict"
    ],
    "requiredDigests": [
      "plugin_version_digest",
      "contract_digest",
      "provider_digest",
      "api_digest",
      "permission_digest",
      "scope_digest",
      "evidence_binding_digest",
      "secret_reference_digest",
      "cluster_response_digest",
      "instance_response_digest",
      "evidence_digest",
      "proposal_digest"
    ],
    "missingOrInsufficientDataFailsClosed": true,
    "partialPostureIsNonAdoptable": true,
    "tamperRejected": true,
    "replayConflictRejected": true,
    "revocationRejected": true
  },
  "redaction": {
    "secretMaterial": false,
    "connectionInfo": false,
    "endpoints": false,
    "credentials": false,
    "users": false,
    "sqlRows": false,
    "rawProviderPayload": false,
    "rawBodies": false,
    "rawPageTokens": false,
    "requestReceiptsRetainDigestsOnly": true,
    "failureMessagesRetainCategoryOnly": true
  },
  "authority": {
    "readOnly": true,
    "proposalOnly": true,
    "externalWrites": false,
    "create": false,
    "patch": false,
    "delete": false,
    "restart": false,
    "failover": false,
    "promote": false,
    "backup": false,
    "restore": false,
    "export": false,
    "import": false,
    "sql": false,
    "userMutation": false,
    "iamMutation": false,
    "connected": false,
    "native": false,
    "firstParty": false,
    "durableProviderReceipt": false,
    "truthAuthority": false,
    "consentAuthority": false,
    "effectAuthority": false,
    "receiptAuthority": false,
    "verificationAuthority": false,
    "outcomeAuthority": false,
    "workProductAdoption": false
  },
  "honesty": {
    "nativeStatus": "BLOCKED_ENV",
    "fixtureIsNative": false,
    "recordingIsNative": false,
    "fakeIsNative": false,
    "loopbackIsNative": false,
    "blockedEnvironmentIsNative": false,
    "fixtureIsConnected": false,
    "recordingIsConnected": false,
    "fakeIsConnected": false,
    "loopbackIsConnected": false,
    "blockedEnvironmentIsConnected": false,
    "layer1Boundary": "Layer-1 emits bounded, redacted external evidence and a Mission decision proposal only. Native GCP credential resolution, HTTPS execution, durable provider receipts, independent readback, consented effects, kernel Truth/Consent/Effect/Receipt/Verification/Outcome authority, and Work Product adoption remain outside this slice."
  },
  "forbidden": [
    "create_cluster",
    "patch_cluster",
    "delete_cluster",
    "restart_cluster",
    "failover_cluster",
    "promote_instance",
    "create_instance",
    "patch_instance",
    "delete_instance",
    "create_backup",
    "restore_backup",
    "export_backup",
    "import_backup",
    "execute_sql",
    "read_sql_rows",
    "mutate_users",
    "mutate_iam",
    "read_connection_info",
    "read_endpoints",
    "read_credentials",
    "serialize_raw_provider_body",
    "claim_connected",
    "claim_native",
    "claim_first_party",
    "claim_durable_provider_receipt",
    "claim_truth_consent_effect_receipt_verification_outcome_authority",
    "adopt_work_product"
  ],
  "layer2Gaps": [
    "native GCP authentication and HTTPS transport",
    "durable provider receipt",
    "independent post-readback reconciliation",
    "consented AlloyDB effects and administration",
    "database data-plane access",
    "verified Work Product adoption",
    "Hartevo Truth, Consent, Effect, Receipt, Verification, and Outcome authority"
  ]
}
