{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tangpingqingwa/hartevo-desktop/contracts/plugins/aws-cloudwatch-alarm-result/contract.v1.json",
  "title": "Hartevo AWS CloudWatch alarm result Layer-1 contract",
  "description": "A bounded, read/proposal/record/verify-only CloudWatch alarm evidence seam. It never executes alarm actions, mutates alarms or dashboards, retrieves logs, scans arbitrary metrics, or certifies production SLOs or Outcomes.",
  "schemaVersion": "hartevo.aws-cloudwatch-alarm-result/v1",
  "contractVersion": "EXT-AWS-CLOUDWATCH-ALARM-01-L1/v1",
  "pluginId": "aws.cloudwatch.alarm-result",
  "pluginVersion": "1.0.0",
  "layer": 1,
  "evidenceLevel": "L1_PROVIDER_CONTRACT",
  "status": "read_proposal_recording_only",
  "officialReferences": [
    "https://docs.aws.amazon.com/AmazonCloudWatch/latest/APIReference/API_DescribeAlarms.html",
    "https://docs.aws.amazon.com/AmazonCloudWatch/latest/APIReference/API_GetMetricData.html",
    "https://docs.aws.amazon.com/AmazonCloudWatch/latest/APIReference/API_ListMetrics.html"
  ],
  "service": {
    "type": "AwsCloudWatchAlarmService",
    "id": "aws.cloudwatch.alarm-result.read",
    "operations": [
      "describe_capabilities",
      "register",
      "revoke_registration",
      "reverse_registration",
      "restore_registration",
      "read_bounded",
      "propose",
      "record",
      "verify"
    ],
    "readOnly": true,
    "proposalOnly": true,
    "recordingOnly": true,
    "liveExecution": false,
    "externalWrites": false,
    "kernelAuthority": false,
    "outcomeAdoption": false,
    "productionSloCertification": false
  },
  "provider": {
    "type": "AwsCloudWatchProvider",
    "id": "aws.cloudwatch.alarm-result.recording",
    "apiRevision": "cloudwatch-describe-alarms-get-metric-data-list-metrics-1",
    "operations": [
      "DescribeAlarms",
      "GetMetricData",
      "ListMetrics"
    ],
    "allowlistedOperations": [
      "DescribeAlarms",
      "GetMetricData",
      "ListMetrics"
    ],
    "allowlistedMethods": ["POST"],
    "allowedTransportProvenance": [
      "recording",
      "fixture",
      "loopback",
      "BLOCKED_ENV"
    ],
    "native": false,
    "connected": false,
    "firstParty": false,
    "externalWrites": false,
    "providerReceipt": false,
    "sigV4Secret": "opaque_non_serializing_secret_reference_only"
  },
  "consumer": {
    "type": "MissionAwsCloudWatchConsumer",
    "id": "mission.aws-cloudwatch-alarm.consumer",
    "deploymentBound": true,
    "missionBound": true,
    "projectBound": true,
    "workProductBound": true,
    "revisionBound": true,
    "permissionBound": true,
    "scopeBound": true,
    "producesDecisionProposal": true,
    "adoptsOutcome": false,
    "truthAuthority": false,
    "certificationAuthority": false,
    "productionSloCertification": false
  },
  "credentials": {
    "scheme": "aws_sigv4",
    "boundary": "opaque SigV4 SecretReference",
    "serialized": false,
    "debugRedacted": true,
    "rawMaterialAccepted": false,
    "resolvedByLayer": 2
  },
  "scope": {
    "required": [
      "deployment_id_and_revision",
      "mission_id_and_revision",
      "project_id_and_revision",
      "work_product_id_and_revision",
      "exact_account_and_region",
      "exact_alarm_name_and_revision",
      "exact_metric_identity_and_dimension_digest",
      "bounded_start_and_end_window",
      "permission_digest",
      "secret_reference_digest",
      "scope_digest"
    ],
    "target": "exactly_one_account_region_alarm_metric_window",
    "metricDiscovery": "optional_exact_metric_filter_only",
    "rawDimensions": false,
    "rawPayload": false,
    "rawLogs": false,
    "rawAlarmActions": false,
    "dashboards": false
  },
  "registration": {
    "pluginVersionBound": true,
    "contractVersionBound": true,
    "contractDigestBound": true,
    "providerIdBound": true,
    "providerVersionBound": true,
    "providerRevisionBound": true,
    "providerDigestBound": true,
    "apiDigestBound": true,
    "permissionDigestBound": true,
    "scopeDigestBound": true,
    "queryDigestBound": true,
    "evidenceDigestBound": true,
    "secretReferenceDigestBound": true,
    "reversible": true,
    "revocable": true,
    "failClosedOn": [
      "plugin_version_drift",
      "contract_digest_drift",
      "provider_or_api_revision_drift",
      "permission_or_scope_digest_drift",
      "query_or_window_drift",
      "alarm_or_metric_revision_drift",
      "evidence_digest_drift",
      "secret_reference_revocation",
      "registration_tamper",
      "registration_revocation",
      "cursor_or_scan_replay",
      "empty_or_partial_evidence",
      "access_loss",
      "stale_read"
    ]
  },
  "bounds": {
    "maxResponseBytes": 1048576,
    "maxPages": 4,
    "maxRequestsPerRead": 8,
    "maxRetries": 2,
    "maxPageSize": 100,
    "maxWindowSeconds": 86400,
    "maxDatapoints": 1000,
    "maxMetricResults": 8,
    "maxReceipts": 8,
    "maxIdentifierBytes": 255,
    "maxProviderErrors": 8
  },
  "evidence": {
    "alarmStates": ["OK", "ALARM", "INSUFFICIENT_DATA"],
    "failureStates": [
      "partial",
      "empty",
      "stale",
      "access_loss",
      "provider_unknown",
      "registration_revoked",
      "tampered"
    ],
    "digests": [
      "plugin_version",
      "contract",
      "provider",
      "api",
      "permission",
      "scope",
      "query",
      "alarm",
      "metric",
      "window",
      "request",
      "cost",
      "evidence",
      "proposal",
      "record"
    ],
    "retained": [
      "alarm_name_and_revision",
      "alarm_state",
      "state_updated_timestamp",
      "alarm_configuration_updated_timestamp",
      "threshold",
      "comparison_operator",
      "evaluation_periods",
      "datapoints_to_alarm",
      "period_seconds",
      "treat_missing_data",
      "metric_namespace_and_name",
      "metric_statistic_and_period",
      "dimension_digest",
      "bounded_datapoint_aggregates",
      "datapoint_digest",
      "redacted_request_receipts",
      "redacted_cost_receipts"
    ],
    "notRetained": [
      "secret_material",
      "raw_next_token",
      "raw_provider_payload",
      "raw_dimensions",
      "alarm_actions",
      "dashboard_definitions",
      "logs",
      "unbounded_datapoints",
      "error_messages"
    ],
    "emptyPartialAccessLossNonAdoptable": true,
    "insufficientDataIsNotCertification": true
  },
  "redaction": {
    "secretMaterial": false,
    "rawNextToken": false,
    "rawProviderPayload": false,
    "rawDimensions": false,
    "rawAlarmActions": false,
    "dashboards": false,
    "logs": false,
    "unboundedDatapoints": false,
    "errorMessages": false,
    "requestUri": false,
    "costDetails": "bounded_digest_and_units_only"
  },
  "authorityBoundary": {
    "owns": [
      "typed exact CloudWatch alarm/account/region scope",
      "bounded DescribeAlarms read",
      "bounded GetMetricData window read",
      "optional exact-filter ListMetrics discovery",
      "OK/ALARM/INSUFFICIENT_DATA projection",
      "bounded threshold/evaluation/metric/datapoint projection",
      "version/provider/api/permission/scope/query/evidence digests",
      "reversible and revocable registration",
      "redacted request and cost receipts",
      "Mission decision proposal below kernel authority"
    ],
    "doesNotOwn": [
      "Hartevo Truth authority",
      "Hartevo Effect authority",
      "Hartevo Receipt authority",
      "Hartevo Verification authority",
      "Hartevo Outcome authority",
      "production SLO certification",
      "native SigV4 credential resolution",
      "live AWS HTTPS",
      "alarm create/update/delete",
      "alarm-action execution",
      "PutMetricData",
      "dashboard mutation",
      "log retrieval",
      "arbitrary metric scanning",
      "raw dimensions or unbounded datapoints",
      "verified Work Product adoption"
    ]
  },
  "provenance": {
    "recording": "non_native_non_connected_non_first_party",
    "fixture": "non_native_non_connected_non_first_party",
    "loopback": "non_native_non_connected_non_first_party",
    "blockedEnv": "non_native_non_connected_non_first_party",
    "connectedClaim": false,
    "nativeClaim": false,
    "firstPartyClaim": false,
    "providerReceipt": false,
    "blockedEnvironmentIsNative": false
  },
  "layer2Gaps": [
    "native_sigv4_transport_and_credential_resolution",
    "live_DescribeAlarms_GetMetricData_ListMetrics_https",
    "durable_provider_receipt",
    "independent_post_readback",
    "consented_alarm_effects_or_alarm_action_execution",
    "connected_native_first_party_evidence",
    "production_slo_certification",
    "Hartevo_Outcome_or_Work_Product_adoption"
  ],
  "forbidden": [
    "PutMetricData",
    "PutMetricAlarm",
    "DeleteAlarms",
    "alarm_create_update_delete",
    "alarm_action_execution",
    "dashboard_mutation",
    "log_retrieval",
    "arbitrary_metric_scan",
    "raw_dimension_retention",
    "unbounded_datapoint_retention",
    "resolve_live_credentials",
    "claim_connected",
    "claim_native",
    "claim_first_party",
    "claim_production_slo",
    "claim_outcome_certification",
    "adopt_kernel_outcome"
  ]
}
