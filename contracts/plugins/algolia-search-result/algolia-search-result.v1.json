{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hartevo.local/contracts/plugins/algolia-search-result/algolia-search-result.v1.json",
  "title": "Hartevo Algolia search-quality result Layer-1 contract",
  "description": "Bounded aggregate Algolia Analytics evidence for a Mission decision; not a search, event, dashboard, relevance, or Outcome authority.",
  "schemaVersion": "hartevo.algolia-search-result/v1",
  "contractVersion": "algolia-search-result-e1/v1",
  "pluginVersion": "0.1.0",
  "layer": 1,
  "authority": {
    "readOnly": true,
    "proposalOnly": true,
    "connected": false,
    "nativeProvider": false,
    "durableReceipt": false,
    "kernelAuthority": false,
    "outcomeAuthority": false,
    "genericAnalyticsEngine": false,
    "relevanceCausalityAuthority": false,
    "contentQualityAuthority": false,
    "purchaseIntentAuthority": false,
    "externalWrites": false
  },
  "typedSurface": {
    "service": "AlgoliaSearchQualityService",
    "provider": "AlgoliaAnalyticsProvider",
    "consumer": "MissionAlgoliaSearchConsumer",
    "models": [
      "AlgoliaSearchQualityScope",
      "AlgoliaRegion",
      "AnalyticsWindow",
      "AlgoliaSearchQualityMetric",
      "AnalyticsTag",
      "ProjectBinding",
      "MissionBinding",
      "WorkProductBinding",
      "ConsentScope",
      "SecretReference",
      "AlgoliaAnalyticsAcl",
      "AlgoliaRegistration",
      "AlgoliaSearchQualityEvidence",
      "AlgoliaSearchQualityProposal"
    ]
  },
  "service": {
    "id": "algolia.search-quality.result",
    "name": "AlgoliaSearchQualityService",
    "version": "1.0.0",
    "access": "read_only",
    "operations": [
      "issue_read_consent",
      "read_aggregate_metric",
      "compile_search_quality_proposal",
      "record_observation_receipt",
      "verify_proposal",
      "revoke_registration",
      "restore_registration"
    ],
    "externalWrites": false,
    "liveExternalIo": false
  },
  "provider": {
    "id": "algolia.analytics.search-quality",
    "name": "AlgoliaAnalyticsProvider",
    "version": "1.0.0",
    "apiRevision": "algolia-analytics-api-v2",
    "apis": ["algolia_analytics_v2"],
    "regionHosts": {
      "us": "https://analytics.us.algolia.com",
      "de": "https://analytics.de.algolia.com"
    },
    "allowlistedGetPaths": [
      "/2/searches/count",
      "/2/searches/noResultRate",
      "/2/clicks/clickThroughRate",
      "/2/conversions/conversionRate"
    ],
    "requiredAcl": "analytics",
    "authentication": ["opaque_secret_reference"],
    "transportProvenance": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
    "maxRequestsPerMinute": 100,
    "maxResponseBytes": 1048576,
    "rawApiKey": false,
    "rawResponseBody": false,
    "rawQueryTerms": false,
    "rawUserTokens": false,
    "rawIpDerivedIdentifiers": false,
    "rawTags": false,
    "rawObjectIds": false,
    "rawEventPayloads": false,
    "reversible": true,
    "revocable": true,
    "native": false,
    "connected": false
  },
  "consumer": {
    "id": "mission.algolia.search-quality",
    "name": "MissionAlgoliaSearchConsumer",
    "kind": "mission_search_quality_projection",
    "scope": [
      "project",
      "mission",
      "work_product",
      "region",
      "application",
      "index",
      "index_revision",
      "analytics_window",
      "metric",
      "tag_digest",
      "consent_digest",
      "mission_revision",
      "work_product_revision",
      "source_evidence_digest"
    ],
    "adoptsOutcome": false,
    "kernelAuthority": false,
    "truthAuthority": false
  },
  "exactScope": [
    "region",
    "application",
    "index",
    "index_revision",
    "analytics_window",
    "metric",
    "tag",
    "project",
    "mission",
    "work_product",
    "consent"
  ],
  "allowlist": {
    "reads": [
      {
        "operation": "search_count",
        "method": "GET",
        "path": "/2/searches/count",
        "requiredAcl": "analytics",
        "aggregateOnly": true
      },
      {
        "operation": "no_result_rate",
        "method": "GET",
        "path": "/2/searches/noResultRate",
        "requiredAcl": "analytics",
        "aggregateOnly": true
      },
      {
        "operation": "click_through_rate",
        "method": "GET",
        "path": "/2/clicks/clickThroughRate",
        "requiredAcl": "analytics",
        "aggregateOnly": true
      },
      {
        "operation": "conversion_rate",
        "method": "GET",
        "path": "/2/conversions/conversionRate",
        "requiredAcl": "analytics",
        "aggregateOnly": true
      }
    ],
    "writes": [],
    "forbidden": [
      "index_mutation",
      "record_mutation",
      "settings_mutation",
      "rule_mutation",
      "synonym_mutation",
      "event_ingestion",
      "a_b_test_mutation",
      "dashboard_ui",
      "generic_search_registry",
      "raw_query_export",
      "raw_user_token_export",
      "raw_ip_derived_identifier_export",
      "raw_tag_export",
      "raw_object_id_export",
      "raw_event_payload_export",
      "content_quality_claim",
      "relevance_causality_claim",
      "purchase_intent_claim",
      "business_success_claim",
      "kernel_receipt",
      "kernel_outcome_authority",
      "verified_work_product_adoption"
    ]
  },
  "authentication": {
    "boundary": "opaque SecretReference",
    "requiredAcl": "analytics",
    "rawCredentialSerialized": false,
    "rawCredentialDebug": false,
    "rawCredentialRequest": false,
    "rawCredentialReceipt": false,
    "resolvedByLayer": 2
  },
  "bounds": {
    "maxAnalyticsWindowDays": 31,
    "maxTags": 4,
    "maxTagBytes": 128,
    "maxIdentifierBytes": 128,
    "maxResponseBytes": 1048576,
    "maxDailyPoints": 31,
    "maxRequestsPerMinute": 100,
    "maxRetryAfterSeconds": 3600,
    "maxDiagnosticBytes": 512
  },
  "normalization": {
    "aggregateCounts": true,
    "aggregateRates": true,
    "dailyDates": true,
    "responseOrderIndependent": true,
    "queryTerms": "redacted_to_digest_or_dropped",
    "userTokens": "redacted_to_digest_or_dropped",
    "ipDerivedIdentifiers": "redacted_to_digest_or_dropped",
    "tags": "redacted_to_digest",
    "objectIds": "dropped",
    "eventPayloads": "dropped",
    "rawJson": false,
    "states": [
      "complete",
      "partial",
      "empty",
      "plan_unavailable",
      "rate_limited",
      "access_lost",
      "provider_unknown"
    ],
    "emptyIsSuccess": false,
    "rateIsProviderReported": true,
    "causalClaims": false
  },
  "digests": {
    "version": true,
    "contract": true,
    "provider": true,
    "acl": true,
    "scope": true,
    "privacy": true,
    "registration": true,
    "index": true,
    "analyticsWindow": true,
    "metric": true,
    "query": true,
    "result": true,
    "response": true
  },
  "registration": {
    "versionBound": true,
    "contractDigestBound": true,
    "providerDigestBound": true,
    "aclDigestBound": true,
    "scopeDigestBound": true,
    "privacyDigestBound": true,
    "secretReferenceDigestBound": true,
    "registrationDigestBound": true,
    "reversible": true,
    "revocable": true,
    "rotationOnStateChange": true,
    "failClosedOn": [
      "version_drift",
      "contract_drift",
      "provider_drift",
      "acl_drift",
      "region_drift",
      "application_drift",
      "index_drift",
      "index_revision_drift",
      "analytics_window_drift",
      "metric_drift",
      "tag_scope_drift",
      "project_drift",
      "mission_stale",
      "work_product_drift",
      "consent_drift",
      "privacy_digest_drift",
      "registration_revocation",
      "replay"
    ]
  },
  "receipts": {
    "rateLimit": ["limitPerMinute", "remaining", "retryAfterSeconds", "throttled"],
    "observation": true,
    "durableNativeReceipt": false,
    "rawHeaders": false,
    "rawResponseBody": false
  },
  "honesty": {
    "fixtureNative": false,
    "recordingNative": false,
    "loopbackNative": false,
    "blockedEnvNative": false,
    "fixtureConnected": false,
    "recordingConnected": false,
    "loopbackConnected": false,
    "blockedEnvConnected": false,
    "nativeHttpsTransport": "layer_2_gap",
    "nativeCredentialResolution": "layer_2_gap",
    "nativeReadback": "layer_2_gap",
    "workProductAdoption": "layer_2_gap",
    "absenceIsSuccess": false,
    "emptyIsSuccess": false,
    "rateIsQualityTruth": false,
    "rateIsCausalTruth": false,
    "rateIsPurchaseIntent": false
  },
  "authorityBoundary": {
    "externalRead": "typed_bounded_aggregate_get_only",
    "externalWrite": false,
    "indexManagement": false,
    "recordManagement": false,
    "eventIngestion": false,
    "aBTestMutation": false,
    "dashboard": false,
    "genericCatalog": false,
    "connected": false,
    "native": false,
    "kernelOutcome": false,
    "truth": false,
    "consentAuthority": false
  },
  "distinction": {
    "notPineconeRetrieval": true,
    "notOpenSearchRetrieval": true,
    "notClarityUxAggregate": true,
    "notPostHogObservability": true,
    "notAmplitudeExperiment": true,
    "providerDomain": "Algolia Analytics search-quality aggregates only"
  },
  "documentation": [
    "https://www.algolia.com/doc/rest-api/analytics",
    "https://www.algolia.com/doc/rest-api/analytics/get-searches-count",
    "https://www.algolia.com/doc/rest-api/analytics/get-no-results-rate",
    "https://www.algolia.com/doc/rest-api/analytics/get-click-through-rate",
    "https://www.algolia.com/doc/rest-api/analytics/get-conversion-rate",
    "https://www.algolia.com/doc/guides/search-analytics/concepts/metrics"
  ],
  "errorHandling": [
    "HTTP_400",
    "HTTP_401",
    "HTTP_402_PLAN_UNAVAILABLE",
    "HTTP_403_ANALYTICS_ACL_OR_ACCESS",
    "HTTP_404",
    "HTTP_429_RATE_LIMITED",
    "HTTP_5XX",
    "BLOCKED_ENV",
    "MALFORMED_RESPONSE",
    "RESPONSE_TOO_LARGE",
    "RESPONSE_REORDER_NORMALIZED",
    "RESPONSE_TRUNCATION_PARTIAL",
    "REGION_MISMATCH",
    "INVALID_WINDOW",
    "INVALID_TAG",
    "TAMPER",
    "REPLAY",
    "REVOCATION"
  ],
  "layer2Gaps": [
    "native_secret_resolution",
    "native_algolia_https_transport",
    "durable_native_provider_receipt",
    "independent_native_readback",
    "event_ingestion",
    "index_or_record_mutation",
    "settings_rules_synonyms_mutation",
    "a_b_test_mutation",
    "raw_query_or_user_token_export",
    "kernel_outcome_persistence",
    "verified_work_product_adoption"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "$id",
    "schemaVersion",
    "contractVersion",
    "pluginVersion",
    "layer",
    "authority",
    "typedSurface",
    "service",
    "provider",
    "consumer",
    "exactScope",
    "allowlist",
    "authentication",
    "bounds",
    "normalization",
    "digests",
    "registration",
    "receipts",
    "honesty",
    "authorityBoundary",
    "distinction",
    "documentation",
    "errorHandling",
    "layer2Gaps"
  ]
}
