{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tangpingqingwa/hartevo-desktop/contracts/plugins/aws-synthetics-canary-result/aws-synthetics-canary-result.v1.json",
  "title": "Hartevo AWS CloudWatch Synthetics canary-run result Layer-1 contract",
  "description": "A bounded, read/proposal/record/verify-only AWS CloudWatch Synthetics canary-run seam that emits a non-authoritative Mission endpoint-verification decision proposal. It is not a native AWS transport, canary controller, endpoint mutator, certification authority, or Hartevo Truth authority.",
  "schemaVersion": "hartevo.aws-synthetics-canary-result.contract/v1",
  "contractVersion": "aws-synthetics-canary-result/v1",
  "pluginVersion": "1.0.0",
  "layer": "Layer-1",
  "officialReferences": [
    "https://docs.aws.amazon.com/synthetics/latest/APIReference/API_GetCanaryRuns.html",
    "https://docs.aws.amazon.com/synthetics/latest/APIReference/API_GetCanary.html",
    "https://docs.aws.amazon.com/synthetics/latest/dg/CloudWatch_Synthetics_Canaries.html"
  ],
  "service": {
    "id": "hartevo.aws.synthetics.canary-result",
    "implementation": "AwsSyntheticsCanaryService",
    "version": "1.0.0",
    "operations": [
      "describe_capabilities",
      "register",
      "revoke_registration",
      "read_bounded",
      "propose",
      "record",
      "verify"
    ],
    "readOnly": true,
    "proposalOnly": true,
    "liveExecution": false,
    "externalWrites": false
  },
  "provider": {
    "id": "aws.synthetics",
    "implementation": "AwsSyntheticsProvider",
    "version": "1.0.0",
    "apiRevision": "aws-synthetics-read-r1",
    "allowlistedOperations": ["GetCanaryRuns"],
    "allowlistedMethods": ["POST"],
    "acceptedTransports": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
    "native": false,
    "connected": false,
    "firstParty": false,
    "externalWrites": false,
    "sigV4Secret": "opaque_non_serializing_secret_reference_only",
    "rawCanaryConfiguration": false,
    "rawProviderPayload": false
  },
  "consumer": {
    "id": "mission.aws.synthetics.endpoint-verification",
    "implementation": "MissionAwsSyntheticsConsumer",
    "version": "1.0.0",
    "deploymentBound": true,
    "missionBound": true,
    "projectBound": true,
    "workProductBound": true,
    "revisionBound": true,
    "permissionBound": true,
    "producesDecisionProposal": true,
    "decisionRequiresHumanReview": true,
    "adoptsOutcome": false,
    "truthAuthority": false,
    "verificationAuthority": false,
    "certificationAuthority": false
  },
  "scope": {
    "required": [
      "deployment_id_and_revision",
      "mission_id_and_revision",
      "project_id_and_revision",
      "work_product_id_and_revision",
      "exact_account_and_region",
      "exact_canary_name_and_revision",
      "exact_endpoint_id_and_digest",
      "get_canary_runs_permission_digest",
      "opaque_secret_reference_digest",
      "scope_digest"
    ],
    "target": "exactly_one_account_region_canary_endpoint_digest",
    "secret": "opaque_non_serializing_sigv4_reference_only",
    "endpointUrl": "not_retained_or_serialized",
    "rawCanaryConfiguration": false,
    "rawRunPayload": false,
    "rawArtifactLocation": false,
    "rawEnvironmentValues": false
  },
  "registration": {
    "pluginVersionBound": true,
    "providerIdBound": true,
    "providerVersionBound": true,
    "providerRevisionBound": true,
    "providerDigestBound": true,
    "apiDigestBound": true,
    "contractVersionBound": true,
    "contractDigestBound": true,
    "permissionDigestBound": true,
    "scopeDigestBound": true,
    "evidenceDigestBound": true,
    "secretReferenceDigestBound": true,
    "registrationDigestBound": true,
    "reversible": true,
    "revocable": true,
    "failClosedOn": [
      "plugin_version_drift",
      "provider_or_api_revision_drift",
      "provider_or_contract_digest_drift",
      "permission_or_scope_digest_drift",
      "evidence_digest_drift",
      "secret_reference_revocation_or_drift",
      "registration_tamper",
      "registration_revocation",
      "cursor_or_filter_replay",
      "pagination_loop",
      "stale_canary_revision",
      "endpoint_scope_mismatch"
    ]
  },
  "bounds": {
    "maxResponseBytes": 1048576,
    "maxPages": 4,
    "pageSize": 50,
    "maxRuns": 128,
    "maxRunsPerPage": 50,
    "maxRequestsPerRead": 6,
    "maxRetries": 2,
    "maxIdentifierBytes": 128,
    "maxCursorBytes": 512
  },
  "evidence": {
    "states": [
      "passed",
      "failed",
      "running",
      "stopped",
      "unknown",
      "partial",
      "access_loss",
      "throttled",
      "timeout",
      "provider_unknown"
    ],
    "digests": [
      "plugin_version",
      "provider",
      "api",
      "contract",
      "permission",
      "scope",
      "query",
      "run",
      "page",
      "evidence",
      "proposal",
      "record",
      "decision"
    ],
    "retained": [
      "canary_name",
      "canary_revision",
      "endpoint_digest",
      "run_id",
      "run_revision",
      "outcome",
      "started_at",
      "completed_at",
      "ordering_timestamp",
      "page_digest",
      "provider_error_kind"
    ],
    "notRetained": [
      "endpoint_url",
      "canary_code",
      "artifact_s3_location",
      "execution_role_arn",
      "vpc_configuration",
      "raw_provider_payload",
      "raw_next_token",
      "credential_material",
      "provider_error_message",
      "environment_values"
    ],
    "missingOrInsufficientDataFailsClosed": true,
    "passedIsObservationNotCertification": true
  },
  "redaction": {
    "secretMaterial": false,
    "rawNextToken": false,
    "rawProviderPayload": false,
    "endpointUrl": false,
    "canaryCode": false,
    "artifactLocation": false,
    "executionRole": false,
    "vpcConfiguration": false,
    "environmentValues": false,
    "errorMessages": false
  },
  "authority": {
    "readOnly": true,
    "proposalOnly": true,
    "externalWrites": false,
    "canaryMutation": false,
    "endpointMutation": false,
    "credentialResolution": false,
    "endpointVerificationAuthority": false,
    "certification": false,
    "connected": false,
    "native": false,
    "firstParty": false,
    "durableReceipt": false,
    "kernelOutcomeAdoption": false,
    "mcp": false
  },
  "honesty": {
    "nativeStatus": "BLOCKED_ENV",
    "blockedEnvironmentIsNative": false,
    "fixtureIsNative": false,
    "recordingIsNative": false,
    "loopbackIsNative": false,
    "firstPartyClaim": false,
    "passedIsEndpointCertification": false,
    "decisionIsTruthAuthority": false,
    "layer1Boundary": "Layer 1 emits bounded external canary-run evidence and a Mission endpoint-verification decision proposal only. Native SigV4 execution, durable provider receipts, independent endpoint readback, canary lifecycle effects, consented remediation, verified Work Product adoption, and endpoint certification remain Layer-2 host authority."
  },
  "layer2Gaps": [
    "native_sigv4_transport_and_credential_resolution",
    "durable_provider_receipt",
    "independent_endpoint_readback",
    "canary_configuration_and_code_provenance",
    "consented_canary_or_endpoint_effects",
    "verified_work_product_adoption",
    "endpoint_verification_and_certification_authority"
  ],
  "forbidden": [
    "create_canary",
    "update_canary",
    "delete_canary",
    "start_canary",
    "stop_canary",
    "mutate_endpoint",
    "resolve_live_credentials",
    "serialize_endpoint_url",
    "serialize_canary_code",
    "retain_artifact_locations",
    "retain_execution_role_or_vpc_configuration",
    "serialize_raw_provider_payload",
    "serialize_raw_next_token",
    "claim_connected",
    "claim_native",
    "claim_first_party",
    "claim_endpoint_certification",
    "adopt_kernel_outcome",
    "declare_authoritative_verification"
  ]
}
