{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tangpingqingwa/hartevo-desktop/contracts/plugins/aws-msk-result/aws-msk-result.v1.json",
  "title": "Hartevo AWS MSK governed cluster and streaming-health result Layer-1 contract",
  "description": "A bounded, read/proposal/record/verify-only Amazon MSK seam. It projects managed Kafka cluster, configuration and operation readiness without reading records, exposing broker endpoints, resolving credentials or mutating AWS.",
  "schemaVersion": "hartevo.aws-msk-result.contract/v1",
  "contractVersion": "aws-msk-result/v1",
  "pluginVersion": "1.0.0",
  "layer": "Layer-1",
  "officialReferences": [
    "https://docs.aws.amazon.com/msk/2.0/APIReference/welcome.html",
    "https://docs.aws.amazon.com/msk/2.0/APIReference/clusters.html",
    "https://docs.aws.amazon.com/msk/2.0/APIReference/operations.html",
    "https://docs.aws.amazon.com/msk/1.0/apireference/clusters-clusterarn.html"
  ],
  "service": {
    "id": "hartevo.aws.msk.result",
    "implementation": "AwsMskService",
    "version": "1.0.0",
    "operations": [
      "describe_capabilities",
      "register",
      "revoke_registration",
      "read_bounded",
      "propose",
      "record",
      "verify"
    ],
    "readOnly": true,
    "proposalOnly": true,
    "liveExecution": false
  },
  "provider": {
    "id": "aws.msk",
    "implementation": "AwsMskProvider",
    "version": "1.0.0",
    "apiRevision": "aws-msk-read-r1",
    "allowlistedOperations": [
      "ListClustersV2",
      "DescribeClusterV2",
      "DescribeConfigurationRevision",
      "ListClusterOperations"
    ],
    "allowlistedMethods": ["GET"],
    "acceptedTransports": ["fixture", "fake", "recording", "loopback", "BLOCKED_ENV"],
    "native": false,
    "connected": false,
    "firstParty": false,
    "externalWrites": false,
    "sigV4Secret": "opaque_non_serializing_secret_reference_only"
  },
  "consumer": {
    "id": "mission.aws.msk.result",
    "implementation": "MissionAwsMskConsumer",
    "version": "1.0.0",
    "deploymentBound": true,
    "missionBound": true,
    "projectBound": true,
    "workProductBound": true,
    "clusterBound": true,
    "configurationBound": true,
    "operationBound": true,
    "revisionBound": true,
    "permissionBound": true,
    "producesDecisionProposal": true,
    "adoptsOutcome": false,
    "truthAuthority": false,
    "certificationAuthority": false
  },
  "scope": {
    "required": [
      "deployment_id_and_revision",
      "mission_id_and_revision",
      "project_id_and_revision",
      "work_product_id_and_revision",
      "exact_account_and_region",
      "cluster_arn_name_type_kafka_version_and_revision",
      "configuration_arn_and_revision",
      "operation_allowlist_and_revision",
      "permission_digest",
      "secret_reference_digest",
      "scope_digest"
    ],
    "target": "exactly_one_account_and_region",
    "secret": "opaque_non_serializing_sigv4_reference_only",
    "clusterReplacement": "fail_closed",
    "bootstrapEndpoints": false,
    "brokerAddresses": false,
    "topicPartitionRecordData": false,
    "rawConfigurationProperties": false,
    "rawOperationMessages": false
  },
  "registration": {
    "pluginVersionBound": true,
    "providerIdBound": true,
    "providerVersionBound": true,
    "providerRevisionBound": true,
    "providerDigestBound": true,
    "apiDigestBound": true,
    "contractVersionBound": true,
    "contractDigestBound": true,
    "permissionDigestBound": true,
    "scopeDigestBound": true,
    "evidenceDigestBound": true,
    "secretReferenceDigestBound": true,
    "clusterRevisionBound": true,
    "configurationRevisionBound": true,
    "operationRevisionBound": true,
    "reversible": true,
    "revocable": true,
    "failClosedOn": [
      "plugin_version_drift",
      "provider_or_api_revision_drift",
      "provider_or_contract_digest_drift",
      "permission_or_scope_digest_drift",
      "evidence_policy_drift",
      "secret_reference_revocation",
      "registration_tamper",
      "registration_revocation",
      "cluster_replacement_or_revision_drift",
      "configuration_revision_drift",
      "operation_revision_drift",
      "marker_or_filter_replay",
      "marker_expiry"
    ]
  },
  "bounds": {
    "maxResponseBytes": 1048576,
    "maxPages": 4,
    "pageSize": 50,
    "maxClusters": 64,
    "maxOperations": 128,
    "maxRequestsPerRead": 8,
    "maxRetries": 2,
    "maxIdentifierBytes": 128,
    "maxOpaqueMarkerBytes": 512
  },
  "evidence": {
    "states": [
      "ready",
      "not_ready",
      "partial",
      "insufficient_data",
      "access_loss",
      "provider_unknown"
    ],
    "readinessProjections": [
      "cluster",
      "configuration",
      "operations"
    ],
    "digests": [
      "plugin_version",
      "provider",
      "api",
      "contract",
      "permission",
      "scope",
      "cluster",
      "configuration",
      "operations",
      "evidence",
      "proposal",
      "record"
    ],
    "retained": [
      "cluster_arn_and_name",
      "cluster_type",
      "kafka_version",
      "cluster_state",
      "broker_count_class",
      "encryption_and_auth_posture_classes",
      "configuration_arn_and_revision",
      "configuration_readiness",
      "operation_id_type_state_and_timestamps",
      "provider_error_class_and_status"
    ],
    "notRetained": [
      "bootstrap_broker_endpoints",
      "broker_addresses",
      "topic_names",
      "partition_data",
      "record_data",
      "raw_configuration_properties",
      "raw_operation_messages",
      "credentials",
      "opaque_markers"
    ],
    "missingOrInsufficientDataFailsClosed": true
  },
  "redaction": {
    "secretMaterial": false,
    "rawNextTokenOrMarker": false,
    "rawProviderPayload": false,
    "bootstrapEndpoints": false,
    "brokerAddresses": false,
    "topicPartitionRecordData": false,
    "configurationProperties": false,
    "operationMessages": false,
    "errorMessages": false
  },
  "authority": {
    "readOnly": true,
    "proposalOnly": true,
    "externalWrites": false,
    "clusterMutation": false,
    "configurationMutation": false,
    "operationMutation": false,
    "topicMutation": false,
    "recordRead": false,
    "credentialResolution": false,
    "nativeTransport": false,
    "connected": false,
    "native": false,
    "firstParty": false,
    "durableReceipt": false,
    "independentNativeReread": false,
    "kernelOutcomeAdoption": false,
    "workProductAdoption": false,
    "certification": false
  },
  "honesty": {
    "nativeStatus": "BLOCKED_ENV",
    "blockedEnvironmentIsNative": false,
    "fixtureIsNative": false,
    "fakeIsNative": false,
    "recordingIsNative": false,
    "loopbackIsNative": false,
    "readyIsCertification": false,
    "layer1Boundary": "Layer 1 emits bounded, redacted external evidence and a Mission decision proposal only. Native SigV4/HTTPS, host-owned Consent/Effect/Receipt/Verification, independent post-deployment reread and verified Work Product adoption remain Layer-2 exits."
  },
  "layer2Gaps": [
    "native_sigv4_transport_and_credential_resolution",
    "durable_native_provider_receipt",
    "independent_post_deployment_readback",
    "consented_cluster_configuration_or_operation_effects",
    "topic_and_record_authority",
    "verified_work_product_adoption",
    "streaming_readiness_certification_authority"
  ],
  "forbidden": [
    "create_cluster",
    "update_cluster",
    "delete_cluster",
    "update_cluster_configuration",
    "update_broker_type",
    "reboot_broker",
    "cancel_operation",
    "create_topic",
    "delete_topic",
    "read_kafka_records",
    "read_bootstrap_endpoints",
    "retain_broker_addresses",
    "retain_raw_configuration_properties",
    "retain_raw_operation_messages",
    "resolve_live_credentials",
    "claim_connected",
    "claim_native",
    "claim_first_party",
    "claim_streaming_certification",
    "adopt_kernel_outcome",
    "adopt_verified_work_product"
  ]
}
