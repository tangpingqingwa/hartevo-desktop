{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tangpingqingwa/hartevo-desktop/contracts/plugins/aws-kms-key-posture-result/aws-kms-key-posture-result.v1.json",
  "title": "Hartevo AWS KMS key-posture result Layer-1 contract",
  "description": "A bounded, read/propose/record/verify-only AWS KMS key-posture seam. It is not a KMS control plane, cryptographic authority, policy exporter, or Hartevo Outcome authority.",
  "schemaVersion": "hartevo.aws-kms-key-posture-result.contract/v1",
  "contractVersion": "aws-kms-key-posture-result/v1",
  "pluginVersion": "1.0.0",
  "layer": "Layer-1",
  "service": {
    "id": "hartevo.aws.kms.key-posture-result",
    "implementation": "AwsKmsKeyPostureService",
    "operations": [
      "describe_capabilities",
      "register",
      "revoke_registration",
      "reverse_registration",
      "propose",
      "record",
      "verify",
      "read_key_posture",
      "consume_mission_proposal"
    ],
    "readOnly": true,
    "proposalOnly": true,
    "liveExecution": false,
    "externalWrites": false,
    "kernelAuthority": false,
    "cryptographicVerificationAuthority": false
  },
  "provider": {
    "id": "aws.kms.key-posture.read",
    "implementation": "AwsKmsProvider",
    "providerVersion": "aws-kms-provider/v1",
    "apiVersion": "2014-11-01",
    "apiRevision": "kms-list-keys-describe-key-rotation-status-list-aliases-list-grants-r1",
    "allowlistedReads": [
      "ListKeys",
      "DescribeKey",
      "GetKeyRotationStatus",
      "ListAliases",
      "ListGrants"
    ],
    "acceptedTransports": ["fixture", "recording", "loopback", "BLOCKED_ENV"],
    "native": false,
    "connected": false,
    "firstParty": false,
    "readOnly": true,
    "sigV4Secret": "opaque_non_serializing_secret_reference_only",
    "boundedMarkers": true,
    "markerDigestOnly": true,
    "noRetries": true
  },
  "consumer": {
    "id": "mission.aws.kms.key-posture",
    "implementation": "MissionAwsKmsConsumer",
    "missionBound": true,
    "projectBound": true,
    "workProductBound": true,
    "revisionBound": true,
    "permissionBound": true,
    "adoptsOutcome": false,
    "truthAuthority": false,
    "cryptographicVerificationAuthority": false
  },
  "scope": {
    "required": [
      "awsAccountId",
      "awsRegion",
      "deploymentIdAndRevision",
      "missionIdAndRevision",
      "projectIdAndRevision",
      "workProductIdAndRevision",
      "permissionDigest",
      "scopeDigest",
      "opaqueSigV4SecretReference"
    ],
    "optional": ["keyIdOrArnAllowlist"],
    "keyIdentifiersInEvidence": "sha256_digest_only",
    "keyMaterial": false,
    "plaintext": false,
    "rawKeyPolicyJson": false,
    "grantPrincipals": false,
    "cryptographicOutputs": false
  },
  "registration": {
    "boundDigests": [
      "pluginVersion",
      "contractVersion",
      "contractDigest",
      "providerId",
      "providerVersion",
      "providerRevision",
      "providerDigest",
      "apiDigest",
      "permissionDigest",
      "scopeDigest",
      "keyScopeDigest",
      "evidenceDigest",
      "secretReferenceDigest",
      "registrationRevision"
    ],
    "reversible": true,
    "revocable": true,
    "failClosedOn": [
      "version_drift",
      "contract_drift",
      "provider_or_api_revision_drift",
      "permission_or_scope_drift",
      "key_allowlist_drift",
      "eventual_consistency",
      "marker_loop",
      "partial_pagination",
      "pending_deletion",
      "disabled_or_unknown_state",
      "access_loss",
      "400_401_403_404_429_500",
      "timeout",
      "tamper",
      "replay",
      "secret_revocation",
      "registration_revocation"
    ]
  },
  "bounds": {
    "maxPageSize": 100,
    "maxPages": 4,
    "maxKeys": 256,
    "maxAliases": 256,
    "maxGrants": 256,
    "maxResponseBytes": 1048576,
    "maxRetries": 0
  },
  "evidence": {
    "projected": [
      "keyIdDigest",
      "keyArnDigest",
      "keyState",
      "keySpec",
      "keyUsage",
      "keyOrigin",
      "multiRegion",
      "aliasCount",
      "aliasDigest",
      "grantCount",
      "grantDigest",
      "rotationEnabled",
      "rotationPeriodDays",
      "rotationNextDate",
      "redactedRequestReceipts",
      "redactedCostReceipt"
    ],
    "digests": [
      "pluginVersion",
      "contract",
      "provider",
      "api",
      "permission",
      "scope",
      "key",
      "proposal",
      "evidence"
    ],
    "notRetained": [
      "keyMaterial",
      "plaintext",
      "rawKeyPolicyJson",
      "grantPrincipals",
      "rawPaginationMarkers",
      "rawProviderPayload",
      "cryptographicOutputs",
      "encryption",
      "decryption",
      "dataKeys"
    ],
    "missingOrUnsafeDataFailsClosed": true
  },
  "forbiddenEffects": [
    "Encrypt",
    "Decrypt",
    "GenerateDataKey",
    "CreateKey",
    "ScheduleKeyDeletion",
    "CancelKeyDeletion",
    "EnableKey",
    "DisableKey",
    "EnableKeyRotation",
    "DisableKeyRotation",
    "PutKeyPolicy",
    "DeleteKeyPolicy",
    "CreateGrant",
    "RetireGrant",
    "RevokeGrant",
    "GetKeyPolicy",
    "cryptographicVerificationAuthority",
    "outcome.adopt"
  ],
  "nativeClaims": {
    "connected": false,
    "nativeProvider": false,
    "firstParty": false,
    "durableReceipt": false,
    "blockedEnvironmentIsNative": false
  },
  "layer2Gaps": [
    "native_opaque_sigv4_secret_resolution",
    "native_sigv4_request_signing",
    "native_bounded_kms_readback",
    "durable_provider_receipt",
    "independent_key_posture_reconciliation",
    "verified_work_product_adoption"
  ]
}
