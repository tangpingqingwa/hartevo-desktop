    "version": "1.0.0",
    "apiRevision": "hightouch-api-v1-metadata-read-r1",
    "baseUrl": "https://api.hightouch.com/api/v1",
    "operations": [
      "GET /workspaces/{workspaceId}",
      "GET /sources/{sourceId}",
      "GET /models/{modelId}",
      "GET /destinations/{destinationId}",
      "GET /syncs/{syncId}",
      "GET /syncs/{syncId}/runs"
    ],
    "allowlistedMethods": ["GET"],
    "allowlistedReads": [
      "workspace_metadata",
      "source_metadata",
      "model_metadata",
      "destination_metadata",
      "sync_metadata",
      "bounded_run_metadata"
    ],
