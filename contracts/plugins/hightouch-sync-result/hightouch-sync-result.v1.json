    "scope": true,
    "workspace": true,
    "source": true,
    "model": true,
    "sync": true,
    "destination": true,
    "run": true,
    "commit": true,
    "cursor": true,
    "idempotency": true,
    "registration": true,
    "evidence": true
  },
