        "method": "GET",
        "path": "/workspaces/{workspaceId}",
        "metadataOnly": true,
        "sourceRows": false
      },
      {
        "operation": "source_metadata",
        "method": "GET",
        "path": "/sources/{sourceId}",
        "metadataOnly": true,
        "sourceRows": false
      },
      {
        "operation": "model_metadata",
        "method": "GET",
        "path": "/models/{modelId}",
        "methodDefinition": false,
        "sourceRows": false
      },
      {
        "operation": "destination_metadata",
        "method": "GET",
        "path": "/destinations/{destinationId}",
        "destinationConfiguration": "digest_only",
        "destinationWrites": false
      },
      {
        "operation": "sync_metadata",
        "method": "GET",
        "path": "/syncs/{syncId}",
        "configuration": "digest_only",
        "syncEffects": false
      },
      {
        "operation": "bounded_run_metadata",
        "method": "GET",
        "path": "/syncs/{syncId}/runs",
        "pagination": "bounded_opaque_cursor",
        "rowData": false,
        "errorDetails": "digest_only"
      }
    ],
    "writes": [],
