  "contractVersion": "EXT-HIGHTOUCH-01-L1/v1",
  "pluginVersion": "0.1.0",
  "layer": 1,
  "evidenceLevel": "L1_PROVIDER_CONTRACT",
  "status": "read_proposal_recording_only",
  "authority": {
