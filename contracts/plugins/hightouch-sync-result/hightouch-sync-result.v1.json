    "id": "hightouch.sync-result.read",
    "type": "HightouchSyncResultService",
    "access": "read_proposal_recording",
    "operations": [
      "describe_capabilities",
      "read_workspace_metadata",
      "read_source_metadata",
      "read_model_metadata",
      "read_destination_metadata",
      "read_sync_metadata",
      "read_bounded_run_metadata",
      "compile_sync_result_proposal",
      "record_observation",
      "verify_proposal",
      "revoke_registration",
      "restore_registration"
