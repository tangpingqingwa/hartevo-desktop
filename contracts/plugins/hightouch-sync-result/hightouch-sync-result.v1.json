      "bounded allowlisted Hightouch metadata GET seams",
      "opaque cursor and bounded retry/backoff evidence",
      "version/provider/permission/consent/scope/evidence digest fences",
      "reversible and revocable registration",
      "redacted idempotent observation recording",
      "Mission proposal projection"
    ],
    "doesNotOwn": [
      "source rows",
      "raw model SQL or preview data",
      "destination payloads or writes",
      "sync trigger, cancel, retry, or mutation",
      "generic ETL registry",
      "native API-key resolution",
      "live Hightouch HTTPS",
      "durable provider receipts",
      "independent run/readback authority",
      "Hartevo Truth, Consent, Effect, Receipt, Verification, or Outcome authority",
      "verified Work Product adoption"
