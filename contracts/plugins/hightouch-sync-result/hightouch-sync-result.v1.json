    "readOnly": true,
    "proposalOnly": true,
    "recordingOnly": true,
    "externalWrites": false,
    "liveExternalIo": false,
    "syncTrigger": false,
    "syncCancel": false,
    "destinationWrite": false,
    "sourceRows": false,
    "kernelAuthority": false,
    "outcomeAdoption": false
