    "rawApiKey": false,
    "rawResponseBody": false,
    "rawSourceRows": false,
    "rawDestinationPayloads": false,
    "connected": false,
    "native": false,
    "durableProviderReceipt": false,
    "externalWrites": false
  },
  "consumer": {
    "id": "mission.hightouch-sync-result",
    "type": "MissionHightouchSyncConsumer",
    "authority": "proposal_and_recording_below_kernel",
