    "proposalOnly": true,
    "recordingOnly": true,
    "connected": false,
    "nativeProvider": false,
    "externalWrites": false,
    "syncEffects": false,
    "destinationWrites": false,
    "sourceRows": false,
    "rawCredentials": false,
    "durableProviderReceipt": false,
    "kernelAuthority": false,
