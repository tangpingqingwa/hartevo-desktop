    "maxPages": 4,
    "maxRunsPerPage": 50,
    "maxRetryAttempts": 3,
    "maxBackoffSeconds": 60,
    "maxResponseBytes": 1048576,
    "maxIdentifierBytes": 256,
    "maxSecretReferenceBytes": 512,
    "maxCursorBytes": 512,
