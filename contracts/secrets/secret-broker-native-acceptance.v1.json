{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hartevo-secret-broker-native-acceptance/v1",
  "title": "Hartevo Secret Broker native acceptance evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentType",
    "authority",
    "releaseDecision",
    "sourceCommit",
    "scope",
    "secretReference",
    "dispatch",
    "lease",
    "provider",
    "consumer",
    "receipt",
    "verification",
    "redaction",
    "lifecycleProofs"
  ],
  "properties": {
    "schemaVersion": { "const": "hartevo-secret-broker-native-acceptance/v1" },
    "documentType": { "const": "secret_broker_native_acceptance" },
    "authority": { "const": "secret_broker_native_acceptance_only" },
    "releaseDecision": { "const": "NOT_EVALUATED" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "scope": { "$ref": "#/$defs/scope" },
    "secretReference": { "$ref": "#/$defs/secretReference" },
    "dispatch": { "$ref": "#/$defs/dispatch" },
    "lease": { "$ref": "#/$defs/lease" },
    "provider": { "$ref": "#/$defs/provider" },
    "consumer": { "$ref": "#/$defs/consumer" },
    "receipt": { "$ref": "#/$defs/receipt" },
    "verification": { "$ref": "#/$defs/verification" },
    "redaction": { "$ref": "#/$defs/redaction" },
    "lifecycleProofs": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/lifecycleProof" }
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "projectId", "missionId", "scopeDigest"],
      "properties": {
        "tenantId": { "type": "string", "minLength": 1 },
        "projectId": { "type": "string", "minLength": 1 },
        "missionId": { "type": "string", "minLength": 1 },
        "scopeDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "secretReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "referenceDigest",
        "serviceDigest",
        "providerId",
        "accountDigest",
        "capability",
        "credentialRevision",
        "generation",
        "scopeDigest",
        "referenceOnly",
        "plaintextPresent"
      ],
      "properties": {
        "referenceDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "serviceDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "providerId": { "type": "string", "minLength": 1 },
        "accountDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "capability": { "type": "string", "minLength": 1 },
        "credentialRevision": { "type": "integer", "minimum": 1 },
        "generation": { "type": "integer", "minimum": 1 },
        "scopeDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "referenceOnly": { "const": true },
        "plaintextPresent": { "const": false }
      }
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "referenceDigest",
        "scopeDigest",
        "containsHandle",
        "containsLease",
        "containsPlaintext",
        "reauthorizationRequired"
      ],
      "properties": {
        "mode": { "const": "reference_only" },
        "referenceDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "scopeDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "containsHandle": { "const": false },
        "containsLease": { "const": false },
        "containsPlaintext": { "const": false },
        "reauthorizationRequired": { "const": true }
      }
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leaseDigest",
        "scopeDigest",
        "generation",
        "credentialRevision",
        "ttlSeconds",
        "issuedAt",
        "expiresAt",
        "reclaimedAt",
        "reclaimed",
        "activeAfterReclaim",
        "providerBoundary",
        "plaintextPresent"
      ],
      "properties": {
        "leaseDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "scopeDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "generation": { "type": "integer", "minimum": 1 },
        "credentialRevision": { "type": "integer", "minimum": 1 },
        "ttlSeconds": { "type": "integer", "minimum": 1, "maximum": 60 },
        "issuedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "reclaimedAt": { "type": "string", "format": "date-time" },
        "reclaimed": { "const": true },
        "activeAfterReclaim": { "const": false },
        "providerBoundary": { "const": true },
        "plaintextPresent": { "const": false }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceCommit",
        "scopeDigest",
        "mode",
        "provenance",
        "outputPresent",
        "outputDigest",
        "osKeyringStatus",
        "realOutputStatus",
        "consumerUsedService",
        "plaintextPresent"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "scopeDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "mode": {
          "enum": ["native", "simulator", "fixture", "blocked_env", "missing"]
        },
        "provenance": {
          "enum": ["native_provider", "simulator", "fixture", "blocked_env", "missing"]
        },
        "outputPresent": { "type": "boolean" },
        "outputDigest": { "type": "string", "pattern": "^([0-9a-f]{64})?$" },
        "osKeyringStatus": {
          "enum": ["available", "blocked_env", "not_evaluated"]
        },
        "realOutputStatus": {
          "enum": ["available", "blocked_env", "not_evaluated"]
        },
        "consumerUsedService": { "const": true },
        "plaintextPresent": { "const": false }
      }
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceCommit",
        "scopeDigest",
        "referenceDigest",
        "generation",
        "credentialRevision",
        "serviceUsed",
        "providerDispatchReferenceOnly",
        "effectAuthorityAttached",
        "plaintextPresent"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "scopeDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "referenceDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "generation": { "type": "integer", "minimum": 1 },
        "credentialRevision": { "type": "integer", "minimum": 1 },
        "serviceUsed": { "const": true },
        "providerDispatchReferenceOnly": { "const": true },
        "effectAuthorityAttached": { "const": false },
        "plaintextPresent": { "const": false }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sourceCommit",
        "scopeDigest",
        "referenceDigest",
        "leaseDigest",
        "resultDigest",
        "verificationDigest",
        "leaseReclaimed",
        "containsHandle",
        "plaintextPresent",
        "errorRedacted"
      ],
      "properties": {
        "status": { "enum": ["completed", "failed", "not_evaluated"] },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "scopeDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "referenceDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "leaseDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "resultDigest": { "type": "string", "pattern": "^([0-9a-f]{64})?$" },
        "verificationDigest": { "type": "string", "pattern": "^([0-9a-f]{64})?$" },
        "leaseReclaimed": { "const": true },
        "containsHandle": { "const": false },
        "plaintextPresent": { "const": false },
        "errorRedacted": { "const": true }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sourceCommit",
        "scopeDigest",
        "receiptDigest",
        "resultDigest",
        "providerOutputDigest",
        "verified",
        "plaintextPresent"
      ],
      "properties": {
        "status": { "enum": ["verified", "not_evaluated", "blocked_env"] },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "scopeDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "receiptDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "resultDigest": { "type": "string", "pattern": "^([0-9a-f]{64})?$" },
        "providerOutputDigest": { "type": "string", "pattern": "^([0-9a-f]{64})?$" },
        "verified": { "type": "boolean" },
        "plaintextPresent": { "const": false }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceCommit", "surfaces", "allContentFree", "scanDigest"],
      "properties": {
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "surfaces": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/redactionSurface" }
        },
        "allContentFree": { "const": true },
        "scanDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "redactionSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "plaintextFound", "scanDigest"],
      "properties": {
        "surface": { "enum": ["mission", "event", "debug", "error", "receipt"] },
        "plaintextFound": { "const": false },
        "scanDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "lifecycleProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hook",
        "sourceCommit",
        "scopeDigest",
        "oldReferenceDigest",
        "oldGeneration",
        "newGeneration",
        "oldLeaseDigest",
        "oldGenerationAccepted",
        "oldLeaseAccepted",
        "replayReferenceOnly",
        "reauthorizationRequired",
        "newLeaseIssued",
        "failureCode",
        "proofDigest"
      ],
      "properties": {
        "hook": { "enum": ["rotation", "revoke", "unmount", "crash", "replay"] },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "scopeDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "oldReferenceDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "oldGeneration": { "type": "integer", "minimum": 1 },
        "newGeneration": { "type": "integer", "minimum": 1 },
        "oldLeaseDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "oldGenerationAccepted": { "const": false },
        "oldLeaseAccepted": { "const": false },
        "replayReferenceOnly": { "type": "boolean" },
        "reauthorizationRequired": { "type": "boolean" },
        "newLeaseIssued": { "type": "boolean" },
        "failureCode": { "type": "string", "minLength": 1 },
        "proofDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
